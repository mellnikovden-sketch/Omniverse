-- Silent Aim для MM2 (только на убийцу)
-- Работает как настоящий Silent Aim: вы стреляете куда угодно, а пуля летит в убийцу
-- Кнопка на экране или клавиша S для включения/выключения

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- ==============================================
-- НАСТРОЙКИ
-- ==============================================
local Config = {
    Enabled = false,
    TargetPart = "Head",           -- Head, HumanoidRootPart, UpperTorso
    SilentMode = true,             -- true = Silent Aim, false = обычный аим
    Prediction = 0.3,              -- Предсказание движения
    AutoShoot = false,             -- Автоматическая стрельба при наведении
}

-- ==============================================
-- ПОИСК УБИЙЦЫ
-- ==============================================

-- Определение убийцы по оружию
local function IsMurderer(player)
    if not player or not player.Character then return false end
    
    local character = player.Character
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    -- Список оружия убийцы
    local murdererWeapons = {
        "knife", "blade", "dagger", "saw", "slasher", "axe", "scythe",
        "peppermint", "cookie", "edge", "batwing", "icewing", "bone",
        "hallow", "vampire", "cutter", "candy"
    }
    
    -- Проверяем оружие в руках
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            for _, wName in ipairs(murdererWeapons) do
                if name:find(wName) or wName:find(name) then
                    return true
                end
            end
            -- Проверка через ToolTip
            if tool.ToolTip and string.lower(tool.ToolTip):find("knife") then
                return true
            end
        end
    end
    
    -- Проверяем рюкзак
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                for _, wName in ipairs(murdererWeapons) do
                    if name:find(wName) or wName:find(name) then
                        return true
                    end
                end
            end
        end
    end
    
    -- Проверяем атрибуты
    if player:GetAttribute("Murderer") == true then
        return true
    end
    
    return false
end

-- Поиск убийцы
local function FindMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsMurderer(player) then
            return player
        end
    end
    return nil
end

-- ==============================================
-- ПОЛУЧЕНИЕ ПОЗИЦИИ ЦЕЛИ С ПРЕДСКАЗАНИЕМ
-- ==============================================

local function GetTargetPosition(murderer)
    if not murderer or not murderer.Character then return nil end
    
    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart)
    if not targetPart then return nil end
    
    local vel = targetPart.AssemblyLinearVelocity or Vector3.new()
    local predPos = targetPart.Position + (vel * Config.Prediction)
    
    return predPos
end

-- ==============================================
-- ПЕРЕХВАТ ВЫСТРЕЛА (SILENT AIM)
-- ==============================================

local function SilentShoot(murderer)
    if not murderer or not murderer.Character then return end
    
    local targetPos = GetTargetPosition(murderer)
    if not targetPos then return end
    
    -- Получаем оружие (пистолет шерифа)
    local character = LocalPlayer.Character
    if not character then return end
    
    local gun = nil
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("gun") or name:find("pistol") or name:find("revolver") then
                gun = tool
                break
            end
        end
    end
    
    if not gun then
        -- Проверяем рюкзак
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local name = tool.Name:lower()
                    if name:find("gun") or name:find("pistol") or name:find("revolver") then
                        gun = tool
                        break
                    end
                end
            end
        end
    end
    
    if not gun then return end
    
    -- Ищем Remote для выстрела
    local remote = nil
    local remotePath = {
        "Remote",
        "Fire",
        "Shoot",
        "GunEvent",
        "FireServer",
        "RemoteEvent"
    }
    
    for _, path in ipairs(remotePath) do
        local found = gun:FindFirstChild(path)
        if found then
            remote = found
            break
        end
        -- Проверяем в ReplicatedStorage
        found = ReplicatedStorage:FindFirstChild(path)
        if found then
            remote = found
            break
        end
    end
    
    if not remote then return end
    
    -- Перехватываем выстрел и перенаправляем в цель
    if Config.SilentMode then
        -- В режиме Silent Aim мы перенаправляем выстрел
        local origin = workspace.CurrentCamera.CFrame.Position
        local direction = (targetPos - origin).Unit
        
        -- Создаем CFrame для выстрела
        local shootCFrame = CFrame.lookAt(origin, targetPos)
        
        -- Отправляем выстрел с измененной траекторией
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(shootCFrame, targetPos)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(shootCFrame, targetPos)
            else
                -- Если это не Remote, пробуем другие методы
                remote:FireServer(shootCFrame)
            end
        end)
    end
end

-- ==============================================
-- ПЕРЕХВАТ СОБЫТИЯ ВЫСТРЕЛА
-- ==============================================

-- Оригинальный метод выстрела
local originalShoot = nil

-- Функция для перехвата выстрела
local function HookShoot()
    local character = LocalPlayer.Character
    if not character then return end
    
    local gun = nil
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("gun") or name:find("pistol") or name:find("revolver") then
                gun = tool
                break
            end
        end
    end
    
    if not gun then return end
    
    -- Ищем Remote для выстрела
    local remote = nil
    for _, child in ipairs(gun:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            remote = child
            break
        end
    end
    
    if not remote then return end
    
    -- Сохраняем оригинальный метод
    if remote:IsA("RemoteEvent") then
        originalShoot = remote.FireServer
        remote.FireServer = function(self, ...)
            if Config.Enabled then
                local murderer = FindMurderer()
                if murderer then
                    SilentShoot(murderer)
                    return
                end
            end
            return originalShoot(self, ...)
        end
    end
end

-- ==============================================
-- СОЗДАНИЕ GUI
-- ==============================================

local function CreateGUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SilentAimMM2"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    
    local parent = gethui and gethui() or game:GetService("CoreGui")
    screenGui.Parent = parent
    
    -- Кнопка
    local button = Instance.new("ImageButton")
    button.Name = "ToggleButton"
    button.Size = UDim2.new(0, 60, 0, 60)
    button.Position = UDim2.new(0.85, 0, 0.85, 0)
    button.AnchorPoint = Vector2.new(0.5, 0.5)
    button.BackgroundTransparency = 1
    button.Image = "rbxassetid://86221076925479"
    button.Parent = screenGui
    
    -- Текст
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "SA:OFF"
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.TextSize = 14
    text.Font = Enum.Font.Jura
    text.Parent = button
    
    -- Обводка
    local stroke = Instance.new("UIGradient", button)
    stroke.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))
    })
    
    return button, text, stroke
end

local button, text, stroke = CreateGUI()

-- ==============================================
-- УПРАВЛЕНИЕ
-- ==============================================

-- Обновление кнопки
local function UpdateButton()
    if button then
        local textLabel = button:FindFirstChildOfClass("TextLabel")
        if textLabel then
            textLabel.Text = Config.Enabled and "SA:ON" or "SA:OFF"
            textLabel.TextColor3 = Config.Enabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        end
    end
    if stroke then
        stroke.Color = Config.Enabled and ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 200, 0))
        }) or ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))
        })
    end
end

-- Переключение Silent Aim
local function ToggleSilentAim()
    Config.Enabled = not Config.Enabled
    UpdateButton()
    print("🎯 Silent Aim: " .. (Config.Enabled and "ENABLED" or "DISABLED"))
    if Config.Enabled then
        print("👤 Цель: Убийца")
        local murderer = FindMurderer()
        if murderer then
            print("🔪 Убийца найден: " .. murderer.Name)
        else
            print("❌ Убийца не найден")
        end
    end
end

-- ==============================================
-- ПОДКЛЮЧЕНИЕ УПРАВЛЕНИЯ
-- ==============================================

-- Кнопка
if button then
    button.MouseButton1Click:Connect(ToggleSilentAim)
    button.TouchTap:Connect(ToggleSilentAim)
end

-- Горячая клавиша S
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.S then
        ToggleSilentAim()
    end
end)

-- ==============================================
-- ПЕРЕХВАТ ВЫСТРЕЛА ПРИ КАЖДОМ КАДРЕ
-- ==============================================

-- Функция для перехвата выстрела через Mouse
local function HookMouseClick()
    local mouse = LocalPlayer:GetMouse()
    if not mouse then return end
    
    -- Сохраняем оригинальный метод
    local originalButton1Down = mouse.Button1Down
    mouse.Button1Down = function(...)
        if Config.Enabled then
            local murderer = FindMurderer()
            if murderer then
                SilentShoot(murderer)
                return
            end
        end
        return originalButton1Down and originalButton1Down(...)
    end
end

-- Запускаем перехват
task.spawn(HookMouseClick)

-- Перехват через CharacterAdded
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    HookShoot()
end)

