    UpdateButton()
    print("🎯 Silent Aim: " .. (Config.Enabled and "ENABLED" or "DISABLED"))
    if Config.Enabled then
        local murderer = FindMurderer()
        if murderer then
            print("🔪 Убийца найден: " .. murderer.Name)
        else
            print("❌ Убийца не найден")
        end
    end
end

