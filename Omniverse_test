local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local shootEnabled = false
local gun = nil

-- Функция для поиска убийцы
local function findMurderer()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local closestMurderer = nil
    local closestDistance = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                -- Проверяем, является ли игрок убийцей (по наличию ножа)
                local hasKnife = false
                for _, child in ipairs(player.Character:GetChildren()) do
                    if child:IsA("Tool") and (child.Name:lower():find("knife") or child.Name:lower():find("dagger") or child.Name:lower():find("blade")) then
                        hasKnife = true
                        break
                    end
                end
                
                if hasKnife then
                    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        local distance = (character.HumanoidRootPart.Position - rootPart.Position).Magnitude
                        if distance < closestDistance then
                            closestDistance = distance
                            closestMurderer = player
                        end
                    end
                end
            end
        end
    end
    
    return closestMurderer
end

-- Функция для получения оружия (пистолета)
local function getGun()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("gun") or tool.Name:lower():find("pistol") or tool.Name:lower():find("revolver")) then
            return tool
        end
    end
    return nil
end

-- Функция для стрельбы в убийцу
local function shootMurderer()
    if not shootEnabled then return end
    
    local murderer = findMurderer()
    if not murderer then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local gun = getGun()
    if not gun then
        -- Если нет оружия, ищем в инвентаре
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:lower():find("gun") or tool.Name:lower():find("pistol") or tool.Name:lower():find("revolver")) then
                    gun = tool
                    break
                end
            end
        end
    end
    
    if not gun then
        print("No gun found!")
        return
    end
    
    -- Экипируем оружие, если оно в рюкзаке
    if gun.Parent ~= character then
        gun.Parent = character
        task.wait(0.1)
    end
    
    local murdererRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not murdererRoot then return end
    
    -- Активируем оружие
    local activate = gun:FindFirstChild("Activate")
    if not activate then
        activate = gun:FindFirstChild("RemoteEvent")
    end
    
    if activate then
        -- Наводимся на убийцу
        local camera = workspace.CurrentCamera
        if camera then
            local targetPosition = murdererRoot.Position + Vector3.new(0, 1.5, 0) -- Целимся в голову/тело
            camera.CFrame = CFrame.new(camera.CFrame.Position, targetPosition)
        end
        
        task.wait(0.05)
        
        -- Стреляем
        if activate:IsA("RemoteEvent") then
            activate:FireServer()
        elseif activate:IsA("BindableEvent") then
            activate:Fire()
        elseif typeof(activate) == "function" then
            activate()
        end
        
        print("Shot at: " .. murderer.Name)
    else
        -- Альтернативный способ стрельбы
        local remote = gun:FindFirstChild("RemoteEvent")
        if remote then
            remote:FireServer("Shoot")
        end
        
        -- Пытаемся использовать через ClickDetector
        local clickDetector = gun:FindFirstChild("ClickDetector")
        if clickDetector then
            clickDetector:Click()
        end
    end
end

-- Функция для непрерывной стрельбы
local shooting = false
local shootCoroutine = nil

local function startAutoShoot()
    if shootCoroutine then
        coroutine.close(shootCoroutine)
        shootCoroutine = nil
    end
    
    shootCoroutine = coroutine.create(function()
        while shooting and shootEnabled do
            shootMurderer()
            task.wait(0.3) -- Задержка между выстрелами
        end
    end)
    coroutine.resume(shootCoroutine)
end

