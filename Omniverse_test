-- ═══════════════════════════════════════════════════════════
-- УТИЛИТЫ
-- ═══════════════════════════════════════════════════════════

local function Clamp(v, min, max)
    return v < min and min or (v > max and max or v)
end

local function Lerp(a, b, t)
    return a + (b - a) * t
end

local function GetPing()
    local ping = LocalPlayer:GetNetworkPing()
    return math.floor((ping > 0 and ping or 0.06) * 1000)
end

local function GetPlayerCount()
    return #Players:GetPlayers()
end

local function GetRoot(p)
    if not p then return nil end
    local c = p.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end

local function HasWeapon(p)
    if not p or not p.Character then return false end
    for _, item in ipairs(p.Character:GetChildren()) do
        if item:IsA("Tool") then
            local n = item.Name:lower()
            if n:find("knife") or n:find("blade") or n:find("dagger") or n:find("sword") then
                return true
            end
        end
    end
    return false
end

local function IsMurderer(p)
    if not p then return false end
    if p:GetAttribute("Murderer") == true or p:GetAttribute("isMurderer") == true then return true end
    return HasWeapon(p)
end

-- ═══════════════════════════════════════════════════════════
-- ПОИСК УБИЙЦЫ
-- ═══════════════════════════════════════════════════════════

local function FindBestTarget()
    if not State.MyRoot then return nil end
    
    local bestTarget = nil
    local bestScore = -math.huge
    
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and IsMurderer(pl) then
            local root = GetRoot(pl)
            local hum = pl.Character and pl.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - State.MyRoot.Position).Magnitude
                if dist >= CONFIG.MIN_DISTANCE and dist <= CONFIG.MAX_DISTANCE then
                    local score = 1000 / (dist + 1)
                    local speed = root.AssemblyLinearVelocity.Magnitude
                    if speed > 15 then score = score + 50 end
                    if score > bestScore then
                        bestScore = score
                        bestTarget = pl
                    end
                end
            end
        end
    end
    
    State.Target = bestTarget
    return bestTarget
end

-- ═══════════════════════════════════════════════════════════
-- ОБРАБОТКА ЦЕЛИ
-- ═══════════════════════════════════════════════════════════

local function ProcessTarget(root)
    if not root then return nil, nil, nil end
    
    local pos = root.Position
    local vel = root.AssemblyLinearVelocity
    
    table.insert(State.TargetPosHistory, pos)
    table.insert(State.TargetVelHistory, vel)
    
    if #State.TargetPosHistory > CONFIG.MAX_HISTORY then
        table.remove(State.TargetPosHistory, 1)
        table.remove(State.TargetVelHistory, 1)
    end
    
    if #State.TargetVelHistory >= 2 then
        local accel = (State.TargetVelHistory[#State.TargetVelHistory] - State.TargetVelHistory[#State.TargetVelHistory - 1]) / 0.05
        table.insert(State.TargetAccelHistory, accel)
        if #State.TargetAccelHistory > CONFIG.MAX_HISTORY then
            table.remove(State.TargetAccelHistory, 1)
        end
    end
    
    local avgP, avgV, avgA = Vector3.new(0, 0, 0), Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)
    
    for i = 1, #State.TargetPosHistory do
        avgP = avgP + State.TargetPosHistory[i]
        avgV = avgV + State.TargetVelHistory[i]
    end
    avgP = avgP / #State.TargetPosHistory
    avgV = avgV / #State.TargetVelHistory
    
    if #State.TargetAccelHistory > 0 then
        for i = 1, #State.TargetAccelHistory do
            avgA = avgA + State.TargetAccelHistory[i]
        end
        avgA = avgA / #State.TargetAccelHistory
    end
    
    if avgV.Magnitude > 1.5 then
        local dir = Vector3.new(avgV.X, 0, avgV.Z).Unit
        local dot = dir:Dot(State.LastDirection)
        if dot < 0.15 then
            State.AntiStrafeFactor = 0.5
        elseif dot < 0.3 then
            State.AntiStrafeFactor = 0.7
        else
            State.AntiStrafeFactor = Clamp(State.AntiStrafeFactor + 0.05, 0.5, 1.3)
        end
        State.LastDirection = dir
    else
        State.AntiStrafeFactor = Lerp(State.AntiStrafeFactor, 1.0, 0.15)
    end
    
    return avgP, avgV, avgA
end

-- ═══════════════════════════════════════════════════════════
-- ПРИМЕНЕНИЕ КОНФИГА
-- ═══════════════════════════════════════════════════════════

local function ApplyGPL(sim, interval, x, y, z, h, v)
    if State.Locked then 
        return 
    end
    
    local last = State.LastApplied
    
    if math.abs(last.H - h) < 1 and math.abs(last.V - v) < 1 and
       math.abs(last.Sim - sim) < 1 and math.abs(last.Int - interval) < 1 and
       last.X == x and last.Y == y and last.Z == z then
        return
    end
    
    last.H, last.V, last.Sim, last.Int = h, v, sim, interval
    last.X, last.Y, last.Z = x, y, z
    
    if gpl_preset[4] then gpl_preset[4](math.floor(sim * CONFIG.ACCURACY_BOOST)) end
    if gpl_preset[5] then gpl_preset[5](math.floor(interval / CONFIG.ACCURACY_BOOST)) end
    if gpl_preset[6] then gpl_preset[6](x) end
    if gpl_preset[7] then gpl_preset[7](y) end
    if gpl_preset[8] then gpl_preset[8](z) end
    if gpl_preset[9] then gpl_preset[9](h) end
    if gpl_preset[10] then gpl_preset[10](v) end
    
    State.Stats.ConfigsGenerated = State.Stats.ConfigsGenerated + 1
end

