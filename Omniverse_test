-- Находим Remote GunBeam
local gunBeamRemote = ReplicatedStorage:FindFirstChild("WeaponEvents")
if gunBeamRemote then
    gunBeamRemote = gunBeamRemote:FindFirstChild("GunBeam")
end

print(gunBeamRemote and "✅ Найден Remote: GunBeam" or "❌ GunBeam не найден")

-- Сохраняем оригинальные методы
local originalFireServer = nil
local originalInvokeServer = nil

-- Функция для обработки выстрела
local function ProcessGunBeam(remote, ...)
    if not Config.Enabled then
        -- Если выключен, вызываем оригинал
        if originalFireServer then
            return originalFireServer(remote, ...)
        end
        return
    end
    
    local murderer = FindMurderer()
    if not murderer then
        if originalFireServer then
            return originalFireServer(remote, ...)
        end
        return
    end
    
    local targetPos = GetTargetPosition(murderer)
    if not targetPos then
        if originalFireServer then
            return originalFireServer(remote, ...)
        end
        return
    end
    
    -- Получаем аргументы
    local args = {...}
    
    -- Для GunBeam обычно передаются: (player, position, something)
    -- Заменяем позицию на цель
    for i, arg in ipairs(args) do
        if typeof(arg) == "Vector3" then
            args[i] = targetPos
        elseif typeof(arg) == "CFrame" then
            local camera = workspace.CurrentCamera
            if camera then
                args[i] = CFrame.lookAt(camera.CFrame.Position, targetPos)
            end
        elseif type(arg) == "table" then
            if arg.Position then
                arg.Position = targetPos
            end
        end
    end
    
    -- Вызываем оригинал с измененными аргументами
    if originalFireServer then
        return originalFireServer(remote, unpack(args))
    end
end

-- Перехватываем GunBeam
if gunBeamRemote and gunBeamRemote:IsA("RemoteEvent") then
    originalFireServer = gunBeamRemote.FireServer
    gunBeamRemote.FireServer = function(self, ...)
        return ProcessGunBeam(self, ...)
    end
    print("✅ GunBeam перехвачен")
end

-- ==============================================
-- АЛЬТЕРНАТИВНЫЙ МЕТОД ЧЕРЕЗ MOUSE
-- ==============================================

local function HookMouse()
    local mouse = LocalPlayer:GetMouse()
    if not mouse then return end
    
    local originalButton1Down = mouse.Button1Down
    
    mouse.Button1Down = function(...)
        if Config.Enabled then
            local murderer = FindMurderer()
            if murderer and gunBeamRemote then
                local targetPos = GetTargetPosition(murderer)
                if targetPos then
                    pcall(function()
                        -- Пробуем разные варианты аргументов
                        gunBeamRemote:FireServer(targetPos)
                        gunBeamRemote:FireServer(LocalPlayer, targetPos)
                        gunBeamRemote:FireServer(LocalPlayer.Name, targetPos)
                    end)
                    return
                end
            end
        end
        if originalButton1Down then
            return originalButton1Down(...)
        end
    end
end

-- Запускаем
task.wait(0.5)
HookMouse()

-- Перехват при появлении персонажа
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    HookMouse()
end)

