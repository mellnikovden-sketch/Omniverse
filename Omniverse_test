button.MouseButton1Click:Connect(ToggleSilentAim)
button.TouchTap:Connect(ToggleSilentAim)

-- Клавиша S (для клавиатуры если есть)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.S then
        ToggleSilentAim()
    end
end)

-- ==============================================
-- ОСНОВНАЯ ЛОГИКА SILENT AIM (ДЛЯ ТЕЛЕФОНА)
-- ==============================================

-- Функция выстрела в убийцу
local function ShootMurderer()
    if not Config.Enabled then return end
    if not shootRemote then return end
    
    local murderer = FindMurderer()
    if not murderer then 
        print("❌ Убийца не найден")
        return 
    end
    
    local targetPos = GetTargetPosition(murderer)
    if not targetPos then return end
    
    -- Пробуем разные варианты вызова
    local success = false
    
    -- Вариант 1: просто позиция
    success = pcall(function()
        shootRemote:FireServer(targetPos)
    end)
    
    if not success then
        -- Вариант 2: с игроком
        success = pcall(function()
            shootRemote:FireServer(LocalPlayer, targetPos)
        end)
    end
    
    if not success then
        -- Вариант 3: с CFrame
        success = pcall(function()
            local camera = workspace.CurrentCamera
            if camera then
                shootRemote:FireServer(CFrame.lookAt(camera.CFrame.Position, targetPos))
            end
        end)
    end
    
    if not success then
        -- Вариант 4: с именем
        success = pcall(function()
            shootRemote:FireServer(LocalPlayer.Name, targetPos)
        end)
    end
    
    if success then
        print("🔫 Выстрел в убийцу!")
    else
        print("❌ Не удалось выстрелить")
    end
end

-- ==============================================
-- ПЕРЕХВАТ НАЖАТИЯ НА ЭКРАН (ДЛЯ ТЕЛЕФОНА)
-- ==============================================

-- Перехватываем касания экрана
UserInputService.TouchEnabled = true

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Если это касание экрана
    if input.UserInputType == Enum.UserInputType.Touch then
        -- Проверяем что это не нажатие на кнопку
        local guiObject = game:GetService("GuiService"):GetGuiObjectsAtPosition(input.Position)
        local isButton = false
        for _, obj in ipairs(guiObject) do
            if obj == button then
                isButton = true
                break
            end
        end
        
        if not isButton then
            -- Это выстрел!
            task.wait(0.05) -- небольшая задержка
            ShootMurderer()
        end
    end
end)

