-- ОСНОВНОЙ ЦИКЛ (СТАБИЛЬНЫЙ)
-- ═══════════════════════════════════════════════════════════

local function UpdateCache()
    local c = LocalPlayer.Character
    State.MyRoot = c and c:FindFirstChild("HumanoidRootPart")
end

UpdateCache()

LocalPlayer.CharacterAdded:Connect(function()
    UpdateCache()
    State.Target = nil
    State.TargetPosHistory = {}
    State.TargetVelHistory = {}
    State.TargetAccelHistory = {}
end)

local lastUpdate = 0
local updateInterval = CONFIG.UPDATE_INTERVAL

RunService.Heartbeat:Connect(function(dt)
    if not State.Enabled then return end
    
    local now = os.clock()
    if now - lastUpdate < updateInterval then return end
    lastUpdate = now
    
    if now - State.LastGC > 30 then
        State.LastGC = now
        collectgarbage("step", 100)
    end
    
    if not State.MyRoot or not State.MyRoot.Parent then
        UpdateCache()
        if not State.MyRoot then return end
    end
    
    local target = FindBestTarget()
    if not target then
        if State.MonitorEnabled and _G.OmegaUpdate then
            _G.OmegaUpdate(
                GetPing(),
                math.floor(1 / (dt or 0.016)),
                State.Stats.ConfigsGenerated,
                GetPlayerCount(),
                State.Locked
            )
        end
        return
    end
    
    local mRoot = GetRoot(target)
    if not mRoot then return end
    
    local myPos = State.MyRoot.Position
    local mPos = mRoot.Position
    local dist = (mPos - myPos).Magnitude
    
    if dist < CONFIG.MIN_DISTANCE or dist > CONFIG.MAX_DISTANCE then return end
    
    local smoothPos, smoothVel, smoothAccel = ProcessTarget(mRoot)
    if not smoothPos then return end
    
    local ping = GetPing()
    if ping <= 0 then ping = 60 end
    
    local horizSpeed = Vector3.new(smoothVel.X, 0, smoothVel.Z).Magnitude
    local vertSpeed = smoothVel.Y
    
    local antiStrafeMult = State.AntiStrafeFactor
    
    local hLead = Clamp(
        math.floor(130 + (ping * 0.38) + (horizSpeed * 2.1 * antiStrafeMult * CONFIG.PREDICTION_AGGRESSIVENESS)),
        100, 500
    )
    
    local vLead = Clamp(
        math.floor(130 + (ping * 0.28) + (dist * 0.28) + (vertSpeed * 0.9 * CONFIG.PREDICTION_AGGRESSIVENESS)),
        80, 420
    )
    
    if vertSpeed > 1.2 then
        vLead = vLead + 55 + math.abs(vertSpeed) * 3.5
    elseif vertSpeed < -4.5 then
        vLead = vLead - 40
    end
    
    if smoothAccel and smoothAccel.Magnitude > 2.5 then
        local accelDir = smoothAccel.Unit
        hLead = hLead + math.floor(accelDir.X * 16)
        vLead = vLead + math.floor(accelDir.Y * 13)
    end
    
    local sim = Clamp(
        math.floor(35 + (horizSpeed * 0.55)),
        18, 120
    )
    
    local interval = Clamp(
        math.floor(45 + (horizSpeed * -0.35)),
        8, 100
    )
    
    local offX, offY, offZ = -2, -1, 0
    
    if dist < 25 then
        offX = -5 + math.floor(horizSpeed * 0.07)
        offZ = 3 + math.floor(horizSpeed * 0.04)
        offY = offY + 2
    elseif dist > 120 then
        offX = 1
        offZ = -1
        offY = offY - 1
    end
    
    if ping > 150 then
        offX = offX - 2
        offY = offY - 2
    elseif ping < 50 then
        offX = offX + 2
        offY = offY + 2
    end
    
    ApplyGPL(sim, interval, offX, offY, offZ, hLead, vLead)
    
    if State.MonitorEnabled then
        if not _G.OmegaGui then
            CreatePremiumMonitor()
        end
        
        if _G.OmegaUpdate then
            local fps = math.floor(1 / (dt or 0.016))
            _G.OmegaUpdate(
                ping,
                fps,
                State.Stats.ConfigsGenerated,
                GetPlayerCount(),
                State.Locked
            )
        end
    end
end)

