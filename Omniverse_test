-- ==============================================
-- УПРАВЛЕНИЕ
-- ==============================================

local function UpdateButton()
    if text then
        text.Text = Config.Enabled and "SA:ON" or "SA:OFF"
        text.TextColor3 = Config.Enabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end
    if stroke then
        stroke.Color = Config.Enabled and ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 200, 0))
        }) or ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 0))
        })
    end
end

local function ToggleSilentAim()
    Config.Enabled = not Config.Enabled
    UpdateButton()
    print("🎯 Silent Aim: " .. (Config.Enabled and "ВКЛЮЧЕН" or "ВЫКЛЮЧЕН"))
    if Config.Enabled then
        local murderer = FindMurderer()
        if murderer then
            print("🔪 Убийца: " .. murderer.Name)
        else
            print("❌ Убийца не найден")
        end
    end
end

