-- ==============================================
-- ОСНОВНАЯ ЛОГИКА SILENT AIM
-- ==============================================

-- Сохраняем оригинальный FireServer
local originalFireServer = nil
local originalInvokeServer = nil

-- Функция для поиска Remote выстрела
local function FindShootRemote()
    -- Ищем в ReplicatedStorage
    for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            local name = child.Name:lower()
            if name:find("shoot") or name:find("fire") or name:find("gun") or name:find("bullet") then
                return child
            end
        end
    end
    
    -- Ищем в игроке
    local character = LocalPlayer.Character
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") then
                for _, child in ipairs(tool:GetDescendants()) do
                    if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                        local name = child.Name:lower()
                        if name:find("shoot") or name:find("fire") or name:find("gun") or name:find("bullet") then
                            return child
                        end
                    end
                end
            end
        end
    end
    
    -- Ищем в PlayerGui
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, child in ipairs(playerGui:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local name = child.Name:lower()
                if name:find("shoot") or name:find("fire") or name:find("gun") or name:find("bullet") then
                    return child
                end
            end
        end
    end
    
    return nil
end

-- Основная функция Silent Aim
local function ProcessSilentShot(remote, ...)
    if not Config.Enabled then
        -- Если Silent Aim выключен, вызываем оригинал
        if remote:IsA("RemoteEvent") and originalFireServer then
            return originalFireServer(remote, ...)
        elseif remote:IsA("RemoteFunction") and originalInvokeServer then
            return originalInvokeServer(remote, ...)
        end
        return
    end
    
    local murderer = FindMurderer()
    if not murderer then
        -- Если убийца не найден, стреляем как обычно
        if remote:IsA("RemoteEvent") and originalFireServer then
            return originalFireServer(remote, ...)
        elseif remote:IsA("RemoteFunction") and originalInvokeServer then
            return originalInvokeServer(remote, ...)
        end
        return
    end
    
    -- Получаем позицию цели
    local targetPos = GetTargetPosition(murderer)
    if not targetPos then
        if remote:IsA("RemoteEvent") and originalFireServer then
            return originalFireServer(remote, ...)
        elseif remote:IsA("RemoteFunction") and originalInvokeServer then
            return originalInvokeServer(remote, ...)
        end
        return
    end
    
    -- Меняем аргументы выстрела
    local args = {...}
    local modified = false
    
    -- Пытаемся найти позицию или CFrame в аргументах и заменить на цель
    for i, arg in ipairs(args) do
        if typeof(arg) == "CFrame" then
            -- Заменяем CFrame на направление к цели
            local camera = workspace.CurrentCamera
            if camera then
                args[i] = CFrame.lookAt(camera.CFrame.Position, targetPos)
                modified = true
            end
        elseif typeof(arg) == "Vector3" then
            -- Заменяем позицию на цель
            args[i] = targetPos
            modified = true
        elseif type(arg) == "table" then
            -- Проверяем таблицу на наличие позиции
            if arg.Position then
                arg.Position = targetPos
                modified = true
            end
            if arg.CFrame then
                local camera = workspace.CurrentCamera
                if camera then
                    arg.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
                    modified = true
                end
            end
        end
    end
    
    -- Если ничего не изменилось, добавляем позицию цели
    if not modified then
        local camera = workspace.CurrentCamera
        if camera then
            table.insert(args, CFrame.lookAt(camera.CFrame.Position, targetPos))
        end
    end
    
    -- Вызываем оригинал с измененными аргументами
    if remote:IsA("RemoteEvent") and originalFireServer then
        return originalFireServer(remote, unpack(args))
    elseif remote:IsA("RemoteFunction") and originalInvokeServer then
        return originalInvokeServer(remote, unpack(args))
    end
end

-- ==============================================
-- ПЕРЕХВАТ REMOTE
-- ==============================================

local function HookRemote()
    local remote = FindShootRemote()
    if not remote then 
        print("⚠️ Remote для выстрела не найден, пробуем другие методы...")
        return false 
    end
    
    print("✅ Найден Remote: " .. remote.Name)
    
    if remote:IsA("RemoteEvent") then
        originalFireServer = remote.FireServer
        remote.FireServer = function(self, ...)
            return ProcessSilentShot(self, ...)
        end
    elseif remote:IsA("RemoteFunction") then
        originalInvokeServer = remote.InvokeServer
        remote.InvokeServer = function(self, ...)
            return ProcessSilentShot(self, ...)
        end
    end
    
    return true
end

-- ==============================================
-- МЕТОД ЧЕРЕЗ MOUSE
-- ==============================================

local function HookMouse()
    local mouse = LocalPlayer:GetMouse()
    if not mouse then return end
    
    -- Сохраняем оригинальные методы
    local originalButton1Down = mouse.Button1Down
    local originalButton1Up = mouse.Button1Up
    
    mouse.Button1Down = function(...)
        if Config.Enabled then
            local murderer = FindMurderer()
            if murderer then
                -- Пытаемся найти и использовать Remote
                local remote = FindShootRemote()
                if remote then
                    if remote:IsA("RemoteEvent") then
                        pcall(function()
                            remote:FireServer(CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, GetTargetPosition(murderer)))
                        end)
                    end
                end
                return
            end
        end
        if originalButton1Down then
            return originalButton1Down(...)
        end
    end
    
    return true
end

-- ==============================================
-- ЗАПУСК
-- ==============================================

-- Пробуем перехватить Remote
local hooked = HookRemote()

-- Если Remote не найден, используем Mouse метод
if not hooked then
    task.wait(1)
    HookMouse()
end

-- Перехват при появлении персонажа
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    HookRemote()
end)

