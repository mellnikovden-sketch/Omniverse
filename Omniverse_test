-- НАСТРОЙКИ
-- ==============================================
local Config = {
    Enabled = false,
    TargetPart = "HumanoidRootPart",
    Prediction = 0.2,
}

-- ==============================================
-- ПОИСК УБИЙЦЫ
-- ==============================================

local function IsMurderer(player)
    if not player or not player.Character then return false end
    
    local character = player.Character
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    local murdererWeapons = {
        "knife", "blade", "dagger", "saw", "slasher", "axe", "scythe",
        "peppermint", "cookie", "edge", "batwing", "icewing", "bone",
        "hallow", "vampire", "cutter", "candy"
    }
    
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            for _, wName in ipairs(murdererWeapons) do
                if name:find(wName) or wName:find(name) then
                    return true
                end
            end
        end
    end
    
    if player:GetAttribute("Murderer") == true then
        return true
    end
    
    return false
end

local function FindMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsMurderer(player) then
            return player
        end
    end
    return nil
end

-- ==============================================
-- ПОЛУЧЕНИЕ ПОЗИЦИИ ЦЕЛИ
-- ==============================================

local function GetTargetPosition(murderer)
    if not murderer or not murderer.Character then return nil end
    
    local targetPart = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then 
        targetPart = murderer.Character:FindFirstChild("Head")
    end
    if not targetPart then return nil end
    
    local vel = targetPart.AssemblyLinearVelocity or Vector3.new()
    local predPos = targetPart.Position + (vel * Config.Prediction)
    
    return predPos
end

