    local function section(name)
        local box = Instance.new('Frame')
        box.Size = UDim2.new(1, -4, 0, 0)
        box.AutomaticSize = Enum.AutomaticSize.Y
        box.BackgroundColor3 = Color3.fromRGB(32, 35, 45)
        box.BorderSizePixel = 0
        box.Parent = scroll
        Instance.new('UICorner', box).CornerRadius = UDim.new(0, 7)
        local pad = Instance.new('UIPadding', box)
        pad.PaddingTop = UDim.new(0, 6); pad.PaddingBottom = UDim.new(0, 6)
        pad.PaddingLeft = UDim.new(0, 6); pad.PaddingRight = UDim.new(0, 6)
        local list = Instance.new('UIListLayout', box)
        list.Padding = UDim.new(0, 4)
        label(box, name, 25, Color3.fromRGB(120, 195, 255)).Font = Enum.Font.GothamBold
        local api = {}
        function api:AddLabel(text) label(box, text, 25) end
        function api:AddParagraph(head, text) label(box, head .. ': ' .. text, 54) end
        function api:AddButton(text, callback)
            button(box, text).MouseButton1Click:Connect(callback)
        end
        function api:AddToggle(text, callback)
            local state = false
            local item = button(box, 'OFF  |  ' .. text)
            item.MouseButton1Click:Connect(function()
                state = not state
                item.Text = (state and 'ON   |  ' or 'OFF  |  ') .. text
                item.BackgroundColor3 = state and Color3.fromRGB(35, 105, 85) or Color3.fromRGB(45, 48, 60)
                callback(state)
            end)
        end
        function api:AddDropdown(text, values, callback)
            local index = 1
            local item = button(box, text .. ': ' .. tostring(values[index] or ''))
            item.MouseButton1Click:Connect(function()
                index = index % math.max(#values, 1) + 1
                item.Text = text .. ': ' .. tostring(values[index] or '')
                callback(values[index])
            end)
        end
        function api:AddSlider(text, minimum, maximum, value, callback)
            local current = value or minimum
            local item = button(box, string.format('%s: %s  [- / +]', text, tostring(current)))
            item.MouseButton1Click:Connect(function()
                current = current >= maximum and minimum or current + 1
                item.Text = string.format('%s: %s  [- / +]', text, tostring(current))
                callback(current)
            end)
        end
        function api:AddColorpicker(text, color, callback)
            local current = color
            local item = button(box, text .. ': ' .. formatColor(current))
            item.MouseButton1Click:Connect(function()
                current = Color3.fromHSV((tick() * 0.15) % 1, 0.85, 1)
                item.Text = text .. ': ' .. formatColor(current)
                callback(current)
            end)
        end
        return api
    end

    shared = { AddSection = section }
    function shared.Notify(text, duration)
        pcall(function()
            game:GetService('StarterGui'):SetCore('SendNotification', {
                Title = 'PrismFlux', Text = tostring(text), Duration = duration or 2
            })
        end)
    end
end


local function notify(text, duration)
    pcall(function()
        shared.Notify(tostring(text), duration or 2)
    end)
end

local function parseRGB(text, fallback)
    local r, g, b = tostring(text or ''):match('^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$')
    r, g, b = tonumber(r), tonumber(g), tonumber(b)
    if r and g and b and r <= 255 and g <= 255 and b <= 255 then
        return Color3.fromRGB(r, g, b)
    end
    return fallback
end

