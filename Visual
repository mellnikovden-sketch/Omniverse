local function clearAura() if auraConn then auraConn:Disconnect() auraConn = nil end if auraFolder then auraFolder:Destroy() auraFolder = nil end auraParts = {} end
local function buildAura()
	clearAura()
	if not vis.Extra.Aura.Enabled or not character then return end
	auraFolder = Instance.new("Folder") auraFolder.Name = "CH_Aura" auraFolder.Parent = ensureFolder()
	local cfg = vis.Extra.Aura
	for i = 1, quantity(cfg.Count, 3) do
		local sz = 0.2 + (i % 3) * 0.08
		local pType = "Ball"
		if cfg.Shape == "Cubes" then pType = "Part" elseif cfg.Shape == "Orbiting Swords" then pType = "Wedge" end
		local orb = createShape(pType, Vector3.new(sz, sz, cfg.Shape == "Orbiting Swords" and sz*3 or sz), cfg.Color, 0.1) orb.Parent = auraFolder
		table.insert(auraParts, { part = orb, angle = (i / cfg.Count) * math.pi * 2, bob = math.random() * math.pi * 2, radius = cfg.Radius * (0.85 + (i % 3) * 0.12), height = cfg.Height, dir = (i % 2 == 0) and 1 or -1, sizeVar = sz })
	end
	if cfg.Shape == "Galactic" then
		for i=1, quantity(15, 8) do
			local s = createShape("Ball", Vector3.new(0.08,0.08,0.08), lighten(cfg.Color, 0.4), 0) s.Parent = auraFolder
			table.insert(auraParts, { part = s, angle = math.random()*10, bob = math.random()*10, radius = math.random()*cfg.Radius, height = math.random()*cfg.Height, dir = 1, sizeVar = 0.08, IsStar = true })
		end
	end
end
local function ensureAuraLoop()
	if auraConn then return end
	auraConn = RunService.Heartbeat:Connect(function(dt)
		if not vis.Extra.Aura.Enabled or not character then return end
		local root = character:FindFirstChild("HumanoidRootPart") or torso
		if not root then return end
		local t, base, cfg = os.clock(), root.Position, vis.Extra.Aura
		for _, item in ipairs(auraParts) do
			if item.part and item.part.Parent then
				local a = item.angle + t * cfg.Speed * item.dir
				local h = item.height + math.sin(t * 2 + item.bob) * 0.5
				if item.IsStar then h = item.height + math.sin(t*3+item.bob)*2 end
				item.part.CFrame = CFrame.new(base + Vector3.new(math.cos(a) * item.radius, h, math.sin(a) * item.radius)) * (cfg.Shape == "Cubes" and CFrame.Angles(t, t, 0) or cfg.Shape == "Orbiting Swords" and CFrame.Angles(math.rad(-90), 0, 0) or CFrame.new())
				item.part.Size = Vector3.new(item.sizeVar, item.sizeVar, cfg.Shape == "Orbiting Swords" and item.sizeVar*3 or item.sizeVar) * (1 + math.sin(t * 4 + item.bob) * 0.15)
			end
		end
	end)
end

local function spawnFootprint(pos, normal, color, size, duration)
	local fp = createShape("Cylinder", Vector3.new(0.04, size, size * 0.7), color, 0.1)
	fp.CFrame, fp.Parent = CFrame.lookAt(pos, pos + normal) * CFrame.Angles(math.rad(90), math.random()*math.pi*2, 0), ensureFolder()
	TweenService:Create(fp, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.01, size * 0.2, size * 0.2), Transparency = 1 }):Play()
	Debris:AddItem(fp, duration + 0.1)

	if vis.Extra.Footprints.Sparks and not IS_PHONE then
		local spark = createShape("Ball", Vector3.new(0.08, 0.08, 0.08), fp.Color, 0.1)
		spark.CFrame, spark.Parent = CFrame.new(pos + normal * 0.2), ensureFolder()
		TweenService:Create(spark, TweenInfo.new(duration * 0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(pos + normal * 1.6 + Vector3.new((math.random()-0.5)*1.2, 0, (math.random()-0.5)*1.2)), Transparency = 1 }):Play()
		Debris:AddItem(spark, duration * 0.7 + 0.1)
	end
end

local function ensureFootprintLoop()
	if footprintConn then return end
	local rayParams = RaycastParams.new() rayParams.FilterType = Enum.RaycastFilterType.Exclude rayParams.IgnoreWater = true
	footprintConn = RunService.Heartbeat:Connect(function(dt)
		if not vis.Extra.Footprints.Enabled or not character or not humanoid then return end
		local root = character:FindFirstChild("HumanoidRootPart") if not root or humanoid.MoveDirection.Magnitude <= 0.05 then return end
		footprintTimer = footprintTimer + dt
		if footprintTimer >= vis.Extra.Footprints.Interval then
			footprintTimer = 0 footprintStepCount = footprintStepCount + 1
			rayParams.FilterDescendantsInstances = { character, ensureFolder() }
			local ray = workspace:Raycast(root.Position + root.CFrame.RightVector * (footprintStepCount % 2 == 0 and 0.5 or -0.5), Vector3.new(0, -6, 0), rayParams)
			if ray and (not lastFootPos or (ray.Position - lastFootPos).Magnitude > 0.5) then
				spawnFootprint(ray.Position + ray.Normal * 0.02, ray.Normal, vis.Extra.Footprints.Color, vis.Extra.Footprints.Size, vis.Extra.Footprints.Duration)
				lastFootPos = ray.Position
			end
		end
	end)
end

local function buildGlow()
	if not torso then return end
	if glowLight then glowLight:Destroy() end
	glowLight = Instance.new("PointLight") glowLight.Name, glowLight.Color, glowLight.Range, glowLight.Brightness, glowLight.Shadows, glowLight.Parent = "CH_Glow", vis.Extra.Glow.Color, vis.Extra.Glow.Range, vis.Extra.Glow.Brightness, false, torso
end
local function ensureGlowLoop()
	if glowConn then return end
	glowConn = RunService.Heartbeat:Connect(function()
		if not vis.Extra.Glow.Enabled or not glowLight then return end
		if vis.Extra.Glow.Pulse then glowLight.Brightness = vis.Extra.Glow.Brightness * (0.7 + math.sin(os.clock() * 2.2) * 0.3) end
	end)
end

-- ====================================================================== --
--                      ГЛАВНЫЙ ЦИКЛ АНИМАЦИИ (WINGS, HALO, HAT)        --
-- ====================================================================== --
local function ensureLoop()
	if animConnection then return end
	animConnection = RunService.Heartbeat:Connect(function(dt)
		animClock = animClock + dt
		if vis.Extra.IdleSpin.Enabled then idleSpinAngle = idleSpinAngle + dt * vis.Extra.IdleSpin.Speed end
		local idleWobble = vis.Extra.IdleSpin.Enabled and math.sin(animClock * 1.8) * math.rad(12) or 0
		local breath = vis.Wings.Breathing and math.sin(animClock * 1.5) * 0.08 or 0
		haloBobOffset = vis.Halo.Bobbing and math.sin(animClock * 2) * 0.15 or 0

		flapAccum = flapAccum + dt
		if #wingParts > 0 and flapAccum >= (1/30) then
			flapAccum = 0
			if vis.Wings.Flap then
				flapReset = false
				for _, i in ipairs(wingParts) do if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * CFrame.Angles(0, breath, math.sin(animClock * 2.6 + i.Phase) * (i.Amp or 0.13)) * i.Offset end end
			elseif not flapReset then
				flapReset = true
				for _, i in ipairs(wingParts) do if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * CFrame.Angles(0, breath, 0) * i.Offset end end
			else
				for _, i in ipairs(wingParts) do if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * CFrame.Angles(0, breath, 0) * i.Offset end end
			end
		end

		for _, i in ipairs(haloParts) do
			if i.Weld and i.Weld.Parent then
				local angle = i.Angle + animClock * vis.Halo.Speed * i.Direction + idleSpinAngle
				i.Weld.C0 = CFrame.new(i.OffsetX or 0, i.Height + haloBobOffset + (i.Bob and math.sin(animClock * 2 + i.Bob) * 0.08 or 0), 0) * CFrame.Angles(i.Tilt + idleWobble, angle, 0) * CFrame.new(0, 0, -i.Radius) * CFrame.Angles(0, math.rad(90), 0)
			end
		end

		for _, i in ipairs(hatParts) do
			if i.Weld and i.Weld.Parent then
				local spin = animClock * vis.ChinaHat.Spin + idleSpinAngle
				if i.Kind == "disc" then i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(idleWobble, spin, 0) * CFrame.Angles(0, 0, math.rad(90))
				elseif i.Kind == "spike" then i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(0, i.Angle + spin, 0) * CFrame.new(0, 0, -i.Radius)
				elseif i.Kind == "visor" then i.Weld.C0 = CFrame.new(0, i.Height, -0.6 * vis.ChinaHat.Size) * CFrame.Angles(idleWobble, idleSpinAngle, 0)
				elseif i.Kind == "shard" then i.Weld.C0 = CFrame.new(0, i.Height + math.sin(animClock*3+i.Angle)*0.3, 0) * CFrame.Angles(idleWobble, i.Angle + (animClock * 2) + idleSpinAngle, 0) * CFrame.new(0, 0, -i.Radius)
				elseif i.Kind == "fixed" then i.Weld.C0 = i.Weld.C0 -- No spin for ears/horns
				else i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(i.Tilt, i.Angle + spin, 0) * CFrame.new(0, 0, -i.Radius) * CFrame.Angles(0, math.rad(90), 0) end
			end
		end
	end)
end

