local function buildHalo()
	clearHalo()
	if not vis.Halo.Enabled or not headPart then return end
	haloFolder = Instance.new("Folder") haloFolder.Name = "CrystalHub_Halo" haloFolder.Parent = character
	local color, style = vis.Halo.Color, vis.Halo.Style

	local function smoothRing(r, h, segs, tlt, dir, th)
		local segL = (2 * math.pi * r / segs) * 1.12
		for i = 1, segs do
			local a = (i / segs) * math.pi * 2
			local p = newNeonPart(Vector3.new(th, th, segL), color) p.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p, CFrame.new(0, h, 0) * CFrame.Angles(tlt or 0, a, 0) * CFrame.new(0, 0, -r) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = r, Height = h, Tilt = tlt or 0, Direction = dir or 1 })
		end
	end

	local function orbitOrbs(count, radius, height, orbSize)
		for i = 1, count do
			local a = (i / count) * math.pi * 2
			local orb = newNeonPart(Vector3.new(orbSize, orbSize, orbSize), color, "Part") orb.Shape, orb.Parent = Enum.PartType.Ball, haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, orb, CFrame.new(0, height, 0)), Angle = a, Radius = radius, Height = height, Tilt = 0, Direction = 1, Bob = i * 0.5 })
		end
	end

	if style == "Double" then
		smoothRing(0.9, 1.55, 24, 0, 1, 0.08) smoothRing(1.15, 1.5, 20, 0, -1, 0.05) orbitOrbs(6, 0.95, 1.6, 0.14)
	elseif style == "Orbs" then
		smoothRing(0.95, 1.6, 20, 0, 1, 0.06) orbitOrbs(8, 1.05, 1.6, 0.22)
	elseif style == "Tilted" then
		smoothRing(0.95, 1.6, 24, math.rad(25), 1, 0.08) smoothRing(0.75, 1.8, 18, math.rad(-35), -1, 0.06)
	elseif style == "Star" or style == "Crown" or style == "Lotus" then
		smoothRing(0.85, 1.5, 24, 0, 1, 0.08) orbitOrbs(6, 0.95, 1.7, 0.2)
	elseif style == "Prism" then
		smoothRing(0.9, 1.6, 20, 0, 1, 0.07) smoothRing(0.9, 1.6, 20, math.rad(22), 1, 0.07) smoothRing(0.9, 1.6, 20, math.rad(-22), -1, 0.07)
	elseif style == "Infinity" then
		smoothRing(0.6, 1.6, 20, 0, 1, 0.07)
		for i = 1, 20 do
			local a = (i / 20) * math.pi * 2
			local p = newNeonPart(Vector3.new(0.07, 0.07, (2 * math.pi * 0.6 / 20) * 1.12), color) p.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p, CFrame.new(0.95, 1.6, 0) * CFrame.Angles(0, a, math.rad(90)) * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = 0.6, Height = 1.6, Tilt = 0, Direction = 1, OffsetX = 0.95 })
			local p2 = newNeonPart(Vector3.new(0.07, 0.07, (2 * math.pi * 0.6 / 20) * 1.12), color) p2.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p2, CFrame.new(-0.95, 1.6, 0) * CFrame.Angles(0, a, math.rad(90)) * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = 0.6, Height = 1.6, Tilt = 0, Direction = -1, OffsetX = -0.95 })
		end
	else
		-- Ring
		smoothRing(0.9, 1.6, 26, 0, 1, 0.07) orbitOrbs(6, 1.15, 1.6, 0.12)
	end

	if vis.Halo.Glow then
		local pl = Instance.new("PointLight") pl.Color, pl.Brightness, pl.Range, pl.Shadows, pl.Name, pl.Parent = color, 1.6, 9, false, "CrystalHub_HaloGlow", headPart
	end
