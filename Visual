-- Применяет пресет к выбранной цели (Jump/Wings/Halo/Hat/Trails/KillFX)
local function applyPresetToTarget(target, preset)
	local colors = preset.colors
	local color  = colors[2] or colors[1]  -- основной цвет (самый яркий)
	local color2 = colors[4] or colors[3] or color -- дополнительный
	if target == "Jump" then
		vis.Jump.Color = color
		vis.Jump.PresetColors = colors
	elseif target == "Wings" then
		vis.Wings.Color = color
		vis.Wings.PresetColors = colors
		if vis.Wings.Enabled then Visuals.RebuildWings() end
	elseif target == "Halo" then
