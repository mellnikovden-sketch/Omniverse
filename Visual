		elseif style == "Void" then
			-- Void: тёмные крылья пустоты — длинные загнутые «щупальца» + тёмные трейлы + перепонки-тени + ядро
			local tendrils = quantity(8, 6)
			for index = 1, tendrils do
				local ratio = (index - 1) / (tendrils - 1)
				local len = (5.6 - ratio * 2.6) * scale
