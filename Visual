end

local function addTrail(part, color, lifetime, width)
	local front = Instance.new("Attachment")
	front.Position = Vector3.new(0, part.Size.Y * 0.5, -part.Size.Z * 0.5)
	front.Parent   = part

	local back = Instance.new("Attachment")
	back.Position = Vector3.new(0, part.Size.Y * 0.5, part.Size.Z * 0.5)
	back.Parent   = part

	local trail = Instance.new("Trail")
	trail.Attachment0    = front
	trail.Attachment1    = back
	trail.Color          = ColorSequence.new(color)
	trail.Transparency   = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	trail.Lifetime       = lifetime or 0.35
	trail.WidthScale     = NumberSequence.new({ NumberSequenceKeypoint.new(0, width or 1), NumberSequenceKeypoint.new(1, 0) })
	trail.LightEmission  = 1
	trail.LightInfluence = 0
	trail.FaceCamera     = true
	trail.Parent         = part
	return trail
end

local function addFeather(side, opts)
	local feather = newNeonPart(Vector3.new(opts.Thickness, opts.Length, opts.Width), opts.Color)
	feather.Transparency = opts.Transparency or 0.1
	feather.Parent       = wingsFolder

	local spread = opts.Spread + math.rad(vis.Wings.Droop or 0)
	local origin = CFrame.new(side * opts.OriginX, opts.OriginY, opts.OriginZ)
		* CFrame.Angles(opts.Pitch or 0, side * opts.Sweep, -side * spread)
	local offset = CFrame.new(0, opts.Length * 0.5, 0)

	table.insert(wingParts, {
		Weld   = weldTo(torso, feather, origin * offset),
		Origin = origin,
		Offset = offset,
		Phase  = opts.Phase or 0,
		Amp    = opts.Amp or 0.12,
	})

	if opts.Tip then
		local tipLength = opts.Length * 0.32
		local tip = newNeonPart(Vector3.new(opts.Thickness, opts.Width * 0.95, tipLength), opts.TipColor or opts.Color, "WedgePart")
		tip.Transparency = math.clamp((opts.Transparency or 0.1) + 0.12, 0, 0.95)
		tip.Parent       = wingsFolder
		local tipOffset = CFrame.new(0, opts.Length + tipLength * 0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
		table.insert(wingParts, {
			Weld   = weldTo(torso, tip, origin * tipOffset),
			Origin = origin,
			Offset = tipOffset,
			Phase  = opts.Phase or 0,
			Amp    = opts.Amp or 0.12,
		})
	end
	return feather
end

local function buildWings()
	clearWings()
	if not vis.Wings.Enabled or not torso then return end

	wingsFolder = Instance.new("Folder")
	wingsFolder.Name   = "CrystalHub_Wings"
	wingsFolder.Parent = character

	local scale = vis.Wings.Scale
	local base  = vis.Wings.Color
	local light = lighten(base, 0.4)
	local dark  = darken(base, 0.3)
	local style = vis.Wings.Style
	local pc    = vis.Wings.PresetColors
	local function colAt(ratio) return presetColorAt(pc, base, ratio) end

	local function addOrb(side, angle, dist, height, sz, col, transp)
		local orb = newNeonPart(Vector3.new(sz, sz, sz), col, "Part")
		orb.Shape = Enum.PartType.Ball
		orb.Transparency = transp or 0.08
		orb.Parent = wingsFolder
		local cf = CFrame.new(0, height * scale, 0) * CFrame.Angles(0, side * angle, 0) * CFrame.new(0, 0, -dist * scale)
		weldTo(torso, orb, cf)
		return orb
	end

	for _, side in ipairs({ -1, 1 }) do
		if style == "Demon" then
			local bones = quantity(7, 5)
			for index = 1, bones do
				local ratio  = (index - 1) / (bones - 1)
				local length = (5.0 - ratio * 1.8) * scale
				local spread = math.rad(52 + ratio * 68)
				addFeather(side, {
					Length = length, Width = 0.2 * scale, Thickness = 0.18 * scale,
					Spread = spread, Sweep = math.rad(32), Pitch = math.rad(-12 - ratio * 10),
					OriginX = 0.55 * scale, OriginY = 0.12 * scale, OriginZ = 0.72 * scale,
					Color = colAt(ratio * 0.4), Transparency = 0.03,
					Phase = index * 0.28, Amp = 0.1 + ratio * 0.12, Tip = true, TipColor = dark,
				})
			end
			addOrb(side, math.rad(70), 0.6, 0.15, 0.18 * scale, colAt(0.9), 0.05)

		elseif style == "Simple" then
			local count = quantity(5, 4)
			for index = 1, count do
				local ratio  = (index - 1) / (count - 1)
				local length = (3.4 - ratio * 1.1) * scale
				local feather = addFeather(side, {
					Length = length, Width = (0.72 - ratio * 0.16) * scale, Thickness = 0.1 * scale,
					Spread = math.rad(60 + ratio * 50), Sweep = math.rad(22), Pitch = math.rad(-10),
					OriginX = 0.44 * scale, OriginY = 0.25 * scale, OriginZ = 0.62 * scale,
					Color = colAt(ratio), Transparency = 0.12,
					Phase = index * 0.32, Amp = 0.12 + ratio * 0.08, Tip = true, TipColor = colAt(0.92),
				})
				if index <= 3 then addTrail(feather, colAt(0.85), 0.35, 1.0) end
			end

		elseif style == "Phantom" then
			for index = 1, quantity(7, 5) do
				local ratio  = (index - 1) / 6
				local blade = addFeather(side, {
					Length = (5.4 - ratio * 2.6) * scale, Width = (0.38 - ratio * 0.1) * scale, Thickness = 0.06 * scale,
					Spread = math.rad(50 + ratio * 76), Sweep = math.rad(28), Pitch = math.rad(-14 - ratio * 12),
					OriginX = 0.38 * scale, OriginY = 0.3 * scale, OriginZ = 0.6 * scale,
					Color = colAt(ratio), Transparency = 0.45 + ratio * 0.2,
					Phase = index * 0.4, Amp = 0.18 + ratio * 0.14, Tip = true, TipColor = colAt(0.97),
				})
				if index <= 4 then addTrail(blade, colAt(ratio * 0.5 + 0.2), 0.55, 1.4) end
			end

		elseif style == "Crystal" then
			for index = 1, 4 do
				local ratio  = (index - 1) / 3
				local shard = addFeather(side, {
					Length = (4.6 - ratio * 1.6) * scale, Width = (1.1 - ratio * 0.3) * scale, Thickness = 0.08 * scale,
					Spread = math.rad(58 + ratio * 44), Sweep = math.rad(26), Pitch = math.rad(-16),
					OriginX = 0.36 * scale, OriginY = 0.3 * scale, OriginZ = 0.64 * scale,
					Color = colAt(ratio * 0.7), Transparency = 0.3,
					Phase = index * 0.45, Amp = 0.1, Tip = true, TipColor = light,
				})
				if index <= 3 then addTrail(shard, colAt(0.9), 0.5, 1.8) end
			end

		elseif style == "Butterfly" then
			for index = 1, quantity(6, 4) do
				local ratio = (index - 1) / 5
				local wing = addFeather(side, {
					Length = (3.0 - ratio * 0.6) * scale, Width = (0.8 - ratio * 0.12) * scale, Thickness = 0.08 * scale,
					Spread = math.rad(72 + ratio * 34), Sweep = math.rad(38), Pitch = math.rad(-22),
					OriginX = 0.3 * scale, OriginY = 0.35 * scale, OriginZ = 0.5 * scale,
					Color = colAt(ratio), Transparency = 0.1,
					Phase = index * 0.38, Amp = 0.2, Tip = true, TipColor = colAt(0.85),
				})
				if index <= 3 then addTrail(wing, colAt(0.8), 0.4, 1.0) end
			end

		elseif style == "Seraph" or style == "Sacred" then
			local rows = {
				{ Count = 9, Long = 5.0, Short = 2.8, From = 48, To = 132, Width = 0.48, Thick = 0.1, Z = 0.72, Y = 0.34, X = 0.44, Pitch = -16 },
				{ Count = 7, Long = 3.6, Short = 2.2, From = 54, To = 126, Width = 0.42, Thick = 0.09, Z = 0.6, Y = 0.28, X = 0.4, Pitch = -12 },
				{ Count = 5, Long = 2.5, Short = 1.6, From = 60, To = 120, Width = 0.36, Thick = 0.08, Z = 0.5, Y = 0.23, X = 0.36, Pitch = -9 },
			}
			for rowIndex, row in ipairs(rows) do
				local count = quantity(row.Count, 3)
				for index = 1, count do
					local ratio = count > 1 and (index - 1) / (count - 1) or 0
					local feather = addFeather(side, {
						Length = (row.Long - ratio * (row.Long - row.Short)) * scale,
						Width = row.Width * scale, Thickness = row.Thick * scale,
						Spread = math.rad(row.From + ratio * (row.To - row.From)),
						Sweep = math.rad(24 - rowIndex * 3), Pitch = math.rad(row.Pitch),
						OriginX = row.X * scale, OriginY = row.Y * scale, OriginZ = row.Z * scale,
						Color = colAt(ratio * 0.9), Transparency = 0.05,
						Phase = index * 0.26 + rowIndex * 0.5, Amp = 0.18, Tip = true, TipColor = light,
					})
					if rowIndex <= 2 and index <= 3 then addTrail(feather, light, 0.45, 1.2) end
				end
			end
		else
			-- Angel (Default)
			local count = quantity(8, 4)
			for index = 1, count do
				local ratio = (index - 1) / (count - 1)
				local feather = addFeather(side, {
					Length = (4.0 - ratio * 1.5) * scale,
					Width = 0.4 * scale, Thickness = 0.08 * scale,
					Spread = math.rad(55 + ratio * 65), Sweep = math.rad(24), Pitch = math.rad(-12),
					OriginX = 0.4 * scale, OriginY = 0.3 * scale, OriginZ = 0.65 * scale,
					Color = colAt(ratio), Transparency = 0.1,
					Phase = index * 0.3, Amp = 0.15, Tip = true, TipColor = light
				})
				if index <= 3 then addTrail(feather, light, 0.4, 1.1) end
			end
		end
	end

	if vis.Wings.Glow then
		local pointLight = Instance.new("PointLight")
		pointLight.Color      = base
		pointLight.Brightness = 2.4
		pointLight.Range      = 14
		pointLight.Shadows    = false
		pointLight.Name       = "CrystalHub_WingGlow"
		pointLight.Parent     = torso
	end
end

