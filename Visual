        knob.BorderSizePixel = 0
        knob.ZIndex = 107
        knob.Parent = toggle
        corner(knob, UDim.new(1, 0))

        -- Subtle shadow under knob
        local knobShadow = Instance.new("UIStroke")
        knobShadow.Color = Color3.fromRGB(0, 0, 0)
        knobShadow.Thickness = 1
        knobShadow.Transparency = 0.5
        knobShadow.Parent = knob

        local state = default

        local function setState(newState, animate)
            state = newState
            if animate then
                tween(toggle, { BackgroundColor3 = state and THEME.ToggleOn or THEME.ToggleOff }, 0.2)
                tween(knob, { Position = UDim2.new(0, state and 21 or 3, 0.5, -8) }, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
