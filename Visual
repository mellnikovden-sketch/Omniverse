local function buildHalo()
	clearHalo()
	if not vis.Halo.Enabled or not headPart then return end

	haloFolder = Instance.new("Folder")
	haloFolder.Name   = "CrystalHub_Halo"
	haloFolder.Parent = character

	local color = vis.Halo.Color
	local pc    = vis.Halo.PresetColors
	local function colAt(ratio) return presetColorAt(pc, color, ratio) end

	local segments = quantity(20, 12)
	local radius = 0.9
	local segmentLength = (2 * math.pi * radius / segments) * 1.12
	for index = 1, segments do
		local angle = (index / segments) * math.pi * 2
		local t = (index - 1) / segments
		local piece = newNeonPart(Vector3.new(0.07, 0.07, segmentLength), colAt(t))
		piece.Parent = haloFolder
		local weld = weldTo(headPart, piece, CFrame.new(0, 1.6, 0)
			* CFrame.Angles(0, angle, 0)
			* CFrame.new(0, 0, -radius)
			* CFrame.Angles(0, math.rad(90), 0))
		table.insert(haloParts, { Weld = weld, Angle = angle, Radius = radius, Height = 1.6, Tilt = 0, Direction = 1 })
	end

	if vis.Halo.Glow then
		local pl = Instance.new("PointLight")
		pl.Color = color
		pl.Brightness = 1.6
		pl.Range = 9
