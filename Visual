local function spawnArcRing(origin, opts)
	local segs, sweep, rad0, rad1, th, dur, rise, color = quantity(opts.Segments or 24, 8), opts.Sweep or (math.pi*2), opts.Radius0 or 1.2, opts.Radius1 or 8, opts.Thickness or 0.2, opts.Duration or 0.7, opts.Rise or 0, opts.Color or Color3.new(1,1,1)
	local tipCol, chord0, chord1 = lighten(color, 0.4), (sweep * rad0 / segs) * 1.1, (sweep * rad1 / segs) * 1.1
	local info, base, folder = TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), CFrame.new(origin) * CFrame.Angles(opts.Tilt or 0, 0, 0), ensureFolder()

	for i = 1, segs do
		local r = (i - 1) / segs
		local angle = (opts.Start or 0) + r * sweep
		local p = createPart("Part", Vector3.new(th, th, chord0), color:Lerp(tipCol, r), math.clamp((opts.Fade or 0) * r, 0, 0.9))
		p.CFrame, p.Anchored, p.Parent = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -rad0) * CFrame.Angles(0, math.rad(90), 0), true, folder
		TweenService:Create(p, info, { CFrame = base * CFrame.Angles(0, angle + (opts.Spin or 0), 0) * CFrame.new(0, rise, -rad1) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(th * 0.3, th * 0.3, chord1), Transparency = 1 }):Play()
		Debris:AddItem(p, dur + 0.1)
	end
end

local function spawnSparks(origin, color, dur, count, rad)
	if not vis.Jump.Sparks then return end
	local total = quantity(count, 4)
	for i = 1, total do
		local angle = (i / total) * math.pi * 2 + math.random() * 0.4
		local sp = createPart("Ball", Vector3.new(0.15, 0.15, 0.15), lighten(color, 0.3), 0.1)
		sp.CFrame, sp.Anchored, sp.Parent = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -0.6), true, ensureFolder()
		local far, high = (rad or 4) * (0.6 + math.random() * 0.7), 1.5 + math.random() * 2.5
		TweenService:Create(sp, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, high, -far), Size = Vector3.new(0.02, 0.02, 0.02), Transparency = 1 }):Play()
		Debris:AddItem(sp, dur + 0.1)
	end
end

