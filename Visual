-- ====================================================================== --
local function clearHalo()
	if haloFolder then haloFolder:Destroy() end haloFolder, haloParts = nil, {}
	if headPart then for _, child in ipairs(headPart:GetChildren()) do if child.Name == "CH_HaloGlow" then child:Destroy() end end end
end

local function buildHalo()
	clearHalo()
	if not vis.Halo.Enabled or not headPart then return end
	haloFolder = Instance.new("Folder") haloFolder.Name = "CrystalHub_Halo" haloFolder.Parent = character
	local color, style, speed = vis.Halo.Color, vis.Halo.Style, vis.Halo.Speed

	-- Создает сплошное 3D кольцо используя Torus Mesh
	local function addTorus(r, h, th, tlt, dir)
		local p = createPart("Part", Vector3.new(r*2, th, r*2), color, 0.1, Enum.MeshType.Torus) p.Parent = haloFolder
		table.insert(haloParts, { Weld = weldTo(headPart, p, CFrame.new(0, h, 0) * CFrame.Angles(tlt or 0, 0, 0)), Angle = 0, Radius = 0, Height = h, Tilt = tlt or 0, Direction = dir or 1, IsMesh = true })
	end

	-- Создает кольцо из отдельных сегментов
	local function addSegRing(r, h, segs, tlt, dir, th, pType)
		local segL = (2 * math.pi * r / segs) * 1.12
		for i = 1, segs do
			local a = (i / segs) * math.pi * 2
			local p = createPart(pType or "Part", Vector3.new(th, th, segL), color, 0.1) p.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p, CFrame.new(0, h, 0) * CFrame.Angles(tlt or 0, a, 0) * CFrame.new(0, 0, -r) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = r, Height = h, Tilt = tlt or 0, Direction = dir or 1 })
		end
	end

	local function addOrbs(count, radius, height, orbSize)
		for i = 1, count do
			local a = (i / count) * math.pi * 2
			local orb = createPart("Ball", Vector3.new(orbSize, orbSize, orbSize), lighten(color, 0.2), 0.05) orb.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, orb, CFrame.new(0, height, 0)), Angle = a, Radius = radius, Height = height, Tilt = 0, Direction = 1, Bob = i * 0.5 })
		end
	end

	if style == "Double" then
		addTorus(0.9, 1.55, 0.08, 0, 1) addTorus(1.15, 1.5, 0.05, 0, -1) addOrbs(6, 0.95, 1.6, 0.14)
	elseif style == "Star" or style == "Crown" then
		addTorus(0.85, 1.5, 0.08, 0, 1) addOrbs(5, 0.95, 1.7, 0.2)
	elseif style == "Tech-Ring" then -- НОВЫЙ СТИЛЬ: Механическое кольцо
		addSegRing(0.9, 1.6, 12, 0, 1, 0.12, "Part") addOrbs(8, 1.2, 1.6, 0.15)
	elseif style == "Rune-Circle" then -- НОВЫЙ СТИЛЬ: Двойные магические кольца с рунами
		addTorus(0.9, 1.6, 0.05, math.rad(15), 1) addTorus(0.9, 1.6, 0.05, math.rad(-15), 1)
		addSegRing(1.1, 1.6, 8, 0, -1, 0.08, "Part") -- Руны
	elseif style == "Infinity" then
		addTorus(0.6, 1.6, 0.07, 0, 1)
		local r = 0.6
		for i = 1, 20 do
			local a = (i / 20) * math.pi * 2
			local p1 = createPart("Part", Vector3.new(0.07, 0.07, (2*math.pi*r/20)*1.12), color, 0.1) p1.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p1, CFrame.new(0.95, 1.6, 0) * CFrame.Angles(0, a, math.rad(90)) * CFrame.new(0, 0, -r) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = r, Height = 1.6, Tilt = 0, Direction = 1, OffsetX = 0.95 })
			local p2 = createPart("Part", Vector3.new(0.07, 0.07, (2*math.pi*r/20)*1.12), color, 0.1) p2.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p2, CFrame.new(-0.95, 1.6, 0) * CFrame.Angles(0, a, math.rad(90)) * CFrame.new(0, 0, -r) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = r, Height = 1.6, Tilt = 0, Direction = -1, OffsetX = -0.95 })
		end
	else
		-- Ring (Default)
		addTorus(0.9, 1.6, 0.07, 0, 1) addOrbs(6, 1.15, 1.6, 0.12)
	end

	if vis.Halo.Glow then
		local pl = Instance.new("PointLight") pl.Color, pl.Brightness, pl.Range, pl.Shadows, pl.Name, pl.Parent = color, 1.6, 9, false, "CH_HaloGlow", headPart
	end
end

