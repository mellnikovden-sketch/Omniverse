		local t, base, cfg = os.clock(), root.Position, vis.Extra.Aura
		for _, item in ipairs(auraParts) do
			if item.part and item.part.Parent then
				local a = item.angle + t * cfg.Speed * item.dir
				local h = item.height + math.sin(t * 2 + item.bob) * 0.5
				item.part.CFrame = CFrame.new(base + Vector3.new(math.cos(a) * item.radius, h, math.sin(a) * item.radius)) * (cfg.Shape == "Cube" and CFrame.Angles(t, t, 0) or CFrame.new())
				item.part.Size = Vector3.new(item.sizeVar, item.sizeVar, item.sizeVar) * (1 + math.sin(t * 4 + item.bob) * 0.15)
			end
		end
	end)
