--  KILLFX – ПРОСЛУШКА СМЕРТЕЙ (теперь ловит и респавны существующих игроков)
-- ============================================================
local function hookCharacterDeath(player, char)
    task.spawn(function()
        task.wait(0.4)
        local h = char and char:FindFirstChildOfClass("Humanoid")
        if h then
            h.Died:Connect(function()
                if not vis.KillFX.Enabled then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    spawnKillEffect(root.Position)
                end
            end)
        end
    end)
end

local function hookPlayer(player)
    if player == LocalPlayer and not vis.KillFX.IncludeMe then return end
    if player.Character then
        hookCharacterDeath(player, player.Character)
    end
    table.insert(killWatchConns, player.CharacterAdded:Connect(function(char)
        hookCharacterDeath(player, char)
    end))
end

local function startKillWatch()
    if #killWatchConns > 0 then return end
    for _, player in ipairs(Players:GetPlayers()) do
        hookPlayer(player)
    end
    table.insert(killWatchConns, Players.PlayerAdded:Connect(hookPlayer))
end

local function stopKillWatch()
    for _, c in ipairs(killWatchConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(killWatchConns)
end

