local function deepMerge(target, source)
    for key, value in pairs(source) do
        if type(value) == "table" and type(target[key]) == "table" then
            deepMerge(target[key], value)
        else
            target[key] = value
        end
    end
end

local function isTouchOnly()
    local input = game:GetService("UserInputService")
    return input.TouchEnabled and not input.KeyboardEnabled
end

local function qualityMultiplier(quality)
    if quality == "Low" then
        return 0.45
    elseif quality == "Medium" then
        return 0.7
    elseif quality == "High" then
        return 1
    end
    return isTouchOnly() and 0.55 or 1
end

local function scaledCount(count, multiplier, minimum)
    return math.max(minimum or 1, math.floor(count * multiplier + 0.5))
end

local function lighten(color, amount)
    return Color3.new(
        math.min(color.R + amount, 1),
        math.min(color.G + amount, 1),
        math.min(color.B + amount, 1)
    )
end

local function darken(color, amount)
    return Color3.new(
        math.max(color.R - amount, 0),
        math.max(color.G - amount, 0),
        math.max(color.B - amount, 0)
    )
end

local function setPartProperties(part, properties)
    for property, value in pairs(properties) do
        part[property] = value
    end
end

local function safeDisconnect(connection)
    if connection then
        connection:Disconnect()
    end
end

-- ============================================================
-- CONTROLLER LIFECYCLE
-- ============================================================
function VisualEffects.new(player, customSettings)
    local self = setmetatable({}, VisualEffects)

    self.Player = player or LOCAL_PLAYER
    self.Settings = Settings
    if customSettings then
        deepMerge(self.Settings, customSettings)
    end

    self.Quality = qualityMultiplier(self.Settings.Quality)
    self.Character = nil
    self.Humanoid = nil
    self.Root = nil
    self.Torso = nil
    self.Head = nil
    self.Destroyed = false
    self.Time = 0
    self.Accumulator = 0
    self.LastJump = 0
    self.LastFootprint = 0
    self.Components = {}
    self.AnimationParts = { wings = {}, halo = {}, hat = {}, aura = {}, shield = {}, pet = {} }
    self.Connections = {}
    self.CharacterConnections = {}

    local oldFolder = Workspace:FindFirstChild("LocalVisualEffects_" .. self.Player.UserId)
    if oldFolder then
        oldFolder:Destroy()
    end

    self.EffectsFolder = Instance.new("Folder")
    self.EffectsFolder.Name = "LocalVisualEffects_" .. self.Player.UserId
    self.EffectsFolder.Parent = Workspace

    if self.Settings.AutoStartPreset ~= "Custom" and PRESETS[self.Settings.AutoStartPreset] then
        deepMerge(self.Settings, PRESETS[self.Settings.AutoStartPreset])
    end

    self:_connectPlayer()
    self:_connectUpdateLoop()

    if self.Player.Character then
        self:_bindCharacter(self.Player.Character)
    end

    return self
end

function VisualEffects:_newComponent(name)
    self:_clearComponent(name)
    local component = { instances = {}, connections = {} }
    self.Components[name] = component
    return component
end

function VisualEffects:_newTransientComponent()
    -- Transient effects are owned by Debris and the controller's root folder.
    -- Keeping them out of Components prevents the tracking tables from growing
    -- indefinitely during a long play session.
    return { instances = {}, connections = {} }
end

function VisualEffects:_track(component, instance)
    table.insert(component.instances, instance)
    return instance
end

function VisualEffects:_connect(component, signal, callback)
    local connection = signal:Connect(callback)
    table.insert(component.connections, connection)
    return connection
end

function VisualEffects:_clearComponent(name)
    local component = self.Components[name]
    if not component then
        return
    end

    for _, connection in ipairs(component.connections) do
        safeDisconnect(connection)
    end
    for _, instance in ipairs(component.instances) do
        if instance and instance.Parent then
            instance:Destroy()
        end
    end
    self.Components[name] = nil
end

function VisualEffects:_clearCharacterConnections()
    for _, connection in ipairs(self.CharacterConnections) do
        safeDisconnect(connection)
    end
    table.clear(self.CharacterConnections)
end

function VisualEffects:_createFolder(component, name, parent)
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent or self.EffectsFolder
    return self:_track(component, folder)
end

function VisualEffects:_newPart(component, properties)
    local part = Instance.new(properties.ClassName or "Part")
    part.Name = properties.Name or "VisualPart"
    part.Anchored = properties.Anchored == true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Massless = true
    part.Material = properties.Material or Enum.Material.Neon
    part.Color = properties.Color or Color3.new(1, 1, 1)
    part.Size = properties.Size or Vector3.new(0.2, 0.2, 0.2)
    part.Transparency = properties.Transparency or 0
    if part:IsA("Part") then
        part.Shape = properties.Shape or Enum.PartType.Block
    end
    part.Parent = properties.Parent or self.EffectsFolder
    return self:_track(component, part)
end

function VisualEffects:_attachPart(component, base, part, offset)
    -- A single Motor6D is used per part. The source script accidentally made
    -- two Weld objects for every halo/hat part, causing conflicts and leaks.
    part.CFrame = base.CFrame * offset
    local motor = Instance.new("Motor6D")
    motor.Name = "VisualMotor"
    motor.Part0 = base
    motor.Part1 = part
    motor.C0 = offset
    motor.Parent = part
    self:_track(component, motor)
    return motor
end

function VisualEffects:_newAttachment(component, parent, name, position)
    local attachment = Instance.new("Attachment")
    attachment.Name = name
    attachment.Position = position or Vector3.zero
    attachment.Parent = parent
    return self:_track(component, attachment)
end

function VisualEffects:_addPointLight(component, parent, color, brightness, range, name)
    local light = Instance.new("PointLight")
    light.Name = name or "VisualLight"
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Shadows = false
    light.Parent = parent
    return self:_track(component, light)
end

function VisualEffects:_connectPlayer()
    table.insert(self.Connections, self.Player.CharacterAdded:Connect(function(character)
        task.defer(function()
            if not self.Destroyed then
                self:_bindCharacter(character)
            end
        end)
    end))

    table.insert(self.Connections, self.Player.CharacterRemoving:Connect(function()
        self:_clearCharacterVisuals()
        self.Character = nil
        self.Humanoid = nil
        self.Root = nil
        self.Torso = nil
        self.Head = nil
    end))
end

function VisualEffects:_connectUpdateLoop()
    table.insert(self.Connections, RunService.Heartbeat:Connect(function(deltaTime)
        if self.Destroyed or not self.Character or not self.Root then
            return
        end

        self.Accumulator += deltaTime
        local interval = 1 / math.clamp(self.Settings.UpdateRate, 15, 60)
        if self.Accumulator < interval then
            return
        end

        local step = self.Accumulator
        self.Accumulator = 0
        self.Time += step
        self:_updateAnimatedParts()
        self:_updateAura()
        self:_updateShield()
        self:_updatePet()
        self:_updateAmbientGlow()
        self:_updateFootprints()
    end))
end

function VisualEffects:_bindCharacter(character)
    self:_clearCharacterVisuals()
    self:_clearCharacterConnections()

    self.Character = character
    self.Humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    self.Root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
    self.Torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or self.Root
    self.Head = character:FindFirstChild("Head") or self.Torso

    if not self.Humanoid or not self.Root or not self.Torso or not self.Head then
        warn("[VisualEffects] Character is missing required body parts.")
        return
    end

    table.insert(self.CharacterConnections, self.Humanoid.Jumping:Connect(function(active)
        if active then
            self:_playJumpEffect()
        end
    end))

    table.insert(self.CharacterConnections, self.Humanoid.Died:Connect(function()
        self:_playDeathEffect(self.Root and self.Root.Position)
    end))

    table.insert(self.CharacterConnections, character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            -- A tool may be equipped after the character is built; rebuilding
            -- trails is harmless and avoids holding stale instances.
            self:_buildTrails()
        end
    end))

    self:RebuildAll()
end

function VisualEffects:_clearCharacterVisuals()
    for _, name in ipairs({ "Wings", "Halo", "Hat", "Trails", "Glow", "Aura", "Shield", "Pet" }) do
        self:_clearComponent(name)
    end
    self.AnimationParts = { wings = {}, halo = {}, hat = {}, aura = {}, shield = {}, pet = {} }
end

function VisualEffects:RebuildAll()
    if not self.Character then
        return
    end
    self.Quality = qualityMultiplier(self.Settings.Quality)
    self:_buildWings()
    self:_buildHalo()
    self:_buildHat()
    self:_buildTrails()
    self:_buildGlow()
    self:_buildAura()
    self:_buildShield()
    self:_buildPet()
end

-- ============================================================
-- SHARED EFFECT HELPERS
-- ============================================================
function VisualEffects:_spawnBurst(position, color, size, duration, count)
    local component = self:_newTransientComponent()
    for _ = 1, scaledCount(count, self.Quality, 5) do
        local direction = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.1, math.random() - 0.5).Unit
        local distance = size * (0.35 + math.random() * 0.8)
        local start = position + Vector3.new(0, 0.15, 0)
        local part = self:_newPart(component, {
            Name = "BurstSpark",
            Anchored = true,
            Shape = Enum.PartType.Ball,
            Size = Vector3.new(0.18, 0.18, 0.18),
            Color = color:Lerp(Color3.new(1, 1, 1), math.random() * 0.35),
            Transparency = 0.08,
        })
        part.CFrame = CFrame.new(start)
        TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = CFrame.new(start + direction * distance),
            Size = Vector3.new(0.025, 0.025, 0.025),
            Transparency = 1,
        }):Play()
        Debris:AddItem(part, duration + 0.15)
    end
end

function VisualEffects:_spawnRing(position, color, radius, thickness, duration, rotation)
    local component = self:_newTransientComponent()
    local segments = scaledCount(math.clamp(radius * 5, 12, 36), self.Quality, 10)
    local segmentLength = (2 * math.pi * radius / segments) * 1.13

    for index = 1, segments do
        local angle = index / segments * math.pi * 2
        local initial = CFrame.new(position)
            * CFrame.Angles(0, angle, 0)
            * CFrame.new(0, 0, -radius)
            * CFrame.Angles(0, math.rad(90), 0)
        local part = self:_newPart(component, {
            Name = "RingSegment",
            Anchored = true,
            Size = Vector3.new(thickness, thickness, segmentLength),
            Color = color,
            Transparency = 0.12,
        })
        part.CFrame = initial
        TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = initial * CFrame.Angles(0, rotation or 0.8, 0) * CFrame.new(0, 0.15, -radius * 0.25),
            Size = Vector3.new(thickness * 0.25, thickness * 0.25, segmentLength * 1.5),
            Transparency = 1,
        }):Play()
        Debris:AddItem(part, duration + 0.15)
    end
end

function VisualEffects:_spawnVerticalFlash(position, color, size, duration)
    local component = self:_newTransientComponent()
    local flash = self:_newPart(component, {
        Name = "JumpFlash",
        Anchored = true,
        Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(0.06, size * 0.35, size * 0.35),
        Color = lighten(color, 0.35),
        Transparency = 0.2,
    })
    flash.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
    TweenService:Create(flash, TweenInfo.new(duration * 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(0.01, size * 1.1, size * 1.1),
        Transparency = 1,
    }):Play()
    Debris:AddItem(flash, duration + 0.1)
end

-- ============================================================
-- JUMP AND DEATH EFFECTS
-- ============================================================
function VisualEffects:_playJumpEffect()
    local config = self.Settings.Jump
    if not config.Enabled or not self.Root then
        return
    end

    local now = os.clock()
    if now - self.LastJump < 0.18 then
        return
    end
    self.LastJump = now

    local position = self.Root.Position - Vector3.new(0, 2.55, 0)
    local color = config.Color
    local size = math.clamp(config.Size, 2, 24)
    local duration = math.clamp(config.Duration, 0.15, 2.5)

    if config.Flash then
        self:_spawnVerticalFlash(position, color, size, duration)
    end

    if config.Style == "Spiral" then
        local component = self:_newTransientComponent()
        local segments = scaledCount(34, self.Quality, 12)
        for index = 1, segments do
            local fraction = index / segments
            local angle = fraction * math.pi * 6
            local radius = size * (0.12 + fraction * 0.35)
            local start = position + Vector3.new(math.cos(angle) * radius, fraction * 2.8, math.sin(angle) * radius)
            local spark = self:_newPart(component, {
                Name = "SpiralSpark", Anchored = true, Shape = Enum.PartType.Ball,
                Size = Vector3.new(0.11, 0.11, 0.11), Color = color:Lerp(lighten(color, 0.35), fraction), Transparency = 0.08,
            })
            spark.CFrame = CFrame.new(start)
            TweenService:Create(spark, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(start + Vector3.new(0, 0.7, 0)), Size = Vector3.new(0.02, 0.02, 0.02), Transparency = 1,
            }):Play()
            Debris:AddItem(spark, duration + 0.15)
        end
        self:_spawnRing(position, color, size * 0.3, 0.06, duration, 0.9)
    elseif config.Style == "Crystal" then
        local component = self:_newTransientComponent()
        for _ = 1, scaledCount(22, self.Quality, 8) do
            local angle = math.random() * math.pi * 2
            local distance = size * (0.25 + math.random() * 0.65)
            local shard = self:_newPart(component, {
                Name = "CrystalShard", Anchored = true, Size = Vector3.new(0.11, 0.5, 0.11),
                Color = color:Lerp(Color3.new(1, 1, 1), 0.25), Transparency = 0.05,
            })
            shard.CFrame = CFrame.new(position) * CFrame.Angles(math.random() * 5, angle, math.random() * 5)
            TweenService:Create(shard, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * distance, 1 + math.random() * 3, math.sin(angle) * distance))
                    * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
                Size = Vector3.new(0.02, 0.07, 0.02), Transparency = 1,
            }):Play()
            Debris:AddItem(shard, duration + 0.15)
        end
        self:_spawnRing(position, lighten(color, 0.25), size * 0.25, 0.06, duration, 0.7)
    elseif config.Style == "Starburst" or config.Style == "Lightning" then
        local component = self:_newTransientComponent()
        local count = config.Style == "Lightning" and 9 or 12
        for index = 1, scaledCount(count, self.Quality, 6) do
            local angle = index / count * math.pi * 2
            local beam = self:_newPart(component, {
                Name = "Starbeam", Anchored = true, Size = Vector3.new(0.07, 0.07, size * 0.35),
                Color = config.Style == "Lightning" and lighten(color, 0.35) or color,
                Transparency = 0.02,
            })
            beam.CFrame = CFrame.new(position) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.3, -size * 0.2)
            TweenService:Create(beam, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(position) * CFrame.Angles(0, angle + 0.65, 0) * CFrame.new(0, 1.1, -size * 0.95),
                Size = Vector3.new(0.015, 0.015, size * 0.95), Transparency = 1,
            }):Play()
            Debris:AddItem(beam, duration + 0.15)
        end
    elseif config.Style == "Wave" then
        for index = 1, 4 do
            self:_spawnRing(position, color:Lerp(lighten(color, 0.25), index / 4), size * (0.1 + index * 0.12), 0.045, duration * (0.8 + index * 0.1), index % 2 == 0 and -0.8 or 0.8)
        end
    elseif config.Style == "Feather" then
        local component = self:_newTransientComponent()
        for _ = 1, scaledCount(16, self.Quality, 6) do
            local angle = math.random() * math.pi * 2
            local start = position + Vector3.new(0, 0.4, 0)
            local feather = self:_newPart(component, {
                Name = "FallingFeather", Anchored = true, ClassName = "WedgePart", Size = Vector3.new(0.07, 0.32, 0.13),
                Color = color:Lerp(Color3.new(1, 1, 1), math.random() * 0.4), Transparency = 0.08,
            })
            feather.CFrame = CFrame.new(start) * CFrame.Angles(math.random() * 6, angle, math.random() * 6)
            TweenService:Create(feather, TweenInfo.new(duration * 1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(start + Vector3.new(math.cos(angle) * size * (0.1 + math.random() * 0.4), -1.2 - math.random() * 1.8, math.sin(angle) * size * 0.2))
                    * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
                Transparency = 1, Size = Vector3.new(0.02, 0.08, 0.04),
            }):Play()
            Debris:AddItem(feather, duration + 0.25)
        end
    else -- Nova
        self:_spawnRing(position, color, size * 0.22, 0.1, duration, 0.8)
        self:_spawnRing(position, lighten(color, 0.28), size * 0.5, 0.055, duration, -0.8)
    end

    if config.Sparks then
        self:_spawnBurst(position, color, size * 0.55, duration * 0.85, 20)
    end
end

function VisualEffects:_playDeathEffect(position)
    local config = self.Settings.DeathFX
    if not config.Enabled or not position then
        return
    end

    local color, size = config.Color, math.clamp(config.Size, 0.3, 3)
    if config.Style == "Shards" or config.Style == "Frost" then
        local shardColor = config.Style == "Frost" and Color3.fromRGB(180, 235, 255) or color
        self:_spawnBurst(position, shardColor, 5 * size, 0.95, 28)
        self:_spawnRing(position, shardColor, 2.2 * size, 0.07, 0.75, 0.8)
    elseif config.Style == "Soul" then
        local component = self:_newTransientComponent()
        for _ = 1, scaledCount(14, self.Quality, 8) do
            local angle = math.random() * math.pi * 2
            local orb = self:_newPart(component, {
                Name = "SoulOrb", Anchored = true, Shape = Enum.PartType.Ball, Size = Vector3.new(0.25, 0.25, 0.25) * size,
                Color = lighten(color, 0.4), Transparency = 0.14,
            })
            orb.CFrame = CFrame.new(position + Vector3.new(math.cos(angle), math.random() * 1.5, math.sin(angle)))
            TweenService:Create(orb, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(position + Vector3.new(math.cos(angle + 1.3) * 1.5, 4 + math.random() * 2, math.sin(angle + 1.3) * 1.5)),
                Size = Vector3.new(0.02, 0.02, 0.02), Transparency = 1,
            }):Play()
            Debris:AddItem(orb, 1.35)
        end
    elseif config.Style == "Firework" then
        task.delay(0.35, function()
            if not self.Destroyed then
                self:_spawnBurst(position + Vector3.new(0, 4 * size, 0), color, 6 * size, 1.05, 34)
            end
        end)
    elseif config.Style == "Void" then
        local component = self:_newTransientComponent()
        local void = self:_newPart(component, {
            Name = "VoidCore", Anchored = true, Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5) * size,
            Color = Color3.fromRGB(15, 0, 30), Transparency = 0.1,
        })
        void.CFrame = CFrame.new(position)
        TweenService:Create(void, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Vector3.new(4.5, 4.5, 4.5) * size, Transparency = 1,
        }):Play()
        Debris:AddItem(void, 1.05)
        self:_spawnBurst(position, color, 3.7 * size, 0.85, 20)
    else
        self:_spawnRing(position, color, 1.8 * size, 0.12, 0.8, 1.1)
        self:_spawnRing(position, lighten(color, 0.25), 3.2 * size, 0.07, 0.95, -0.9)
        self:_spawnBurst(position, color, 4.5 * size, 0.9, 26)
    end
end

