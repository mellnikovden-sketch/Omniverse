local function clearWings()
	if wingsFolder then wingsFolder:Destroy() end wingsFolder, wingParts = nil, {}
	if torso then for _, child in ipairs(torso:GetChildren()) do if child.Name == "CrystalHub_WingGlow" then child:Destroy() end end end
end

local function addTrail(part, color, lifetime, width)
	local front, back = Instance.new("Attachment"), Instance.new("Attachment")
	front.Position, back.Position = Vector3.new(0, part.Size.Y * 0.5, -part.Size.Z * 0.5), Vector3.new(0, part.Size.Y * 0.5, part.Size.Z * 0.5)
	front.Parent, back.Parent = part, part
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1, trail.Color, trail.Lifetime, trail.LightEmission, trail.LightInfluence, trail.FaceCamera = front, back, ColorSequence.new(color), lifetime or 0.35, 1, 0, true
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, width or 1), NumberSequenceKeypoint.new(1, 0) })
	trail.Parent = part
	return trail
end

local function addFeather(side, opts)
	local feather = newNeonPart(Vector3.new(opts.Thickness, opts.Length, opts.Width), opts.Color)
	feather.Transparency, feather.Parent = opts.Transparency or 0.1, wingsFolder
	local spread = opts.Spread + math.rad(vis.Wings.Droop or 0)
	local origin = CFrame.new(side * opts.OriginX, opts.OriginY, opts.OriginZ) * CFrame.Angles(opts.Pitch or 0, side * opts.Sweep, -side * spread)
	local offset = CFrame.new(0, opts.Length * 0.5, 0)
	table.insert(wingParts, { Weld = weldTo(torso, feather, origin * offset), Origin = origin, Offset = offset, Phase = opts.Phase or 0, Amp = opts.Amp or 0.12 })
	if opts.Tip then
		local tipLen = opts.Length * 0.32
		local tip = newNeonPart(Vector3.new(opts.Thickness, opts.Width * 0.95, tipLen), opts.TipColor or opts.Color, "WedgePart")
		tip.Transparency, tip.Parent = math.clamp((opts.Transparency or 0.1) + 0.12, 0, 0.95), wingsFolder
		local tipOff = CFrame.new(0, opts.Length + tipLen * 0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
		table.insert(wingParts, { Weld = weldTo(torso, tip, origin * tipOff), Origin = origin, Offset = tipOff, Phase = opts.Phase or 0, Amp = opts.Amp or 0.12 })
	end
	return feather
end

