-- Pet (теперь 5 стилей: Phoenix / Wisp / Slime / Star / Cube)
local function buildPet()
    safeDestroy(petFolder)
    petFolder = Instance.new("Folder")
    petFolder.Name = "Pet"
    petFolder.Parent = effectsFolder
    petOrb, petLight, petTrail = nil, nil, nil

    local cfg = vis.Extra.Pet
    if not cfg.Enabled then return end

    local style = cfg.Style or "Phoenix"
    local shape = (style == "Cube") and Enum.PartType.Block or Enum.PartType.Ball
    petOrb = newPart(Vector3.new(cfg.Size, cfg.Size, cfg.Size), cfg.Color, shape)
    petOrb.Anchored = true
    petOrb.Transparency = 0.1
    petOrb.Parent = petFolder

    petLight = Instance.new("PointLight")
    petLight.Color = cfg.Color
    petLight.Brightness = 3
    petLight.Range = 10
    petLight.Parent = petOrb

    local function deco(part, cf)
        part.Parent = petFolder
        weldTo(petOrb, part, cf)
    end

    if style == "Phoenix" then
        for side = -1, 1, 2 do
            local wing = newPart(
                Vector3.new(0.06 * cfg.Size, 0.25 * cfg.Size, 0.9 * cfg.Size),
                lighten(cfg.Color, 0.25), Enum.PartType.Wedge)
            deco(wing, CFrame.new(side * cfg.Size * 0.5, 0, -0.1 * cfg.Size)
                * CFrame.Angles(0, math.rad(side * 25), 0))
        end
        local crest = newPart(Vector3.new(0.12, 0.12, 0.12), Color3.fromRGB(255, 220, 120), Enum.PartType.Ball)
        deco(crest, CFrame.new(0, cfg.Size * 0.55, 0))
    elseif style == "Wisp" then
        local core = newPart(Vector3.new(cfg.Size * 0.4, cfg.Size * 0.4, cfg.Size * 0.4), Color3.fromRGB(255, 255, 255), Enum.PartType.Ball)
        core.Transparency = 0
        deco(core, CFrame.new(0, 0, 0))
        for i = 1, 3 do
            local a = (i / 3) * math.pi * 2
            local orb = newPart(Vector3.new(0.1, 0.1, 0.1), lighten(cfg.Color, 0.4), Enum.PartType.Ball)
            deco(orb, CFrame.new(math.cos(a) * cfg.Size * 0.8, 0, math.sin(a) * cfg.Size * 0.8))
        end
    elseif style == "Slime" then
        for side = -1, 1, 2 do
            local eye = newPart(Vector3.new(0.1, 0.14, 0.1), Color3.fromRGB(25, 25, 35), Enum.PartType.Ball)
            eye.Material = Enum.Material.SmoothPlastic
            deco(eye, CFrame.new(side * cfg.Size * 0.22, cfg.Size * 0.12, -cfg.Size * 0.42))
        end
    elseif style == "Star" then
        for i = 1, 5 do
            local a = (i / 5) * math.pi * 2
            local spike = newPart(Vector3.new(0.06 * cfg.Size, 0.06 * cfg.Size, 0.7 * cfg.Size), lighten(cfg.Color, 0.35))
            deco(spike, CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -cfg.Size * 0.7))
        end
        local core = newPart(Vector3.new(cfg.Size * 0.35, cfg.Size * 0.35, cfg.Size * 0.35), Color3.fromRGB(255, 255, 200), Enum.PartType.Ball)
        deco(core, CFrame.new(0, 0, 0))
    else -- Cube
        local inner = newPart(Vector3.new(cfg.Size * 0.5, cfg.Size * 0.5, cfg.Size * 0.5), lighten(cfg.Color, 0.3))
        deco(inner, CFrame.new(0, 0, 0))
    end

    if cfg.Trail then
        local a0 = Instance.new("Attachment")
        a0.Position = Vector3.new(0, cfg.Size * 0.5, 0)
        a0.Parent = petOrb
        local a1 = Instance.new("Attachment")
        a1.Position = Vector3.new(0, -cfg.Size * 0.5, 0)
        a1.Parent = petOrb
        petTrail = Instance.new("Trail")
        petTrail.Attachment0 = a0
        petTrail.Attachment1 = a1
        petTrail.Lifetime = 0.5
        petTrail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, cfg.Size * 1.5), NumberSequenceKeypoint.new(1, 0)})
        petTrail.LightEmission = 1
        petTrail.FaceCamera = true
        petTrail.Color = ColorSequence.new(cfg.Color)
        petTrail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
        petTrail.Parent = petOrb
    end

    -- прячем питомца, пока персонаж не готов
    local root = character and character:FindFirstChild("HumanoidRootPart")
    petOrb.CFrame = root and CFrame.new(root.Position + Vector3.new(0, cfg.Height + 2, 0)) or CFrame.new(0, -500, 0)
end

