local function spawnRing(pos, radius, thickness, color, dur, dir, tilt)
    local segs = quantity(30, 12)
    local segLen = (2 * math.pi * radius / segs) * 1.1
    for i = 1, segs do
        local a = (i / segs) * math.pi * 2
        local p = newPart(Vector3.new(thickness, thickness, segLen), color)
        p.Anchored = true
        p.Transparency = 0.1
        p.Parent = effectsFolder
        local cf = CFrame.new(pos) * CFrame.Angles(tilt or 0, a, 0) * CFrame.new(0, 0, -radius) * CFrame.Angles(0, math.rad(90), 0)
        p.CFrame = cf
        local tween = TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Transparency = 1,
            Size = Vector3.new(thickness * 0.3, thickness * 0.3, segLen * 1.8),
            CFrame = cf * CFrame.Angles(0, (dir or 1) * 0.8, 0) * CFrame.new(0, 0.3, -radius * 0.3)
        })
        tween:Play()
        Debris:AddItem(p, dur + 0.2)
    end
end

