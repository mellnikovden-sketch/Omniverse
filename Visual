local function clearSoulPet()
	if petConn then petConn:Disconnect() petConn = nil end
	if petFolder then petFolder:Destroy() petFolder = nil end
	petOrb, petLight, petCurrentPos, petExtra = nil, nil, nil, {}
end

local function buildSoulPet()
	clearSoulPet()
	if not vis.Extra.SoulPet.Enabled or not character then return end
	petFolder = Instance.new("Folder") petFolder.Name = "CH_Pet" petFolder.Parent = ensureFolder()
	local cfg, col, sz, style = vis.Extra.SoulPet, vis.Extra.SoulPet.Color, vis.Extra.SoulPet.Size, vis.Extra.SoulPet.Style

	petOrb = createShape(style == "Crystal" and "Part" or "Ball", Vector3.new(sz, sz, sz), col, 0.1)
	petOrb.Parent = petFolder
	petLight = Instance.new("PointLight") petLight.Color, petLight.Brightness, petLight.Range, petLight.Shadows, petLight.Parent = col, 3.5, 12, false, petOrb

	if style == "Dragonling" then
		for i=1, 5 do
			local tail = createShape("Ball", Vector3.new(sz - i*0.08, sz - i*0.08, sz - i*0.08), darken(col, i*0.1), 0.1) tail.Parent = petFolder table.insert(petExtra, tail)
		end
	elseif style == "Navi Fairy" then
		for i=1, 4 do
			local wing = createShape("Cylinder", Vector3.new(0.05, sz*1.2, sz*0.8), lighten(col, 0.4), 0.3) wing.Parent = petFolder table.insert(petExtra, wing)
		end
	elseif style == "Biblical Angel" then
		petOrb.Size = Vector3.new(sz*0.6, sz*0.6, sz*0.6)
		for i=1, 3 do
			local ring = createShape("Cylinder", Vector3.new(0.05, sz*2.5, sz*2.5), lighten(col, 0.2), 0.1) ring.Parent = petFolder table.insert(petExtra, ring)
		end
	elseif style == "Companion Cube" then
		petOrb.Shape, petOrb.Size, petOrb.Color = Enum.PartType.Block, Vector3.new(sz*1.2, sz*1.2, sz*1.2), darken(col, 0.3)
		local core = createShape("Ball", Vector3.new(sz*1.3, sz*1.3, sz*1.3), lighten(col, 0.5), 0.5) core.Parent = petFolder table.insert(petExtra, core)
	end
end

local function ensureSoulPetLoop()
	if petConn then return end
	petConn = RunService.Heartbeat:Connect(function(dt)
		if not vis.Extra.SoulPet.Enabled or not character or not petOrb then return end
		local root = character:FindFirstChild("HumanoidRootPart") or torso
		if not root then return end

		local cfg, t = vis.Extra.SoulPet, os.clock()
		
		if petSpinBoost > 0 then petSpinBoost = math.max(0, petSpinBoost - dt * 25) t = t + petSpinBoost end

		local angle = t * cfg.Speed
		local targetPos = root.Position + Vector3.new(math.cos(angle) * cfg.Distance, cfg.Height + math.sin(t * 1.8) * 0.7, math.sin(angle) * cfg.Distance)
		petCurrentPos = not petCurrentPos and targetPos or petCurrentPos:Lerp(targetPos, math.clamp(dt * 8, 0, 1))

		petOrb.CFrame = CFrame.new(petCurrentPos) * (cfg.Style == "Crystal" and CFrame.Angles(t * 1.5, t * 2, 0) or CFrame.new())

		if cfg.Style == "Dragonling" then
			for i, tail in ipairs(petExtra) do
				local tailA = angle - (i * 0.3)
				local tailPos = root.Position + Vector3.new(math.cos(tailA) * cfg.Distance, cfg.Height + math.sin(t * 1.8 - i*0.2) * 0.7, math.sin(tailA) * cfg.Distance)
				tail.CFrame = CFrame.new(tail.CFrame.Position:Lerp(tailPos, dt * 10))
			end
		elseif cfg.Style == "Navi Fairy" then
			local flap = math.sin(t * 15) * 40
			for i, w in ipairs(petExtra) do w.CFrame = petOrb.CFrame * CFrame.Angles(0, math.rad(i*90), 0) * CFrame.new(0,0,-cfg.Size) * CFrame.Angles(math.rad(flap), 0, 0) end
		elseif cfg.Style == "Biblical Angel" then
			for i, r in ipairs(petExtra) do r.CFrame = petOrb.CFrame * CFrame.Angles(t*(i), t*(1.5*i), 0) end
		elseif cfg.Style == "Companion Cube" then
			petExtra[1].CFrame = petOrb.CFrame * CFrame.Angles(t, t, t)
			petOrb.CFrame = CFrame.new(petCurrentPos) * CFrame.Angles(t, t*0.5, 0)
		end
	end)
end

