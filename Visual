local function spawnArcRing(origin, opts)
	local segs, sweep, rad0, rad1, th, dur, rise, color = quantity(opts.Segments or 24, 8), opts.Sweep or (math.pi*2), opts.Radius0 or 1.2, opts.Radius1 or 8, opts.Thickness or 0.2, opts.Duration or 0.7, opts.Rise or 0, opts.Color or Color3.new(1,1,1)
	local tipCol, chord0, chord1 = lighten(color, 0.4), (sweep * rad0 / segs) * 1.1, (sweep * rad1 / segs) * 1.1
	local info, base, folder = TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), CFrame.new(origin) * CFrame.Angles(opts.Tilt or 0, 0, 0), ensureFolder()

	for i = 1, segs do
		local r = (i - 1) / segs
		local angle = (opts.Start or 0) + r * sweep
		local p = createShape("Part", Vector3.new(th, th, chord0), color:Lerp(tipCol, r), math.clamp((opts.Fade or 0) * r, 0, 0.9))
		p.CFrame, p.Parent = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -rad0) * CFrame.Angles(0, math.rad(90), 0), folder
		TweenService:Create(p, info, { CFrame = base * CFrame.Angles(0, angle + (opts.Spin or 0), 0) * CFrame.new(0, rise, -rad1) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(th * 0.3, th * 0.3, chord1), Transparency = 1 }):Play()
		Debris:AddItem(p, dur + 0.1)
	end
end

local function spawnSparks(origin, color, dur, count, rad)
	local total = quantity(count, 4)
	for i = 1, total do
		local angle = (i / total) * math.pi * 2 + math.random() * 0.4
		local sp = createShape("Ball", Vector3.new(0.2, 0.2, 0.2), lighten(color, 0.3), 0.1)
		sp.CFrame, sp.Parent = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -0.6), ensureFolder()
		local far, high = (rad or 4) * (0.6 + math.random() * 0.7), 1.5 + math.random() * 2.5
		TweenService:Create(sp, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, high, -far), Size = Vector3.new(0.02, 0.02, 0.02), Transparency = 1 }):Play()
		Debris:AddItem(sp, dur + 0.1)
	end
end

local function playJumpEffect()
	if not vis.Jump.Enabled or not torso then return end
	local now = os.clock() if now - lastJumpEffect < 0.15 then return end lastJumpEffect = now
	local root = character and character:FindFirstChild("HumanoidRootPart") if not root then return end
	local origin, color, dur, sz, style = root.Position - Vector3.new(0, 2.55, 0), vis.Jump.Color, vis.Jump.Duration, vis.Jump.Size, vis.Jump.Style

	if vis.Jump.Flash then
		local fl = createShape("Cylinder", Vector3.new(0.08, sz * 0.45, sz * 0.45), lighten(color, 0.4), 0.25)
		fl.CFrame, fl.Parent = CFrame.new(origin) * CFrame.Angles(0, 0, math.rad(90)), ensureFolder()
		TweenService:Create(fl, TweenInfo.new(dur * 0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = Vector3.new(0.02, sz * 1.5, sz * 1.5), Transparency = 1 }):Play()
		Debris:AddItem(fl, dur)
	end

	if vis.Jump.Crater then
		local crBase = createShape("Cylinder", Vector3.new(0.02, sz * 0.8, sz * 0.8), Color3.new(0,0,0), 0.3)
		crBase.CFrame, crBase.Parent = CFrame.new(origin + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, 0, math.rad(90)), ensureFolder()
		local crNeon = createShape("Cylinder", Vector3.new(0.03, sz * 0.85, sz * 0.85), darken(color, 0.2), 0.1)
		crNeon.CFrame, crNeon.Parent = crBase.CFrame, ensureFolder()
		TweenService:Create(crBase, TweenInfo.new(dur * 1.5, Enum.EasingStyle.Sine), { Size = Vector3.new(0.01, sz * 1.2, sz * 1.2), Transparency = 1 }):Play()
		TweenService:Create(crNeon, TweenInfo.new(dur * 1.2, Enum.EasingStyle.Sine), { Size = Vector3.new(0.01, sz * 1.3, sz * 1.3), Transparency = 1 }):Play()
		Debris:AddItem(crBase, dur * 1.5) Debris:AddItem(crNeon, dur * 1.5)
	end

	if style == "Ring" then
		spawnArcRing(origin, { Color = color, Duration = dur, Segments = 30, Radius0 = sz * 0.16, Radius1 = sz, Thickness = sz * 0.035, Fade = 0.15, Rise = 0.25 })
		if vis.Jump.Sparks then spawnSparks(origin, color, dur, 8, sz * 0.5) end
	elseif style == "Vortex" then
		for layer = 1, 3 do task.delay((layer - 1) * 0.07, function() spawnArcRing(origin, { Color = color, Duration = dur, Segments = 22, Sweep = math.rad(300), Start = layer * 2.1, Radius0 = sz * (0.12 + layer * 0.05), Radius1 = sz * (0.75 + layer * 0.2), Thickness = sz * (0.045 - layer * 0.008), Spin = (layer % 2 == 0) and -0.9 or 0.9, Tilt = math.rad(layer * 4), Rise = 0.35 * layer, Fade = 0.75 }) end) end
	elseif style == "Lightning" then
		for i = 1, quantity(10, 5) do
			local a = (i/10) * math.pi * 2
			local sp = createShape("Wedge", Vector3.new(0.08, 0.08, sz * 0.8), lighten(color, 0.5), 0)
			sp.CFrame, sp.Parent = CFrame.new(origin) * CFrame.Angles(math.rad(math.random(10, 40)), a, 0) * CFrame.new(0,0,-sz*0.4), ensureFolder()
			TweenService:Create(sp, TweenInfo.new(dur*0.6, Enum.EasingStyle.Bounce), { CFrame = sp.CFrame * CFrame.new(0, sz*0.5, -sz), Transparency = 1, Size = Vector3.new(0.01, 0.01, sz * 1.5) }):Play()
			Debris:AddItem(sp, dur)
		end
	elseif style == "Hologram" then
		for i = 1, 4 do task.delay(i * 0.1, function() spawnArcRing(origin, { Color = lighten(color, 0.3), Duration = dur, Segments = 24, Radius0 = sz * 0.5, Radius1 = sz * 0.6, Thickness = sz * 0.015, Rise = i * 0.8, Fade = 0.1 }) end) end
	elseif style == "Kaleidoscope" then
		for index = 1, 6 do spawnArcRing(origin, { Color = index % 2 == 0 and color or lighten(color, 0.35), Duration = dur * 1.1, Segments = 14, Sweep = math.rad(55), Start = (index / 6) * math.pi * 2, Radius0 = sz * 0.15, Radius1 = sz * 1.0, Thickness = sz * 0.055, Spin = 1.2, Tilt = math.rad(10), Rise = 0.4, Fade = 0.35 }) end
		spawnArcRing(origin, { Color = lighten(color, 0.5), Duration = dur * 0.8, Segments = 20, Radius0 = sz * 0.08, Radius1 = sz * 0.4, Thickness = sz * 0.04, Spin = -1.5, Fade = 0.1 })
	elseif style == "Tsunami" then
		for wave = 1, 3 do
			task.delay((wave - 1) * 0.09, function()
				spawnArcRing(origin, { Color = wave == 1 and lighten(color, 0.3) or color, Duration = dur * (0.8 + wave * 0.15), Segments = 32, Radius0 = sz * (0.1 + wave * 0.05), Radius1 = sz * (0.6 + wave * 0.35), Thickness = sz * (0.05 - wave * 0.01), Rise = 0.1 * wave, Fade = 0.2 })
			end)
		end
	else
		-- Swirl
		spawnArcRing(origin, { Color = color, Duration = dur, Segments = 28, Sweep = math.rad(310), Start = 0, Radius0 = sz * 0.15, Radius1 = sz, Thickness = sz * 0.045, Spin = 0.7, Rise = 0.4, Fade = 0.85 })
		spawnArcRing(origin, { Color = color, Duration = dur * 1.15, Segments = 22, Sweep = math.rad(265), Start = math.pi, Radius0 = sz * 0.1, Radius1 = sz * 0.78, Thickness = sz * 0.03, Spin = -0.5, Tilt = math.rad(6), Rise = 0.2, Fade = 0.7 })
		if vis.Jump.Sparks then spawnSparks(origin, color, dur, 6, sz * 0.45) end
	end

	if vis.Extra.SoulPet.Enabled and vis.Extra.SoulPet.JumpReact then petSpinBoost = 35 end
end

