local function clearHalo()
	if haloFolder then haloFolder:Destroy() end
	haloFolder = nil
	haloParts  = {}
	if headPart then
		for _, child in ipairs(headPart:GetChildren()) do
			if child.Name == "CrystalHub_HaloGlow" then child:Destroy() end
		end
	end
end

local function buildHalo()
	clearHalo()
	if not vis.Halo.Enabled or not headPart then return end

	haloFolder = Instance.new("Folder")
	haloFolder.Name   = "CrystalHub_Halo"
	haloFolder.Parent = character

	local color = vis.Halo.Color
	local light = lighten(color, 0.4)
	local style = vis.Halo.Style
	local pc    = vis.Halo.PresetColors
	local function colAt(ratio) return presetColorAt(pc, color, ratio) end

	local function smoothRing(radius, height, segments, tilt, direction, thickness)
		segments = quantity(segments, 14)
		local segmentLength = (2 * math.pi * radius / segments) * 1.12
		for index = 1, segments do
			local angle = (index / segments) * math.pi * 2
			local t = (index - 1) / segments
			local piece = newNeonPart(Vector3.new(thickness, thickness, segmentLength), colAt(t))
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, height, 0)
				* CFrame.Angles(tilt or 0, angle, 0)
				* CFrame.new(0, 0, -radius)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = radius, Height = height, Tilt = tilt or 0, Direction = direction or 1 })
		end
	end

	local function orbitOrbs(count, radius, height, orbSize)
		count = quantity(count, 4)
		for index = 1, count do
			local angle = (index / count) * math.pi * 2
			local orb = newNeonPart(Vector3.new(orbSize, orbSize, orbSize), colAt((index - 1) / count), "Part")
			orb.Shape = Enum.PartType.Ball
			orb.Parent = haloFolder
			local weld = weldTo(headPart, orb, CFrame.new(0, height, 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = radius, Height = height, Tilt = 0, Direction = 1, Bob = index * 0.5 })
		end
	end

	if style == "Double" then
		smoothRing(0.9, 1.55, 24, 0, 1, 0.08)
		smoothRing(1.15, 1.5, 20, 0, -1, 0.05)
		orbitOrbs(6, 0.95, 1.6, 0.14)
	elseif style == "Orbs" then
		smoothRing(0.95, 1.6, 20, 0, 1, 0.06)
		orbitOrbs(8, 1.05, 1.6, 0.22)
	elseif style == "Tilted" then
		smoothRing(0.95, 1.6, 24, math.rad(25), 1, 0.08)
		smoothRing(0.75, 1.8, 18, math.rad(-35), -1, 0.06)
	elseif style == "Star" or style == "Crown" then
		smoothRing(0.85, 1.5, 24, 0, 1, 0.08)
		orbitOrbs(5, 0.95, 1.7, 0.2)
	else
		-- Ring
		smoothRing(0.9, 1.6, 26, 0, 1, 0.07)
		orbitOrbs(6, 1.15, 1.6, 0.12)
	end

	if vis.Halo.Glow then
		local pl = Instance.new("PointLight")
		pl.Color = color
		pl.Brightness = 1.6
		pl.Range = 9
		pl.Shadows = false
		pl.Name = "CrystalHub_HaloGlow"
		pl.Parent = headPart
	end
end

