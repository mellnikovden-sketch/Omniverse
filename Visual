local function addFeather(side, opts)
    local p = newPart(Vector3.new(opts.Thick, opts.Length, opts.Width), opts.Color)
    p.Transparency = opts.Transparency or 0.1
    p.Parent = wingFolder
    local spread = opts.Spread + math.rad(vis.Wings.Droop or 0)
    local origin = CFrame.new(side * opts.X, opts.Y, opts.Z) * CFrame.Angles(opts.Pitch or 0, side * opts.Sweep, -side * spread)
    local offset = CFrame.new(0, opts.Length * 0.5, 0)
    local w = weldTo(torso, p, origin * offset)
    table.insert(wingParts, {Weld = w, Origin = origin, Offset = offset, Phase = opts.Phase or 0, Amp = opts.Amp or 0.12})
    if opts.Tip then
        local tip = newPart(Vector3.new(opts.Thick, opts.Width * 0.9, opts.Length * 0.3), opts.TipColor or opts.Color, Enum.PartType.Wedge)
        tip.Transparency = math.clamp((opts.Transparency or 0.1) + 0.15, 0, 0.9)
        tip.Parent = wingFolder
        local toff = CFrame.new(0, opts.Length + opts.Length * 0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        local w2 = weldTo(torso, tip, origin * toff)
        table.insert(wingParts, {Weld = w2, Origin = origin, Offset = toff, Phase = opts.Phase or 0, Amp = opts.Amp or 0.12})
    end
    if vis.Wings.Trail then
        local a0 = Instance.new("Attachment")
        a0.Position = Vector3.new(0, opts.Length * 0.4, 0)
        a0.Parent = p
        local a1 = Instance.new("Attachment")
        a1.Position = Vector3.new(0, -opts.Length * 0.4, 0)
        a1.Parent = p
        local tr = Instance.new("Trail")
        tr.Attachment0 = a0
        tr.Attachment1 = a1
        tr.Lifetime = 0.3
        tr.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, opts.Width * 1.2), NumberSequenceKeypoint.new(1, 0)})
        tr.LightEmission = 1
        tr.FaceCamera = true
        tr.Color = ColorSequence.new(lighten(opts.Color, 0.2))
        tr.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
        tr.Parent = p
    end
    return p
end

