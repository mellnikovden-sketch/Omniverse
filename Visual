        end
end

-- ===== Footprints: отпечатки разной формы + искры + цветовые вариации =====
local FOOTPRINT_SHAPES = { "oval", "diamond", "star", "oval", "oval" }

local function spawnFootprint(pos, color, size, duration, shapeIdx)
        local fx = ensureFolder()
        local shape = FOOTPRINT_SHAPES[((shapeIdx - 1) % #FOOTPRINT_SHAPES) + 1]
        local fp
        if shape == "diamond" then
                fp = newNeonPart(Vector3.new(size * 0.8, 0.06, size * 0.8), color, "Part")
        elseif shape == "star" then
