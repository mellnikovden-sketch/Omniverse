-- [ ANIMATION LOOP ] --
local function stopLoopIfIdle()
	if #wingParts == 0 and #haloParts == 0 and #hatParts == 0 and animConnection then
		animConnection:Disconnect()
		animConnection = nil
	end
end

local function ensureLoop()
	if animConnection then return end
	animConnection = RunService.Heartbeat:Connect(function(dt)
		animClock = animClock + dt
		if vis.Extra.IdleSpin.Enabled then idleSpinAngle = idleSpinAngle + dt * vis.Extra.IdleSpin.Speed end
		local idleWobble = vis.Extra.IdleSpin.Enabled and math.sin(animClock * 1.8) * math.rad(12) or 0

		flapAccum = flapAccum + dt
		if #wingParts > 0 and flapAccum >= (1/30) then
			flapAccum = 0
			if vis.Wings.Flap then
				flapReset = false
				for _, i in ipairs(wingParts) do if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * CFrame.Angles(0, 0, math.sin(animClock * 2.6 + i.Phase) * i.Amp) * i.Offset end end
			elseif not flapReset then
				flapReset = true
				for _, i in ipairs(wingParts) do if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * i.Offset end end
			end
		end

		for _, i in ipairs(haloParts) do
			if i.Weld and i.Weld.Parent then
				local angle = i.Angle + animClock * vis.Halo.Speed * i.Direction + (vis.Extra.IdleSpin.Enabled and idleSpinAngle or 0)
				i.Weld.C0 = CFrame.new(i.OffsetX or 0, i.Height + (i.Bob and math.sin(animClock * 2 + i.Bob) * 0.08 or 0), 0) * CFrame.Angles(i.Tilt + idleWobble, angle, 0) * CFrame.new(0, 0, -i.Radius) * CFrame.Angles(0, math.rad(90), 0)
			end
		end

		for _, i in ipairs(hatParts) do
			if i.Weld and i.Weld.Parent then
				local spin = animClock * vis.ChinaHat.Spin + (vis.Extra.IdleSpin.Enabled and idleSpinAngle or 0)
				if i.Kind == "disc" then i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(idleWobble, spin, 0) * CFrame.Angles(0, 0, math.rad(90))
				elseif i.Kind == "spike" then i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(0, i.Angle + spin, 0) * CFrame.new(0, 0, -i.Radius)
				else i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(i.Tilt, i.Angle + spin, 0) * CFrame.new(0, 0, -i.Radius) * CFrame.Angles(0, math.rad(90), 0) end
			end
		end
	end)
end

