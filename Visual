function VisualEffects:_wingPalette(style, base, fraction)
    if style == "Fire" then
        return base:Lerp(Color3.fromRGB(255, 205, 65), fraction)
    elseif style == "Ice" then
        return base:Lerp(Color3.fromRGB(220, 250, 255), fraction)
    elseif style == "Dark" then
        return darken(base, 0.32):Lerp(base, fraction * 0.55)
    elseif style == "Cyber" then
        return base:Lerp(Color3.fromRGB(255, 35, 210), fraction)
    elseif style == "Light" then
        return lighten(base, fraction * 0.45)
    end
    return base:Lerp(lighten(base, 0.3), fraction)
end

function VisualEffects:_addWingBlade(component, folder, side, index, total, options)
    local fraction = total <= 1 and 0 or (index - 1) / (total - 1)
    local scale = options.scale
    local length = (options.length - fraction * options.taper) * scale
    local width = (options.width - fraction * options.widthTaper) * scale
    local className = options.crystal and "WedgePart" or "Part"
    local blade = self:_newPart(component, {
        Name = "WingBlade", ClassName = className, Parent = folder,
        Size = Vector3.new(math.max(options.thickness * scale, 0.035), math.max(length, 0.3), math.max(width, 0.06)),
        Color = self:_wingPalette(options.style, options.color, fraction),
        Transparency = options.transparency,
    })

    local spread = math.rad(options.spread + fraction * options.spreadRange + self.Settings.Wings.Droop)
    local offset = CFrame.new(side * options.x * scale, options.y * scale, options.z * scale)
        * CFrame.Angles(math.rad(options.pitch + fraction * options.pitchRange), side * math.rad(options.sweep), -side * spread)
        * CFrame.new(0, length * 0.5, 0)
    local motor = self:_attachPart(component, self.Torso, blade, offset)
    table.insert(self.AnimationParts.wings, {
        motor = motor,
        base = offset,
        phase = index * 0.34 + (side == 1 and 0.3 or 0),
        amplitude = options.amplitude,
        side = side,
    })

    if self.Settings.Wings.Trail and index % math.max(1, math.floor(total / 3)) == 0 then
        local top = self:_newAttachment(component, blade, "WingTrailTop", Vector3.new(0, length * 0.38, 0))
        local bottom = self:_newAttachment(component, blade, "WingTrailBottom", Vector3.new(0, -length * 0.38, 0))
        local trail = Instance.new("Trail")
        trail.Name = "WingTrail"
        trail.Attachment0 = top
        trail.Attachment1 = bottom
        trail.Lifetime = 0.25
        trail.LightEmission = 1
        trail.FaceCamera = true
        trail.Color = ColorSequence.new(lighten(blade.Color, 0.15))
        trail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, math.max(width * 0.8, 0.06)),
            NumberSequenceKeypoint.new(1, 0),
        })
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.4),
            NumberSequenceKeypoint.new(1, 1),
        })
        trail.Parent = blade
        self:_track(component, trail)
    end
end

function VisualEffects:_buildWings()
    local component = self:_newComponent("Wings")
    table.clear(self.AnimationParts.wings)
    local config = self.Settings.Wings
    if not config.Enabled or not self.Torso then
        return
    end

    local folder = self:_createFolder(component, "Wings", self.Character)
    local style = config.Style
    local bladeCount = (style == "Light" or style == "Cyber") and 9 or 6
    if style == "Mechanical" then bladeCount = 7 end
    if style == "Crystal" then bladeCount = 7 end
    bladeCount = scaledCount(bladeCount, self.Quality, 4)

    local options = {
        style = style, color = config.Color, scale = math.clamp(config.Scale, 0.4, 2.5),
        length = style == "Light" and 4.1 or 4.45,
        width = style == "Mechanical" and 0.34 or 0.5,
        taper = style == "Light" and 2.35 or 1.7,
        widthTaper = 0.08,
        thickness = style == "Mechanical" and 0.12 or 0.055,
        transparency = style == "Light" and 0.02 or (style == "Dark" and 0.14 or 0.08),
        spread = style == "Mechanical" and 50 or 55,
        spreadRange = style == "Light" and 80 or 67,
        pitch = style == "Fire" and -18 or -10,
        pitchRange = style == "Fire" and -8 or 2,
        sweep = style == "Mechanical" and 15 or 25,
        x = 0.46, y = 0.25, z = 0.62,
        amplitude = style == "Mechanical" and 0.045 or (style == "Light" and 0.065 or 0.14),
        crystal = style == "Crystal" or style == "Ice",
    }

    for _, side in ipairs({ -1, 1 }) do
        for index = 1, bladeCount do
            self:_addWingBlade(component, folder, side, index, bladeCount, options)
        end
    end

    if style == "Mechanical" or style == "Cyber" then
        for _, side in ipairs({ -1, 1 }) do
            local hub = self:_newPart(component, {
                Name = "WingHub", Parent = folder, Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.35, 0.35),
                Color = lighten(config.Color, 0.2), Transparency = 0.05,
            })
            self:_attachPart(component, self.Torso, hub, CFrame.new(side * 0.5, 0.25, 0.55))
        end
    end

    if config.Glow then
        self:_addPointLight(component, self.Torso, config.Color, 1.7, 11, "WingGlow")
    end
end

