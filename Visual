	local folder = ensureFolder()
	local total  = quantity(count or 10, 4)
	for index = 1, total do
		local angle = (index / total) * math.pi * 2 + math.random() * 0.4
		local spark = newNeonPart(Vector3.new(0.16, 0.16, 0.16), lighten(color, 0.3), "Part")
		spark.Shape        = Enum.PartType.Ball
		spark.Anchored     = true
		spark.Transparency = 0.1
		spark.CFrame       = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -0.6)
		spark.Parent       = folder
		local far  = (radius or 4) * (0.6 + math.random() * 0.7)
		local high = 1.4 + math.random() * 2.2
		TweenService:Create(spark,
			TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				CFrame       = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, high, -far),
				Size         = Vector3.new(0.03, 0.03, 0.03),
				Transparency = 1,
			}
		):Play()
		task.delay(duration + 0.15, function()
			spark:Destroy()
		end)
	end
end

Visuals.JumpStyles = {
	"Swirl", "Ring", "Vortex", "Triple", "Nova",
	"Ripple", "Comet", "Shockwave", "Petals",
	"Bloom", "Spiral", "Galaxy", "Phoenix",
	"Tsunami", "Kaleidoscope", "Black Hole",
	"Hologram", "Lightning",
	"Aurora-Burst", "Confetti",
}

local function playJumpEffect()
	if not vis.Jump.Enabled or not torso then
		return
	end
	-- при частых прыжках событие приходит пачками, а один стиль это десятки деталей
	local now = os.clock()
	if now - lastJumpEffect < 0.15 then
		return
	end
	lastJumpEffect = now

	local folder = ensureFolder()
	-- троттлинг ограничивает частоту, но не количество
	if #folder:GetChildren() > (IS_PHONE and 220 or 400) then
		return
	end

	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local origin   = root.Position - Vector3.new(0, 2.55, 0)
	local color    = vis.Jump.Color
	local duration = vis.Jump.Duration
	local size     = vis.Jump.Size
	local style    = vis.Jump.Style

	if vis.Jump.Flash then
		spawnFlash(origin, size * 0.5, color, duration)
	end

	if style == "Ring" then
		spawnArcRing(origin, {
			Color = color, Duration = duration, Segments = 30,
			Radius0 = size * 0.16, Radius1 = size, Thickness = size * 0.035,
			Fade = 0.15, Rise = 0.25,
		})
		spawnSparks(origin, color, duration, 8, size * 0.5)
	elseif style == "Vortex" then
		for layer = 1, 3 do
			task.delay((layer - 1) * 0.07, function()
				spawnArcRing(origin, {
					Color     = color,
					Duration  = duration,
					Segments  = 22,
					Sweep     = math.rad(300),
					Start     = layer * 2.1,
					Radius0   = size * (0.12 + layer * 0.05),
					Radius1   = size * (0.75 + layer * 0.2),
					Thickness = size * (0.045 - layer * 0.008),
					Spin      = (layer % 2 == 0) and -0.9 or 0.9,
					Tilt      = math.rad(layer * 4),
					Rise      = 0.35 * layer,
					Fade      = 0.75,
				})
			end)
		end
	elseif style == "Triple" then
		for index = 1, 3 do
			task.delay((index - 1) * 0.11, function()
				spawnArcRing(origin, {
					Color = color, Duration = duration, Segments = 24,
					Radius0 = size * 0.14, Radius1 = size * (0.6 + index * 0.22),
					Thickness = size * 0.03, Fade = 0.2, Rise = 0.15 * index,
				})
			end)
		end
	elseif style == "Nova" then
		spawnArcRing(origin, {
			Color = color, Duration = duration, Segments = 28,
			Radius0 = size * 0.15, Radius1 = size * 0.95, Thickness = size * 0.04, Fade = 0.1,
		})
		for index = 1, quantity(8, 4) do
			spawnShard(origin, (index / 8) * math.pi * 2, color, duration * 0.9)
		end
		spawnSparks(origin, color, duration, 12, size * 0.6)
	elseif style == "Ripple" then
		for index = 1, 3 do
			task.delay((index - 1) * 0.13, function()
				spawnDisc(origin, size * (0.4 + index * 0.1), 0.14, color, duration, 2.1)
			end)
		end
	elseif style == "Comet" then
		-- одна короткая дуга-хвост, летящая наружу с сильным градиентом
		spawnArcRing(origin, {
			Color     = color,
			Duration  = duration * 1.1,
			Segments  = 24,
			Sweep     = math.rad(150),
			Start     = math.random() * math.pi * 2,
			Radius0   = size * 0.12,
			Radius1   = size * 1.15,
			Thickness = size * 0.05,
			Spin      = 1.6,
			Tilt      = math.rad(8),
			Rise      = 0.8,
			Fade      = 0.95,
		})
		spawnSparks(origin, color, duration, 8, size * 0.4)
	elseif style == "Shockwave" then
		-- плоская волна плюс тонкое кольцо-обод: читается даже в бою
		spawnDisc(origin, size * 0.5, 0.18, color, duration, 2.6)
		spawnArcRing(origin, {
			Color = color, Duration = duration * 0.9, Segments = 34,
			Radius0 = size * 0.3, Radius1 = size * 1.3, Thickness = size * 0.025, Fade = 0.05,
		})
	elseif style == "Petals" then
		-- шесть коротких дуг лепестками вокруг персонажа
		for index = 1, quantity(6, 3) do
			spawnArcRing(origin, {
				Color     = color,
				Duration  = duration,
				Segments  = 10,
				Sweep     = math.rad(52),
				Start     = (index / 6) * math.pi * 2,
				Radius0   = size * 0.2,
				Radius1   = size * 0.9,
				Thickness = size * 0.05,
				Tilt      = math.rad(14),
				Rise      = 0.5,
				Fade      = 0.5,
			})
		end
	elseif style == "Bloom" then
		-- Bloom: расцветающий цветок — 3 слоя лепестков + пыльца + ядро
		local petals = quantity(8, 4)
		-- внешние большие лепестки
		for index = 1, petals do
			task.delay((index - 1) * 0.02, function()
				spawnArcRing(origin, {
					Color = color, Duration = duration, Segments = 8,
					Sweep = math.rad(40), Start = (index / petals) * math.pi * 2,
					Radius0 = size * 0.1, Radius1 = size * 0.95,
					Thickness = size * 0.06, Tilt = math.rad(25), Rise = 1.2, Fade = 0.3,
				})
			end)
		end
		-- средний слой (меньше, чем внешний, с другим цветом)
		task.delay(0.06, function()
			for index = 1, petals do
				spawnArcRing(origin, {
					Color = lighten(color, 0.25), Duration = duration * 0.9, Segments = 8,
					Sweep = math.rad(34), Start = (index / petals) * math.pi * 2 + math.rad(22),
					Radius0 = size * 0.08, Radius1 = size * 0.6,
					Thickness = size * 0.045, Tilt = math.rad(32), Rise = 0.9, Fade = 0.4,
				})
			end
		end)
		-- внутреннее ядро + ѧельца
		spawnFlash(origin, size * 0.35, lighten(color, 0.4), duration * 0.6)
		spawnSparks(origin, color, duration * 1.4, 16, size * 0.7)

	elseif style == "Spiral" then
		-- Spiral: 3D-спираль с 2 витками + центральный колн
		local arms = 2
		for layer = 1, 5 do
			task.delay((layer - 1) * 0.04, function()
				for arm = 0, arms - 1 do
					spawnArcRing(origin, {
						Color = arm == 0 and color or lighten(color, 0.3),
						Duration = duration * 1.1, Segments = 24,
						Sweep = math.rad(280),
						Start = layer * 1.2 + arm * math.pi,
						Radius0 = size * (0.06 + layer * 0.03),
						Radius1 = size * (0.4 + layer * 0.22),
						Thickness = size * (0.05 - layer * 0.006),
						Spin = layer * 1.4, Tilt = math.rad(layer * 4),
						Rise = 0.15 + layer * 0.12, Fade = 0.65,
					})
				end
			end)
		end
		spawnFlash(origin, size * 0.3, lighten(color, 0.5), duration * 0.5)
		spawnSparks(origin, color, duration, 8, size * 0.5)

	elseif style == "Galaxy" then
		-- Galaxy: спиральные рукава + орбита звёзд + ядро
		-- две спиральные рукава
		for arm = 0, 1 do
			spawnArcRing(origin, {
				Color = arm == 0 and color or lighten(color, 0.3),
				Duration = duration * 1.3, Segments = 30,
				Sweep = math.rad(200), Start = arm * math.pi,
				Radius0 = size * 0.15, Radius1 = size * 1.1,
				Thickness = size * 0.04, Spin = arm == 0 and 1.8 or -1.8,
				Rise = 0.3, Fade = 0.25,
			})
		end
		-- вращающееся кольцо-орбита
		spawnArcRing(origin, {
			Color = lighten(color, 0.2), Duration = duration * 1.4, Segments = 28,
			Radius0 = size * 0.3, Radius1 = size * 0.85,
			Thickness = size * 0.03, Spin = 2.2, Tilt = math.rad(15),
			Rise = 0.2, Fade = 0.4,
		})
		-- звёзды-искры по орбите
		local fx = ensureFolder()
		for index = 1, quantity(20, 10) do
			local angle = (index / 20) * math.pi * 2 + math.random() * 0.3
			local star = newNeonPart(Vector3.new(0.2, 0.2, 0.2), lighten(color, 0.45), "Part")
			star.Shape        = Enum.PartType.Ball
			star.Anchored     = true
			star.Transparency = 0.05
			local orbitR = size * (0.35 + math.random() * 0.65)
			local orbitH = 0.3 + math.random() * 2.2
			star.CFrame       = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.3, -orbitR * 0.3)
			star.Parent       = fx
			TweenService:Create(star,
				TweenInfo.new(duration * 1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{
					CFrame       = CFrame.new(origin) * CFrame.Angles(0, angle + 2.8, 0) * CFrame.new(0, orbitH, -orbitR),
					Size         = Vector3.new(0.03, 0.03, 0.03),
					Transparency = 1,
				}):Play()
			task.delay(duration * 1.3 + 0.2, function() star:Destroy() end)
		end
		-- ядро галактики
		spawnFlash(origin, size * 0.4, lighten(color, 0.5), duration * 0.8)

	elseif style == "Phoenix" then
		-- Phoenix: крылья феникса + огненные перья + угли
		-- два слоя крыльев с обеих сторон
		for _, side in ipairs({ -1, 1 }) do
			-- большое внешнее крыло
			spawnArcRing(origin, {
				Color = color, Duration = duration * 1.2, Segments = 22,
				Sweep = math.rad(130), Start = side > 0 and math.rad(-65) or math.rad(115),
				Radius0 = size * 0.12, Radius1 = size * 1.25,
				Thickness = size * 0.07, Spin = side * 0.5, Tilt = math.rad(28),
				Rise = 1.6, Fade = 0.45,
			})
			-- меньшее внутреннее крыло (огненное)
			task.delay(0.04, function()
				spawnArcRing(origin, {
					Color = lighten(color, 0.35), Duration = duration * 1.0, Segments = 18,
					Sweep = math.rad(95), Start = side > 0 and math.rad(-50) or math.rad(130),
					Radius0 = size * 0.1, Radius1 = size * 0.8,
					Thickness = size * 0.05, Spin = side * 0.7, Tilt = math.rad(35),
					Rise = 1.1, Fade = 0.55,
				})
			end)
		end
		-- восходящие огненные перья-искры
		spawnSparks(origin, color, duration * 1.5, 22, size * 1.0)
		-- центральная вспышка-рождение
		spawnFlash(origin, size * 0.6, lighten(color, 0.4), duration * 0.7)

	elseif style == "Tsunami" then
		-- Tsunami: волна-взглавье, 3 нарастающих кольца + быстрые брызги
		for wave = 1, 3 do
			task.delay((wave - 1) * 0.09, function()
				spawnArcRing(origin, {
					Color = wave == 1 and lighten(color, 0.3) or color,
					Duration = duration * (0.8 + wave * 0.15),
					Segments = 32,
					Radius0 = size * (0.1 + wave * 0.05),
					Radius1 = size * (0.6 + wave * 0.35),
					Thickness = size * (0.05 - wave * 0.01),
					Rise = 0.1 * wave,
					Fade = 0.2,
				})
				-- брызги воды
				for s = 1, quantity(6, 3) do
					spawnShard(origin, (s / 6) * math.pi * 2 + wave, color, duration * 0.7, 1.5 + wave * 0.3, size * (0.3 + wave * 0.15))
				end
			end)
		end
		spawnFlash(origin, size * 0.3, lighten(color, 0.5), duration * 0.5)

	elseif style == "Kaleidoscope" then
		-- Kaleidoscope: 6 симметричных секторов с вращением + многоугольный центр
		local sectors = 6
		for index = 1, sectors do
			spawnArcRing(origin, {
				Color = index % 2 == 0 and color or lighten(color, 0.35),
				Duration = duration * 1.1,
				Segments = 14,
				Sweep = math.rad(55),
				Start = (index / sectors) * math.pi * 2,
				Radius0 = size * 0.15,
				Radius1 = size * 1.0,
				Thickness = size * 0.055,
				Spin = 1.2,
				Tilt = math.rad(10),
				Rise = 0.4,
				Fade = 0.35,
			})
		end
		-- внутренний контрастный круг
		spawnArcRing(origin, {
			Color = lighten(color, 0.5), Duration = duration * 0.8, Segments = 20,
			Radius0 = size * 0.08, Radius1 = size * 0.4, Thickness = size * 0.04,
			Spin = -1.5, Fade = 0.1,
		})
		spawnSparks(origin, color, duration, 10, size * 0.5)

	elseif style == "Black Hole" then
		-- Black Hole: впадающие струги к центру + тёмное кольцо вдоб аккреции
		-- внешнее тёмное кольцо
		spawnArcRing(origin, {
			Color = darken(color, 0.5), Duration = duration * 1.2, Segments = 30,
			Radius0 = size * 0.2, Radius1 = size * 1.1, Thickness = size * 0.07,
			Spin = -0.8, Fade = 0.05,
		})
		-- струги, впадающие в центр
		local fx = ensureFolder()
		for index = 1, quantity(14, 7) do
			local angle = (index / 14) * math.pi * 2
			local shard = newNeonPart(Vector3.new(0.14, 0.5, 0.14), color, "Part")
			shard.Anchored = true
			shard.Transparency = 0.1
			local startR = size * (0.8 + math.random() * 0.4)
			shard.CFrame = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.5, -startR)
			shard.Parent = fx
			TweenService:Create(shard,
				TweenInfo.new(duration * 0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
				{
					CFrame = CFrame.new(origin) * CFrame.Angles(0, angle + 2.0, 0) * CFrame.new(0, 0, -size * 0.1),
					Size = Vector3.new(0.03, 0.1, 0.03),
					Transparency = 1,
				}):Play()
			task.delay(duration * 0.9 + 0.15, function() shard:Destroy() end)
		end
		-- центральный вспышка-воронка
		spawnFlash(origin, size * 0.25, darken(color, 0.6), duration * 0.7)
	elseif style == "Hologram" then
		-- Hologram: glitchy ascending rings that phase in and out
		for i = 1, 4 do
			task.delay(i * 0.1, function()
				spawnArcRing(origin, {
					Color = lighten(color, 0.3), Duration = duration,
					Segments = 24, Radius0 = size * 0.5, Radius1 = size * 0.6,
					Thickness = size * 0.015, Rise = i * 0.8, Fade = 0.1,
				})
			end)
		end
		spawnFlash(origin, size * 0.3, lighten(color, 0.4), duration * 0.5)

	elseif style == "Lightning" then
		-- Lightning: jagged electric bolts radiating outward + bounce
		local fx = ensureFolder()
		for i = 1, quantity(8, 4) do
			local a = (i / 8) * math.pi * 2
			local bolt = newNeonPart(Vector3.new(0.08, 0.08, size * 0.8), lighten(color, 0.5), "WedgePart")
			bolt.Transparency = 0
			bolt.Anchored = true
			bolt.CFrame = CFrame.new(origin) * CFrame.Angles(math.rad(math.random(10, 40)), a, 0) * CFrame.new(0, 0, -size * 0.4)
			bolt.Parent = fx
			TweenService:Create(bolt,
				TweenInfo.new(duration * 0.6, Enum.EasingStyle.Bounce),
				{
					CFrame = bolt.CFrame * CFrame.new(0, size * 0.5, -size),
					Transparency = 1,
					Size = Vector3.new(0.01, 0.01, size * 1.5),
				}):Play()
			game:GetService("Debris"):AddItem(bolt, duration)
		end
		spawnFlash(origin, size * 0.2, lighten(color, 0.6), duration * 0.3)

	elseif style == "Aurora-Burst" then
		-- Aurora-Burst: layered rainbow-tinted arcs rising and expanding outward
		local fx = ensureFolder()
		local layers = 5
		for layer = 1, layers do
			local hue0 = (os.clock() * 0.15 + layer * 0.18) % 1
			local acol = Color3.fromHSV(hue0, 0.7, 1)
			task.delay(layer * 0.06, function()
				spawnArcRing(origin, {
					Color = acol, Duration = duration * (0.9 + layer * 0.08),
					Segments = quantity(26, 12), Sweep = math.pi * 2,
					Start = layer * 0.4, Radius0 = size * 0.1, Radius1 = size * (0.7 + layer * 0.12),
					Thickness = size * 0.03, Spin = 0.4 * (layer % 2 == 0 and 1 or -1),
					Rise = layer * 0.5, Fade = 0.5,
				})
			end)
		end
		spawnFlash(origin, size * 0.35, Color3.fromHSV((os.clock()*0.2)%1, 0.6, 1), duration * 0.6)
		spawnSparks(origin, color, duration, 10, size * 0.6)

	elseif style == "Confetti" then
		-- Confetti: colourful small squares bursting upward and outward, rotating as they fall
		local fx = ensureFolder()
		local total = quantity(26, 12)
		for i = 1, total do
			local a = (i / total) * math.pi * 2 + math.random() * 0.3
			local hue = (i / total + os.clock() * 0.1) % 1
			local ccol = Color3.fromHSV(hue, 0.85, 1)
			local conf = newNeonPart(Vector3.new(0.18, 0.18, 0.04), ccol, "Part")
			conf.Anchored = true
			conf.Transparency = 0.05
			conf.CFrame = CFrame.new(origin) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.3, -0.4)
			conf.Parent = fx
			local far = size * (0.5 + math.random() * 0.7)
			local high = 2 + math.random() * 3
			TweenService:Create(conf,
				TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{
					CFrame = CFrame.new(origin) * CFrame.Angles(math.rad(math.random(-120, 120)), a, math.rad(math.random(-120, 120)))
						* CFrame.new(0, high, -far),
					Size = Vector3.new(0.04, 0.04, 0.01),
					Transparency = 1,
				}):Play()
			game:GetService("Debris"):AddItem(conf, duration + 0.2)
		end
		spawnFlash(origin, size * 0.25, lighten(color, 0.5), duration * 0.4)

	else
		-- Swirl: две встречные дуги с разной скоростью — росчерк, как на референсе
		spawnArcRing(origin, {
			Color     = color,
			Duration  = duration,
			Segments  = 28,
			Sweep     = math.rad(310),
			Start     = 0,
			Radius0   = size * 0.15,
			Radius1   = size,
			Thickness = size * 0.045,
			Spin      = 0.7,
			Rise      = 0.4,
			Fade      = 0.85,
		})
		spawnArcRing(origin, {
			Color     = color,
			Duration  = duration * 1.15,
			Segments  = 22,
			Sweep     = math.rad(265),
			Start     = math.pi,
			Radius0   = size * 0.1,
			Radius1   = size * 0.78,
			Thickness = size * 0.03,
			Spin      = -0.5,
			Tilt      = math.rad(6),
			Rise      = 0.2,
			Fade      = 0.7,
		})
		spawnSparks(origin, color, duration, 6, size * 0.45)
	end

	-- ===== NEW FEATURE: GroundPulse — expanding flat ground ripple =====
	if vis.Jump.GroundPulse then
		-- outer wide ripple hugging the ground plane
		spawnDisc(origin - Vector3.new(0, 0.05, 0), size * 0.5, size * 0.06, lighten(color, 0.3), duration * 1.1, 5.5)
		-- a second tighter, brighter inner ripple
		spawnDisc(origin - Vector3.new(0, 0.08, 0), size * 0.3, size * 0.04, color, duration * 0.8, 4.0)
	end

	-- ===== NEW FEATURE: StarBurst — radial neon spike explosion =====
	if vis.Jump.StarBurst then
		local spikeCount = 8
		local burstDur   = duration * 1.0
		for i = 1, spikeCount do
			local ang = (i - 1) / spikeCount * math.pi * 2
			local dir = Vector3.new(math.cos(ang), 0.35, math.sin(ang))
			local spike = newNeonPart(Vector3.new(0.05 * size, 0.05 * size, 0.05 * size), lighten(color, 0.4))
			spike.Anchored   = true
			spike.CanCollide = false
			spike.Material   = Enum.Material.Neon
			spike.Parent     = folder
			spike.CFrame     = CFrame.new(origin)
			local targetPos = origin + dir * (size * 1.3)
			TweenService:Create(spike,
				TweenInfo.new(burstDur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ CFrame = CFrame.new(targetPos), Transparency = 1, Size = Vector3.new(0.01, 0.01, 0.01) }
			):Play()
			game:GetService("Debris"):AddItem(spike, burstDur + 0.2)
		end
	end
end

