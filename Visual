-- Утилиты для работы с цветом
-- Строит ColorSequence из массива цветов (для трейлов)
local function buildColorSequence(colors)
	local keypoints = {}
	local count = #colors
	if count == 1 then
		return ColorSequence.new(colors[1])
	end
	local step = 1 / (count - 1)
	for i, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) * step, color))
	end
	return ColorSequence.new(keypoints)
end

-- Строит радужную ColorSequence из текущего hue
local function buildRainbowColorSequence(hue)
	local keypoints = {}
	for i = 0, 4 do
		local h = (hue + i * 0.12) % 1
		local color = Color3.fromHSV(h, 0.9, 1)
		table.insert(keypoints, ColorSequenceKeypoint.new(i / 4, color))
	end
	return ColorSequence.new(keypoints)
end

-- Возвращает цвет по hue (для сплошных цветов, не градиентов)
local function rainbowColor(hue)
	return Color3.fromHSV(hue % 1, 0.9, 1)
end

