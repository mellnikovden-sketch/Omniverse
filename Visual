local function clearChinaHat()
	if hatFolder then hatFolder:Destroy() end hatFolder, hatParts = nil, {}
	if headPart then for _, child in ipairs(headPart:GetChildren()) do if child.Name == "CH_HatGlow" then child:Destroy() end end end
end

local function buildChinaHat()
	clearChinaHat()
	if not vis.ChinaHat.Enabled or not headPart then return end
	hatFolder = Instance.new("Folder") hatFolder.Name = "CrystalHub_ChinaHat" hatFolder.Parent = character
	local color, size, style = vis.ChinaHat.Color, math.clamp(vis.ChinaHat.Size, 0.4, 3), vis.ChinaHat.Style

	local function addDisc(radius, height, thickness, transp)
		local p = createPart("Cylinder", Vector3.new(thickness, radius * 2, radius * 2), color, transp or 0.2) p.Parent = hatFolder
		table.insert(hatParts, { Weld = weldTo(headPart, p, CFrame.new(0, height, 0) * CFrame.Angles(0, 0, math.rad(90))), Kind = "disc", Height = height, Radius = radius })
	end

	if style == "Cone" then
		for index = 1, quantity(6, 4) do local ratio = (index - 1) / 5 addDisc((2.8 - ratio * 2.5) * size, (1.75 + ratio * 1.6) * size, 0.14 * size, 0.15) end
	elseif style == "UFO" then -- НОВЫЙ СТИЛЬ: НЛО
		addDisc(2.5 * size, 2.2 * size, 0.3 * size, 0.1) -- Тарелка
		addDisc(1.5 * size, 2.4 * size, 0.5 * size, 0.5) -- Кабина
		local beam = createPart("Cylinder", Vector3.new(2.5 * size, 2.0 * size, 2.0 * size), lighten(color, 0.4), 0.7) beam.Parent = hatFolder -- Луч захвата
		table.insert(hatParts, { Weld = weldTo(headPart, beam, CFrame.new(0, 1.0 * size, 0) * CFrame.Angles(0, 0, math.rad(90))), Kind = "disc", Height = 1.0 * size, Radius = 0 })
	elseif style == "Cyber-Visor" then -- НОВЫЙ СТИЛЬ: Кибер очки
		local p = createPart("Part", Vector3.new(0.2 * size, 0.3 * size, 1.4 * size), color, 0.1) p.Parent = hatFolder
		table.insert(hatParts, { Weld = weldTo(headPart, p, CFrame.new(0, 0.2, -0.6 * size)), Kind = "visor", Height = 0.2, Radius = 0 })
	elseif style == "Diamond" then
		for i = 1, 4 do local r = (i - 1) / 3 addDisc((0.3 + r * 1.9) * size, (1.7 + r * 0.7) * size, 0.1 * size, 0.18) end
		for i = 1, 4 do local r = (i - 1) / 3 addDisc((2.2 - r * 1.9) * size, (2.4 + r * 0.9) * size, 0.1 * size, 0.18) end
	elseif style == "Pagoda" then
		for i = 1, 3 do
			local r = (i - 1) / 2
			local rad, h = (2.6 - r * 1.6) * size, (1.7 + r * 2.0) * size
			addDisc(rad, h, 0.16 * size, 0.15)
			-- Изогнутые края крыши пагоды
			for k = 1, 8 do
				local a = (k / 8) * math.pi * 2
				local roofEdge = createPart("CornerWedge", Vector3.new(0.4 * size, 0.4 * size, 0.4 * size), color, 0.1) roofEdge.Parent = hatFolder
				table.insert(hatParts, { Weld = weldTo(headPart, roofEdge, CFrame.new(0, h, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -rad) * CFrame.Angles(math.rad(180), 0, 0)), Kind = "shard", Angle = a, Radius = rad, Height = h })
			end
		end
	else
		-- Layered (Default)
		for index = 1, quantity(5, 3) do local ratio = (index - 1) / 4 addDisc((2.8 - ratio * 2.3) * size, (1.78 + ratio * 1.8) * size, 0.16 * size, 0.2) end
	end

	-- ✨ НОВАЯ ФИЧА HAT: Orbit Shards
	if vis.ChinaHat.OrbitShards then
		for i = 1, 4 do
			local a = (i/4)*math.pi*2
			local sp = createPart("Part", Vector3.new(0.15,0.15,0.15), lighten(color, 0.4), 0) sp.Parent = hatFolder
			table.insert(hatParts, { Weld = weldTo(headPart, sp, CFrame.new(0, 2.0 * size, 0)), Kind = "shard", Angle = a, Radius = 3.0 * size, Height = 2.0 * size })
		end
	end

	if vis.ChinaHat.Glow then
		local pl = Instance.new("PointLight") pl.Color, pl.Brightness, pl.Range, pl.Shadows, pl.Name, pl.Parent = color, 1.8, 11, false, "CH_HatGlow", headPart
	end
end

