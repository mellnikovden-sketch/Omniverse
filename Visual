local function ensureSoulPetLoop()
	if petConn then return end
	if not vis.Extra.SoulPet.Enabled then return end
	petConn = RunService.Heartbeat:Connect(function(dt)
		if not vis.Extra.SoulPet.Enabled or not character or not petOrb then return end
		local root = character:FindFirstChild("HumanoidRootPart") or torso
		if not root then return end

		local cfg = vis.Extra.SoulPet
		local t = os.clock()
		local angle = t * cfg.Speed
		local targetPos = root.Position + Vector3.new(
			math.cos(angle) * cfg.Distance,
			cfg.Height + math.sin(t * 1.8) * 0.7,
			math.sin(angle) * cfg.Distance
		)

		if not petCurrentPos then
			petCurrentPos = targetPos
		else
			petCurrentPos = petCurrentPos:Lerp(targetPos, math.clamp(dt * 8, 0, 1))
		end

		petOrb.CFrame = CFrame.new(petCurrentPos)
	end)
end

local function findTorso(char, human)
	local rig = human and human.RigType
	if rig == Enum.HumanoidRigType.R6 then
		return char:FindFirstChild("Torso") or char:WaitForChild("Torso", 3)
	end
	return char:FindFirstChild("UpperTorso") or char:WaitForChild("UpperTorso", 3)
end

local function bindCharacter(char)
	character = char
	humanoid  = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
	torso     = findTorso(char, humanoid) or char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
	headPart  = char:FindFirstChild("Head") or char:WaitForChild("Head", 3) or torso

	wingParts, haloParts, hatParts = {}, {}, {}

	if jumpConnection then jumpConnection:Disconnect() jumpConnection = nil end
	if humanoid then
		jumpConnection = humanoid.Jumping:Connect(function(active)
			if active then playJumpEffect() end
		end)
	end

	if vis.Wings.Enabled then buildWings() end
	if vis.Halo.Enabled then buildHalo() end
	if vis.ChinaHat.Enabled then buildChinaHat() end
	if #wingParts > 0 or #haloParts > 0 or #hatParts > 0 then ensureLoop() end

	if vis.Extra.Glow.Enabled then buildGlow() ensureGlowLoop() end
	if vis.Extra.SoulPet.Enabled then buildSoulPet() ensureSoulPetLoop() end
end

