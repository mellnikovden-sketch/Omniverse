function VisualEffects:_addHeadPiece(component, folder, kind, properties, offset, collection)
    local part = self:_newPart(component, {
        Name = kind, Parent = folder, ClassName = properties.ClassName or "Part",
        Shape = properties.Shape or Enum.PartType.Block, Size = properties.Size,
        Color = properties.Color, Transparency = properties.Transparency or 0.06,
        Material = properties.Material or Enum.Material.Neon,
    })
    local motor = self:_attachPart(component, self.Head, part, offset)
    table.insert(collection, { motor = motor, base = offset })
    return part
end

function VisualEffects:_buildHalo()
    local component = self:_newComponent("Halo")
    table.clear(self.AnimationParts.halo)
    local config = self.Settings.Halo
    if not config.Enabled or not self.Head then
        return
    end

    local folder = self:_createFolder(component, "Halo", self.Character)
    local color, style = config.Color, config.Style
    local pieces = self.AnimationParts.halo

    if style == "Crown" then
        for index = 1, scaledCount(14, self.Quality, 8) do
            local angle = index / 14 * math.pi * 2
            local offset = CFrame.new(0, 1.52, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.82)
                * CFrame.Angles(math.rad(-15), 0, 0)
            self:_addHeadPiece(component, folder, "CrownRay", {
                Size = Vector3.new(0.07, 0.32, 0.07), Color = color:Lerp(lighten(color, 0.32), index / 14),
            }, offset, pieces)
        end
        for index = 1, scaledCount(7, self.Quality, 5) do
            local angle = index / 7 * math.pi * 2
            local offset = CFrame.new(0, 1.75, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.84)
            self:_addHeadPiece(component, folder, "CrownOrb", {
                Shape = Enum.PartType.Ball, Size = Vector3.new(0.16, 0.16, 0.16), Color = lighten(color, 0.4),
            }, offset, pieces)
        end
    elseif style == "Orbs" then
        local total = scaledCount(10, self.Quality, 6)
        for index = 1, total do
            local angle = index / total * math.pi * 2
            local offset = CFrame.new(0, 1.5 + math.sin(angle * 2) * 0.14, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.9)
            self:_addHeadPiece(component, folder, "HaloOrb", {
                Shape = Enum.PartType.Ball, Size = Vector3.new(0.21, 0.21, 0.21), Color = color:Lerp(lighten(color, 0.35), index / total),
            }, offset, pieces)
        end
    elseif style == "Star" then
        for index = 1, 5 do
            local angle = index / 5 * math.pi * 2 - math.pi / 2
            local offset = CFrame.new(0, 1.55, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.52)
            self:_addHeadPiece(component, folder, "StarRay", {
                Size = Vector3.new(0.06, 0.75, 0.06), Color = color:Lerp(lighten(color, 0.3), index / 5),
            }, offset, pieces)
        end
    elseif style == "Hexagon" then
        for index = 1, 6 do
            local angle = index / 6 * math.pi * 2
            local offset = CFrame.new(0, 1.56, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.83) * CFrame.Angles(0, math.rad(90), 0)
            self:_addHeadPiece(component, folder, "HexSegment", {
                Size = Vector3.new(0.045, 0.045, 0.42), Color = color:Lerp(lighten(color, 0.3), index / 6),
            }, offset, pieces)
        end
    elseif style == "Swirl" then
        local total = scaledCount(26, self.Quality, 12)
        for index = 1, total do
            local fraction = index / total
            local angle = fraction * math.pi * 4
            local radius = 0.25 + fraction * 0.75
            local offset = CFrame.new(0, 1.53 + math.sin(fraction * math.pi) * 0.25, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius)
            self:_addHeadPiece(component, folder, "SwirlDot", {
                Shape = Enum.PartType.Ball, Size = Vector3.new(0.07, 0.07, 0.07), Color = color:Lerp(lighten(color, 0.38), fraction),
            }, offset, pieces)
        end
    else -- Ring
        local total = scaledCount(24, self.Quality, 12)
        for index = 1, total do
            local angle = index / total * math.pi * 2
            local offset = CFrame.new(0, 1.55, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.85) * CFrame.Angles(0, math.rad(90), 0)
            self:_addHeadPiece(component, folder, "RingSegment", {
                Size = Vector3.new(0.04, 0.04, 0.13), Color = color:Lerp(lighten(color, 0.25), index / total),
            }, offset, pieces)
        end
    end

    if config.Glow then
        self:_addPointLight(component, self.Head, color, 1.2, 8, "HaloGlow")
    end
end

