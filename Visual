-- AURA, SHIELD, PET, AND FOOTPRINTS
-- ============================================================
function VisualEffects:_buildAura()
    local component = self:_newComponent("Aura")
    table.clear(self.AnimationParts.aura)
    local config = self.Settings.Extra.Aura
    if not config.Enabled or not self.Root then
        return
    end

    local folder = self:_createFolder(component, "Aura", self.EffectsFolder)
    local count = scaledCount(math.clamp(config.Count, 3, 24), self.Quality, 4)
    for index = 1, count do
        local angle = index / count * math.pi * 2
        local fraction = index / count
        local radius = config.Radius * (config.Style == "Spiral" and (0.55 + fraction * 0.5) or (0.85 + math.random() * 0.18))
        local height = config.Height + (config.Style == "Spiral" and (fraction - 0.5) * 1.4 or math.sin(angle * 2) * 0.25)
        local orb = self:_newPart(component, {
            Name = "AuraOrb", Parent = folder, Anchored = true, Shape = Enum.PartType.Ball,
            Size = Vector3.new(0.16, 0.16, 0.16), Color = config.Color:Lerp(lighten(config.Color, 0.3), fraction), Transparency = 0.13,
        })
        table.insert(self.AnimationParts.aura, { part = orb, angle = angle, radius = radius, height = height, phase = fraction * math.pi * 2 })
    end
end

function VisualEffects:_updateAura()
    local config = self.Settings.Extra.Aura
    if not config.Enabled or not self.Root then
        return
    end
    for _, item in ipairs(self.AnimationParts.aura) do
        if item.part.Parent then
            local angle = item.angle + self.Time * config.Speed
            local vertical = math.sin(self.Time * 2 + item.phase) * 0.25
            local radiusPulse = config.Style == "Nebula" and math.sin(self.Time * 1.8 + item.phase) * 0.2 or 0
            item.part.CFrame = CFrame.new(self.Root.Position + Vector3.new(math.cos(angle) * (item.radius + radiusPulse), item.height + vertical, math.sin(angle) * (item.radius + radiusPulse)))
        end
    end
end

function VisualEffects:_buildShield()
    local component = self:_newComponent("Shield")
    table.clear(self.AnimationParts.shield)
    local config = self.Settings.Extra.Shield
    if not config.Enabled or not self.Root then
        return
    end

    local folder = self:_createFolder(component, "Shield", self.EffectsFolder)
    local rings = self.Quality < 0.7 and 2 or 3
    local segments = scaledCount(16, self.Quality, 10)
    for ring = 1, rings do
        local tilt = (ring - 2) * math.rad(28)
        for index = 1, segments do
            local angle = index / segments * math.pi * 2
            local segment = self:_newPart(component, {
                Name = "ShieldSegment", Parent = folder, Anchored = true, Size = Vector3.new(0.045, 0.045, 0.15),
                Color = config.Color:Lerp(lighten(config.Color, 0.25), ring / rings), Transparency = 0.2,
            })
            local localOffset = CFrame.Angles(tilt, angle, 0) * CFrame.new(0, 0, -config.Radius) * CFrame.Angles(0, math.rad(90), 0)
            table.insert(self.AnimationParts.shield, { part = segment, offset = localOffset, phase = angle + ring })
        end
    end
end

function VisualEffects:_updateShield()
    local config = self.Settings.Extra.Shield
    if not config.Enabled or not self.Root then
        return
    end
    local pulse = config.Pulse and (1 + math.sin(self.Time * 3) * 0.05) or 1
    for _, item in ipairs(self.AnimationParts.shield) do
        if item.part.Parent then
            local offset = item.offset * CFrame.new(0, 0, -(pulse - 1) * config.Radius)
            item.part.CFrame = self.Root.CFrame * offset
            item.part.Transparency = 0.18 + math.sin(self.Time * 2 + item.phase) * 0.08
        end
    end
end

function VisualEffects:_buildPet()
    local component = self:_newComponent("Pet")
    table.clear(self.AnimationParts.pet)
    local config = self.Settings.Extra.Pet
    if not config.Enabled or not self.Root then
        return
    end

    local folder = self:_createFolder(component, "Pet", self.EffectsFolder)
    local scale = math.clamp(config.Size, 0.2, 2)
    local core = self:_newPart(component, {
        Name = "PetCore", Parent = folder, Anchored = true, Shape = Enum.PartType.Ball,
        Size = Vector3.new(scale, scale, scale), Color = config.Color, Transparency = 0.08,
    })
    self:_addPointLight(component, core, config.Color, 1.6, 7, "PetGlow")
    table.insert(self.AnimationParts.pet, { part = core, role = "core" })

    if config.Style == "Phoenix" then
        for _, side in ipairs({ -1, 1 }) do
            local wing = self:_newPart(component, {
                Name = "PetWing", Parent = folder, Anchored = true, ClassName = "WedgePart",
                Size = Vector3.new(0.05 * scale, 0.62 * scale, 0.24 * scale), Color = lighten(config.Color, 0.23), Transparency = 0.08,
            })
            table.insert(self.AnimationParts.pet, { part = wing, role = "wing", side = side })
        end
    elseif config.Style == "Crystal" then
        for index = 1, 4 do
            local crystal = self:_newPart(component, {
                Name = "PetCrystal", Parent = folder, Anchored = true,
                Size = Vector3.new(0.15, 0.45, 0.15) * scale, Color = lighten(config.Color, 0.25), Transparency = 0.05,
            })
            table.insert(self.AnimationParts.pet, { part = crystal, role = "crystal", phase = index / 4 * math.pi * 2 })
        end
    end

    if config.Trail then
        local top = self:_newAttachment(component, core, "PetTrailTop", Vector3.new(0, scale * 0.4, 0))
        local bottom = self:_newAttachment(component, core, "PetTrailBottom", Vector3.new(0, -scale * 0.4, 0))
        local trail = Instance.new("Trail")
        trail.Name = "PetTrail"
        trail.Attachment0 = top
        trail.Attachment1 = bottom
        trail.Lifetime = 0.4
        trail.FaceCamera = true
        trail.LightEmission = 1
        trail.Color = ColorSequence.new(config.Color)
        trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, scale * 1.15), NumberSequenceKeypoint.new(1, 0) })
        trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
        trail.Parent = core
        self:_track(component, trail)
    end
end

function VisualEffects:_updatePet()
    local config = self.Settings.Extra.Pet
    if not config.Enabled or not self.Root then
        return
    end

    local angle = self.Time * config.Speed
    local center = self.Root.Position + Vector3.new(math.cos(angle) * config.Distance, config.Height + math.sin(self.Time * 2.2) * 0.35, math.sin(angle) * config.Distance)
    local scale = math.clamp(config.Size, 0.2, 2)
    for _, item in ipairs(self.AnimationParts.pet) do
        if item.part.Parent then
            if item.role == "core" then
                item.part.CFrame = CFrame.new(center)
            elseif item.role == "wing" then
                item.part.CFrame = CFrame.new(center) * CFrame.new(item.side * 0.28 * scale, 0, 0) * CFrame.Angles(0, 0, item.side * (0.5 + math.sin(self.Time * 7) * 0.35))
            elseif item.role == "crystal" then
                local a = angle * 1.5 + item.phase
                item.part.CFrame = CFrame.new(center + Vector3.new(math.cos(a) * 0.38 * scale, math.sin(self.Time * 3 + item.phase) * 0.15, math.sin(a) * 0.38 * scale)) * CFrame.Angles(0, a, 0)
            end
        end
    end
end

function VisualEffects:_updateFootprints()
    local config = self.Settings.Extra.Footprints
    if not config.Enabled or not self.Root or not self.Humanoid then
        return
    end
    if self.Humanoid.MoveDirection.Magnitude < 0.2 or os.clock() - self.LastFootprint < config.Interval then
        return
    end
    self.LastFootprint = os.clock()

    local rayParameters = RaycastParams.new()
    rayParameters.FilterType = Enum.RaycastFilterType.Exclude
    rayParameters.FilterDescendantsInstances = { self.Character, self.EffectsFolder }
    local hit = Workspace:Raycast(self.Root.Position, Vector3.new(0, -6, 0), rayParameters)
    if not hit then
        return
    end

    local component = self:_newTransientComponent()
    local footprint = self:_newPart(component, {
        Name = "Footprint", Anchored = true, Shape = Enum.PartType.Cylinder,
        Size = Vector3.new(0.025, 0.5 * config.Size, 0.7 * config.Size), Color = config.Color, Transparency = 0.28,
    })
    local yaw = math.atan2(self.Root.CFrame.LookVector.X, self.Root.CFrame.LookVector.Z)
    footprint.CFrame = CFrame.new(hit.Position + hit.Normal * 0.025) * CFrame.Angles(0, yaw, math.rad(90))
    TweenService:Create(footprint, TweenInfo.new(config.Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(0.01, 0.68 * config.Size, 0.9 * config.Size), Transparency = 1,
    }):Play()
    Debris:AddItem(footprint, config.Duration + 0.1)

    if config.Spark then
        self:_spawnBurst(hit.Position + hit.Normal * 0.05, config.Color, config.Size * 0.7, math.min(config.Duration, 0.55), 5)
    end
end

-- ============================================================
-- ANIMATION, RUNTIME API, AND CLEAN-UP
-- ============================================================
function VisualEffects:_updateAnimatedParts()
    local wingConfig = self.Settings.Wings
    if wingConfig.Enabled and wingConfig.Flap then
        for _, item in ipairs(self.AnimationParts.wings) do
            if item.motor.Parent then
                local flap = math.sin(self.Time * 2.6 + item.phase) * item.amplitude
                item.motor.C0 = item.base * CFrame.Angles(0, 0, flap * item.side)
            end
        end
    end

    local haloConfig = self.Settings.Halo
    if haloConfig.Enabled then
        local rotation = self.Time * haloConfig.Speed
        for _, item in ipairs(self.AnimationParts.halo) do
            if item.motor.Parent then
                item.motor.C0 = CFrame.Angles(0, rotation, 0) * item.base
            end
        end
    end

    local hatConfig = self.Settings.Hat
    if hatConfig.Enabled and hatConfig.Spin ~= 0 then
        for _, item in ipairs(self.AnimationParts.hat) do
            if item.motor.Parent then
                item.motor.C0 = CFrame.Angles(0, self.Time * hatConfig.Spin, 0) * item.base
            end
        end
    end
end

function VisualEffects:ApplyPreset(name)
    local preset = PRESETS[name]
    if not preset then
        warn(("[VisualEffects] Unknown preset: %s"):format(tostring(name)))
        return false
    end
    deepMerge(self.Settings, preset)
    self.Settings.AutoStartPreset = name
    self:RebuildAll()
    return true
end

function VisualEffects:SetEnabled(effectName, enabled)
    local targets = {
        Jump = self.Settings.Jump,
        Wings = self.Settings.Wings,
        Halo = self.Settings.Halo,
        Hat = self.Settings.Hat,
        Trails = self.Settings.Trails,
        Glow = self.Settings.Extra.Glow,
        Aura = self.Settings.Extra.Aura,
        Footprints = self.Settings.Extra.Footprints,
        Pet = self.Settings.Extra.Pet,
        Shield = self.Settings.Extra.Shield,
        DeathFX = self.Settings.DeathFX,
    }
    local target = targets[effectName]
    if not target then
        warn(("[VisualEffects] Unknown effect: %s"):format(tostring(effectName)))
        return false
    end
    target.Enabled = enabled == true
    self:RebuildAll()
    return true
end

function VisualEffects:Destroy()
    if self.Destroyed then
        return
    end
    self.Destroyed = true
    self:_clearCharacterConnections()
    self:_clearCharacterVisuals()
    for _, connection in ipairs(self.Connections) do
        safeDisconnect(connection)
    end
    table.clear(self.Connections)
    if self.EffectsFolder then
        self.EffectsFolder:Destroy()
    end
end

