local function clearHalo() if haloFolder then haloFolder:Destroy() end haloFolder, haloParts = nil, {} end
local function buildHalo()
	clearHalo()
	if not vis.Halo.Enabled or not headPart then return end
	haloFolder = Instance.new("Folder") haloFolder.Name = "CH_Halo" haloFolder.Parent = ensureFolder()
	local color, style = vis.Halo.Color, vis.Halo.Style

	local function addSegRing(r, h, segs, tlt, dir, th, pType)
		local segL = (2 * math.pi * r / segs) * 1.12
		for i = 1, segs do
			local a = (i / segs) * math.pi * 2
			local p = createWeldable(pType or "Part", Vector3.new(th, th, segL), color, 0.1) p.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p, CFrame.new(0, h, 0) * CFrame.Angles(tlt or 0, a, 0) * CFrame.new(0, 0, -r) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = r, Height = h, Tilt = tlt or 0, Direction = dir or 1 })
		end
	end

	local function addOrbs(count, radius, height, orbSize)
		for i = 1, count do
			local a = (i / count) * math.pi * 2
			local orb = createWeldable("Ball", Vector3.new(orbSize, orbSize, orbSize), lighten(color, 0.2), 0.05) orb.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, orb, CFrame.new(0, height, 0)), Angle = a, Radius = radius, Height = height, Tilt = 0, Direction = 1, Bob = i * 0.5 })
		end
	end

	if style == "Double" then
		addSegRing(0.9, 1.55, 24, 0, 1, 0.08) addSegRing(1.15, 1.5, 20, 0, -1, 0.05) addOrbs(6, 0.95, 1.6, 0.14)
	elseif style == "Star" or style == "Crown" then
		addSegRing(0.85, 1.5, 24, 0, 1, 0.08) addOrbs(5, 0.95, 1.7, 0.2)
	elseif style == "Tech-Ring" then
		addSegRing(0.9, 1.6, 12, 0, 1, 0.12, "Part") addOrbs(8, 1.2, 1.6, 0.15)
	elseif style == "Rune-Circle" then
		addSegRing(0.9, 1.6, 16, math.rad(15), 1, 0.05) addSegRing(0.9, 1.6, 16, math.rad(-15), 1, 0.05)
		addSegRing(1.1, 1.6, 8, 0, -1, 0.08, "Part")
	else
		addSegRing(0.9, 1.6, 26, 0, 1, 0.07) addOrbs(6, 1.15, 1.6, 0.12)
	end
end

local function clearHat() if hatFolder then hatFolder:Destroy() end hatFolder, hatParts = nil, {} end
local function buildChinaHat()
	clearHat()
	if not vis.ChinaHat.Enabled or not headPart then return end
	hatFolder = Instance.new("Folder") hatFolder.Name = "CH_Hat" hatFolder.Parent = ensureFolder()
	local color, size, style = vis.ChinaHat.Color, math.clamp(vis.ChinaHat.Size, 0.4, 3), vis.ChinaHat.Style

	local function addDisc(radius, height, thickness, transp)
		local p = createWeldable("Cylinder", Vector3.new(thickness, radius * 2, radius * 2), color, transp or 0.2) p.Parent = hatFolder
		table.insert(hatParts, { Weld = weldTo(headPart, p, CFrame.new(0, height, 0) * CFrame.Angles(0, 0, math.rad(90))), Kind = "disc", Height = height, Radius = radius })
	end

	if style == "Cone" then
		for index = 1, quantity(6, 4) do local ratio = (index - 1) / 5 addDisc((2.8 - ratio * 2.5) * size, (1.75 + ratio * 1.6) * size, 0.14 * size, 0.15) end
	elseif style == "UFO" then
		addDisc(2.5 * size, 2.2 * size, 0.3 * size, 0.1) addDisc(1.5 * size, 2.4 * size, 0.5 * size, 0.5)
		local beam = createWeldable("Cylinder", Vector3.new(2.5 * size, 2.0 * size, 2.0 * size), lighten(color, 0.4), 0.7) beam.Parent = hatFolder
		table.insert(hatParts, { Weld = weldTo(headPart, beam, CFrame.new(0, 1.0 * size, 0) * CFrame.Angles(0, 0, math.rad(90))), Kind = "disc", Height = 1.0 * size, Radius = 0 })
	elseif style == "Cat Ears" then -- НОВЫЙ СТИЛЬ
		for side = -1, 1, 2 do
			local ear = createWeldable("CornerWedge", Vector3.new(0.3*size, 0.8*size, 0.6*size), color, 0.1) ear.Parent = hatFolder
			table.insert(hatParts, { Weld = weldTo(headPart, ear, CFrame.new(side * 0.4 * size, 0.6 * size, 0) * CFrame.Angles(0, side > 0 and math.rad(-90) or math.rad(90), 0)), Kind = "fixed", Height = 0.6*size, Radius = 0 })
		end
	elseif style == "Demon Horns" then -- НОВЫЙ СТИЛЬ
		for side = -1, 1, 2 do
			for i = 1, 4 do
				local horn = createWeldable("Cylinder", Vector3.new(0.2*size, (0.4 - i*0.05)*size, (0.4 - i*0.05)*size), darken(color, 0.2), 0.1) horn.Parent = hatFolder
				table.insert(hatParts, { Weld = weldTo(headPart, horn, CFrame.new(side * (0.4 + i*0.1) * size, 0.5 + i*0.2 * size, i*0.1 * size) * CFrame.Angles(0, 0, math.rad(90 + side*i*15))), Kind = "fixed", Height = 0, Radius = 0 })
			end
		end
	elseif style == "Cyber-Visor" then
		local p = createWeldable("Part", Vector3.new(0.2 * size, 0.3 * size, 1.4 * size), color, 0.1) p.Parent = hatFolder
		table.insert(hatParts, { Weld = weldTo(headPart, p, CFrame.new(0, 0.2, -0.6 * size)), Kind = "visor", Height = 0.2, Radius = 0 })
	elseif style == "Pagoda" then
		for i = 1, 3 do
			local r = (i - 1) / 2
			local rad, h = (2.6 - r * 1.6) * size, (1.7 + r * 2.0) * size
			addDisc(rad, h, 0.16 * size, 0.15)
			for k = 1, 8 do
				local a = (k / 8) * math.pi * 2
				local roofEdge = createWeldable("CornerWedge", Vector3.new(0.4 * size, 0.4 * size, 0.4 * size), color, 0.1) roofEdge.Parent = hatFolder
				table.insert(hatParts, { Weld = weldTo(headPart, roofEdge, CFrame.new(0, h, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -rad) * CFrame.Angles(math.rad(180), 0, 0)), Kind = "shard", Angle = a, Radius = rad, Height = h })
			end
		end
	else
		for index = 1, quantity(5, 3) do local ratio = (index - 1) / 4 addDisc((2.8 - ratio * 2.3) * size, (1.78 + ratio * 1.8) * size, 0.16 * size, 0.2) end
	end

	if vis.ChinaHat.OrbitShards then
		for i = 1, 4 do
			local a = (i/4)*math.pi*2
			local sp = createWeldable("Part", Vector3.new(0.15,0.15,0.15), lighten(color, 0.4), 0) sp.Parent = hatFolder
			table.insert(hatParts, { Weld = weldTo(headPart, sp, CFrame.new(0, 2.0 * size, 0)), Kind = "shard", Angle = a, Radius = 3.0 * size, Height = 2.0 * size })
		end
	end
end

