local function updateFootprints(dt)
    local cfg = vis.Extra.Footprints
    if not cfg.Enabled or not footprintFolder then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local v = root.AssemblyLinearVelocity
    local horiz = Vector3.new(v.X, 0, v.Z)
    if horiz.Magnitude < 4 then
        footAccum = cfg.Interval * 0.9 -- первый шаг после остановки срабатывает сразу
        return
    end
    footAccum = footAccum + dt
    if footAccum < cfg.Interval then return end
    footAccum = 0
    footSide = -footSide

    local sidePos = root.Position + root.CFrame.RightVector * (0.45 * footSide) - root.CFrame.LookVector * 0.1
    footprintRayParams.FilterDescendantsInstances = { effectsFolder, character }
    local ray = workspace:Raycast(sidePos + Vector3.new(0, 3, 0), Vector3.new(0, -8, 0), footprintRayParams)
    if not ray then return end -- в воздухе следы не ставим

    local lv = root.CFrame.LookVector
    local flat = Vector3.new(lv.X, 0, lv.Z)
    local groundPos = Vector3.new(sidePos.X, ray.Position.Y + 0.03, sidePos.Z)
    local cf
    if flat.Magnitude > 0.01 then
        cf = CFrame.lookAt(groundPos, groundPos + flat.Unit)
    else
        cf = CFrame.new(groundPos)
    end
    spawnFootprint(cf)
end

