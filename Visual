                local bd = pickerBackdrop
                pickerBackdrop = nil
                tween(bd, { BackgroundTransparency = 1 }, 0.15)
                task.delay(0.16, function()
                    if bd then bd:Destroy() end
                end)
            end
            if pickerFrame then
                local pf = pickerFrame
                pickerFrame = nil
                tween(pf, { Size = UDim2.new(0, 220, 0, 0) }, 0.18, Enum.EasingStyle.Exponential, Enum.EasingDirection.In)
                task.delay(0.19, function()
                    if pf then pf:Destroy() end
                end)
            end
        end

        row.Activated:Connect(function()
            if pickerFrame then
                closePicker()
                return
            end

            local g = getGui()

            -- ── Backdrop dim (Frame, NOT TextButton — doesn't steal touch) ──
            pickerBackdrop = Instance.new("Frame")
            pickerBackdrop.Size = UDim2.new(1, 0, 1, 0)
            pickerBackdrop.Position = UDim2.new(0, 0, 0, 0)
            pickerBackdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            pickerBackdrop.BackgroundTransparency = 1
            pickerBackdrop.BorderSizePixel = 0
            pickerBackdrop.ZIndex = 600
            pickerBackdrop.Parent = g
            tween(pickerBackdrop, { BackgroundTransparency = 0.4 }, 0.15)

            pickerFrame = Instance.new("Frame")
            pickerFrame.Size = UDim2.new(0, 220, 0, 0)
            pickerFrame.Position = UDim2.new(0.5, -110, 0.5, 0)
            pickerFrame.BackgroundColor3 = THEME.Background
            pickerFrame.BorderSizePixel = 0
            pickerFrame.ZIndex = 650
            pickerFrame.Parent = g
            corner(pickerFrame, THEME.Corner)
            stroke(pickerFrame, THEME.BorderLight, 1.5, 0.15)

            -- Shadow
            local pickerShadow = Instance.new("UIStroke")
            pickerShadow.Color = Color3.fromRGB(0, 0, 0)
            pickerShadow.Thickness = 3
            pickerShadow.Transparency = 0.7
            pickerShadow.Parent = pickerFrame

            -- Animate in
            tween(pickerFrame, { Size = UDim2.new(0, 220, 0, 195), Position = UDim2.new(0.5, -110, 0.5, -97) }, 0.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

            -- SV picker area (TextButton so it receives InputBegan)
            local svArea = Instance.new("TextButton")
            svArea.Size = UDim2.new(0, 200, 0, 120)
            svArea.Position = UDim2.new(0, 10, 0, 10)
            svArea.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            svArea.BorderSizePixel = 0
            svArea.Text = ""
            svArea.AutoButtonColor = false
            svArea.ZIndex = 651
            svArea.Parent = pickerFrame
            corner(svArea, UDim.new(0, 4))

            -- Saturation gradient (white → transparent, left → right)
            local satGrad = Instance.new("UIGradient")
            satGrad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255))
            satGrad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 1),
            })
            satGrad.Parent = svArea

            -- Value gradient overlay (black, bottom → top, transparent → opaque)
            -- Using a separate Frame with Active=false so it doesn't block clicks
            local valOverlay = Instance.new("Frame")
            valOverlay.Size = UDim2.new(1, 0, 1, 0)
            valOverlay.BackgroundTransparency = 1
            valOverlay.ZIndex = 652
            valOverlay.Active = false
            valOverlay.Parent = svArea

            local valGrad = Instance.new("UIGradient")
            valGrad.Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(0,0,0))
            valGrad.Rotation = 90
            valGrad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0),
            })
            valGrad.Parent = valOverlay

            -- Hue slider
            local hueBar = Instance.new("TextButton")
            hueBar.Size = UDim2.new(0, 200, 0, 16)
            hueBar.Position = UDim2.new(0, 10, 0, 140)
            hueBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hueBar.BorderSizePixel = 0
            hueBar.Text = ""
            hueBar.AutoButtonColor = false
            hueBar.ZIndex = 651
            hueBar.Parent = pickerFrame
            corner(hueBar, UDim.new(0, 7))

            local hueGrad = Instance.new("UIGradient")
            hueGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1,    Color3.fromRGB(255, 0, 0)),
            })
            hueGrad.Parent = hueBar

            -- SV cursor indicator
            local svCursor = Instance.new("Frame")
            svCursor.Size = UDim2.new(0, 8, 0, 8)
            svCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            svCursor.BorderSizePixel = 0
            svCursor.ZIndex = 655
            svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
            svCursor.Position = UDim2.new(1, 0, 0, 0)
            svCursor.Parent = svArea
            corner(svCursor, UDim.new(0, 4))
            stroke(svCursor, Color3.fromRGB(0, 0, 0), 1, 0)

            -- Hue cursor indicator
            local hueCursor = Instance.new("Frame")
            hueCursor.Size = UDim2.new(0, 4, 0, 20)
            hueCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hueCursor.BorderSizePixel = 0
            hueCursor.ZIndex = 655
            hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
            hueCursor.Position = UDim2.new(0, 0, 0.5, 0)
            hueCursor.Parent = hueBar
            corner(hueCursor, UDim.new(0, 2))
            stroke(hueCursor, Color3.fromRGB(0, 0, 0), 1, 0)

            -- Initialize HSV from current color
            local h, s, v = Color3.toHSV(currentColor)
            if h == 0 and s == 0 and v == 1 then h = 0; s = 1; v = 1 end

            local function hsvToColor(hue, sat, val)
                return Color3.fromHSV(hue, sat, val)
            end

            local function updateColor()
                local col = hsvToColor(h, s, v)
                currentColor = col
                cBtn.BackgroundColor3 = col
                svArea.BackgroundColor3 = hsvToColor(h, 1, 1)
                svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
                if callback then task.spawn(function() callback(col) end) end
            end

            -- SV area interaction (mouse + touch)
            local svDragging = false
            local function updateSVFromInput(input)
                local mp = input.Position
                local ap = svArea.AbsolutePosition
                local as = svArea.AbsoluteSize
                s = math.clamp((mp.X - ap.X) / as.X, 0, 1)
                v = 1 - math.clamp((mp.Y - ap.Y) / as.Y, 0, 1)
                updateColor()
            end
            svArea.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    svDragging = true
                    updateSVFromInput(input)
                end
            end)
            local svMoveConn
            svMoveConn = UserInputService.InputChanged:Connect(function(input)
                if svDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSVFromInput(input)
                end
            end)
            local svEndConn
            svEndConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    svDragging = false
                end
            end)

            -- Hue interaction (mouse + touch)
            local hueDragging = false
            local function updateHueFromInput(input)
                local mp = input.Position
                local ap = hueBar.AbsolutePosition
                local as = hueBar.AbsoluteSize
                h = math.clamp((mp.X - ap.X) / as.X, 0, 1)
                updateColor()
            end
            hueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = true
                    updateHueFromInput(input)
                end
            end)
            local hueMoveConn
            hueMoveConn = UserInputService.InputChanged:Connect(function(input)
                if hueDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateHueFromInput(input)
                end
            end)
            local hueEndConn
            hueEndConn = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = false
                end
            end)

            -- Clean up move/end connections when picker closes
            local origClose = closePicker
            closePicker = function()
                if svMoveConn then svMoveConn:Disconnect() svMoveConn = nil end
                if svEndConn then svEndConn:Disconnect() svEndConn = nil end
                if hueMoveConn then hueMoveConn:Disconnect() hueMoveConn = nil end
                if hueEndConn then hueEndConn:Disconnect() hueEndConn = nil end
                origClose()
            end

            -- Close button
            local closeBtn = Instance.new("TextButton")
            closeBtn.Size = UDim2.new(0, 200, 0, 24)
            closeBtn.Position = UDim2.new(0, 10, 0, 162)
            closeBtn.BackgroundColor3 = THEME.Element
            closeBtn.BorderSizePixel = 0
            closeBtn.Text = "Close"
            closeBtn.Font = Enum.Font.GothamMedium
            closeBtn.TextSize = 12
            closeBtn.TextColor3 = THEME.TextDim
            closeBtn.AutoButtonColor = false
            closeBtn.ZIndex = 651
            closeBtn.Parent = pickerFrame
            corner(closeBtn, THEME.CornerSm)
            closeBtn.Activated:Connect(function()
                closePicker()
            end)

            -- Initial update to position cursors
            updateColor()

            -- Close when tapping outside (using UserInputService, not backdrop)
            task.wait(0.2)
            pickerCloseConn = UserInputService.InputBegan:Connect(function(input, processed)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if svDragging or hueDragging then return end -- don't close while dragging
                    local pos = input.Position
                    local pfPos = pickerFrame and pickerFrame.AbsolutePosition
                    local pfSize = pickerFrame and pickerFrame.AbsoluteSize
                    if pfPos and pfSize then
                        if pos.X >= pfPos.X and pos.X <= pfPos.X + pfSize.X
                           and pos.Y >= pfPos.Y and pos.Y <= pfPos.Y + pfSize.Y then
                            return -- inside picker, do nothing
                        end
                    end
                    closePicker()
                end
            end)
        end)

        local cpObj = {}
        function cpObj:SetColor(c)
            currentColor = c
            cBtn.BackgroundColor3 = c
        end
        function cpObj:GetColor() return currentColor end
        return cpObj
    end

