local function ensureGlowLoop()
	if glowConn then return end
	if not vis.Extra.Glow.Enabled then return end
	local baseBright = vis.Extra.Glow.Brightness
	local baseColor  = vis.Extra.Glow.Color
	glowConn = RunService.Heartbeat:Connect(function()
		if not vis.Extra.Glow.Enabled or not glowLight then return end
		local t = os.clock()
		if vis.Extra.Glow.Pulse then
			local pulse = 0.7 + math.sin(t * 2.2) * 0.3
			glowLight.Brightness = baseBright * pulse
		end
		if vis.Extra.Glow.ColorShift then
			local h, s, v = Color3.toHSV(baseColor)
			glowLight.Color = Color3.fromHSV((h + math.sin(t * 0.6) * 0.08) % 1, s, v)
		end
	end)
end

