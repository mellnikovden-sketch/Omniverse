        else
                fp = newNeonPart(Vector3.new(size, 0.06, size * 0.7), color, "Part")
        end
        fp.Anchored     = true
        fp.CanCollide   = false
        fp.CanQuery     = false
        fp.CanTouch     = false
        fp.CastShadow   = false
        fp.Material     = Enum.Material.Neon
        fp.Transparency = 0.1
        local rotY = math.random() * math.pi * 2
        fp.CFrame       = CFrame.new(pos) * CFrame.Angles(0, rotY, 0)
        fp.Parent       = fx
