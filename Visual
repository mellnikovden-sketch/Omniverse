-- ====================================================================
-- TAB SWITCHING
-- ====================================================================
local function switchTab(tabData)
    for _, t in ipairs(tabs) do
        if t.page ~= tabData.page then
            t.page.Visible = false
            tween(t.button, { BackgroundColor3 = THEME.Sidebar, TextColor3 = THEME.TextDim }, 0.15)
        end
    end
    tabData.page.Visible = true
    tween(tabData.button, { BackgroundColor3 = THEME.Element, TextColor3 = THEME.Text }, 0.15)
    activeTab = tabData
end

