-- Aura (теперь стили Nebula / Ring / Spiral реально различаются)
local function buildAura()
    safeDestroy(auraFolder)
    auraFolder = Instance.new("Folder")
    auraFolder.Name = "Aura"
    auraFolder.Parent = effectsFolder
    auraParts = {}
    local cfg = vis.Extra.Aura
    if not cfg.Enabled then return end
    local count = quantity(cfg.Count, 4)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    for i = 1, count do
        local a = (i / count) * math.pi * 2
        local r = cfg.Radius * (0.8 + math.random() * 0.4)
        local h = cfg.Height * (0.8 + math.random() * 0.4)
        local p = newPart(Vector3.new(0.2, 0.2, 0.2), cfg.Color:Lerp(lighten(cfg.Color, 0.3), i / count), Enum.PartType.Ball)
        p.Anchored = true
        p.Transparency = 0.1
        p.Parent = auraFolder
        if root then
            p.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a) * r, h, math.sin(a) * r))
        else
            p.CFrame = CFrame.new(0, -500, 0) -- прячем, пока персонаж не готов
        end
        table.insert(auraParts, {Part = p, Angle = a, Radius = r, Height = h, Speed = cfg.Speed, Seed = i / count})
    end
end

local function updateAura()
    if not auraFolder or not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local cfg = vis.Extra.Aura
    local pos = root.Position
    for _, item in ipairs(auraParts) do
        local a = item.Angle + animClock * item.Speed
        local x = math.cos(a) * item.Radius
        local z = math.sin(a) * item.Radius
        local y
        if cfg.Style == "Spiral" then
            y = ((animClock * item.Speed * 0.35 + item.Seed) % 1) * (item.Height * 2)
        elseif cfg.Style == "Ring" then
            y = item.Height
        else -- Nebula
            y = item.Height + math.sin(animClock * 2 + item.Angle) * 0.3
        end
        item.Part.CFrame = CFrame.new(pos + Vector3.new(x, y, z))
    end
end

