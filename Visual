local function playJumpEffect()
    if not vis.Jump.Enabled or not effectsFolder then return end
    local now = os.clock()
    if now - lastJumpTime < 0.15 then return end
    lastJumpTime = now
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos = root.Position - Vector3.new(0, 2.5, 0)
    local color = vis.Jump.Color
    local size = vis.Jump.Size
    local dur = vis.Jump.Duration
    local style = vis.Jump.Style

    if vis.Jump.Flash then
        local flash = newPart(Vector3.new(0.1, size * 0.4, size * 0.4), lighten(color, 0.4), Enum.PartType.Cylinder)
        flash.Anchored = true
        flash.Parent = effectsFolder
        flash.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
        TweenService:Create(flash, TweenInfo.new(dur * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Vector3.new(0.02, size * 1.2, size * 1.2),
            Transparency = 1
        }):Play()
        Debris:AddItem(flash, dur + 0.2)
    end

    if style == "Nova" then
        spawnRing(pos, size * 0.2, 0.1, color, dur, 1, 0)
        spawnRing(pos, size * 0.5, 0.05, lighten(color, 0.3), dur, -1, 0)
        spawnBurst(pos, color, size * 0.6, dur)
    elseif style == "DiamondRain" then
        spawnDiamondRain(pos, color, size, dur)
        spawnRing(pos, size * 0.1, 0.08, lighten(color, 0.5), dur * 0.8, 1, 0)
    elseif style == "Spiral" then
        spawnHelix(pos, color, size, dur, 3, 3)
        spawnRing(pos, size * 0.3, 0.06, color, dur, 1, 0)
    elseif style == "GalaxyRing" then
        spawnGalaxyRing(pos, color, size, dur)
        spawnBurst(pos, color, size * 0.3, dur * 0.7)
    elseif style == "LightningStrike" then
        spawnLightningStrike(pos, color, size, dur)
        spawnRing(pos, size * 0.2, 0.04, lighten(color, 0.4), dur, 1, 0)
    elseif style == "FeatherFall" then
        spawnFeatherFall(pos, color, size, dur)
        spawnRing(pos, size * 0.15, 0.03, color, dur, 1, 0)
    elseif style == "ShadowBurst" then
        spawnShadowBurst(pos, color, size, dur)
    elseif style == "CrystalShards" then
        for i = 1, 20 do
            local p = newPart(Vector3.new(0.1, 0.3, 0.1), color:Lerp(lighten(color, 0.3), i / 20), Enum.PartType.Block)
            p.Anchored = true
            p.Parent = effectsFolder
            local a = math.random() * math.pi * 2
            local r = size * (0.2 + math.random() * 0.8)
            p.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, a, math.random() * 6)
            TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, 1 + math.random() * 3, math.sin(a) * r)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
                Size = Vector3.new(0.02, 0.06, 0.02),
                Transparency = 1
            }):Play()
            Debris:AddItem(p, dur + 0.2)
        end
        spawnRing(pos, size * 0.2, 0.06, lighten(color, 0.4), dur, 1, 0)
    elseif style == "StarBurst" then
        for i = 1, 12 do
            local a = (i / 12) * math.pi * 2
            local p = newPart(Vector3.new(0.08, 0.08, size * 0.6), color:Lerp(Color3.fromRGB(255, 255, 200), i / 12))
            p.Anchored = true
            p.Parent = effectsFolder
            p.CFrame = CFrame.new(pos) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.2, -size * 0.2)
            TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = CFrame.new(pos) * CFrame.Angles(0, a + 1.2, 0) * CFrame.new(0, 1.2, -size * 1.2),
                Size = Vector3.new(0.02, 0.02, size * 1.2),
                Transparency = 1
            }):Play()
            Debris:AddItem(p, dur + 0.2)
        end
        spawnBurst(pos, color, size * 0.4, dur)
    elseif style == "Wave" then
        for i = 1, 5 do
            local rad = size * (0.1 + i * 0.12)
            spawnRing(pos, rad, 0.04, color:Lerp(lighten(color, 0.2), i / 5), dur * (1 + i * 0.1), (i % 2 == 0 and 1 or -1), math.rad(i * 5))
        end
    elseif style == "Tornado" then
        spawnHelix(pos, color, size, dur, 5, 4)
        spawnBurst(pos, color, size * 0.2, dur * 0.8)
    elseif style == "MeteorShower" then
        for i = 1, 10 do
            local a = math.random() * math.pi * 2
            local r = size * (0.5 + math.random() * 0.5)
            local p = newPart(Vector3.new(0.15, 0.15, 0.15), color:Lerp(Color3.fromRGB(255, 200, 100), math.random()), Enum.PartType.Ball)
            p.Anchored = true
            p.Parent = effectsFolder
            p.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, math.random() * 0.5, math.sin(a) * r))
            TweenService:Create(p, TweenInfo.new(dur * 1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = p.CFrame + Vector3.new((math.random() - 0.5) * 5, -2 - math.random() * 3, (math.random() - 0.5) * 5),
                Transparency = 1,
                Size = Vector3.new(0.03, 0.03, 0.03)
            }):Play()
            Debris:AddItem(p, dur + 0.2)
        end
    end

    if vis.Jump.Sparks then
        spawnBurst(pos, color, size * 0.3, dur * 0.7)
    end
end

