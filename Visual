		-- sharp glowing tip
		local tip = newNeonPart(Vector3.new(0.06 * size, 0.9 * size, 0.06 * size), light)
		tip.Transparency = 0.05
		tip.Parent = hatFolder
		local tweld = weldTo(headPart, tip, CFrame.new(0, 4.2 * size, 0))
		table.insert(hatParts, { Weld = tweld, Kind = "seg", Angle = 0, Radius = 0, Height = 4.2 * size, Tilt = 0 })
		-- base glow ring
		segRing(1.7 * size, 1.7 * size, 20, 0.07 * size, 0, 0)
		orbs(6, 1.5 * size, 1.7 * size, 0.1 * size, 0)
	else
		-- Layered: ступенчатая пагода — 8 ярусов + орб-шпиль + кольца + подвески
		local steps = 5
		for index = 1, steps do
			local ratio  = (index - 1) / (steps - 1)
			local radius = (2.8 - ratio * 2.3) * size
			local height = (1.78 + ratio * 1.8) * size
			disc(radius, height, 0.16 * size, 0.2, colAt(ratio))
			segRing(radius + 0.04 * size, height, 26 - index * 2, 0.06 * size, 0, 0)
		end
		disc(0.2 * size, 3.9 * size, 0.4 * size, 0.04, light)
		orbs(1, 0, 4.2 * size, 0.32 * size, 0)
		pendants(8, 2.7 * size, 1.75 * size, 0.35 * size)
	end

	-- ===== NEW FEATURE: ChinaHat.Crest — glowing energy crest rising above the hat apex =====
	if vis.ChinaHat.Crest then
		local apexH = 3.9 * size        -- hat apex height
		local crestCount = IS_PHONE and 4 or 6
		for i = 1, crestCount do
			local ratio = (i - 1) / (crestCount - 1)
			local discR = (0.55 - ratio * 0.35) * size
			local discH = apexH + 0.35 * size + ratio * 0.55 * size
			local ccol  = colAt(ratio)
			local d = newNeonPart(Vector3.new(0.05 * size, discR * 2, discR * 2), ccol, "Part")
			d.Shape = Enum.PartType.Cylinder
			d.Material = Enum.Material.Neon
			d.Transparency = 0.15 + ratio * 0.1
			d.Parent = hatFolder
			local weld = Instance.new("Weld")
			weld.Part0 = headPart
			weld.Part1 = d
			weld.C0 = CFrame.new(0, discH, 0)
			weld.C1 = CFrame.Angles(0, 0, math.rad(90))
			weld.Parent = d
			table.insert(hatParts, { Weld = weld, Kind = "crest", Height = discH, Index = i, Total = crestCount, BaseRadius = discR, DiscThick = 0.05 * size, BobScale = 0.06 * size })
		end
		-- glowing core orb at the very top of the crest
		local coreR = 0.22 * size
		local coreOrb = newNeonPart(Vector3.new(coreR, coreR, coreR), lighten(color, 0.4), "Part")
		coreOrb.Shape = Enum.PartType.Ball
		coreOrb.Material = Enum.Material.Neon
		coreOrb.Transparency = 0.05
		coreOrb.Parent = hatFolder
		local cweld = Instance.new("Weld")
		cweld.Part0 = headPart
		cweld.Part1 = coreOrb
		cweld.C0 = CFrame.new(0, apexH + 0.35 * size + 0.55 * size + 0.18 * size, 0)
		cweld.Parent = coreOrb
		table.insert(hatParts, { Weld = cweld, Kind = "crestCore", Height = apexH + 0.35 * size + 0.55 * size + 0.18 * size, CoreSize = 0.22 * size, BobScale = 0.1 * size })
		-- small orbiting motes around the crest
		local moteCount = IS_PHONE and 4 or 6
		for i = 1, moteCount do
			local mr = 0.07 * size
			local m = newNeonPart(Vector3.new(mr, mr, mr), lighten(colAt(i / moteCount), 0.5), "Part")
			m.Shape = Enum.PartType.Ball
			m.Material = Enum.Material.Neon
			m.Transparency = 0.1
			m.Parent = hatFolder
			local mw = Instance.new("Weld")
			mw.Part0 = headPart
			mw.Part1 = m
			mw.C0 = CFrame.new(0, apexH + 0.6 * size, 0)
			mw.Parent = m
			table.insert(hatParts, { Weld = mw, Kind = "crestMote", Height = apexH + 0.6 * size, Angle = (i / moteCount) * math.pi * 2, Radius = 0.5 * size, BobScale = 0.08 * size })
		end
	end

	if vis.ChinaHat.Glow then
		local pointLight = Instance.new("PointLight")
		pointLight.Color      = color
		pointLight.Brightness = 1.8
		pointLight.Range      = 11
		pointLight.Name       = "CrystalHub_HatGlow"
		pointLight.Parent     = headPart
	end
end

--======================================================================--
--                        ОБЩИЙ ЦИКЛ АНИМАЦИИ                           --
--======================================================================--
local function stopLoopIfIdle()
	if #wingParts == 0 and #haloParts == 0 and #hatParts == 0 and animConnection then
		animConnection:Disconnect()
		animConnection = nil
	end
end

local FLAP_STEP = 1 / 30 -- взмах на 30 Гц: глазу хватает, кадрам легче

local function ensureLoop()
	if animConnection then
		return
	end
	animConnection = RunService.Heartbeat:Connect(function(delta)
		animClock = animClock + delta

		-- Idle Spin: плавно вращает визуалы (нимб/hat) вокруг вертикальной оси
		if vis.Extra.IdleSpin.Enabled then
			idleSpinAngle = idleSpinAngle + delta * vis.Extra.IdleSpin.Speed
		end
		-- Wobble: покачивание (наклон) для Idle Spin
		local idleWobble = 0
		if vis.Extra.IdleSpin.Enabled and vis.Extra.IdleSpin.Wobble then
			idleWobble = math.sin(animClock * 1.8) * math.rad(12)
		end

		flapAccum = flapAccum + delta
		if #wingParts > 0 and flapAccum >= FLAP_STEP then
			flapAccum = 0
			if vis.Wings.Flap then
				flapReset = false
				for _, item in ipairs(wingParts) do
					local flap = math.sin(animClock * 2.6 + item.Phase) * (item.Amp or 0.13)
					item.Weld.C0 = item.Origin * CFrame.Angles(0, 0, flap) * item.Offset
				end
			elseif not flapReset then
				-- один раз вернуть крылья в исходное положение, а не бросать их
				-- застывшими в середине взмаха
				flapReset = true
				for _, item in ipairs(wingParts) do
					item.Weld.C0 = item.Origin * item.Offset
				end
			end
		end

		for _, item in ipairs(haloParts) do
			local angle  = item.Angle + animClock * vis.Halo.Speed * item.Direction
			if vis.Extra.IdleSpin.Enabled then angle = angle + idleSpinAngle end
			local height = item.Height
			if item.Bob then
				height = height + math.sin(animClock * 2 + item.Bob) * 0.08
			end
			item.Weld.C0 = CFrame.new(item.OffsetX or 0, height, 0)
				* CFrame.Angles(item.Tilt + idleWobble, angle, 0)
				* CFrame.new(0, 0, -item.Radius)
				* CFrame.Angles(0, math.rad(90), 0)
		end

		if #hatParts > 0 then
			local spin = animClock * (vis.ChinaHat.Spin or 0)
			if vis.Extra.IdleSpin.Enabled then spin = spin + idleSpinAngle end
			for _, item in ipairs(hatParts) do
				if item.Kind == "disc" then
					item.Weld.C0 = CFrame.new(0, item.Height, 0)
						* CFrame.Angles(idleWobble, spin, 0)
						* CFrame.Angles(0, 0, math.rad(90))
				elseif item.Kind == "spike" then
					item.Weld.C0 = CFrame.new(0, item.Height, 0)
						* CFrame.Angles(0, item.Angle + spin, 0)
						* CFrame.new(0, 0, -item.Radius)
				elseif item.Kind == "crest" then
					local pulse = 1 + math.sin(animClock * 3 + item.Index * 0.7) * 0.18
					local bob = math.sin(animClock * 2 + item.Index * 0.5) * (item.BobScale or 0.06)
					local r = item.BaseRadius * pulse
					item.Weld.C0 = CFrame.new(0, item.Height + bob, 0)
						* CFrame.Angles(idleWobble, spin + animClock * 1.5, 0)
						* CFrame.Angles(0, 0, math.rad(90))
					if item.Weld.Part1 then
						item.Weld.Part1.Size = Vector3.new(item.DiscThick or 0.05, r * 2, r * 2)
						item.Weld.Part1.Transparency = 0.15 + (item.Index / item.Total) * 0.1 + math.sin(animClock * 4 + item.Index) * 0.08
					end
				elseif item.Kind == "crestCore" then
					local pulse = 1 + math.sin(animClock * 4) * 0.22
					local bob = math.sin(animClock * 1.5) * (item.BobScale or 0.1)
					item.Weld.C0 = CFrame.new(0, item.Height + bob, 0)
					if item.Weld.Part1 then
						local s = (item.CoreSize or 0.22) * pulse
						item.Weld.Part1.Size = Vector3.new(s, s, s)
						item.Weld.Part1.Transparency = 0.05 + math.sin(animClock * 5) * 0.12
					end
				elseif item.Kind == "crestMote" then
					local a = item.Angle + animClock * 2.5
					local bob = math.sin(animClock * 3 + item.Angle * 2) * (item.BobScale or 0.08)
					item.Weld.C0 = CFrame.new(0, item.Height + bob, 0)
						* CFrame.Angles(0, a, 0)
						* CFrame.new(0, 0, -item.Radius)
				else
					item.Weld.C0 = CFrame.new(0, item.Height, 0)
						* CFrame.Angles(item.Tilt, item.Angle + spin, 0)
						* CFrame.new(0, 0, -item.Radius)
						* CFrame.Angles(0, math.rad(90), 0)
				end
			end
		end
	end)
end

--------------------------------------------------- привязка к персонажу
-- R6 не имеет UpperTorso: раньше здесь висело ожидание на 5 секунд,
-- теперь смотрим RigType и ждём ровно ту часть, которая существует
local function findTorso(char, human)
	local rig = human and human.RigType
	if rig == Enum.HumanoidRigType.R6 then
		return char:FindFirstChild("Torso") or char:WaitForChild("Torso", 3)
	end
	return char:FindFirstChild("UpperTorso") or char:WaitForChild("UpperTorso", 3)
end

