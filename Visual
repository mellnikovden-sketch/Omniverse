local function clearHalo()
	if haloFolder then haloFolder:Destroy() end haloFolder, haloParts = nil, {}
	if headPart then for _, child in ipairs(headPart:GetChildren()) do if child.Name == "CrystalHub_HaloGlow" then child:Destroy() end end end
end

local function buildHalo()
	clearHalo()
	if not vis.Halo.Enabled or not headPart then return end
	haloFolder = Instance.new("Folder") haloFolder.Name = "CrystalHub_Halo" haloFolder.Parent = character
	local color, style = vis.Halo.Color, vis.Halo.Style
	
	local function smoothRing(r, h, segs, tlt, dir, th)
		local segL = (2 * math.pi * r / segs) * 1.12
		for i = 1, segs do
			local a = (i / segs) * math.pi * 2
			local p = newNeonPart(Vector3.new(th, th, segL), color)
			p.Parent = haloFolder
			table.insert(haloParts, { Weld = weldTo(headPart, p, CFrame.new(0, h, 0) * CFrame.Angles(tlt, a, 0) * CFrame.new(0, 0, -r) * CFrame.Angles(0, math.rad(90), 0)), Angle = a, Radius = r, Height = h, Tilt = tlt, Direction = dir })
		end
	end

	if style == "Double" then
		smoothRing(0.9, 1.55, 20, 0, 1, 0.08) smoothRing(1.15, 1.5, 16, 0, -1, 0.05)
	elseif style == "Tilted" then
		smoothRing(0.95, 1.6, 20, math.rad(25), 1, 0.08) smoothRing(0.75, 1.8, 16, math.rad(-35), -1, 0.06)
	else
		smoothRing(0.9, 1.6, 22, 0, 1, 0.07)
	end
	if vis.Halo.Glow then
		local pl = Instance.new("PointLight") pl.Color, pl.Brightness, pl.Range, pl.Shadows, pl.Name, pl.Parent = color, 1.6, 9, false, "CrystalHub_HaloGlow", headPart
	end
end

