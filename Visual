local function trailColorSeq(style, color, color2)
	local c2 = color2 or color
	local light = lighten(color, 0.35)
	local dark  = darken(color, 0.35)
	if style == "Fire" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.4)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   darken(color, 0.5)),
		})
	elseif style == "Comet" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.4, color),
			ColorSequenceKeypoint.new(1,   darken(color, 0.6)),
		})
	elseif style == "Pastel" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,    lighten(color, 0.55)),
			ColorSequenceKeypoint.new(0.3,  lighten(color, 0.3)),
			ColorSequenceKeypoint.new(0.5,  lighten(c2, 0.5)),
			ColorSequenceKeypoint.new(0.7,  lighten(c2, 0.3)),
			ColorSequenceKeypoint.new(1,    color:Lerp(c2, 0.5)),
		})
	elseif style == "Dark" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.15)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.7, darken(color, 0.4)),
			ColorSequenceKeypoint.new(1,   Color3.fromRGB(10, 10, 15)),
		})
	elseif style == "Crystal" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.4)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   color:Lerp(c2, 0.6)),
		})
	elseif style == "Candy" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,    lighten(color, 0.2)),
			ColorSequenceKeypoint.new(0.25, color),
			ColorSequenceKeypoint.new(0.5,  lighten(c2, 0.3)),
			ColorSequenceKeypoint.new(0.75, lighten(color, 0.15)),
			ColorSequenceKeypoint.new(1,    lighten(color, 0.35)),
		})
	elseif style == "Galaxy" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   darken(color, 0.4)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.6, c2),
			ColorSequenceKeypoint.new(1,   darken(c2, 0.5)),
		})
	elseif style == "Phoenix" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.5)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.7, darken(color, 0.2)),
			ColorSequenceKeypoint.new(1,   Color3.fromRGB(40, 10, 0)),
		})
	elseif style == "Nebula" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   color:Lerp(c2, 0.2)),
			ColorSequenceKeypoint.new(0.25, lighten(color, 0.25)),
			ColorSequenceKeypoint.new(0.5, c2),
			ColorSequenceKeypoint.new(0.75, lighten(c2, 0.25)),
			ColorSequenceKeypoint.new(1,   color:Lerp(c2, 0.8)),
		})
	elseif style == "Rainbow-Galaxy" then
		-- handled dynamically by rainbow loop; fallback gradient
		return ColorSequence.new({ ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(0.5, c2), ColorSequenceKeypoint.new(1, color) })
	elseif style == "Toxic-Slime" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   Color3.fromRGB(180, 255, 60)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   darken(color, 0.6)),
		})
	elseif style == "Vortex" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.4)),
			ColorSequenceKeypoint.new(0.33, color),
			ColorSequenceKeypoint.new(0.66, c2),
			ColorSequenceKeypoint.new(1,   lighten(c2, 0.4)),
		})
	elseif style == "Ghost-Trail" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.6)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   Color3.fromRGB(220, 220, 240):Lerp(lighten(c2, 0.3), 0.4)),
		})
	elseif style == "Rainbow-Dual" then
		-- handled dynamically by rainbow loop; fallback gradient
		return ColorSequence.new({ ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(0.5, c2), ColorSequenceKeypoint.new(1, color) })
	else -- Neon / Rainbow: яркая вспышка → основной цвет → мягкий переход
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.3)),
			ColorSequenceKeypoint.new(0.2, color),
			ColorSequenceKeypoint.new(0.7, c2 or color),
			ColorSequenceKeypoint.new(1,   darken(c2 or color, 0.2)),
		})
	end
end

local function trailTransSeq(style)
	if style == "Fire" then
		return NumberSequence.new({
