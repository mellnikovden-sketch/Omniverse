local function clearTrails()
	if trailConn then trailConn:Disconnect() trailConn = nil end
	if trailFolder then trailFolder:Destroy() trailFolder = nil end
	if trailAtt0 then trailAtt0:Destroy() trailAtt0 = nil end
	if trailAtt1 then trailAtt1:Destroy() trailAtt1 = nil end
	mainTrail = nil
end

local function buildTrails()
	clearTrails()
	if not trSet.Enabled or not character then return end
	local root = character:FindFirstChild("HumanoidRootPart") if not root then return end
	
	trailFolder = Instance.new("Folder") trailFolder.Name = "CH_Trails" trailFolder.Parent = ensureFolder()
	trailAtt0, trailAtt1 = Instance.new("Attachment", root), Instance.new("Attachment", root)
	trailAtt0.Position, trailAtt1.Position = Vector3.new(0, 1, 0), Vector3.new(0, -1, 0)
	
	mainTrail = Instance.new("Trail", trailFolder)
	mainTrail.Attachment0, mainTrail.Attachment1, mainTrail.Lifetime, mainTrail.LightEmission = trailAtt0, trailAtt1, trSet.Lifetime, 1
	mainTrail.Color = ColorSequence.new(trSet.Color, trSet.Color2)
	mainTrail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, trSet.Width), NumberSequenceKeypoint.new(1, 0)})
	
	trailConn = RunService.Heartbeat:Connect(function(dt)
		if not trSet.Enabled or not humanoid then return end
		if trSet.PulseWidth then
			local pulse = trSet.Width * (0.5 + math.abs(math.sin(os.clock() * 5)) * 0.5)
			mainTrail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, pulse), NumberSequenceKeypoint.new(1, 0)})
		end
		if trSet.EmitSparks and humanoid.MoveDirection.Magnitude > 0.1 and math.random() > 0.7 then
			local sp = createShape("Ball", Vector3.new(0.15,0.15,0.15), trSet.Color2, 0.1)
			sp.CFrame, sp.Parent = root.CFrame * CFrame.new(math.random(-1,1), -2, math.random(-1,1)), trailFolder
			TweenService:Create(sp, TweenInfo.new(1), { Size = Vector3.new(0,0,0), CFrame = sp.CFrame * CFrame.new(0, 2, 0) }):Play()
			Debris:AddItem(sp, 1)
		end
	end)
end

