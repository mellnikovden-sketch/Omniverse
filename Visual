        para.ZIndex = 104
        para.Parent = page
        corner(para, THEME.CornerSm)
        stroke(para, THEME.Border, 1, 0.6)
        padding(para, 8, 8, 10, 10)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 16)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.Text = title
        lbl.TextSize = IS_PHONE and 11 or 12
        lbl.TextColor3 = THEME.AccentLight
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 105
        lbl.Parent = para

        local bodyLbl = Instance.new("TextLabel")
        bodyLbl.Size = UDim2.new(1, 0, 0, 0)
        bodyLbl.Position = UDim2.new(0, 0, 0, 18)
        bodyLbl.BackgroundTransparency = 1
        bodyLbl.Font = Enum.Font.Gotham
        bodyLbl.Text = body
        bodyLbl.TextSize = IS_PHONE and 10 or 11
        bodyLbl.TextColor3 = THEME.TextDim
        bodyLbl.TextWrapped = true
        bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
        bodyLbl.AutomaticSize = Enum.AutomaticSize.Y
        bodyLbl.ZIndex = 105
        bodyLbl.Parent = para

        return para
    end

    return section
end

-- ====================================================================
-- NOTIFY
-- ====================================================================
local notifyCount = 0
local function notify(text, duration)
    duration = duration or 3
    local g = getGui()
    notifyCount = notifyCount + 1
    local slot = notifyCount

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 260, 0, 0)
    notif.Position = UDim2.new(1, -280, 1, -20)
    notif.BackgroundColor3 = THEME.Element
    notif.BackgroundTransparency = 0.05
    notif.BorderSizePixel = 0
    notif.ZIndex = 800
    notif.Parent = g
    corner(notif, THEME.Corner)
    stroke(notif, THEME.Accent, 1.5, 0.15)
    padding(notif, 10, 10, 14, 14)

    -- Accent dot
    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 6, 0, 6)
    dot.Position = UDim2.new(0, 0, 0.5, -3)
    dot.BackgroundColor3 = THEME.AccentLight
    dot.BorderSizePixel = 0
    dot.ZIndex = 801
    dot.Parent = notif
    corner(dot, UDim.new(1, 0))

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -12, 0, 16)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.Text = tostring(text)
    lbl.TextSize = 13
    lbl.TextColor3 = THEME.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 801
    lbl.Parent = notif

    -- Animate in
    tween(notif, { Size = UDim2.new(0, 260, 0, 38), Position = UDim2.new(1, -280, 1, -20 - (slot * 46)) }, 0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

    -- Animate out
    task.delay(duration, function()
        local t = tween(notif, { Size = UDim2.new(0, 0, 0, 38), Position = UDim2.new(1, -10, 1, -20 - (slot * 46)) }, 0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.In)
        t.Completed:Wait()
        notif:Destroy()
        notifyCount = notifyCount - 1
    end)
end

