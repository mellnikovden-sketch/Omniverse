--  ОБНОВЛЕНИЕ ВСЕХ ДОПОЛНИТЕЛЬНЫХ ФИЧ (один Heartbeat-цикл)
-- ============================================================
local function updateExtras(dt)
    -- Ambient Glow (пульс / сдвиг цвета обрабатываются здесь, без лишних соединений)
    local glowCfg = vis.Extra.Glow
    if glowCfg.Enabled and glowLight then
        if glowCfg.Pulse then
            glowLight.Brightness = glowCfg.Brightness * (0.7 + math.sin(animClock * 2.2) * 0.3)
        else
            glowLight.Brightness = glowCfg.Brightness
        end
        if glowCfg.ColorShift then
            local h, s, v = Color3.toHSV(glowCfg.Color)
            glowLight.Color = Color3.fromHSV((h + math.sin(animClock * 0.6) * 0.08) % 1, s, v)
        else
            glowLight.Color = glowCfg.Color
        end
        glowLight.Range = glowCfg.Range
    end

    if vis.Extra.Aura.Enabled then updateAura() end
    if vis.Extra.Shield.Enabled then updateShield() end
    if vis.Extra.WeaponGlow.Enabled then updateWeaponGlow() end
    if vis.Extra.Pet.Enabled then updatePet() end
    if vis.Extra.Footprints.Enabled then updateFootprints(dt) end
    if vis.Halo.Enabled and vis.Halo.Aura then updateHaloAura() end
end

