local function clearHaloAura()
    safeDestroy(haloAuraFolder)
    haloAuraFolder = nil
    haloAuraParts = {}
end

local function buildHaloAura()
    clearHaloAura()
    if not vis.Halo.Enabled or not vis.Halo.Aura or not headPart then return end
    haloAuraFolder = Instance.new("Folder")
    haloAuraFolder.Name = "HaloAura"
    haloAuraFolder.Parent = effectsFolder
    haloAuraParts = {}
    local count = quantity(10, 4)
    for i = 1, count do
        local p = newPart(Vector3.new(0.12, 0.12, 0.12), lighten(vis.Halo.Color, 0.35), Enum.PartType.Ball)
        p.Anchored = true
        p.Transparency = 0.2
        p.Parent = haloAuraFolder
        table.insert(haloAuraParts, {
            Part = p,
            Angle = (i / count) * math.pi * 2,
            Radius = 1.3 + math.random() * 0.3,
            Phase = math.random() * 6.28
        })
    end
end

local function updateHaloAura()
    if not haloAuraFolder or not headPart then return end
    local base = headPart.Position
    for _, item in ipairs(haloAuraParts) do
        local a = item.Angle + animClock * vis.Halo.Speed * 1.4
        local fall = (animClock * 0.9 + item.Phase) % 1
        item.Part.CFrame = CFrame.new(base + Vector3.new(math.cos(a) * item.Radius, 2.6 - fall * 1.6, math.sin(a) * item.Radius))
        item.Part.Transparency = 0.2 + fall * 0.6
    end
end

