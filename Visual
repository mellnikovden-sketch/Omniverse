            else
                toggle.BackgroundColor3 = state and THEME.ToggleOn or THEME.ToggleOff
                knob.Position = UDim2.new(0, state and 21 or 3, 0.5, -8)
                toggleStroke.Color = state and THEME.AccentLight or THEME.Border
            end
            if callback then
                task.spawn(function() callback(state) end)
            end
        end

        -- Click on the entire row toggles
        row.Activated:Connect(function()
            setState(not state, true)
        end)

        -- Return a table with SetValue method
        local toggleObj = {}
        function toggleObj:SetValue(val) setState(val, true) end
        function toggleObj:GetValue() return state end
        return toggleObj
    end

    -- ════════ ADD SLIDER ════════════════════════════════════════════════
    function section:AddSlider(label, minVal, maxVal, default, callback)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 50)
        row.BackgroundColor3 = THEME.Element
        row.BackgroundTransparency = 0.1
        row.BorderSizePixel = 0
