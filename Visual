function VisualEffects:_buildTrails()
    local component = self:_newComponent("Trails")
    local config = self.Settings.Trails
    if not config.Enabled or not self.Root then
        return
    end

    local top = self:_newAttachment(component, self.Root, "VisualTrailTop", Vector3.new(0, 1.0, 0))
    local bottom = self:_newAttachment(component, self.Root, "VisualTrailBottom", Vector3.new(0, -1.0, 0))
    local trail = Instance.new("Trail")
    trail.Name = "VisualTrail"
    trail.Attachment0 = top
    trail.Attachment1 = bottom
    trail.Lifetime = math.clamp(config.Lifetime, 0.05, 3)
    trail.FaceCamera = true
    trail.LightEmission = 1
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, config.Color),
        ColorSequenceKeypoint.new(0.5, config.Color2),
        ColorSequenceKeypoint.new(1, config.Color),
    })

    if config.Style == "Wavy" then
        trail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, config.Width * 0.55),
            NumberSequenceKeypoint.new(0.5, config.Width * 1.25),
            NumberSequenceKeypoint.new(1, config.Width * 0.1),
        })
    elseif config.Style == "Soft" then
        trail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, config.Width * 0.8),
            NumberSequenceKeypoint.new(1, 0),
        })
    else
        trail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, config.Width),
            NumberSequenceKeypoint.new(1, 0),
        })
    end
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, config.Style == "Soft" and 0.4 or 0.08),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.Parent = self.Root
    self:_track(component, trail)

    if config.Echo then
        local echoTop = self:_newAttachment(component, self.Root, "VisualTrailEchoTop", Vector3.new(0, 2.15, 0))
        local echoBottom = self:_newAttachment(component, self.Root, "VisualTrailEchoBottom", Vector3.new(0, 1.2, 0))
        local echo = Instance.new("Trail")
        echo.Name = "VisualTrailEcho"
        echo.Attachment0 = echoTop
        echo.Attachment1 = echoBottom
        echo.Lifetime = math.clamp(config.Lifetime * 1.5, 0.05, 3)
        echo.FaceCamera = true
        echo.LightEmission = 1
        echo.Color = ColorSequence.new(lighten(config.Color, 0.25), config.Color2)
        echo.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, config.Width * 0.5), NumberSequenceKeypoint.new(1, 0) })
        echo.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
        echo.Parent = self.Root
        self:_track(component, echo)
    end
end

function VisualEffects:_buildGlow()
    local component = self:_newComponent("Glow")
    local config = self.Settings.Extra.Glow
    if config.Enabled and self.Torso then
        self:_addPointLight(component, self.Torso, config.Color, config.Brightness, config.Range, "AmbientGlow")
    end
end

function VisualEffects:_updateAmbientGlow()
    local component = self.Components.Glow
    local config = self.Settings.Extra.Glow
    if component and config.Enabled then
        for _, instance in ipairs(component.instances) do
            if instance:IsA("PointLight") then
                instance.Brightness = config.Brightness * (config.Pulse and (0.78 + math.sin(self.Time * 2.2) * 0.22) or 1)
                if config.ColorShift then
                    local hue, saturation, value = Color3.toHSV(config.Color)
                    instance.Color = Color3.fromHSV((hue + math.sin(self.Time * 0.6) * 0.08) % 1, saturation, value)
                else
                    instance.Color = config.Color
                end
            end
        end
    end

    local trails = self.Components.Trails
    if self.Settings.Trails.Enabled and self.Settings.Trails.Rainbow and trails then
        local hue = (self.Time * 0.18) % 1
        for _, instance in ipairs(trails.instances) do
            if instance:IsA("Trail") then
                instance.Color = ColorSequence.new(Color3.fromHSV(hue, 0.9, 1), Color3.fromHSV((hue + 0.48) % 1, 0.9, 1))
            end
        end
    end
end

