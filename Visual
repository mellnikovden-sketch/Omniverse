-- ===== Ambient Glow: динамический PointLight с дыханием и переливом цвета =====
local function buildGlow()
        if not torso then return end
        if glowLight then glowLight:Destroy() end
        glowLight = Instance.new("PointLight")
        glowLight.Name        = "CrystalHub_AmbientGlow"
        glowLight.Color       = vis.Extra.Glow.Color
        glowLight.Range       = vis.Extra.Glow.Range
        glowLight.Brightness  = vis.Extra.Glow.Brightness
        glowLight.Shadows     = false
        glowLight.Parent      = torso
end

local function clearGlow()
        if glowConn then
                glowConn:Disconnect()
                glowConn = nil
        end
        if glowLight then
                glowLight:Destroy()
                glowLight = nil
        end
end

local function ensureGlowLoop()
        if glowConn then return end
        if not vis.Extra.Glow.Enabled then return end
        local baseBright = vis.Extra.Glow.Brightness
        local baseColor  = vis.Extra.Glow.Color
        glowConn = RunService.Heartbeat:Connect(function(dt)
                if not vis.Extra.Glow.Enabled or not glowLight then return end
                local t = os.clock()
                -- дыхание: яркость пульсирует синусоидой
                if vis.Extra.Glow.Pulse then
                        local pulse = 0.7 + math.sin(t * 2.2) * 0.3
                        glowLight.Brightness = baseBright * pulse
                        glowLight.Range = vis.Extra.Glow.Range * (0.88 + math.sin(t * 2.2) * 0.12)
                end
                -- перелив цвета: лёгкий сдвиг по HSV
                if vis.Extra.Glow.ColorShift then
                        local h, s, v = Color3.toHSV(baseColor)
                        local shifted = Color3.fromHSV((h + math.sin(t * 0.6) * 0.08) % 1, s, v)
                        glowLight.Color = shifted
                end
        end)
end

function Visuals.SetGlow(enabled)
        vis.Extra.Glow.Enabled = enabled and true or false
        if vis.Extra.Glow.Enabled then
                buildGlow()
                ensureGlowLoop()
        else
                clearGlow()
        end
end

-- ===== Floating Aura: разнообразные частицы (шары/ромбы/кольца) по орбите =====
local AURA_SHAPES = { "Ball", "Diamond", "Ring", "Star", "Cube", "Ball", "Diamond" }

local function buildAura()
        if auraFolder then auraFolder:Destroy() end
        auraFolder = Instance.new("Folder")
        auraFolder.Name   = "CrystalHub_Aura"
        auraFolder.Parent = ensureFolder()
        auraParts = {}
        if not character then return end
        local root = character:FindFirstChild("HumanoidRootPart") or torso
        if not root then return end
        local cfg = vis.Extra.Aura
        local baseColor = cfg.Color
        local count = IS_PHONE and math.max(4, math.floor(cfg.Count * 0.5)) or cfg.Count

        -- ===== Ground ring: пульсирующее кольцо на земле =====
        local ringParts = {}
        local ringSegs = IS_PHONE and 16 or 28
        for i = 1, ringSegs do
                local angle = (i / ringSegs) * math.pi * 2
                local t = (i - 1) / ringSegs
                local segLen = (2 * math.pi * cfg.Radius * 1.4 / ringSegs) * 1.15
                local seg = newNeonPart(Vector3.new(0.06, 0.06, segLen), baseColor, "Part")
                seg.Anchored = true
                seg.CanCollide = false
                seg.CanQuery = false
                seg.CanTouch = false
                seg.CastShadow = false
                seg.Material = Enum.Material.Neon
                seg.Transparency = 0.15
                seg.Parent = auraFolder
                table.insert(ringParts, { part = seg, angle = angle })
        end

        -- ===== Orbital particles: main layer =====
        for i = 1, count do
                local shape = cfg.Shape or "Mixed"
                local partType = "Part"
                local sz = 0.2 + (i % 3) * 0.08
                if shape == "Mixed" then
                        shape = AURA_SHAPES[((i - 1) % #AURA_SHAPES) + 1]
                end
                local subParts = {}
                local orb
                if shape == "Ball" then
                        orb = newNeonPart(Vector3.new(sz, sz, sz), baseColor, "Part")
                        orb.Shape = Enum.PartType.Ball
                        orb.Size = Vector3.new(sz, sz, sz)
                        table.insert(subParts, orb)
                elseif shape == "Diamond" then
                        -- ромб: 2 пирамиды Ball (верх + низ)
                        local top = newNeonPart(Vector3.new(sz * 0.5, sz * 1.0, sz * 0.5), lighten(baseColor, 0.15), "Part")
                        top.Shape = Enum.PartType.Ball
                        top.Size = Vector3.new(sz * 0.5, sz * 1.0, sz * 0.5)
                        table.insert(subParts, top)
                        local bot = newNeonPart(Vector3.new(sz * 0.5, sz * 1.0, sz * 0.5), baseColor, "Part")
                        bot.Shape = Enum.PartType.Ball
                        bot.Size = Vector3.new(sz * 0.5, sz * 1.0, sz * 0.5)
                        table.insert(subParts, bot)
                        orb = top
                elseif shape == "Ring" then
                        -- звезда: 2 скрещённые балки Block (вертикальная + горизонтальная)
                        local beam1 = newNeonPart(Vector3.new(0.06, sz * 1.4, 0.06), lighten(baseColor, 0.2), "Part")
                        beam1.Shape = Enum.PartType.Block
                        beam1.Size = Vector3.new(0.06, sz * 1.4, 0.06)
                        table.insert(subParts, beam1)
                        local beam2 = newNeonPart(Vector3.new(0.06, sz * 1.4, 0.06), baseColor, "Part")
                        beam2.Shape = Enum.PartType.Block
                        beam2.Size = Vector3.new(0.06, sz * 1.4, 0.06)
                        table.insert(subParts, beam2)
                        orb = beam1
                elseif shape == "Cube" then
                        -- куб: Block (реальный куб, не Ball!)
                        orb = newNeonPart(Vector3.new(sz, sz, sz), baseColor, "Part")
                        orb.Shape = Enum.PartType.Block
                        orb.Size = Vector3.new(sz * 0.85, sz * 0.85, sz * 0.85)
                        table.insert(subParts, orb)
                end
                -- свойства для всех суб-частей
                local h, s, v = Color3.toHSV(baseColor)
                local pcol = Color3.fromHSV((h + (i % 5) * 0.02) % 1, s, v)
                for _, sp in ipairs(subParts) do
                        sp.Anchored     = true
                        sp.CanCollide   = false
                        sp.CanQuery     = false
                        sp.CanTouch     = false
                        sp.CastShadow   = false
                        sp.Material     = Enum.Material.Neon
                        sp.Parent       = auraFolder
                        sp.Color        = pcol
                end
                local entry = {
                        part   = orb,
                        subParts = subParts,
                        angle  = (i / count) * math.pi * 2,
                        bob    = math.random() * math.pi * 2,
                        radius = cfg.Radius * (0.85 + (i % 3) * 0.12),
                        height = cfg.Height,
                        dir    = (i % 2 == 0) and 1 or -1,
                        shape  = shape,
                        rotSpeed = math.random() * 2 + 1,
                        sizeVar = sz,
                        baseColor = pcol,
                        layer = 1,
                }
                -- трейл на каждой 2-й частице
                if not IS_PHONE and i % 2 == 0 then
                        local att0 = Instance.new("Attachment")
                        att0.Position = Vector3.new(0, sz * 0.5, 0)
                        att0.Parent = orb
                        local att1 = Instance.new("Attachment")
                        att1.Position = Vector3.new(0, -sz * 0.5, 0)
                        att1.Parent = orb
                        local tr = Instance.new("Trail")
                        tr.Attachment0 = att0
                        tr.Attachment1 = att1
                        tr.Lifetime = 0.5
                        tr.WidthScale = NumberSequence.new({
                                NumberSequenceKeypoint.new(0, sz * 2.2),
                                NumberSequenceKeypoint.new(1, 0),
                        })
                        tr.LightEmission = 1
                        tr.LightInfluence = 0
                        tr.FaceCamera = true
                        tr.Color = ColorSequence.new(pcol)
                        tr.Transparency = NumberSequence.new({
                                NumberSequenceKeypoint.new(0, 0.4),
                                NumberSequenceKeypoint.new(1, 1),
                        })
                        tr.Parent = orb
                end
                table.insert(auraParts, entry)
        end

        -- ===== Inner layer: мелкие быстрые частицы ближе к телу =====
        if not IS_PHONE then
                local innerCount = math.max(3, math.floor(count * 0.6))
                for i = 1, innerCount do
                        local sz = 0.1 + (i % 3) * 0.04
                        local orb = newNeonPart(Vector3.new(sz, sz, sz), baseColor, "Part")
                        orb.Shape = Enum.PartType.Ball
                        orb.Anchored = true
                        orb.CanCollide = false
                        orb.CanQuery = false
                        orb.CanTouch = false
                        orb.CastShadow = false
                        orb.Material = Enum.Material.Neon
                        orb.Transparency = 0.1
                        orb.Parent = auraFolder
                        local h, s, v = Color3.toHSV(baseColor)
                        local pcol = Color3.fromHSV((h + 0.05) % 1, s, v)
                        orb.Color = pcol
                        table.insert(auraParts, {
                                part = orb,
                                angle = (i / innerCount) * math.pi * 2,
                                bob = math.random() * math.pi * 2,
                                radius = cfg.Radius * 0.5 * (0.8 + (i % 3) * 0.1),
                                height = cfg.Height * 0.6,
                                dir = (i % 2 == 0) and 1 or -1,
                                shape = "Ball",
                                rotSpeed = math.random() * 3 + 2,
                                sizeVar = sz,
                                baseColor = pcol,
                                layer = 2,
                        })
                end
        end

        -- ===== Rising sparks: искры, поднимающиеся снизу вверх =====
        if not IS_PHONE then
                local sparkCount = math.max(4, math.floor(count * 0.5))
                for i = 1, sparkCount do
                        local sz = 0.06 + math.random() * 0.06
                        local sp = newNeonPart(Vector3.new(sz, sz, sz), baseColor, "Part")
                        sp.Shape = Enum.PartType.Ball
                        sp.Anchored = true
                        sp.CanCollide = false
                        sp.CanQuery = false
                        sp.CanTouch = false
                        sp.CastShadow = false
                        sp.Material = Enum.Material.Neon
                        sp.Transparency = 0.15
                        sp.Parent = auraFolder
                        local h, s, v = Color3.toHSV(baseColor)
                        local pcol = Color3.fromHSV((h + (i % 4) * 0.03) % 1, s, v)
                        sp.Color = pcol
                        table.insert(auraParts, {
                                part = sp,
                                angle = math.random() * math.pi * 2,
                                bob = math.random() * math.pi * 2,
                                radius = cfg.Radius * (0.3 + math.random() * 1.0),
                                height = 0,
                                dir = 1,
                                shape = "Spark",
                                rotSpeed = 0,
                                sizeVar = sz,
                                baseColor = pcol,
                                layer = 3,
                                riseSpeed = 1.5 + math.random() * 1.5,
                                riseOffset = math.random() * 3,
                        })
                end
        end

        -- сохраняем кольцо в отдельной таблице для анимации
        auraRingParts = ringParts
end

local function clearAura()
        if auraConnection then
                auraConnection:Disconnect()
                auraConnection = nil
        end
        if auraFolder then
                auraFolder:Destroy()
                auraFolder = nil
        end
        auraParts = {}
        auraRingParts = nil
end

local function ensureAuraLoop()
        if auraConnection then return end
        if not vis.Extra.Aura.Enabled then return end
        auraConnection = RunService.Heartbeat:Connect(function(dt)
                if not vis.Extra.Aura.Enabled or not character then return end
                local root = character:FindFirstChild("HumanoidRootPart") or torso
                if not root then return end
                local cfg   = vis.Extra.Aura
                local t     = os.clock()
                local base  = root.Position
                -- анимация наземного кольца (пульс + вращение)
                if auraRingParts then
                        local pulse = 0.9 + math.sin(t * 3) * 0.1
                        local ringR = cfg.Radius * 1.4 * pulse
                        local ringY = base.Y - 2.8
                        for _, rp in ipairs(auraRingParts) do
                                if not rp.part or rp.part.Parent == nil then
                                        goto skipRing
                                end
                                local a = rp.angle + t * 0.5
                                local pos = base + Vector3.new(math.cos(a) * ringR, ringY, math.sin(a) * ringR)
                                rp.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, a + math.rad(90), 0)
                                rp.part.Transparency = 0.15 + math.sin(t * 3 + rp.angle * 3) * 0.1
                                ::skipRing::
                        end
                end
                -- анимация частиц
                for _, item in ipairs(auraParts) do
                        if not item.part or item.part.Parent == nil then
                                -- частица уже удалена (респавн / clearAura) — пропускаем
                                goto skipItem
                        end
                        if item.layer == 3 then
                                -- Rising spark: поднимается снизу вверх и исчезает
                                local cycle = (t * item.riseSpeed + item.riseOffset) % 4
                                local riseProgress = cycle / 4
                                local a = item.angle + t * 0.3
                                local r = item.radius * (1 - riseProgress * 0.3)
                                local h = riseProgress * (cfg.Height + 2) - 2.5
                                local pos = base + Vector3.new(math.cos(a) * r, h, math.sin(a) * r)
                                item.part.CFrame = CFrame.new(pos)
                                item.part.Transparency = 0.15 + riseProgress * 0.6
                                item.part.Size = Vector3.new(item.sizeVar, item.sizeVar, item.sizeVar) * (1 - riseProgress * 0.5)
                        else
                                local a = item.angle + t * cfg.Speed * item.dir
                                local h = item.height + math.sin(t * 2 + item.bob) * 0.5
                                local pos = base + Vector3.new(math.cos(a) * item.radius, h, math.sin(a) * item.radius)
                                local rot = t * item.rotSpeed
                                if item.shape == "Ring" then
                                        item.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, t * item.rotSpeed, math.rad(90))
                                elseif item.shape == "Diamond" then
                                        local cf = CFrame.new(pos) * CFrame.Angles(rot, 0, 0)
                                        if item.subParts and #item.subParts >= 2 then
                                                local half = item.sizeVar * 0.5
                                                item.subParts[1].CFrame = cf * CFrame.new(0, half, 0)
                                                item.subParts[2].CFrame = cf * CFrame.new(0, -half, 0)
                                        else
                                                item.part.CFrame = cf
                                        end
                                elseif item.shape == "Star" then
                                        local cf = CFrame.new(pos) * CFrame.Angles(rot * 2, rot, 0)
                                        if item.subParts and #item.subParts >= 2 then
                                                item.subParts[1].CFrame = cf
                                                item.subParts[2].CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
                                        else
                                                item.part.CFrame = cf
                                        end
                                elseif item.shape == "Cube" then
                                        item.part.CFrame = CFrame.new(pos) * CFrame.Angles(rot, rot * 0.7, 0)
                                else
                                        item.part.CFrame = CFrame.new(pos)
                                end
                                -- пульсация размера только для Ball/Cube (не для многокомпонентных Diamond/Star)
                                if item.layer == 1 and (item.shape == "Ball" or item.shape == "Cube") then
                                        local pulse = 1 + math.sin(t * 4 + item.bob) * 0.15
                                        item.part.Size = Vector3.new(item.sizeVar, item.sizeVar, item.sizeVar) * pulse
                                end
                        end
                        ::skipItem::
                end
        end)
end

function Visuals.SetAura(enabled)
        vis.Extra.Aura.Enabled = enabled and true or false
        if vis.Extra.Aura.Enabled then
                buildAura()
                ensureAuraLoop()
        else
                clearAura()
        end
end

function Visuals.RebuildAura()
