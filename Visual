local shared = odh_shared_plugins
if type(shared) ~= "table" then
    -- Заглушка: скрипт не падает без ODH (например, при тестах)
    local function makeStubSection()
        local sec = {}
        local function stub() return sec end
        sec.AddToggle, sec.AddDropdown, sec.AddColorpicker, sec.AddSlider, sec.AddButton = stub, stub, stub, stub, stub
        return sec
    end
    shared = {
        AddSection = function() return makeStubSection() end,
        Notify = function() end,
    }
end

local function notify(text, dur)
    pcall(function() shared.Notify(tostring(text), dur or 2) end)
end

local function safeSection(name)
    local ok, sec = pcall(function() return shared.AddSection(name) end)
    if ok and type(sec) == "table" then return sec end
    local stub = {}
    local function s() return stub end
    stub.AddToggle, stub.AddDropdown, stub.AddColorpicker, stub.AddSlider, stub.AddButton = s, s, s, s, s
    return stub
end

