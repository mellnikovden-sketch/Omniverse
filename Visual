local function newPart(size, color, shape)
    local p = Instance.new("Part")
    p.Size = size
    p.Color = color
    p.Material = Enum.Material.Neon
    p.Anchored = false
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Massless = true
    p.Locked = true
    if shape then p.Shape = shape end
    return p
end

local function weldTo(parent, part, c0)
    local w = Instance.new("Weld")
    w.Part0 = parent
    w.Part1 = part
    w.C0 = c0
    w.Parent = part
    return w
end

local function lighten(c, a)
    return Color3.new(math.min(c.R + a, 1), math.min(c.G + a, 1), math.min(c.B + a, 1))
end

local function darken(c, a)
    return Color3.new(math.max(c.R - a, 0), math.max(c.G - a, 0), math.max(c.B - a, 0))
end

local function randomColor()
    return Color3.new(math.random(), math.random(), math.random())
end

local function safeDestroy(obj)
    if obj then
        pcall(function() obj:Destroy() end)
    end
end

