local function clearSoulPet()
	if petConn then petConn:Disconnect() petConn = nil end
	if petFolder then petFolder:Destroy() petFolder = nil end
	petOrb, petLight, petCurrentPos, petExtra = nil, nil, nil, {}
end

local function buildSoulPet()
	clearSoulPet()
	if not vis.Extra.SoulPet.Enabled or not character then return end
	petFolder = Instance.new("Folder") petFolder.Name = "CrystalHub_SoulPet" petFolder.Parent = ensureFolder()
	local cfg, col, sz, style = vis.Extra.SoulPet, vis.Extra.SoulPet.Color, vis.Extra.SoulPet.Size, vis.Extra.SoulPet.Style

	petOrb = createPart(style == "Crystal" and "Part" or "Ball", Vector3.new(sz, sz, sz), col, 0.1)
	petOrb.Anchored, petOrb.Parent = true, petFolder
	petLight = Instance.new("PointLight") petLight.Color, petLight.Brightness, petLight.Range, petLight.Shadows, petLight.Parent = col, 3.5, 12, false, petOrb

	if style == "Dragonling" then -- НОВЫЙ СТИЛЬ: Дракончик
		for i=1, 5 do
			local tail = createPart("Ball", Vector3.new(sz - i*0.08, sz - i*0.08, sz - i*0.08), darken(col, i*0.1), 0.1)
			tail.Anchored, tail.Parent = true, petFolder
			table.insert(petExtra, tail)
		end
	elseif style == "Eye of God" then -- НОВЫЙ СТИЛЬ: Глаз
		petOrb.Size = Vector3.new(sz*0.5, sz*1.5, sz*0.5)
		local ring1 = createPart("Cylinder", Vector3.new(0.05, sz*2.2, sz*2.2), lighten(col, 0.4), 0.2) ring1.Anchored, ring1.Parent = true, petFolder table.insert(petExtra, ring1)
		local ring2 = createPart("Cylinder", Vector3.new(0.05, sz*1.8, sz*1.8), col, 0.1) ring2.Anchored, ring2.Parent = true, petFolder table.insert(petExtra, ring2)
	end
end

local function ensureSoulPetLoop()
	if petConn then return end
	petConn = RunService.Heartbeat:Connect(function(dt)
		if not vis.Extra.SoulPet.Enabled or not character or not petOrb then return end
		local root = character:FindFirstChild("HumanoidRootPart") or torso
		if not root then return end

		local cfg, t = vis.Extra.SoulPet, os.clock()
		
		-- ✨ НОВАЯ ФИЧА PET: Jump React (Резкое закручивание питомца при прыжке)
		if petSpinBoost > 0 then
			petSpinBoost = math.max(0, petSpinBoost - dt * 25)
			t = t + petSpinBoost
		end

		local angle = t * cfg.Speed
		local targetPos = root.Position + Vector3.new(math.cos(angle) * cfg.Distance, cfg.Height + math.sin(t * 1.8) * 0.7, math.sin(angle) * cfg.Distance)
		petCurrentPos = not petCurrentPos and targetPos or petCurrentPos:Lerp(targetPos, math.clamp(dt * 8, 0, 1))

		petOrb.CFrame = CFrame.new(petCurrentPos) * (cfg.Style == "Crystal" and CFrame.Angles(t * 1.5, t * 2, 0) or CFrame.new())

		if cfg.Style == "Dragonling" then
			for i, tail in ipairs(petExtra) do
				local tailA = angle - (i * 0.3)
				local tailPos = root.Position + Vector3.new(math.cos(tailA) * cfg.Distance, cfg.Height + math.sin(t * 1.8 - i*0.2) * 0.7, math.sin(tailA) * cfg.Distance)
				tail.CFrame = CFrame.new(tail.CFrame.Position:Lerp(tailPos, dt * 10))
			end
		elseif cfg.Style == "Eye of God" then
			if petExtra[1] then petExtra[1].CFrame = petOrb.CFrame * CFrame.Angles(t*2, math.rad(90), 0) end
			if petExtra[2] then petExtra[2].CFrame = petOrb.CFrame * CFrame.Angles(math.rad(90), t*3, 0) end
		end
	end)
end

-- ====================================================================== --
--                      ГЛАВНЫЙ ЦИКЛ АНИМАЦИИ                             --
-- ====================================================================== --
local function ensureLoop()
	if animConnection then return end
	animConnection = RunService.Heartbeat:Connect(function(dt)
		animClock = animClock + dt
		if vis.Extra.IdleSpin.Enabled then idleSpinAngle = idleSpinAngle + dt * vis.Extra.IdleSpin.Speed end
		local idleWobble = vis.Extra.IdleSpin.Enabled and math.sin(animClock * 1.8) * math.rad(12) or 0

		-- ✨ НОВАЯ ФИЧА WINGS: Breathing (Крылья "дышат")
		local breath = vis.Wings.Breathing and math.sin(animClock * 1.5) * 0.08 or 0

		flapAccum = flapAccum + dt
		if #wingParts > 0 and flapAccum >= (1/30) then
			flapAccum = 0
			if vis.Wings.Flap then
				flapReset = false
				for _, i in ipairs(wingParts) do
					if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * CFrame.Angles(0, breath, math.sin(animClock * 2.6 + i.Phase) * (i.Amp or 0.13)) * i.Offset end
				end
			elseif not flapReset then
				flapReset = true
				for _, i in ipairs(wingParts) do if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * CFrame.Angles(0, breath, 0) * i.Offset end end
			else
				for _, i in ipairs(wingParts) do if i.Weld and i.Weld.Parent then i.Weld.C0 = i.Origin * CFrame.Angles(0, breath, 0) * i.Offset end end
			end
		end

		-- ✨ НОВАЯ ФИЧА HALO: Bobbing (плавный взлет/спуск)
		haloBobOffset = vis.Halo.Bobbing and math.sin(animClock * 2) * 0.15 or 0

		for _, i in ipairs(haloParts) do
			if i.Weld and i.Weld.Parent then
				local angle = i.Angle + animClock * vis.Halo.Speed * i.Direction + idleSpinAngle
				if i.IsMesh then
					i.Weld.C0 = CFrame.new(0, i.Height + haloBobOffset, 0) * CFrame.Angles(i.Tilt + idleWobble, angle, 0)
				else
					i.Weld.C0 = CFrame.new(i.OffsetX or 0, i.Height + haloBobOffset + (i.Bob and math.sin(animClock * 2 + i.Bob) * 0.08 or 0), 0) * CFrame.Angles(i.Tilt + idleWobble, angle, 0) * CFrame.new(0, 0, -i.Radius) * CFrame.Angles(0, math.rad(90), 0)
				end
			end
		end

		for _, i in ipairs(hatParts) do
			if i.Weld and i.Weld.Parent then
				local spin = animClock * vis.ChinaHat.Spin + idleSpinAngle
				if i.Kind == "disc" then i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(idleWobble, spin, 0) * CFrame.Angles(0, 0, math.rad(90))
				elseif i.Kind == "spike" then i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(0, i.Angle + spin, 0) * CFrame.new(0, 0, -i.Radius)
				elseif i.Kind == "visor" then i.Weld.C0 = CFrame.new(0, i.Height, -0.6 * vis.ChinaHat.Size) * CFrame.Angles(idleWobble, idleSpinAngle, 0)
				elseif i.Kind == "shard" then i.Weld.C0 = CFrame.new(0, i.Height + math.sin(animClock*3+i.Angle)*0.3, 0) * CFrame.Angles(idleWobble, i.Angle + (animClock * 2) + idleSpinAngle, 0) * CFrame.new(0, 0, -i.Radius) -- Orbit Shards
				else i.Weld.C0 = CFrame.new(0, i.Height, 0) * CFrame.Angles(i.Tilt, i.Angle + spin, 0) * CFrame.new(0, 0, -i.Radius) * CFrame.Angles(0, math.rad(90), 0) end
			end
		end
	end)
end

