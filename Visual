local function ensureFolder()
	if effectsFolder and effectsFolder.Parent then return effectsFolder end
	effectsFolder = Instance.new("Folder") effectsFolder.Name = "CrystalHub_Effects" effectsFolder.Parent = workspace
	return effectsFolder
end

local function createPart(pType, size, color, transp, meshType)
	local part = Instance.new((pType == "Wedge" and "WedgePart") or (pType == "CornerWedge" and "CornerWedgePart") or "Part")
	if pType == "Ball" then part.Shape = Enum.PartType.Ball elseif pType == "Cylinder" then part.Shape = Enum.PartType.Cylinder end
	part.Size, part.Color, part.Material = size, color, Enum.Material.Neon
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = false, false, false, false, false
	part.Massless, part.Locked, part.Transparency = true, true, transp or 0
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	
	if meshType then
		local m = Instance.new("SpecialMesh", part)
		m.MeshType = meshType
		if meshType == Enum.MeshType.Torus then m.Scale = Vector3.new(1, 1, 1) end
	end
	return part
end

local function weldTo(basePart, part, c0)
	local weld = Instance.new("Weld") weld.Part0, weld.Part1, weld.C0, weld.Parent = basePart, part, c0, part return weld
end

local function lighten(c, a) return Color3.new(math.clamp(c.R+a,0,1), math.clamp(c.G+a,0,1), math.clamp(c.B+a,0,1)) end
local function darken(c, a) return Color3.new(math.clamp(c.R-a,0,1), math.clamp(c.G-a,0,1), math.clamp(c.B-a,0,1)) end

