			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Toxic-Slime" then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.4, 0.15),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Vortex" then
		return NumberSequence.new({
