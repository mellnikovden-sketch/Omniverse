	local color, size, style = vis.ChinaHat.Color, math.clamp(vis.ChinaHat.Size, 0.4, 3), vis.ChinaHat.Style

	local function disc(radius, height, thickness, transp)
		local part = newNeonPart(Vector3.new(thickness, radius * 2, radius * 2), color)
		part.Shape, part.Transparency, part.Parent = Enum.PartType.Cylinder, transp or 0.2, hatFolder
		table.insert(hatParts, { Weld = weldTo(headPart, part, CFrame.new(0, height, 0) * CFrame.Angles(0, 0, math.rad(90))), Kind = "disc", Height = height })
	end

	local function segRing(radius, height, segments, thickness, tilt)
		for i = 1, segments do
			local a = (i / segments) * math.pi * 2
			local piece = newNeonPart(Vector3.new(thickness, thickness, (2 * math.pi * radius / segments) * 1.08), color) piece.Parent = hatFolder
			table.insert(hatParts, { Weld = weldTo(headPart, piece, CFrame.new(0, height, 0) * CFrame.Angles(tilt or 0, a, 0) * CFrame.new(0, 0, -radius) * CFrame.Angles(0, math.rad(90), 0)), Kind = "seg", Angle = a, Radius = radius, Height = height, Tilt = tilt or 0 })
		end
	end

	local function spikes(count, radius, height, length)
		for i = 1, count do
			local a = (i / count) * math.pi * 2
			local piece = newNeonPart(Vector3.new(0.09 * size, 0.09 * size, length), color) piece.Parent = hatFolder
			table.insert(hatParts, { Weld = weldTo(headPart, piece, CFrame.new(0, height, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -(radius + length * 0.45))), Kind = "spike", Angle = a, Radius = radius + length * 0.45, Height = height })
		end
	end

	if style == "Cone" then
		for index = 1, quantity(6, 4) do local ratio = (index - 1) / 5 disc((2.8 - ratio * 2.5) * size, (1.75 + ratio * 1.6) * size, 0.14 * size, 0.15) end
		disc(0.16 * size, (1.75 + 1.6 + 0.2) * size, 0.4 * size, 0.04)
	elseif style == "Rings" then
		segRing(2.7 * size, 1.8 * size, 28, 0.1 * size) segRing(1.8 * size, 2.3 * size, 22, 0.09 * size) segRing(1.0 * size, 2.8 * size, 16, 0.08 * size) disc(0.28 * size, 3.5 * size, 0.5 * size, 0.05)
	elseif style == "Spikes" then
		for i = 1, 3 do local r = (i - 1) / 2 disc((2.6 - r * 2.1) * size, (1.8 + r * 1.2) * size, 0.16 * size, 0.2) end spikes(12, 2.65 * size, 1.82 * size, 0.9 * size)
	elseif style == "Crown" then
		disc(2.0 * size, 1.8 * size, 0.16 * size, 0.12) segRing(2.05 * size, 1.82 * size, 24, 0.1 * size) spikes(8, 1.95 * size, 1.85 * size, 1.2 * size)
	elseif style == "Sun-Rays" then
		disc(1.4 * size, 2.0 * size, 0.3 * size, 0.06) segRing(1.45 * size, 2.05 * size, 24, 0.18 * size)
		for i = 1, 14 do
			local a = (i / 14) * math.pi * 2
			local rayLen = (0.8 + (i % 2 == 0 and 0.3 or 0)) * size
			local ray = newNeonPart(Vector3.new(0.1 * size, 0.1 * size, rayLen), color) ray.Parent = hatFolder
			weldTo(headPart, ray, CFrame.new(0, 2.0 * size, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -(1.4 * size + rayLen * 0.5)) * CFrame.Angles(0, math.rad(90), 0))
		end
	elseif style == "Ice-Crystal" then
		disc(1.5 * size, 1.85 * size, 0.14 * size, 0.2) segRing(1.55 * size, 1.88 * size, 20, 0.22 * size)
		for i = 1, 8 do
			local a = (i / 8) * math.pi * 2
			local sh = newNeonPart(Vector3.new(0.12 * size, 0.12 * size, (1.0 + (i % 2) * 0.4) * size), color) sh.Parent = hatFolder
			weldTo(headPart, sh, CFrame.new(0, 1.9 * size, 0) * CFrame.Angles(math.rad(22), a, 0) * CFrame.new(0, 0, -1.5 * size) * CFrame.Angles(math.rad(90), 0, 0))
		end
		disc(0.25 * size, 2.9 * size, 0.4 * size, 0.04)
	elseif style == "Diamond" then
		for i = 1, 4 do local r = (i - 1) / 3 disc((0.3 + r * 1.9) * size, (1.7 + r * 0.7) * size, 0.1 * size, 0.18) end
		for i = 1, 4 do local r = (i - 1) / 3 disc((2.2 - r * 1.9) * size, (2.4 + r * 0.9) * size, 0.1 * size, 0.18) end
		for i = 1, 8 do
			local a = (i / 8) * math.pi * 2
			local edge = newNeonPart(Vector3.new(0.07 * size, 0.07 * size, 2.2 * size), color) edge.Parent = hatFolder
			table.insert(hatParts, { Weld = weldTo(headPart, edge, CFrame.new(0, 2.4 * size, 0) * CFrame.Angles(math.rad(45), a, 0) * CFrame.new(0, 0, -1.3 * size) * CFrame.Angles(math.rad(90), 0, 0)), Kind = "seg", Angle = a, Radius = 1.3 * size, Height = 2.4 * size, Tilt = math.rad(45) })
		end
	else
		-- Layered / Pagoda
		for index = 1, quantity(5, 3) do
			local ratio  = (index - 1) / 4
			local radius, height = (2.8 - ratio * 2.3) * size, (1.78 + ratio * 1.8) * size
			disc(radius, height, 0.16 * size, 0.2)
			segRing(radius + 0.04 * size, height, 20 - index * 2, 0.06 * size)
		end
		disc(0.2 * size, 3.9 * size, 0.4 * size, 0.04)
	end

	if vis.ChinaHat.Glow then
		local pl = Instance.new("PointLight") pl.Color, pl.Brightness, pl.Range, pl.Shadows, pl.Name, pl.Parent = color, 1.8, 11, false, "CrystalHub_HatGlow", headPart
	end
