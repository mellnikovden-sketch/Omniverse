local function detectPhone()
	if not UserInputService.TouchEnabled then return false end
	if UserInputService.KeyboardEnabled then return false end
	return true
end

local IS_PHONE = detectPhone()
local QUALITY = IS_PHONE and 0.6 or 1

local function quantity(count, minimum)
	return math.max(minimum or 1, math.floor(count * QUALITY + 0.5))
end

