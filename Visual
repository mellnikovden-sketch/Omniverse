-- Применяет пресет к выбранной цели (Jump/Wings/Halo/Hat/Trails/KillFX)
local function applyPresetToTarget(target, preset)
	local colors = preset.colors
	local color  = colors[2] or colors[1]  -- основной цвет (самый яркий)
	local color2 = colors[4] or colors[3] or color -- дополнительный
	if target == "Jump" then
		vis.Jump.Color = color
		vis.Jump.PresetColors = colors
	elseif target == "Wings" then
		vis.Wings.Color = color
		vis.Wings.PresetColors = colors
		if vis.Wings.Enabled then Visuals.RebuildWings() end
	elseif target == "Halo" then
		vis.Halo.Color = color
		vis.Halo.PresetColors = colors
		if vis.Halo.Enabled then Visuals.RebuildHalo() end
	elseif target == "Hat" then
		vis.ChinaHat.Color = color
		vis.ChinaHat.PresetColors = colors
		if vis.ChinaHat.Enabled then Visuals.RebuildChinaHat() end
	elseif target == "Trails" then
		trailSettings.Color = color
		trailSettings.Color2 = color2
		trailSettings.PresetColors = colors
		if trailSettings.Enabled then Trails.Rebuild() end
	elseif target == "KillFX" then
		killSettings.Color = color
		killSettings.PresetColors = colors
	end
end

-- Проверяет, включен ли хотя бы один анимационный эффект
local function anyAnimFxActive()
	for _, mode in pairs({"rainbow"}) do
		for _, cfg in pairs(animFx[mode]) do
			if cfg.enabled then
				return true
			end
		end
	end
	return false
end

-- Применяет радужный цвет к цели (сплошной цвет по hue)
local function applyRainbowToTarget(target, hue)
	local color = rainbowColor(hue)
	if target == "Jump" then
		vis.Jump.Color = color
	elseif target == "Wings" then
		if vis.Wings.Color ~= color then
			vis.Wings.Color = color
			if vis.Wings.Enabled then Visuals.RebuildWings() end
		end
	elseif target == "Halo" then
		if vis.Halo.Color ~= color then
			vis.Halo.Color = color
			if vis.Halo.Enabled then Visuals.RebuildHalo() end
		end
	elseif target == "Hat" then
		if vis.ChinaHat.Color ~= color then
			vis.ChinaHat.Color = color
			if vis.ChinaHat.Enabled then Visuals.RebuildChinaHat() end
		end
	elseif target == "Trails" then
		trailSettings.Color = color
		trailSettings.Color2 = rainbowColor(hue + 0.5)
		-- трейл обновляется напрямую в ensureFxLoop
	elseif target == "KillFX" then
		killSettings.Color = color
	end
end
local function ensureFxLoop()
	if fxConnection then
		if not anyAnimFxActive() then
			fxConnection:Disconnect()
			fxConnection = nil
		end
		return
	end
	if not anyAnimFxActive() then
		return
	end
	fxConnection = RunService.Heartbeat:Connect(function(dt)
	-- радуга: скорость по цели (cfg.speed)
	local anyRainbow = false
	local rainbowMaxSpeed = 0.15
	for _, cfg in pairs(animFx.rainbow) do
		if cfg.enabled then
			anyRainbow = true
			rainbowMaxSpeed = math.max(rainbowMaxSpeed, cfg.speed or 0.15)
		end
	end
	if anyRainbow then
		fxState.rainbowHue = (fxState.rainbowHue + dt * (rainbowMaxSpeed * 0.15)) % 1
		for target, cfg in pairs(animFx.rainbow) do
			if cfg.enabled then
				applyRainbowToTarget(target, fxState.rainbowHue)
			end
		end
		if animFx.rainbow.Trails.enabled and trailFolder then
			local trail = trailFolder:FindFirstChildOfClass("Trail")
			if trail then
				trail.Color = buildRainbowColorSequence(fxState.rainbowHue)
			end
		end
	end


		if not anyRainbow and fxConnection then
			fxConnection:Disconnect()
			fxConnection = nil
		end
	end)
end

-- Включение/выключение радужного режима для цели
local function setRainbow(target, enabled)
	animFx.rainbow[target].enabled = enabled
	ensureFxLoop()
	if not enabled then
		-- при выключении радуги возвращаем цвет из пресета или текущий
		notify(target .. " rainbow: OFF", 1.5)
	else
		notify(target .. " rainbow: ON", 1.5)
	end
end



