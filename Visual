-- Универсальный генератор 3D геометрии
local function createShape(shape, size, color, transp, mat)
	local p = Instance.new((shape == "Wedge" and "WedgePart") or (shape == "CornerWedge" and "CornerWedgePart") or "Part")
	if shape == "Ball" then p.Shape = Enum.PartType.Ball elseif shape == "Cylinder" then p.Shape = Enum.PartType.Cylinder end
	p.Size, p.Color, p.Material = size, color, mat or Enum.Material.Neon
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Massless, p.Locked, p.Transparency = true, true, transp or 0
	return p
end

local function createWeldable(shape, size, color, transp, mat)
	local p = createShape(shape, size, color, transp, mat)
	p.Anchored = false
	return p
end

local function weldTo(base, part, c0)
	local w = Instance.new("Weld") w.Part0, w.Part1, w.C0, w.Parent = base, part, c0, part return w
end

local function lighten(c, a) return Color3.new(math.clamp(c.R+a,0,1), math.clamp(c.G+a,0,1), math.clamp(c.B+a,0,1)) end
local function darken(c, a) return Color3.new(math.clamp(c.R-a,0,1), math.clamp(c.G-a,0,1), math.clamp(c.B-a,0,1)) end

