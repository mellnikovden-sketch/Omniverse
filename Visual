			addOrb(side, math.rad(70), 0.45, 0.2, 0.16 * scale, colAt(0.3), 0.1)
		elseif style == "Sacred" then
			-- Sacred: священные крылья — симметричные перья с золотистыми акцентами-полосами + ореол + трейлы
			local rows = {
				{ Count = 9, Long = 4.4, Short = 2.6, From = 52, To = 128, Width = 0.54, Thick = 0.1,  Z = 0.68, Y = 0.32, X = 0.42, Alpha = 0.04, Amp = 0.18, Tip = true,  Pitch = -14 },
				{ Count = 6, Long = 3.0, Short = 1.9, From = 58, To = 122, Width = 0.44, Thick = 0.09, Z = 0.56, Y = 0.26, X = 0.38, Alpha = 0.15, Amp = 0.14, Tip = true,  Pitch = -10 },
