        local h, s, v = Color3.toHSV(color)
        fp.Color = Color3.fromHSV((h + (math.random() - 0.5) * 0.06) % 1, s, v * (0.85 + math.random() * 0.15))
        TweenService:Create(fp,
                TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Size = Vector3.new(fp.Size.X * 0.2, 0.02, fp.Size.Z * 0.2), Transparency = 1 }
        ):Play()
        -- искра вверх при появлении
        if vis.Extra.Footprints.Sparks and not IS_PHONE then
                local spark = newNeonPart(Vector3.new(0.08, 0.08, 0.08), fp.Color, "Part")
                spark.Shape = Enum.PartType.Ball
                spark.Anchored = true
                spark.CanCollide = false
                spark.CanQuery = false
                spark.CanTouch = false
                spark.CastShadow = false
                spark.Material = Enum.Material.Neon
                spark.Transparency = 0.1
                spark.CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0))
                spark.Parent = fx
                TweenService:Create(spark,
                        TweenInfo.new(duration * 0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                        { CFrame = CFrame.new(pos + Vector3.new((math.random() - 0.5) * 1.5, 1.8, (math.random() - 0.5) * 1.5)), Transparency = 1 }
                ):Play()
                task.delay(duration * 0.7 + 0.1, function() spark:Destroy() end)
        end
        task.delay(duration + 0.15, function() fp:Destroy() end)
end

local function clearFootprints()
        if footprintConn then
                footprintConn:Disconnect()
                footprintConn = nil
        end
        footprintTimer = 0
        lastFootPos    = nil
end

local footprintStepCount = 0

local function ensureFootprintLoop()
        if footprintConn then return end
        if not vis.Extra.Footprints.Enabled then return end
        footprintConn = RunService.Heartbeat:Connect(function(dt)
                if not vis.Extra.Footprints.Enabled or not character or not humanoid then return end
                local root = character:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local speed = humanoid.MoveDirection.Magnitude
                if speed <= 0.05 then return end
                footprintTimer = footprintTimer + dt
                local cfg = vis.Extra.Footprints
                if footprintTimer >= cfg.Interval then
                        footprintTimer = 0
                        footprintStepCount = footprintStepCount + 1
                        local pos = root.Position - Vector3.new(0, 2.9, 0)
                        pos = pos + root.CFrame.RightVector * (footprintStepCount % 2 == 0 and 0.5 or -0.5)
                        if not lastFootPos or (pos - lastFootPos).Magnitude > 0.6 then
                                spawnFootprint(pos, cfg.Color, cfg.Size, cfg.Duration, footprintStepCount)
                                lastFootPos = pos
                        end
                end
        end)
end

function Visuals.SetFootprints(enabled)
        vis.Extra.Footprints.Enabled = enabled and true or false
        if vis.Extra.Footprints.Enabled then
                ensureFootprintLoop()
        else
                clearFootprints()
        end
end

