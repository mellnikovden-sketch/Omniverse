local function buildSoulPet()
	clearSoulPet()
	if not vis.Extra.SoulPet.Enabled or not character then return end
	local root = character:FindFirstChild("HumanoidRootPart") or torso
	if not root then return end

	petFolder = Instance.new("Folder")
	petFolder.Name   = "CrystalHub_SoulPet"
	petFolder.Parent = ensureFolder()

	local cfg   = vis.Extra.SoulPet
	local sz    = cfg.Size
	local col   = cfg.Color
	local style = cfg.Style or "Orb"

	if style == "Crystal" then
		petOrb = newNeonPart(Vector3.new(sz * 1.3, sz * 1.3, sz * 1.3), col, "Part")
		petOrb.Shape = Enum.PartType.Block
	elseif style == "Ghost" then
		petOrb = newNeonPart(Vector3.new(sz * 1.2, sz * 1.2, sz * 1.2), lighten(col, 0.2), "Part")
		petOrb.Shape = Enum.PartType.Ball
		petOrb.Transparency = 0.4
	else
		petOrb = newNeonPart(Vector3.new(sz, sz, sz), col, "Part")
		petOrb.Shape = Enum.PartType.Ball
	end

	petOrb.Anchored = true
	petOrb.Parent   = petFolder

	petLight = Instance.new("PointLight")
	petLight.Color = col
	petLight.Brightness = 3.5
	petLight.Range = 12
	petLight.Shadows = false
	petLight.Parent = petOrb
end

local function ensureSoulPetLoop()
	if petConn then return end
	if not vis.Extra.SoulPet.Enabled then return end
	petConn = RunService.Heartbeat:Connect(function(dt)
		if not vis.Extra.SoulPet.Enabled or not character or not petOrb then return end
		local root = character:FindFirstChild("HumanoidRootPart") or torso
		if not root then return end

		local cfg   = vis.Extra.SoulPet
		local style = cfg.Style or "Orb"
		local t     = os.clock()
		local angle = t * cfg.Speed
		local targetPos = root.Position + Vector3.new(
			math.cos(angle) * cfg.Distance,
			cfg.Height + math.sin(t * 1.8) * 0.7,
			math.sin(angle) * cfg.Distance
		)

		if not petCurrentPos then
			petCurrentPos = targetPos
		else
			petCurrentPos = petCurrentPos:Lerp(targetPos, math.clamp(dt * 8, 0, 1))
		end

		if style == "Crystal" then
			petOrb.CFrame = CFrame.new(petCurrentPos) * CFrame.Angles(t * 1.5, t * 2, 0)
		else
			petOrb.CFrame = CFrame.new(petCurrentPos)
		end
	end)
end

