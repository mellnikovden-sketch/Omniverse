	wingsFolder = Instance.new("Folder")
	wingsFolder.Name   = "CrystalHub_Wings"
	wingsFolder.Parent = character

	local scale = vis.Wings.Scale
	local base  = vis.Wings.Color
	local light = lighten(base, 0.4)
	local dark  = darken(base, 0.3)
	local style = vis.Wings.Style
	local pc    = vis.Wings.PresetColors
	local function colAt(ratio)
		return presetColorAt(pc, base, ratio)
	end

	-- helper: adds a small accent orb at a position on the wing
	local function addOrb(side, angle, dist, height, sz, col, transp)
		local orb = newNeonPart(Vector3.new(sz, sz, sz), col, "Part")
		orb.Shape = Enum.PartType.Ball
		orb.Transparency = transp or 0.08
		orb.Parent = wingsFolder
		local cf = CFrame.new(0, height * scale, 0)
			* CFrame.Angles(0, side * angle, 0)
			* CFrame.new(0, 0, -dist * scale)
		weldTo(torso, orb, cf)
		return orb
	end

	for _, side in ipairs({ -1, 1 }) do
		if style == "Demon" then
			-- Demon: массивный каркас из длинных костяных перьев-когтей + перепонки + шипы по верхнему краю + тёмные кончики
			local bones = quantity(7, 5)
			for index = 1, bones do
				local ratio  = (index - 1) / (bones - 1)
				local length = (5.0 - ratio * 1.8) * scale
				local spread = math.rad(52 + ratio * 68)
				addFeather(side, {
					Length = length, Width = 0.2 * scale, Thickness = 0.18 * scale,
					Spread = spread, Sweep = math.rad(32), Pitch = math.rad(-12 - ratio * 10),
					OriginX = 0.55 * scale, OriginY = 0.12 * scale, OriginZ = 0.72 * scale,
					Color = colAt(ratio * 0.4), Transparency = 0.03,
					Phase = index * 0.28, Amp = 0.1 + ratio * 0.12, Tip = true,
					TipColor = dark,
				})
				if index < bones then
					local nextRatio = index / (bones - 1)
					addFeather(side, {
						Length = length * 0.85, Width = (1.4 - ratio * 0.3) * scale,
						Thickness = 0.06 * scale,
						Spread = spread + math.rad(12 + nextRatio * 6), Sweep = math.rad(32),
						Pitch = math.rad(-12 - ratio * 10),
						OriginX = 0.55 * scale, OriginY = 0.12 * scale, OriginZ = 0.7 * scale,
						Color = colAt(ratio * 0.2), Transparency = 0.55,
						Phase = index * 0.28 + 0.08, Amp = 0.1 + ratio * 0.12,
					})
				end
			end
			-- шипы по верхнему краю
			for index = 1, quantity(5, 3) do
				local ratio = (index - 1) / 4
				addFeather(side, {
					Length = (0.8 - ratio * 0.3) * scale, Width = 0.12 * scale, Thickness = 0.11 * scale,
					Spread = math.rad(54 + ratio * 30), Sweep = math.rad(32), Pitch = math.rad(-28),
					OriginX = 0.56 * scale, OriginY = 0.3 * scale, OriginZ = 0.72 * scale,
					Color = dark, Transparency = 0.05,
					Phase = index * 0.28 + 0.2, Amp = 0.06, Tip = true, TipColor = colAt(0.05),
				})
			end
			-- акцент-орбы у основания
			addOrb(side, math.rad(70), 0.6, 0.15, 0.18 * scale, colAt(0.9), 0.05)

		elseif style == "Simple" then
			-- Simple: чистые крупные перья + длинные трейлы + тонкие акцент-полоски + кончики-орбы
			local count = quantity(5, 4)
