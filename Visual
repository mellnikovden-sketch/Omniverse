					Phase = index * 0.28 + 0.14, Amp = 0.08,
				})
			end
			-- шипы вдоль верхнего края
			for index = 1, quantity(5, 4) do
				local ratio = (index - 1) / 4
				addFeather(side, {
					Length = (0.7 - ratio * 0.2) * scale, Width = 0.11 * scale, Thickness = 0.1 * scale,
					Spread = math.rad(48 + ratio * 34), Sweep = math.rad(24), Pitch = math.rad(-28),
					OriginX = 0.54 * scale, OriginY = 0.32 * scale, OriginZ = 0.68 * scale,
					Color = dark, Transparency = 0.08,
					Phase = index * 0.28 + 0.2, Amp = 0.06, Tip = true, TipColor = colAt(0.1),
				})
			end
		elseif style == "Fairy" then
			-- Fairy: маленькие прозрачные крылышки феи — два слоя + блёстки-трейлы + ореол
			for index = 1, quantity(5, 4) do
				local ratio = (index - 1) / 4
				local blade = addFeather(side, {
					Length = (2.8 - ratio * 0.8) * scale, Width = (0.56 - ratio * 0.1) * scale,
					Thickness = 0.05 * scale,
					Spread = math.rad(68 + ratio * 38), Sweep = math.rad(40), Pitch = math.rad(-20),
					OriginX = 0.28 * scale, OriginY = 0.4 * scale, OriginZ = 0.46 * scale,
