					Shape = "CornerWedge", Length = (4.5 - r * 1.5) * scale,
					Width = 0.6 * scale, Thickness = 0.15 * scale,
					Spread = math.rad(45 + r * 60), Sweep = math.rad(15), Pitch = math.rad(-5),
					OriginX = 0.6 * scale, OriginY = 0.2 * scale, OriginZ = 0.8 * scale,
					Color = dark, Transparency = 0.05, Phase = i * 0.2, Amp = 0.05,
