local function bindCharacter(char)
    character = char

    -- чистим возможные остатки от прошлого запуска
    for _, name in ipairs({"Wings", "Halo", "Hat", "Trails"}) do
        local old = char:FindFirstChild(name)
        if old then old:Destroy() end
    end

    humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
    torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:WaitForChild("HumanoidRootPart", 3)
    headPart = char:FindFirstChild("Head") or char:WaitForChild("Head", 3) or torso
    wingParts, haloParts, hatParts = {}, {}, {}

    if jumpConn then jumpConn:Disconnect() end
    jumpConn = nil
    if humanoid then
        jumpConn = humanoid.Jumping:Connect(function(active)
            if active then playJumpEffect() end
        end)
    end

    -- Weapon Glow: реагируем на экипировку инструментов
    if toolAddedConn then toolAddedConn:Disconnect() end
    if toolRemovedConn then toolRemovedConn:Disconnect() end
    toolAddedConn = char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and vis.Extra.WeaponGlow.Enabled then
            task.defer(buildWeaponGlow)
        end
    end)
    toolRemovedConn = char.ChildRemoved:Connect(function(c)
        if c:IsA("Tool") and vis.Extra.WeaponGlow.Enabled then
            task.defer(buildWeaponGlow)
        end
    end)

    applyGlow()
    buildWings()
    buildHalo()
    buildHaloAura()
    buildHat()
    buildTrails()
    if vis.Extra.Aura.Enabled then buildAura() else safeDestroy(auraFolder); auraFolder = nil end
    if vis.Extra.Shield.Enabled then buildShield() else safeDestroy(shieldFolder); shieldFolder = nil end
    if vis.Extra.Pet.Enabled then buildPet() else safeDestroy(petFolder); petFolder = nil end
    if vis.Extra.Footprints.Enabled then buildFootprints() else safeDestroy(footprintFolder); footprintFolder = nil end
    buildWeaponGlow()

    if animConn then animConn:Disconnect() end
    animConn = RunService.Heartbeat:Connect(function(dt)
        animClock = animClock + dt

        -- КРЫЛЬЯ: взмахи
        if vis.Wings.Enabled and vis.Wings.Flap then
            for _, item in ipairs(wingParts) do
                local flap = math.sin(animClock * 2.6 + item.Phase) * (item.Amp or 0.12)
                item.Weld.C0 = item.Origin * CFrame.Angles(0, 0, flap) * item.Offset
            end
        end

        -- ОБЩИЙ УГОЛ: IdleSpin (+ Wobble, теперь работает)
        local spinAngle, wobbleY
        if vis.Extra.IdleSpin.Enabled then
            idleAngle = idleAngle + dt * vis.Extra.IdleSpin.Speed
            spinAngle = idleAngle
            if vis.Extra.IdleSpin.Wobble then
                wobbleY = math.sin(animClock * 3) * 0.08
            end
        end

        -- НИМБ: вращение с сохранением наклонов деталей (исправлено)
        if #haloParts > 0 then
            local a = spinAngle or (animClock * vis.Halo.Speed)
            local bob = wobbleY and CFrame.new(0, wobbleY, 0) or CFrame.new()
            for _, item in ipairs(haloParts) do
                item.Weld.C0 = bob * CFrame.Angles(0, a, 0) * item.Offset
            end
        end

        -- ШЛЯПА: вращение
        if #hatParts > 0 then
            if spinAngle or vis.Hat.Spin ~= 0 then
                local a = spinAngle or (animClock * vis.Hat.Spin)
                local bob = wobbleY and CFrame.new(0, wobbleY, 0) or CFrame.new()
                for _, item in ipairs(hatParts) do
                    item.Weld.C0 = bob * item.Offset * CFrame.Angles(0, a, 0)
                end
            end
        end

        -- ДОПОЛНИТЕЛЬНЫЕ ЭФФЕКТЫ
        updateExtras(dt)
    end)
end

