local function addFeather(side, opts)
	local feather = newNeonPart(Vector3.new(opts.Thickness, opts.Length, opts.Width), opts.Color)
	feather.Transparency, feather.Parent = opts.Transparency or 0.1, wingsFolder
	local spread = opts.Spread + math.rad(vis.Wings.Droop or 0)
	local origin = CFrame.new(side * opts.OriginX, opts.OriginY, opts.OriginZ) * CFrame.Angles(opts.Pitch or 0, side * opts.Sweep, -side * spread)
	local offset = CFrame.new(0, opts.Length * 0.5, 0)
	table.insert(wingParts, { Weld = weldTo(torso, feather, origin * offset), Origin = origin, Offset = offset, Phase = opts.Phase or 0, Amp = opts.Amp or 0.12 })
	return feather
end

local function buildWings()
	clearWings()
	if not vis.Wings.Enabled or not torso then return end
	wingsFolder = Instance.new("Folder") wingsFolder.Name = "CrystalHub_Wings" wingsFolder.Parent = character
	local scale, base, style = vis.Wings.Scale, vis.Wings.Color, vis.Wings.Style
	
	for _, side in ipairs({ -1, 1 }) do
		if style == "Demon" or style == "Dragon" then
			for index = 1, quantity(6, 4) do
				local ratio = (index - 1) / 5
				addFeather(side, { Length = (5.0 - ratio * 1.8) * scale, Width = 0.2 * scale, Thickness = 0.18 * scale, Spread = math.rad(52 + ratio * 68), Sweep = math.rad(32), Pitch = math.rad(-12 - ratio * 10), OriginX = 0.55 * scale, OriginY = 0.12 * scale, OriginZ = 0.72 * scale, Color = darken(base, 0.2), Transparency = 0.03, Phase = index * 0.28, Amp = 0.15 })
			end
		elseif style == "Butterfly" or style == "Fairy" then
			for index = 1, quantity(6, 4) do
				local ratio = (index - 1) / 5
				addFeather(side, { Length = (3.0 - ratio * 0.6) * scale, Width = (0.8 - ratio * 0.12) * scale, Thickness = 0.08 * scale, Spread = math.rad(72 + ratio * 34), Sweep = math.rad(38), Pitch = math.rad(-22), OriginX = 0.3 * scale, OriginY = 0.35 * scale, OriginZ = 0.5 * scale, Color = base, Transparency = 0.1, Phase = index * 0.38, Amp = 0.2 })
			end
		else -- Angel
			for index = 1, quantity(8, 4) do
				local ratio = (index - 1) / 7
				addFeather(side, { Length = (4.0 - ratio * 1.5) * scale, Width = 0.4 * scale, Thickness = 0.08 * scale, Spread = math.rad(55 + ratio * 65), Sweep = math.rad(24), Pitch = math.rad(-12), OriginX = 0.4 * scale, OriginY = 0.3 * scale, OriginZ = 0.65 * scale, Color = base, Transparency = 0.1, Phase = index * 0.3, Amp = 0.15 })
			end
		end
	end
	if vis.Wings.Glow then
		local pl = Instance.new("PointLight") pl.Color, pl.Brightness, pl.Range, pl.Shadows, pl.Name, pl.Parent = base, 2.4, 14, false, "CrystalHub_WingGlow", torso
	end
end

