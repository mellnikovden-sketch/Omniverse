-- [ CHARACTER BINDING ]
local function bindCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid", 5)
	torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:WaitForChild("HumanoidRootPart", 5)
	headPart = char:FindFirstChild("Head") or torso

	if jumpConnection then jumpConnection:Disconnect() end
	if humanoid then jumpConnection = humanoid.Jumping:Connect(function(a) if a and vis.Jump.Enabled then playJumpEffect() end end) end

	if vis.Wings.Enabled then buildWings() end
	if vis.Halo.Enabled then buildHalo() end
	if vis.ChinaHat.Enabled then buildChinaHat() end
	if vis.Extra.Glow.Enabled then buildGlow() ensureGlowLoop() end
	if vis.Extra.SoulPet.Enabled then buildSoulPet() ensureSoulPetLoop() end
	if vis.Extra.Aura.Enabled then buildAura() ensureAuraLoop() end
	ensureLoop()
end

