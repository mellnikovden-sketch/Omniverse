local function makePetPart(sizeVec, color, shape)
        local p = newNeonPart(sizeVec, color, "Part")
        if shape then p.Shape = shape end
        p.Anchored   = true
        p.CanCollide = false
        p.CanQuery   = false
        p.CanTouch   = false
        p.CastShadow = false
        p.Material   = Enum.Material.Neon
        return p
end

local function makePetTrail(orb, sz, color, widthMul, lifetime, transparency0)
        local att0 = Instance.new("Attachment")
        att0.Position = Vector3.new(0, sz * 0.5, 0)
        att0.Parent = orb
        local att1 = Instance.new("Attachment")
        att1.Position = Vector3.new(0, -sz * 0.5, 0)
        att1.Parent = orb
        local tr = Instance.new("Trail")
        tr.Attachment0 = att0
        tr.Attachment1 = att1
        tr.Lifetime = lifetime
        tr.WidthScale = NumberSequence.new({
                NumberSequenceKeypoint.new(0, sz * (widthMul or 1.5)),
                NumberSequenceKeypoint.new(1, 0),
        })
        tr.LightEmission  = 1
        tr.LightInfluence = 0
        tr.FaceCamera     = true
        tr.Color          = ColorSequence.new(color)
        tr.Transparency   = NumberSequence.new({
                NumberSequenceKeypoint.new(0, transparency0 or 0.3),
                NumberSequenceKeypoint.new(1, 1),
        })
        tr.Parent = orb
        return tr
end

