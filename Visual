local function openColorPicker(title, currentColor, callback)
	ModalTitle.Text = title
	for _, c in ipairs(ModalScroll:GetChildren()) do if not c:IsA("UIListLayout") then c:Destroy() end end
	
	local r, g, b = currentColor.R, currentColor.G, currentColor.B
	local preview = Instance.new("Frame")
	preview.Size, preview.BackgroundColor3, preview.ZIndex, preview.Parent = UDim2.new(1, -6, 0, 40), currentColor, 53, ModalScroll
	local pCorn = Instance.new("UICorner") pCorn.CornerRadius, pCorn.Parent = UDim.new(0, 6), preview
	
	local function makeSlider(cName, cColor, startVal, func)
		local row = Instance.new("Frame") row.Size, row.BackgroundTransparency, row.ZIndex, row.Parent = UDim2.new(1, -6, 0, 35), 1, 53, ModalScroll
		local track = Instance.new("TextButton") track.Size, track.Position, track.BackgroundColor3, track.Text, track.ZIndex, track.Parent = UDim2.new(1, -20, 0, 10), UDim2.new(0, 10, 0.5, -5), Color3.fromRGB(30, 30, 40), "", 54, row
		local tCorn = Instance.new("UICorner") tCorn.CornerRadius, tCorn.Parent = UDim.new(1, 0), track
		local fill = Instance.new("Frame") fill.Size, fill.BackgroundColor3, fill.ZIndex, fill.Parent = UDim2.new(startVal, 0, 1, 0), cColor, 55, track
		local fCorn = Instance.new("UICorner") fCorn.CornerRadius, fCorn.Parent = UDim.new(1, 0), fill
		
		local dragging = false
		track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
		UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				fill.Size = UDim2.new(pct, 0, 1, 0)
				func(pct)
			end
		end)
	end
	
	makeSlider("R", Color3.fromRGB(255, 50, 50), r, function(v) r = v preview.BackgroundColor3 = Color3.new(r, g, b) callback(Color3.new(r, g, b)) end)
	makeSlider("G", Color3.fromRGB(50, 255, 50), g, function(v) g = v preview.BackgroundColor3 = Color3.new(r, g, b) callback(Color3.new(r, g, b)) end)
	makeSlider("B", Color3.fromRGB(50, 50, 255), b, function(v) b = v preview.BackgroundColor3 = Color3.new(r, g, b) callback(Color3.new(r, g, b)) end)
	
	ModalOverlay.Visible = true
end

