local function clearHalo()
	if haloFolder then
		haloFolder:Destroy()
	end
	haloFolder = nil
	haloParts  = {}
	if headPart then
		for _, child in ipairs(headPart:GetChildren()) do
			if child.Name == "CrystalHub_HaloGlow" then
				child:Destroy()
			end
		end
	end
end

Visuals.HaloStyles = { "Ring", "Double", "Orbs", "Tilted", "Star", "Crown", "Sun", "Hexagon", "Lotus", "Infinity", "Prism", "Tech-Ring", "Rune-Circle", "Halo-Flower", "Galactic-Disc" }

local function buildHalo()
	clearHalo()
	if not vis.Halo.Enabled or not headPart then
		return
	end

	haloFolder = Instance.new("Folder")
	haloFolder.Name   = "CrystalHub_Halo"
	haloFolder.Parent = character

	local color = vis.Halo.Color
	local light = lighten(color, 0.4)
	local dark  = darken(color, 0.3)
	local style = vis.Halo.Style
	local pc    = vis.Halo.PresetColors
	local function colAt(ratio)
		return presetColorAt(pc, color, ratio)
	end

	-- smoothRing: кольцо из множества мелких сегментов с градиентом по кругу
	local function smoothRing(radius, height, segments, tilt, direction, thickness)
		segments = quantity(segments, 24)
		local segmentLength = (2 * math.pi * radius / segments) * 1.12
		for index = 1, segments do
			local angle = (index / segments) * math.pi * 2
			local t = (index - 1) / segments
			local piece = newNeonPart(Vector3.new(thickness, thickness, segmentLength), colAt(t))
			piece.Transparency = 0.08 + math.abs(math.sin(t * math.pi)) * 0.12
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, height, 0)
				* CFrame.Angles(tilt, angle, 0)
				* CFrame.new(0, 0, -radius)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, {
				Weld = weld, Angle = angle, Radius = radius,
				Height = height, Tilt = tilt, Direction = direction,
			})
		end
	end

	-- torusRing: объёмное кольцо (тор) из двух смещённых рядов сегментов
	local function torusRing(radius, height, segments, thickness)
		segments = quantity(segments, 20)
		local segLen = (2 * math.pi * radius / segments) * 1.14
		for index = 1, segments do
			local angle = (index / segments) * math.pi * 2
			local t = (index - 1) / segments
			local col = colAt(t)
			for _, dy in ipairs({ -thickness * 0.7, thickness * 0.7 }) do
				local piece = newNeonPart(Vector3.new(thickness, thickness, segLen), col)
				piece.Transparency = 0.15
				piece.Parent = haloFolder
				local weld = weldTo(headPart, piece, CFrame.new(0, height + dy, 0)
					* CFrame.Angles(math.rad(dy * 40), angle, 0)
					* CFrame.new(0, 0, -radius)
					* CFrame.Angles(0, math.rad(90), 0))
				table.insert(haloParts, {
					Weld = weld, Angle = angle, Radius = radius,
					Height = height + dy, Tilt = math.rad(dy * 40), Direction = 1,
				})
			end
		end
	end

	-- orbitOrbs: парящие орбы на орбите с покачиванием
	local function orbitOrbs(count, radius, height, orbSize, tilt, direction, bob)
		count = quantity(count, 5)
		for index = 1, count do
			local angle = (index / count) * math.pi * 2
			local t = (index - 1) / count
			local orb = newNeonPart(Vector3.new(orbSize, orbSize, orbSize), colAt(t), "Part")
			orb.Shape = Enum.PartType.Ball
			orb.Transparency = 0.05
			orb.Parent = haloFolder
			local weld = weldTo(headPart, orb, CFrame.new(0, height, 0))
			table.insert(haloParts, {
				Weld = weld, Angle = angle, Radius = radius,
				Height = height, Tilt = tilt or 0, Direction = direction or 1,
				Bob = bob and (index * bob) or nil,
			})
		end
	end

	-- sparkles: мелкие парящие искры вокруг кольца
	local function sparkles(count, radius, height)
		count = quantity(count, 8)
		for index = 1, count do
			local angle = (index / count) * math.pi * 2 + 0.3
			local r = radius * (0.7 + (index % 3) * 0.2)
			local h = height + math.sin(index * 1.7) * 0.25
			local sp = newNeonPart(Vector3.new(0.07, 0.07, 0.07), colAt((index-1)/count), "Part")
			sp.Shape = Enum.PartType.Ball
			sp.Transparency = 0.1
			sp.Parent = haloFolder
			local weld = weldTo(headPart, sp, CFrame.new(0, h, 0))
			table.insert(haloParts, {
				Weld = weld, Angle = angle, Radius = r,
				Height = h, Tilt = 0, Direction = -1, Bob = index * 0.6,
			})
		end
	end

	-- rayBurst: лучи из центра (для Sun / Star / Crown стилей)
	local function rayBurst(count, innerR, height, minLen, maxLen, thick)
		count = quantity(count, 8)
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local t = (i - 1) / count
			local rayLen = minLen + (i % 2 == 0 and (maxLen - minLen) or 0)
			local ray = newNeonPart(Vector3.new(thick, thick, rayLen), colAt(t))
			ray.Parent = haloFolder
			local weld = weldTo(headPart, ray, CFrame.new(0, height, 0)
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, 0, -(innerR + rayLen * 0.5))
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = innerR + rayLen * 0.5, Height = height, Tilt = 0, Direction = 1 })
		end
	end

	if style == "Double" then
		-- Double: два кольца разного радиуса + орбы между ними
		torusRing(0.9, 1.55, 28, 0.09)
		smoothRing(1.1, 1.5, 24, 0, 1, 0.04)
		orbitOrbs(8, 0.95, 1.6, 0.12, 0, 1, 0.5)
	elseif style == "Orbs" then
		-- Orbs: крупное кольцо-основание + парящие орбы разного размера
		torusRing(0.95, 1.6, 24, 0.06)
		orbitOrbs(8, 1.0, 1.6, 0.26, 0, 1, 0.5)
		orbitOrbs(6, 0.7, 1.7, 0.16, 0, -1, 0.7)
	elseif style == "Tilted" then
		-- Tilted: сильно наклоненное кольцо + вторичное кольцо под другим углом + орбы
		torusRing(0.95, 1.6, 32, math.rad(25), 1, 0.09)
		smoothRing(0.7, 1.8, 24, math.rad(-35), -1, 0.06)
		orbitOrbs(4, 1.0, 1.65, 0.14, 0, 1, 0.6)
	elseif style == "Star" then
		-- Star: 5-конечная звезда из лучей + вершины-орбы + внутреннее кольцо + искры
		local points = 5
		local outerR = 1.0
		for i = 0, points - 1 do
			local angle = (i / points) * math.pi * 2 - math.pi / 2
			local segLen = outerR * 1.1
			local piece = newNeonPart(Vector3.new(0.09, 0.09, segLen), colAt(i / points))
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, 1.6, 0)
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, 0, -outerR * 0.5)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = outerR * 0.5, Height = 1.6, Tilt = 0, Direction = 1 })
			local tip = newNeonPart(Vector3.new(0.22, 0.22, 0.22), light, "Part")
			tip.Shape = Enum.PartType.Ball
			tip.Parent = haloFolder
			local weldT = weldTo(headPart, tip, CFrame.new(0, 1.6, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -outerR))
			table.insert(haloParts, { Weld = weldT, Angle = angle, Radius = outerR, Height = 1.6, Tilt = 0, Direction = 1, Bob = i * 0.4 })
		end
		-- соединительные лучи между вершинами (звезда)
		for i = 0, points - 1 do
			local a1 = (i / points) * math.pi * 2 - math.pi / 2
			local a2 = ((i + 2) / points) * math.pi * 2 - math.pi / 2
			local p1 = Vector3.new(math.cos(a1) * outerR, 0, math.sin(a1) * outerR)
			local p2 = Vector3.new(math.cos(a2) * outerR, 0, math.sin(a2) * outerR)
			local mid = (p1 + p2) * 0.5
			local dist = (p1 - p2).Magnitude
			local ang = math.atan2(p2.X - p1.X, p2.Z - p1.Z)
			local bar = newNeonPart(Vector3.new(0.06, 0.06, dist), colAt((i + 1) / points))
			bar.Transparency = 0.3
			bar.Parent = haloFolder
			local weld = weldTo(headPart, bar, CFrame.new(mid.X, 1.6, mid.Z) * CFrame.Angles(0, ang, 0) * CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = ang, Radius = mid.Magnitude, Height = 1.6, Tilt = 0, Direction = 1 })
		end
		smoothRing(0.45, 1.6, 16, 0, 1, 0.06)
	elseif style == "Crown" then
		-- Crown: кольцо-основа + высокие шипы-зубцы короны + орбы на вершинах + искры
		torusRing(0.85, 1.5, 28, 0, 1, 0.09)
		smoothRing(0.85, 1.5, 28, 0, 1, 0.06)
		local spikes = 8
		for i = 1, spikes do
			local angle = (i / spikes) * math.pi * 2
			local t = (i - 1) / spikes
			local spike = newNeonPart(Vector3.new(0.12, 0.55, 0.12), colAt(t + 0.1))
			spike.Parent = haloFolder
			local weld = weldTo(headPart, spike, CFrame.new(0, 1.7, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.85) * CFrame.Angles(math.rad(-18), 0, 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = 0.85, Height = 1.7, Tilt = math.rad(-18), Direction = 1 })
			-- орб на вершине шипа
			local topOrb = newNeonPart(Vector3.new(0.18, 0.18, 0.18), light, "Part")
			topOrb.Shape = Enum.PartType.Ball
			topOrb.Parent = haloFolder
			local weldO = weldTo(headPart, topOrb, CFrame.new(0, 2.0, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -0.85))
			table.insert(haloParts, { Weld = weldO, Angle = angle, Radius = 0.85, Height = 2.0, Tilt = 0, Direction = 1, Bob = i * 0.3 })
		end
		orbitOrbs(8, 0.85, 1.82, 0.14, 0, 1, 0.4)
	elseif style == "Sun" then
		-- Sun: яркое ядро + 12 лучей разной длины + внешнее кольцо + искры
		local core = newNeonPart(Vector3.new(0.4, 0.4, 0.4), light, "Part")
		core.Shape = Enum.PartType.Ball
		core.Parent = haloFolder
		local coreWeld = weldTo(headPart, core, CFrame.new(0, 1.6, 0))
		table.insert(haloParts, { Weld = coreWeld, Angle = 0, Radius = 0, Height = 1.6, Tilt = 0, Direction = 1 })
		-- второе ядро (свечение)
		local core2 = newNeonPart(Vector3.new(0.25, 0.25, 0.25), colAt(0.1), "Part")
		core2.Shape = Enum.PartType.Ball
		core2.Transparency = 0.3
		core2.Parent = haloFolder
		local core2Weld = weldTo(headPart, core2, CFrame.new(0, 1.6, 0))
		table.insert(haloParts, { Weld = core2Weld, Angle = 0, Radius = 0, Height = 1.6, Tilt = 0, Direction = 1, Bob = 0.5 })
		rayBurst(14, 0.5, 1.6, 0.55, 0.8, 0.07)
		smoothRing(1.0, 1.6, 28, 0, -1, 0.04)
	elseif style == "Hexagon" then
		-- Hexagon: 6-угольник из сегментов + узлы-орбы на вершинах + внутренний шестиугольник + искры
		local sides = 6
		local radius = 0.9
		local chord = (2 * math.pi * radius / sides) * 1.08
		for i = 1, sides do
			local angle = (i / sides) * math.pi * 2
			local t = (i - 1) / sides
			local piece = newNeonPart(Vector3.new(0.12, 0.12, chord), colAt(t))
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, 1.6, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius) * CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = radius, Height = 1.6, Tilt = 0, Direction = 1 })
			local node = newNeonPart(Vector3.new(0.24, 0.24, 0.24), light, "Part")
			node.Shape = Enum.PartType.Ball
			node.Parent = haloFolder
			local weldN = weldTo(headPart, node, CFrame.new(0, 1.6, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius))
			table.insert(haloParts, { Weld = weldN, Angle = angle, Radius = radius, Height = 1.6, Tilt = 0, Direction = 1, Bob = i * 0.3 })
		end
		-- внутренний шестиугольник (меньший)
		local innerR = 0.5
		local innerChord = (2 * math.pi * innerR / sides) * 1.08
		for i = 1, sides do
			local angle = (i / sides) * math.pi * 2 + math.rad(30)
			local piece = newNeonPart(Vector3.new(0.07, 0.07, innerChord), colAt((i + 2) / sides))
			piece.Transparency = 0.2
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, 1.6, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -innerR) * CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = innerR, Height = 1.6, Tilt = 0, Direction = -1 })
		end
	elseif style == "Lotus" then
		-- Lotus: 8 лепестков лотоса (двойных) + центральное кольцо + искры + внутренние орбы
		local petals = 8
		for i = 1, petals do
			local angle = (i / petals) * math.pi * 2
			local t = (i - 1) / petals
			-- внешний лепесток
			local segLen = 0.5
			local piece = newNeonPart(Vector3.new(0.08, 0.08, segLen), colAt(t))
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, 1.6, 0)
				* CFrame.Angles(math.rad(22), angle, 0)
				* CFrame.new(0, 0, -0.8)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = 0.8, Height = 1.6, Tilt = math.rad(22), Direction = 1 })
			-- кончик лепестка
			local tip = newNeonPart(Vector3.new(0.18, 0.18, 0.18), light, "Part")
			tip.Shape = Enum.PartType.Ball
			tip.Parent = haloFolder
			local weldT = weldTo(headPart, tip, CFrame.new(0, 1.6, 0)
				* CFrame.Angles(math.rad(22), angle, 0)
				* CFrame.new(0, 0, -1.0))
			table.insert(haloParts, { Weld = weldT, Angle = angle, Radius = 1.0, Height = 1.6, Tilt = math.rad(22), Direction = 1, Bob = i * 0.3 })
			-- внутренний лепесток (короче)
			local inner = newNeonPart(Vector3.new(0.06, 0.06, 0.3), colAt(t + 0.2))
			inner.Transparency = 0.15
			inner.Parent = haloFolder
			local weldI = weldTo(headPart, inner, CFrame.new(0, 1.6, 0)
				* CFrame.Angles(math.rad(35), angle, 0)
				* CFrame.new(0, 0, -0.55)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weldI, Angle = angle, Radius = 0.55, Height = 1.6, Tilt = math.rad(35), Direction = -1 })
		end
		torusRing(0.4, 1.6, 16, 0.06)
		orbitOrbs(4, 0.3, 1.6, 0.12, 0, 1, 0.8)
	elseif style == "Infinity" then
		-- Infinity: фигура в виде восьмёрки (∞) из двух пересекающихся колец + искры + центральные орбы
		smoothRing(0.6, 1.6, 24, 0, 1, 0.07)
		-- правое кольцо смещено вбок
		for index = 1, 24 do
			local angle = (index / 24) * math.pi * 2
			local t = (index - 1) / 24
			local segLen = (2 * math.pi * 0.6 / 24) * 1.12
			local piece = newNeonPart(Vector3.new(0.07, 0.07, segLen), colAt(t))
			piece.Transparency = 0.08 + math.abs(math.sin(t * math.pi)) * 0.12
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(0.95, 1.6, 0)
				* CFrame.Angles(0, angle, math.rad(90))
				* CFrame.new(0, 0, -0.6)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = 0.6, Height = 1.6, Tilt = 0, Direction = 1, OffsetX = 0.95 })
		end
		-- симметричное левое кольцо
		for index = 1, 24 do
			local angle = (index / 24) * math.pi * 2
			local t = (index - 1) / 24
			local segLen = (2 * math.pi * 0.6 / 24) * 1.12
			local piece = newNeonPart(Vector3.new(0.07, 0.07, segLen), colAt(t))
			piece.Transparency = 0.08 + math.abs(math.sin(t * math.pi)) * 0.12
			piece.Parent = haloFolder
			local weld = weldTo(headPart, piece, CFrame.new(-0.95, 1.6, 0)
				* CFrame.Angles(0, angle, math.rad(90))
				* CFrame.new(0, 0, -0.6)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(haloParts, { Weld = weld, Angle = angle, Radius = 0.6, Height = 1.6, Tilt = 0, Direction = -1, OffsetX = -0.95 })
		end
		orbitOrbs(2, 0, 1.6, 0.2, 0, 1, 0.8)
	elseif style == "Prism" then
		-- Prism: 3 наклонённых призматических кольца под разными углами
		torusRing(0.9, 1.6, 30, 0.07)
		smoothRing(0.9, 1.6, 30, math.rad(22), 1, 0.07)
		smoothRing(0.9, 1.6, 30, math.rad(-22), -1, 0.07)
	elseif style == "Tech-Ring" then
		-- Tech-Ring: segmented tech ring with accent orbs
		smoothRing(0.9, 1.6, 12, 0, 1, 0.12)
		orbitOrbs(8, 1.2, 1.6, 0.15, 0, 1, 0.5)

	elseif style == "Rune-Circle" then
		-- Rune-Circle: two counter-rotating thin rune rings + inner segmented ring
		smoothRing(0.9, 1.6, 16, math.rad(15), 1, 0.05)
		smoothRing(0.9, 1.6, 16, math.rad(-15), -1, 0.05)
		smoothRing(1.1, 1.6, 8, 0, 1, 0.08)

	elseif style == "Halo-Flower" then
		-- Halo-Flower: 6 petal-like arcs forming a flower around the head + centre orbs
		local petals = 6
		for i = 1, petals do
			local a = (i / petals) * math.pi * 2
			local pr = 0.85
			local segs = quantity(10, 6)
			local segLen = (math.pi * 0.6 * pr / segs) * 1.2
			for s = 1, segs do
				local tr = (s - 1) / segs
				local ang = a - 0.3 + tr * 0.6
				local rr = pr * math.sin(tr * math.pi)
				local hh = 1.6 + math.cos(tr * math.pi) * 0.35
				local piece = newNeonPart(Vector3.new(0.07, 0.07, segLen), colAt((i + s) / (petals + segs)))
				piece.Transparency = 0.1
				piece.Parent = haloFolder
				local weld = weldTo(headPart, piece, CFrame.new(0, hh, 0)
					* CFrame.Angles(0, ang, 0)
					* CFrame.new(0, 0, -rr)
					* CFrame.Angles(0, math.rad(90), 0))
				table.insert(haloParts, { Weld = weld, Angle = ang, Radius = rr, Height = hh, Tilt = 0, Direction = 1 })
			end
		end
		-- centre ring + orbiting pollen orbs
		smoothRing(0.45, 1.62, 18, 0, 1, 0.05)
		orbitOrbs(6, 0.55, 1.7, 0.1, 0, 1, 0.5)

	elseif style == "Galactic-Disc" then
		-- Galactic-Disc: a tilted wide segmented disc + spiral arm orbs + bright core
		smoothRing(1.25, 1.55, 36, math.rad(18), 1, 0.05)
		smoothRing(1.05, 1.6, 30, math.rad(18), -1, 0.04)
		-- spiral arms of orbs
		local arms = 2
		local perArm = quantity(7, 4)
		for arm = 1, arms do
			local dir = (arm == 1) and 1 or -1
			for k = 1, perArm do
				local ratio = k / perArm
				local ang = (arm * math.pi + ratio * math.pi * 2 * dir)
				local rr = 0.4 + ratio * 0.95
				local hh = 1.6 + math.sin(ratio * math.pi) * 0.18
				local orb = newNeonPart(Vector3.new(0.1, 0.1, 0.1), colAt(ratio), "Part")
				orb.Shape = Enum.PartType.Ball
				orb.Transparency = 0.08
				orb.Parent = haloFolder
				local weld = weldTo(headPart, orb, CFrame.new(0, hh, 0) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -rr))
				table.insert(haloParts, { Weld = weld, Angle = ang, Radius = rr, Height = hh, Tilt = math.rad(18), Direction = dir, Bob = k * 0.3 })
			end
		end
		-- bright galactic core
		orbitOrbs(1, 0, 1.62, 0.22, 0, 1, 0)
	else
		-- Ring (default): объёмный тор + плавное градиентное кольцо + парящие орбы
		torusRing(0.9, 1.6, 28, 0.08)
		smoothRing(0.9, 1.6, 36, 0, 1, 0.06)
		orbitOrbs(8, 1.2, 1.6, 0.11, 0, 1, 0.6)
	end

	-- ===== NEW FEATURE: Halo.Aura — orbiting bobbing divine aura orbs =====
	if vis.Halo.Aura then
		-- inner layer: tight fast orbit close to the halo
		orbitOrbs(6, 1.0, 1.7, 0.13, math.rad(8), 1, 0.5)
		-- outer layer: wider, slower, counter-rotating, higher
		orbitOrbs(8, 1.45, 2.05, 0.10, math.rad(-6), -1, 0.7)
		-- floating sparkles drifting between the layers
		sparkles(10, 1.25, 1.9)
	end
	if vis.Halo.Glow then
		local pl = Instance.new("PointLight")
		pl.Color      = color
		pl.Brightness = 1.6
		pl.Range      = 9
		pl.Name       = "CrystalHub_HaloGlow"
		pl.Parent     = headPart
	end
end

--======================================================================--
--                        CHINA HAT (новый визуал)                      --
--======================================================================--
-- Собран без единого ассета: диски-цилиндры и радиальные сегменты.
-- Крепится к голове, вращается общим циклом анимации.

local function clearChinaHat()
	if hatFolder then
		hatFolder:Destroy()
	end
	hatFolder = nil
	hatParts  = {}
	if headPart then
		for _, child in ipairs(headPart:GetChildren()) do
			if child.Name == "CrystalHub_HatGlow" then
				child:Destroy()
			end
		end
	end
end

Visuals.HatStyles = { "Layered", "Cone", "Rings", "Spikes", "Crown", "Sun-Rays", "Aura", "Ice-Crystal", "Pagoda", "Diamond", "Lotus-Crown", "Obsidian-Spire" }

local function buildChinaHat()
	clearChinaHat()
	if not vis.ChinaHat.Enabled or not headPart then
		return
	end

	hatFolder = Instance.new("Folder")
	hatFolder.Name   = "CrystalHub_ChinaHat"
	hatFolder.Parent = character

	local color = vis.ChinaHat.Color
	local light = lighten(color, 0.35)
	local dark  = darken(color, 0.3)
	local size  = math.clamp(vis.ChinaHat.Size or 1, 0.4, 3)
	local style = vis.ChinaHat.Style
	local pc    = vis.ChinaHat.PresetColors
	local function colAt(ratio)
		return presetColorAt(pc, color, ratio)
	end

	-- плоский диск-цилиндр (шляпа набирается из них)
	local function disc(radius, height, thickness, transparency, discColor)
		local part = newNeonPart(Vector3.new(thickness, radius * 2, radius * 2), discColor or color, "Part")
		part.Shape        = Enum.PartType.Cylinder
		part.Transparency = transparency or 0.2
		part.Parent       = hatFolder
		local weld = weldTo(headPart, part, CFrame.new(0, height, 0) * CFrame.Angles(0, 0, math.rad(90)))
		table.insert(hatParts, { Weld = weld, Kind = "disc", Height = height })
		return part
	end

	-- кольцо из сегментов на заданном радиусе
	local function segRing(radius, height, segments, thickness, tilt, transparency)
		segments = quantity(segments, 6)
		local chord = (2 * math.pi * radius / segments) * 1.08
		for index = 1, segments do
			local angle = (index / segments) * math.pi * 2
			local t = (index - 1) / segments
			local piece = newNeonPart(Vector3.new(thickness, thickness, chord), colAt(t))
			piece.Transparency = transparency or 0.1
			piece.Parent       = hatFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, height, 0)
				* CFrame.Angles(tilt or 0, angle, 0)
				* CFrame.new(0, 0, -radius)
				* CFrame.Angles(0, math.rad(90), 0))
			table.insert(hatParts, {
				Weld   = weld,
				Kind   = "seg",
				Angle  = angle,
				Radius = radius,
				Height = height,
				Tilt   = tilt or 0,
			})
		end
	end

	-- радиальные шипы по краю
	local function spikes(count, radius, height, length)
		count = quantity(count, 4)
		for index = 1, count do
			local angle = (index / count) * math.pi * 2
			local t = (index - 1) / count
			local piece = newNeonPart(Vector3.new(0.09 * size, 0.09 * size, length), colAt(t + 0.1))
			piece.Transparency = 0.05
			piece.Parent       = hatFolder
			local weld = weldTo(headPart, piece, CFrame.new(0, height, 0)
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, 0, -(radius + length * 0.45)))
			table.insert(hatParts, {
				Weld   = weld,
				Kind   = "spike",
				Angle  = angle,
				Radius = radius + length * 0.45,
				Height = height,
			})
		end
	end

	-- камни-орбы (шары) на заданном радиусе
	local function orbs(count, radius, height, orbSize, yOffset)
		count = quantity(count, 6)
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local t = (i - 1) / count
			local gem = newNeonPart(Vector3.new(orbSize, orbSize, orbSize), colAt(t), "Part")
			gem.Shape = Enum.PartType.Ball
			gem.Transparency = 0.08
			gem.Parent = hatFolder
			weldTo(headPart, gem, CFrame.new(0, height, 0) * CFrame.Angles(0, angle, 0)
				* CFrame.new(0, yOffset or 0, -radius))
		end
	end

	-- висячие украшения-подвески по краю
	local function pendants(count, radius, height, length)
		count = quantity(count, 6)
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local t = (i - 1) / count
			-- нить
			local cord = newNeonPart(Vector3.new(0.03 * size, length, 0.03 * size), colAt(t))
			cord.Transparency = 0.15
			cord.Parent = hatFolder
			weldTo(headPart, cord, CFrame.new(0, height - length * 0.5, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius))
			-- орб на конце
			local bead = newNeonPart(Vector3.new(0.12 * size, 0.12 * size, 0.12 * size), light, "Part")
			bead.Shape = Enum.PartType.Ball
			bead.Parent = hatFolder
			weldTo(headPart, bead, CFrame.new(0, height - length, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius))
		end
	end

	if style == "Cone" then
		-- Cone: гладкий конус из дисков + орб-вершина + шпиль + кольцо-основание
		local steps = quantity(8, 5)
		for index = 1, steps do
			local ratio  = (index - 1) / (steps - 1)
			local radius = (2.8 - ratio * 2.5) * size
			local height = (1.75 + ratio * 1.6) * size
			disc(radius, height, 0.14 * size, 0.15, colAt(ratio))
		end
		segRing(2.85 * size, 1.72 * size, 28, 0.08 * size, 0, 0)
		-- сияющий шар на вершине конуса
		orbs(1, 0, (1.75 + 1.6 + 0.3) * size, 0.3 * size, 0)
		disc(0.16 * size, (1.75 + 1.6 + 0.2) * size, 0.4 * size, 0.04, light)
		pendants(6, 2.7 * size, 1.68 * size, 0.4 * size)
	elseif style == "Rings" then
		-- Rings: три кольца разного радиуса + парящие орбы + шпиль + подвески
		segRing(2.7 * size, 1.8 * size, 28, 0.1 * size, 0, 0)
		segRing(1.8 * size, 2.3 * size, 22, 0.09 * size, 0, 0.05)
		segRing(1.0 * size, 2.8 * size, 16, 0.08 * size, 0, 0.1)
		disc(0.28 * size, 3.5 * size, 0.5 * size, 0.05, light)
		orbs(8, 1.8 * size, 2.3 * size, 0.14 * size, 0)
		orbs(1, 0, 3.7 * size, 0.22 * size, 0)
		pendants(6, 2.6 * size, 1.75 * size, 0.35 * size)
	elseif style == "Spikes" then
		-- Spikes: мощная шипастая корона — длинные шипы + кольцо-основа
		for index = 1, 3 do
			local ratio = (index - 1) / 2
			disc((2.6 - ratio * 2.1) * size, (1.8 + ratio * 1.2) * size, 0.16 * size, 0.2,
				colAt(ratio))
		end
		spikes(12, 2.65 * size, 1.82 * size, 0.9 * size)
		segRing(2.7 * size, 1.78 * size, 26, 0.08 * size, 0, 0)
		orbs(1, 0, 3.3 * size, 0.2 * size, 0)
	elseif style == "Crown" then
		-- Crown: классическая корона — основание-диск + длинные шипы-зубцы + орбы на вершинах + подвески
		disc(2.0 * size, 1.8 * size, 0.16 * size, 0.12, colAt(0.3))
		segRing(2.05 * size, 1.82 * size, 24, 0.1 * size, 0, 0)
		spikes(8, 1.95 * size, 1.85 * size, 1.2 * size)
		orbs(8, 1.95 * size, 2.4 * size, 0.2 * size, 0)
		orbs(1, 0, 2.7 * size, 0.28 * size, 0)
		pendants(8, 1.9 * size, 1.75 * size, 0.3 * size)
	elseif style == "Sun-Rays" then
		-- Sun-Rays: солнечный диск + 14 лучей разной длины + кольцо + центральный шар + искры
		disc(1.4 * size, 2.0 * size, 0.3 * size, 0.06, colAt(0.1))
		local rayCount = 14
		for i = 1, rayCount do
			local angle = (i / rayCount) * math.pi * 2
			local t = (i - 1) / rayCount
			local rayLen = (0.8 + (i % 2 == 0 and 0.3 or 0)) * size
			local ray = newNeonPart(Vector3.new(0.1 * size, 0.1 * size, rayLen), colAt(t))
			ray.Transparency = 0.08
			ray.Parent = hatFolder
			weldTo(headPart, ray, CFrame.new(0, 2.0 * size, 0)
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, 0, -(1.4 * size + rayLen * 0.5))
				* CFrame.Angles(0, math.rad(90), 0))
		end
		segRing(1.45 * size, 2.05 * size, 24, 0.18 * size, 0, 0)
		orbs(1, 0, 2.4 * size, 0.25 * size, 0)
	elseif style == "Aura" then
		-- Aura: парящее кольцо из орбов + лёгкий диск-аура + сегмент-ореол
		disc(1.4 * size, 1.9 * size, 0.04 * size, 0.6, colAt(0.4))
		orbs(12, 1.1 * size, 1.85 * size, 0.22 * size, 0)
		segRing(1.5 * size, 1.9 * size, 18, 0.05 * size, 0, 0.3)
	elseif style == "Ice-Crystal" then
		-- Ice-Crystal: кристаллическая шапка + 8 осколков + кольцо-основа + шпиль + искры
		disc(1.5 * size, 1.85 * size, 0.14 * size, 0.2, colAt(0.1))
		segRing(1.55 * size, 1.88 * size, 20, 0.22 * size, 0, 0)
		local shards = 8
		for i = 1, shards do
			local angle = (i / shards) * math.pi * 2
			local t = (i - 1) / shards
			local sh = newNeonPart(Vector3.new(0.12 * size, 0.12 * size, (1.0 + (i % 2) * 0.4) * size), colAt(t + 0.15))
			sh.Transparency = 0.06
			sh.Parent = hatFolder
			weldTo(headPart, sh, CFrame.new(0, 1.9 * size, 0)
				* CFrame.Angles(math.rad(22), angle, 0)
				* CFrame.new(0, 0, -1.5 * size)
				* CFrame.Angles(math.rad(90), 0, 0))
		end
		-- центральный кристалл-шпиль
		for index = 1, 2 do
			local ratio = (index - 1) / 1
			disc((0.4 - ratio * 0.3) * size, (2.3 + ratio * 0.5) * size, 0.12 * size, 0.1, colAt(0.5 + ratio * 0.3))
		end
		disc(0.25 * size, 2.9 * size, 0.4 * size, 0.04, light)
		orbs(1, 0, 3.1 * size, 0.22 * size, 0)
	elseif style == "Pagoda" then
		-- Pagoda: многоярусная башня-пагода с загнутыми вверх краями крыш + шпиль + подвески
		local tiers = 3
		for tier = 1, tiers do
			local tierRatio = (tier - 1) / (tiers - 1)
			local baseH = (1.7 + tierRatio * 2.0) * size
			local roofR = (2.6 - tierRatio * 1.6) * size
			disc(roofR, baseH, 0.16 * size, 0.15, colAt(tierRatio))
			spikes(8, roofR - 0.1 * size, baseH, 0.45 * size)
			segRing(roofR * 0.55, baseH + 0.3 * size, 18, 0.08 * size, 0, 0.1)
		end
		disc(0.18 * size, (1.7 + 2.0 + 0.4) * size, 0.7 * size, 0.04, light)
		orbs(1, 0, (1.7 + 2.0 + 0.85) * size, 0.28 * size, 0)
		pendants(6, 2.5 * size, 1.68 * size, 0.4 * size)
	elseif style == "Diamond" then
		-- Diamond: огранённый алмаз — октаэдр из дисков + сияющие рёбра-грани + шпиль + кольцо-основание
		-- нижняя пирамида (расширяется вверх)
		for index = 1, 4 do
			local ratio = (index - 1) / 3
			local radius = (0.3 + ratio * 1.9) * size
			local height = (1.7 + ratio * 0.7) * size
			disc(radius, height, 0.1 * size, 0.18, colAt(ratio * 0.5))
		end
		-- верхняя пирамида (сужается к вершине)
		for index = 1, 4 do
			local ratio = (index - 1) / 3
			local radius = (2.2 - ratio * 1.9) * size
			local height = (2.4 + ratio * 0.9) * size
			disc(radius, height, 0.1 * size, 0.18, colAt(0.5 + ratio * 0.5))
		end
		-- сияющие рёбра-грани
		for i = 1, 8 do
			local angle = (i / 8) * math.pi * 2
			local t = (i - 1) / 8
			local edge = newNeonPart(Vector3.new(0.07 * size, 0.07 * size, 2.2 * size), light)
			edge.Transparency = 0.08
			edge.Parent = hatFolder
			local weld = weldTo(headPart, edge, CFrame.new(0, 2.4 * size, 0)
				* CFrame.Angles(math.rad(45), angle, 0)
				* CFrame.new(0, 0, -1.3 * size)
				* CFrame.Angles(math.rad(90), 0, 0))
			table.insert(hatParts, { Weld = weld, Kind = "seg", Angle = angle, Radius = 1.3 * size, Height = 2.4 * size, Tilt = math.rad(45) })
		end
		-- сверкающий шар-вершина
		orbs(1, 0, 3.5 * size, 0.3 * size, 0)
		segRing(2.3 * size, 1.72 * size, 24, 0.08 * size, 0, 0)

	elseif style == "Lotus-Crown" then
		-- Lotus-Crown: layered lotus petals fanning upward + jewelled centre + base ring
		local petals = 8
		for layer = 1, 3 do
			local layR = (3 - layer) / 2
			for i = 1, quantity(petals, 5) do
				local a = (i / petals) * math.pi * 2 + layer * 0.2
				local ph = (1.7 + layer * 0.55) * size
				local pw = (0.5 - layer * 0.08) * size
				local pt = 0.08 * size
				local petal = newNeonPart(Vector3.new(pt, (1.2 + layer * 0.3) * size, pw), colAt(layR))
				petal.Transparency = 0.12
				petal.Parent = hatFolder
				local weld = weldTo(headPart, petal, CFrame.new(0, ph, 0)
					* CFrame.Angles(math.rad(35 - layer * 8), a, 0)
					* CFrame.new(0, 0, -(1.4 - layer * 0.25) * size)
					* CFrame.Angles(math.rad(90), 0, 0))
				table.insert(hatParts, { Weld = weld, Kind = "seg", Angle = a, Radius = (1.4 - layer * 0.25) * size, Height = ph, Tilt = math.rad(35 - layer * 8) })
			end
		end
		-- jewelled centre + base ring
		orbs(1, 0, 3.6 * size, 0.28 * size, 0)
		segRing(2.4 * size, 1.7 * size, 22, 0.07 * size, 0, 0)
		orbs(8, 2.2 * size, 1.7 * size, 0.12 * size, 0)

	elseif style == "Obsidian-Spire" then
		-- Obsidian-Spire: dark tapering obsidian spire with glowing cracks + sharp tip
		local steps = 7
		for index = 1, steps do
			local ratio = (index - 1) / (steps - 1)
			local radius = (1.6 - ratio * 1.45) * size
			local height = (1.8 + ratio * 2.2) * size
			-- dark obsidian disc
			local d = disc(radius, height, 0.14 * size, 0.1, darken(color, 0.35))
