						Spread = spread + math.rad(10 + nextRatio * 6), Sweep = math.rad(24),
						Pitch = math.rad(-10 - ratio * 8),
						OriginX = 0.52 * scale, OriginY = 0.2 * scale, OriginZ = 0.66 * scale,
						Color = colAt(ratio * 0.5 + 0.1), Transparency = 0.5,
						Phase = index * 0.28 + 0.07, Amp = 0.1 + ratio * 0.1,
					})
				end
			end
			-- второй слой перепонок (более прозрачный)
			for index = 1, fingers - 1 do
				local t = index / fingers
				addFeather(side, {
					Length = ((5.2 - t * 2.0) * 0.6) * scale, Width = 0.3 * scale, Thickness = 0.03 * scale,
					Spread = math.rad(48 + t * 76) + math.rad(5), Sweep = math.rad(24),
					Pitch = math.rad(-10 - t * 8),
					OriginX = 0.52 * scale, OriginY = 0.18 * scale, OriginZ = 0.6 * scale,
