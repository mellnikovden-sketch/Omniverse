                        {CFrame.new( half, 0,  half),    CFrame.Angles(0, 0, 0),            cubeSz},
                        {CFrame.new( half, 0, -half),    CFrame.Angles(0, 0, 0),            cubeSz},
                        {CFrame.new(-half, 0,  half),    CFrame.Angles(0, 0, 0),            cubeSz},
                        {CFrame.new(-half, 0, -half),    CFrame.Angles(0, 0, 0),            cubeSz},
                }
                for _, ed in ipairs(edgeDefs) do
                        local bar = newNeonPart(Vector3.new(barThick, barThick, ed[3]), lighten(col, 0.4), "Part")
                        bar.Material = Enum.Material.Neon
                        bar.Transparency = 0.1
                        bar.Parent = petFolder
                        table.insert(petExtra.edges, { part = bar, offset = ed[1], rot = ed[2] })
                end
                -- inner beating heart: a small glowing sphere with a soft pink/magenta tint
                petExtra.core = makePetPart(Vector3.new(cubeSz * 0.38, cubeSz * 0.38, cubeSz * 0.38), col:Lerp(Color3.fromRGB(255, 90, 160), 0.6), Enum.PartType.Ball)
                petExtra.core.Material = Enum.Material.Neon
                petExtra.core.Transparency = 0.25
                petExtra.core.Parent = petFolder
                -- 4 corner orbs (like portal companion cube dimples) glowing
                petExtra.corners = {}
                local cornerSz = cubeSz * 0.16
                local cornerOff = half * 0.78
                local cornerPos = {
                        Vector3.new( cornerOff,  cornerOff, 0),
                        Vector3.new(-cornerOff,  cornerOff, 0),
                        Vector3.new( cornerOff, -cornerOff, 0),
                        Vector3.new(-cornerOff, -cornerOff, 0),
                }
                for _, cp in ipairs(cornerPos) do
                        local co = newNeonPart(Vector3.new(cornerSz, cornerSz, cornerSz), lighten(col, 0.5), "Part")
                        co.Shape = Enum.PartType.Ball
                        co.Material = Enum.Material.Neon
                        co.Transparency = 0.05
                        co.Parent = petFolder
                        table.insert(petExtra.corners, { part = co, offset = cp })
                end

        elseif style == "Mini-Sun" then
                -- Mini-Sun: glowing fiery core + radiating solar rays + flare sparks
                petOrb = makePetPart(Vector3.new(sz * 1.1, sz * 1.1, sz * 1.1), lighten(col, 0.4):Lerp(Color3.fromRGB(255, 180, 40), 0.5), Enum.PartType.Ball)
                petOrb.Parent = petFolder
                petLight = Instance.new("PointLight")
                petLight.Color = Color3.fromRGB(255, 200, 80)
                petLight.Brightness = 5
                petLight.Range = 16
                petLight.Shadows = false
                petLight.Parent = petOrb
                if vis.Extra.SoulPet.Trail then
                        petTrail = makePetTrail(petOrb, sz * 1.1, Color3.fromRGB(255, 200, 80), 2.0, 0.7, 0.1)
                end
                -- radiating solar rays (thin wedges) stored in petExtra.rays
                petExtra.rays = {}
                if not IS_PHONE then
                        for i = 1, 10 do
                                local ray = makePetPart(Vector3.new(0.06, 0.06, sz * 1.4), lighten(col, 0.5):Lerp(Color3.fromRGB(255, 220, 120), 0.4), Enum.PartType.Block)
                                ray.Parent = petFolder
                                table.insert(petExtra.rays, ray)
                        end
                end
                -- flare sparks
                petExtra.sparks = {}
                if not IS_PHONE then
                        for i = 1, 8 do
                                local sp = makePetPart(Vector3.new(0.08, 0.08, 0.08), Color3.fromRGB(255, 230, 140), Enum.PartType.Ball)
                                sp.Parent = petFolder
                                table.insert(petExtra.sparks, sp)
                        end
                end

        elseif style == "Lightning-Orb" then
                -- Lightning-Orb: crackling electric sphere + jagged bolt shards + pulsing light
                petOrb = makePetPart(Vector3.new(sz * 1.0, sz * 1.0, sz * 1.0), lighten(col, 0.3):Lerp(Color3.fromRGB(150, 200, 255), 0.4), Enum.PartType.Ball)
                petOrb.Parent = petFolder
                petLight = Instance.new("PointLight")
                petLight.Color = Color3.fromRGB(170, 210, 255)
                petLight.Brightness = 4
                petLight.Range = 14
                petLight.Shadows = false
                petLight.Parent = petOrb
                if vis.Extra.SoulPet.Trail then
                        petTrail = makePetTrail(petOrb, sz * 1.0, Color3.fromRGB(180, 220, 255), 1.6, 0.6, 0.15)
                end
                -- jagged bolt shards around the orb
                petExtra.bolts = {}
                if not IS_PHONE then
                        for i = 1, 7 do
                                local bolt = makePetPart(Vector3.new(0.07, 0.07, sz * 1.1), Color3.fromRGB(200, 230, 255), Enum.PartType.Block)
                                bolt.Parent = petFolder
                                table.insert(petExtra.bolts, bolt)
                        end
                end
                -- electric sparks
                petExtra.sparks = {}
                if not IS_PHONE then
                        for i = 1, 6 do
                                local sp = makePetPart(Vector3.new(0.06, 0.06, 0.06), Color3.fromRGB(220, 240, 255), Enum.PartType.Ball)
                                sp.Parent = petFolder
                                table.insert(petExtra.sparks, sp)
                        end
                end

        else
                -- Orb (default): классический шар + свет + трейл + 6 орбитальных искр + вторичный трейл
                petOrb = makePetPart(Vector3.new(sz, sz, sz), col, Enum.PartType.Ball)
                petOrb.Parent = petFolder
                petLight = Instance.new("PointLight")
                petLight.Color = col
                petLight.Brightness = 3.5
                petLight.Range = 12
                petLight.Shadows = false
                petLight.Parent = petOrb
                petTrail = makePetTrail(petOrb, sz, col, 1.8, 0.8, 0.2)
                -- вторичный трейл
                local tr2 = makePetTrail(petOrb, sz * 0.5, lighten(col, 0.4), 0.8, 0.4, 0.1)
                petExtra.sparks = {}
                if not IS_PHONE then
                        for i = 1, 6 do
                                local sp = makePetPart(Vector3.new(0.07, 0.07, 0.07), lighten(col, 0.3), Enum.PartType.Ball)
                                sp.Parent = petFolder
                                table.insert(petExtra.sparks, sp)
                        end
                end
        end
	-- ===== NEW FEATURE: PetAura — orbiting glowing spark ring around any pet style =====
	if vis.Extra.SoulPet.PetAura and petOrb and petOrb.Parent then
		petExtra.auraSparks = {}
		petExtra.auraCount = IS_PHONE and 5 or 8
		petExtra.auraR = cfg.Size * 1.0 + 0.45
		for i = 1, petExtra.auraCount do
			local asp = makePetPart(Vector3.new(0.08, 0.08, 0.08), lighten(col, 0.35), Enum.PartType.Ball)
			asp.Material = Enum.Material.Neon
			asp.Transparency = 0.1
			asp.Parent = petFolder
			table.insert(petExtra.auraSparks, asp)
		end
	end
end

local function clearSoulPet()
        if petConn then
                petConn:Disconnect()
                petConn = nil
        end
        if petFolder then
                petFolder:Destroy()
                petFolder = nil
        end
        petOrb = nil
        petLight = nil
        petTrail = nil
        petExtra = {}
end

local function ensureSoulPetLoop()
        if petConn then return end
        if not vis.Extra.SoulPet.Enabled then return end
        petConn = RunService.Heartbeat:Connect(function(dt)
                if not vis.Extra.SoulPet.Enabled or not character then return end
                local root = character:FindFirstChild("HumanoidRootPart") or torso
                if not root or not petFolder then return end
                local cfg   = vis.Extra.SoulPet
                local style = cfg.Style or "Orb"
                local t     = os.clock()
                local base  = root.Position
                local angle = t * cfg.Speed
                local h     = cfg.Height + math.sin(t * 1.5) * 0.8
                local pos   = base + Vector3.new(
                        math.cos(angle) * cfg.Distance,
                        h,
                        math.sin(angle) * cfg.Distance
                )
                if petOrb then
                        if style == "Comet" then
                                -- Comet: рывки — скорость меняется, вытянутая орбита
                                local dash = 1 + math.sin(t * 4) * 0.3
                                local cpos = base + Vector3.new(
                                        math.cos(angle) * cfg.Distance * dash,
                                        h + math.sin(t * 2.5) * 0.4,
                                        math.sin(angle) * cfg.Distance * dash
                                )
                                petOrb.CFrame = CFrame.new(cpos)
                                pos = cpos
                                if petLight then
                                        petLight.Brightness = 4 * (0.6 + math.abs(math.sin(t * 4)) * 0.4)
                                end
                        elseif style == "Fairy" then
                                -- Fairy: быстрые зигзаги + мерцание
                                local zig = Vector3.new(
                                        math.sin(t * 6) * 0.5,
                                        math.cos(t * 4) * 0.3,
                                        math.sin(t * 5 + 1) * 0.5
                                )
                                petOrb.CFrame = CFrame.new(pos + zig)
                                pos = pos + zig
                                if petLight then
                                        petLight.Brightness = 3 * (0.5 + math.abs(math.sin(t * 8)) * 0.5)
                                end
                        elseif style == "Ghost" then
                                -- Ghost: медленное плавное колыхание, большие амплитуды
                                local gpos = base + Vector3.new(
                                        math.cos(angle * 0.7) * cfg.Distance,
                                        cfg.Height + math.sin(t * 0.8) * 1.5,
                                        math.sin(angle * 0.7) * cfg.Distance
                                )
                                petOrb.CFrame = CFrame.new(gpos)
                                pos = gpos
                                if petOrb.Transparency then
                                        petOrb.Transparency = 0.4 + math.sin(t * 2) * 0.15
                                end
                                if petLight then
                                        petLight.Brightness = 2.5 * (0.7 + math.sin(t * 1.5) * 0.3)
                                end
                        elseif style == "Star" then
                                -- Star: вращается вокруг своей оси, пульсация
                                local sp = 1 + math.sin(t * 5) * 0.12
                                petOrb.CFrame = CFrame.new(pos) * CFrame.Angles(0, t * 3, 0)
                                if petLight then
                                        petLight.Brightness = 4 * (0.7 + math.sin(t * 6) * 0.3)
                                end
                                local baseSize = cfg.Size * 0.7
                                petOrb.Size = Vector3.new(baseSize * sp, baseSize * sp, baseSize * sp)
                        elseif style == "Butterfly" then
                                -- Butterfly: порхание — мягкие зигзаги вверх-вниз
                                local flut = Vector3.new(
                                        math.sin(t * 3) * 0.4,
                                        math.sin(t * 4) * 0.6,
                                        math.cos(t * 3.5) * 0.4
                                )
                                petOrb.CFrame = CFrame.new(pos + flut)
                                pos = pos + flut
                                if petLight then
                                        petLight.Brightness = 3 * (0.7 + math.abs(math.sin(t * 5)) * 0.3)
                                end
                        elseif style == "Phoenix" then
                                -- Phoenix: рывки вверх-вниз как взлёт, дрожание
                                local phPos = base + Vector3.new(
                                        math.cos(angle) * cfg.Distance,
                                        h + math.sin(t * 3) * 1.2 + math.abs(math.sin(t * 6)) * 0.3,
                                        math.sin(angle) * cfg.Distance
                                )
                                petOrb.CFrame = CFrame.new(phPos)
                                pos = phPos
                                if petLight then
                                        petLight.Brightness = 5 * (0.7 + math.abs(math.sin(t * 7)) * 0.3)
                                end
                        elseif style == "Wisp" then
                                -- Wisp: медленный дрейф, мерцание прозрачности
                                local wpos = base + Vector3.new(
                                        math.cos(angle * 0.6) * cfg.Distance,
                                        h + math.sin(t * 1.2) * 1.0,
                                        math.sin(angle * 0.6) * cfg.Distance
                                )
                                petOrb.CFrame = CFrame.new(wpos)
                                pos = wpos
                                if petOrb.Transparency then
                                        petOrb.Transparency = 0.2 + math.sin(t * 5) * 0.2
                                end
                                if petLight then
                                        petLight.Brightness = 4 * (0.5 + math.abs(math.sin(t * 6)) * 0.5)
                                end
                        elseif style == "Mini-Sun" then
                                -- Mini-Sun: пульсирующее солнце, яркая пульсация света
                                local pulse = 1 + math.sin(t * 4) * 0.18
                                petOrb.CFrame = CFrame.new(pos)
                                local bsz = cfg.Size * 1.1
                                petOrb.Size = Vector3.new(bsz * pulse, bsz * pulse, bsz * pulse)
                                if petLight then
                                        petLight.Brightness = 6 * (0.5 + math.abs(math.sin(t * 5)) * 0.5)
                                        petLight.Color = Color3.fromRGB(255, 200, 90):Lerp(Color3.fromRGB(255, 240, 180), 0.5 + math.sin(t * 4) * 0.5)
                                end
                        elseif style == "Lightning-Orb" then
                                -- Lightning-Orb: джиттерное электрическое движение + мерцание
                                local jit = Vector3.new(
                                        (math.random() - 0.5) * 0.4,
                                        (math.random() - 0.5) * 0.3,
                                        (math.random() - 0.5) * 0.4
                                )
                                petOrb.CFrame = CFrame.new(pos + jit)
                                pos = pos + jit
                                if petOrb.Transparency then
                                        petOrb.Transparency = 0.1 + math.abs(math.sin(t * 12)) * 0.25
                                end
                                if petLight then
                                        petLight.Brightness = 5 * (0.6 + math.abs(math.sin(t * 15)) * 0.4)
                                        petLight.Color = Color3.fromRGB(180, 220, 255)
                                end
                        else
                                -- Orb / Crystal: стандартная орбита + пульсация света
                                petOrb.CFrame = CFrame.new(pos)
                                if style == "Crystal" then
                                        petOrb.CFrame = CFrame.new(pos) * CFrame.Angles(t * 1.5, t * 2, 0)
                                end
                                if petLight then
                                        petLight.Brightness = 3.5 * (0.75 + math.sin(t * 3) * 0.25)
                                end
                        end
                end

                -- ===== Спец-анимация для новых стилей =====
                if style == "Star" and petExtra.rays then
                        local baseSize = cfg.Size
                        for i, ray in ipairs(petExtra.rays) do
                                local a = (i / #petExtra.rays) * math.pi * 2 + t * 2
                                local r = baseSize * 1.2
                                local tipPos = pos + Vector3.new(math.cos(a) * r, math.sin(a) * r, math.sin(a * 1.3) * 0.2)
                                -- луч от центра к кончику
                                local midPos = pos:Lerp(tipPos, 0.5)
                                ray.CFrame = CFrame.new(midPos) * CFrame.lookAt(midPos, tipPos) * CFrame.Angles(math.rad(90), 0, 0)
                                -- искра на кончике
                                if petExtra.tipSparks and petExtra.tipSparks[i] then
                                        petExtra.tipSparks[i].CFrame = CFrame.new(tipPos)
                                end
                        end
                        -- орбитальные искры (после ray-спарков)
                        if petExtra.tipSparks then
                                local orbStart = #petExtra.rays + 1
                                local orbCount = #petExtra.tipSparks - #petExtra.rays
                                for k = 1, orbCount do
                                        local idx = orbStart + k - 1
                                        local sp = petExtra.tipSparks[idx]
                                        if sp then
                                                local a = t * 4 + (k / orbCount) * math.pi * 2
                                                local r = cfg.Size * 1.8
                                                sp.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, math.sin(a * 2) * 0.4, math.sin(a) * r))
                                        end
                                end
                        end

                elseif style == "Butterfly" and petExtra.wings then
                        local flap = math.sin(t * 8) * 0.6 + 0.4 -- машущие крылья
                        for i = 1, #petExtra.wings, 2 do
                                local wing = petExtra.wings[i]
                                local wing2 = petExtra.wings[i + 1]
                                local side = (i == 1) and 1 or -1
                                local wingOff = cfg.Size * 0.7 * (0.5 + flap * 0.5)
                                if wing then
                                        wing.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(side * 70 * (1 - flap * 0.6)), 0)
                                                * CFrame.new(side * wingOff, 0, 0)
                                end
                                if wing2 then
                                        local wingOff2 = cfg.Size * 0.4 * (0.5 + flap * 0.5)
                                        wing2.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(side * 70 * (1 - flap * 0.6)), 0)
                                                * CFrame.new(side * wingOff2, -cfg.Size * 0.5, 0)
                                end
                        end
                        -- искры-пыльца с крыльев
                        if petExtra.sparks then
                                for k, sp in ipairs(petExtra.sparks) do
                                        local a = t * 3 + (k / #petExtra.sparks) * math.pi * 2
                                        local r = cfg.Size * (1.2 + math.sin(t * 5 + k) * 0.3)
                                        local sp2 = pos + Vector3.new(math.cos(a) * r, math.sin(t * 4 + k) * 0.5, math.sin(a) * r)
                                        sp.CFrame = CFrame.new(sp2)
                                end
                        end

                elseif style == "Phoenix" and petExtra.flames then
                        -- пламенные перья тянутся позади с колебанием
                        for i, fl in ipairs(petExtra.flames) do
                                local lag = i * 0.15
                                local a = angle - lag
                                local fpos = pos + Vector3.new(
                                        -math.cos(angle) * i * 0.15,
                                        -i * 0.1 + math.sin(t * 5 + i) * 0.15,
                                        -math.sin(angle) * i * 0.15
                                )
                                fl.CFrame = CFrame.new(fpos) * CFrame.Angles(math.rad(180 + math.sin(t * 4 + i) * 20), 0, 0)
                        end
                        -- искры огня разлетаются
                        if petExtra.sparks then
                                for k, sp in ipairs(petExtra.sparks) do
                                        local a = t * 6 + (k / #petExtra.sparks) * math.pi * 2
                                        local r = cfg.Size * (1.0 + math.sin(t * 8 + k) * 0.4)
                                        local yOff = math.sin(t * 7 + k * 1.5) * 0.6 - (t * 2 + k) % 2
                                        sp.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, yOff, math.sin(a) * r))
                                end
                        end

                elseif style == "Wisp" and petExtra.tendrils then
                        -- туманные щупальца дрейфуют и извиваются под шаром
                        for i, td in ipairs(petExtra.tendrils) do
                                local a = (i / #petExtra.tendrils) * math.pi * 2 + t * 0.8
                                local r = cfg.Size * 0.5
                                local base_pos = pos + Vector3.new(math.cos(a) * r, -cfg.Size * 0.5, math.sin(a) * r)
                                local tip = pos + Vector3.new(math.cos(a) * r * 1.5, -cfg.Size * 1.8 + math.sin(t * 2 + i) * 0.3, math.sin(a) * r * 1.5)
                                local mid = base_pos:Lerp(tip, 0.5)
                                td.CFrame = CFrame.new(mid) * CFrame.lookAt(mid, tip) * CFrame.Angles(math.rad(90), 0, 0)
                                td.Transparency = 0.35 + math.sin(t * 3 + i) * 0.15
                        end
                        -- мерцающие искры
                        if petExtra.sparks then
                                for k, sp in ipairs(petExtra.sparks) do
                                        if sp and sp.Parent ~= nil then
                                                local a = t * 2 + (k / #petExtra.sparks) * math.pi * 2
                                                local r = cfg.Size * 1.3
                                                local sp2 = pos + Vector3.new(math.cos(a) * r, math.sin(t * 3 + k) * 0.6, math.sin(a) * r)
                                                sp.CFrame = CFrame.new(sp2)
                                                sp.Transparency = 0.2 + math.sin(t * 6 + k) * 0.25
                                        end
                                end
                        end

                elseif style == "Dragonling" and petExtra.tail then
                        -- Dragonling: serpentine tail follows the orb's recorded path
                        -- record the orb's current position into a history buffer
                        petExtra.tailCounter = (petExtra.tailCounter or 0) + 1
                        if petExtra.tailCounter >= (petExtra.tailSpacing or 3) then
                                petExtra.tailCounter = 0
                                table.insert(petExtra.tailHistory, 1, pos)
                                -- keep enough history for every segment
                                local need = #petExtra.tail * (petExtra.tailSpacing or 3) + 4
                                while #petExtra.tailHistory > need do
                                        table.remove(petExtra.tailHistory)
                                end
                        end
                        local spacing = petExtra.tailSpacing or 3
                        for i, tp in ipairs(petExtra.tail) do
                                if tp and tp.Parent ~= nil then
                                        local histIdx = i * spacing + 1
                                        local hp = petExtra.tailHistory[histIdx]
                                        local tpos
                                        if hp then
                                                -- place segment along the recorded path with a gentle wave
                                                tpos = hp + Vector3.new(0, math.sin(t * 4 + i * 0.9) * 0.12 - i * 0.02, 0)
                                        else
                                                -- not enough history yet: trail straight behind the orb
                                                local back = (pos - base).Unit
                                                tpos = pos - back * (i * 0.18) + Vector3.new(0, math.sin(t * 4 + i * 0.9) * 0.12 - i * 0.02, 0)
                                        end
                                        tp.CFrame = CFrame.new(tpos)
                                end
                        end
                        -- position the two horns on the head, tilted backward
                        if petExtra.horns then
                                local back = (pos - base)
                                if back.Magnitude > 0.01 then back = back.Unit else back = Vector3.new(0,0,-1) end
                                local right = Vector3.new(-back.Z, 0, back.X)
                                if right.Magnitude < 0.01 then right = Vector3.new(1,0,0) end
                                for hi, horn in ipairs(petExtra.horns) do
                                        if horn and horn.Parent ~= nil then
                                                local side = (hi == 1) and 1 or -1
                                                local hp = pos + right * side * sz * 0.45 + Vector3.new(0, sz * 0.55, 0) - back * sz * 0.25
                                                horn.CFrame = CFrame.new(hp, hp + back) * CFrame.Angles(math.rad(20), 0, 0)
                                        end
                                end
                        end

                elseif style == "Eye of God" and petExtra.rings then
                        -- Eye of God: rotating halo rings around the orb on different axes
                        for _, ringData in ipairs(petExtra.rings) do
                                if ringData.part and ringData.part.Parent ~= nil then
                                        local rot = t * ringData.speed
                                        if ringData.axis == 1 then
                                                ringData.part.CFrame = CFrame.new(pos) * CFrame.Angles(rot, 0, 0)
                                        elseif ringData.axis == 2 then
                                                ringData.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, rot, 0)
                                        else
                                                ringData.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, rot)
                                        end
                                end
                        end

                elseif style == "Companion Cube" and petOrb and petOrb.Parent then
                        -- Companion Cube: slow tumble rotation, beating heart, glowing edge frame + corner dimples
                        local cubeSz = cfg.Size * 1.25
                        local spin = CFrame.Angles(t * 0.6, t * 0.9, t * 0.4)
                        local cubeCF = CFrame.new(pos) * spin
                        petOrb.CFrame = cubeCF
                        -- edge frame bars follow cube rotation
                        if petExtra.edges then
                                for _, ed in ipairs(petExtra.edges) do
                                        if ed.part and ed.part.Parent then
                                                ed.part.CFrame = cubeCF * ed.offset * ed.rot
                                        end
                                end
                        end
                        -- corner dimples
                        if petExtra.corners then
                                for _, co in ipairs(petExtra.corners) do
                                        if co.part and co.part.Parent then
                                                co.part.CFrame = cubeCF * co.offset
                                        end
                                end
                        end
                        -- beating heart: double-thump rhythm (lub-dub)
                        local beatT = t * 2.4
                        local dub = math.sin(beatT) ^ 2 + 0.5 * math.sin(beatT * 2 + 0.4) ^ 2
                        local heartPulse = 0.9 + dub * 0.35
                        if petExtra.core and petExtra.core.Parent then
                                petExtra.core.CFrame = cubeCF
                                local hs = cubeSz * 0.38 * heartPulse
                                petExtra.core.Size = Vector3.new(hs, hs, hs)
                                petExtra.core.Transparency = 0.2 + (1 - heartPulse) * 0.3
                        end
                elseif style == "Mini-Sun" and petExtra.rays then
                        -- Mini-Sun: солнечные лучи вращаются и пульсируют
                        local baseSize = cfg.Size
                        local rayPulse = 1 + math.sin(t * 4) * 0.2
                        for i, ray in ipairs(petExtra.rays) do
                                if ray and ray.Parent ~= nil then
                                        local a = (i / #petExtra.rays) * math.pi * 2 + t * 1.5
                                        local r = baseSize * 1.3 * rayPulse
                                        local tipPos = pos + Vector3.new(math.cos(a) * r, math.sin(a) * r * 0.8, math.sin(a) * r)
                                        local midPos = pos:Lerp(tipPos, 0.5)
                                        ray.CFrame = CFrame.new(midPos) * CFrame.lookAt(midPos, tipPos) * CFrame.Angles(math.rad(90), 0, 0)
                                        ray.Size = Vector3.new(baseSize * 0.08, baseSize * 1.1 * rayPulse, baseSize * 0.08)
                                        ray.Transparency = 0.15 + math.sin(t * 5 + i) * 0.1
                                end
                        end
                        -- искры-вспышки вокруг солнца
                        if petExtra.sparks then
                                for k, sp in ipairs(petExtra.sparks) do
                                        if sp and sp.Parent ~= nil then
                                                local a = t * 3 + (k / #petExtra.sparks) * math.pi * 2
                                                local r = cfg.Size * (1.6 + math.sin(t * 6 + k) * 0.4)
                                                sp.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, math.sin(a * 2) * 0.5, math.sin(a) * r))
                                                sp.Transparency = 0.2 + math.abs(math.sin(t * 8 + k)) * 0.3
                                        end
                                end
                        end
                elseif style == "Lightning-Orb" and petExtra.bolts then
                        -- Lightning-Orb: молнии-щупьцы трещат вокруг шара
                        local baseSize = cfg.Size
                        for i, bolt in ipairs(petExtra.bolts) do
                                if bolt and bolt.Parent ~= nil then
                                        local a = (i / #petExtra.bolts) * math.pi * 2 + t * 2
                                        local jitter = (math.random() - 0.5) * 0.3
                                        local r = baseSize * (1.0 + math.abs(math.sin(t * 10 + i)) * 0.4)
                                        local tipPos = pos + Vector3.new(math.cos(a) * r + jitter, math.sin(a) * r + jitter, math.sin(a) * r + jitter)
                                        local midPos = pos:Lerp(tipPos, 0.5)
                                        bolt.CFrame = CFrame.new(midPos) * CFrame.lookAt(midPos, tipPos) * CFrame.Angles(math.rad(90), 0, 0)
                                        -- мерцание молний
                                        bolt.Transparency = (math.random() < 0.3) and 0.8 or (0.1 + math.sin(t * 14 + i) * 0.2)
                                end
                        end
                        -- электрические искры поляёт вокруг
                        if petExtra.sparks then
                                for k, sp in ipairs(petExtra.sparks) do
                                        if sp and sp.Parent ~= nil then
                                                local a = t * 8 + (k / #petExtra.sparks) * math.pi * 2
                                                local r = cfg.Size * (1.2 + math.sin(t * 12 + k) * 0.5)
                                                sp.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, math.sin(a * 3) * 0.4, math.sin(a) * r))
                                                sp.Transparency = 0.1 + math.abs(math.sin(t * 16 + k)) * 0.4
                                        end
                                end
                        end
                else
                        -- ===== Орбитальные искры (для Orb, Comet, Fairy, Crystal, Ghost) =====
                        local sparkIdx = 0
                        for _, child in ipairs(petFolder:GetChildren()) do
                                if child ~= petOrb and child:IsA("BasePart") then
                                        sparkIdx = sparkIdx + 1
                                        local sr = cfg.Size * 1.5
                                        local sa, sx, sy, sz
                                        if style == "Comet" then
                                                -- хвостовые искры тянутся позади
                                                sa = t * 2 + (sparkIdx / 10) * 0.5
                                                sx = math.cos(angle - 0.3) * sr * (0.5 + sparkIdx * 0.1)
                                                sy = math.sin(t * 3 + sparkIdx) * 0.2
                                                sz = math.sin(angle - 0.3) * sr * (0.5 + sparkIdx * 0.1)
                                        elseif style == "Fairy" then
                                                -- блёстки хаотично мерцают вокруг
                                                sa = t * 5 + (sparkIdx / 14) * math.pi * 2
                                                sx = math.cos(sa) * sr * (0.6 + math.sin(t * 7 + sparkIdx) * 0.3)
                                                sy = math.sin(t * 6 + sparkIdx * 2) * 0.4
                                                sz = math.sin(sa) * sr * (0.6 + math.cos(t * 7 + sparkIdx) * 0.3)
                                        elseif style == "Crystal" then
                                                -- осколки-акценты вращаются по 6 осям
                                                sa = t * 2 + (sparkIdx / 10) * math.pi * 2
                                                sx = math.cos(sa) * sr
                                                sy = math.sin(sa * 2) * sr * 0.5
                                                sz = math.sin(sa) * sr
                                        elseif style == "Ghost" then
                                                -- редкие искры медленно дрейфуют
                                                sa = t * 0.8 + (sparkIdx / 7) * math.pi * 2
                                                sx = math.cos(sa) * sr * 1.2
                                                sy = math.sin(t * 1.2 + sparkIdx) * 0.6
                                                sz = math.sin(sa) * sr * 1.2
                                        else
                                                -- Orb: стандартная орбита
                                                sa = t * 3 + (sparkIdx / 6) * math.pi * 2
                                                sx = math.cos(sa) * sr
                                                sy = math.sin(sa * 2) * 0.3
                                                sz = math.sin(sa) * sr
                                        end
                                        child.CFrame = CFrame.new(pos + Vector3.new(sx, sy, sz))
                                end
                        end
                end
		-- PetAura: orbit the pet with glowing sparks in a tilted ring + pulse
		if petExtra.auraSparks and #petExtra.auraSparks > 0 then
			local aR = (petExtra.auraR or (cfg.Size + 0.45)) * (1 + math.sin(t * 3) * 0.12)
			local tilt = math.rad(25)
			for i, asp in ipairs(petExtra.auraSparks) do
				if asp and asp.Parent then
					local sa = t * 2.2 + (i / #petExtra.auraSparks) * math.pi * 2
					local sx = math.cos(sa) * aR
					local sy = math.sin(sa) * aR * math.sin(tilt)
					local sz = math.sin(sa) * aR * math.cos(tilt)
					asp.CFrame = CFrame.new(pos + Vector3.new(sx, sy, sz))
					local p2 = 0.9 + math.sin(t * 4 + i) * 0.1
					asp.Size = Vector3.new(0.08, 0.08, 0.08) * p2
					asp.Transparency = 0.1 + math.sin(t * 3 + i * 0.7) * 0.12
				end
			end
		end
        end)
end

