	petOrb.Shape, petOrb.Anchored, petOrb.Parent = (cfg.Style == "Crystal" and Enum.PartType.Block or Enum.PartType.Ball), true, petFolder
	petLight = Instance.new("PointLight") petLight.Color, petLight.Brightness, petLight.Range, petLight.Shadows, petLight.Parent = cfg.Color, 3.5, 12, false, petOrb
