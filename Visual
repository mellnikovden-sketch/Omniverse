local function spawnFlash(position, diameter, color, duration)
	local flash = Instance.new("Part")
	flash.Shape, flash.Size, flash.CFrame = Enum.PartType.Cylinder, Vector3.new(0.08, diameter * 0.45, diameter * 0.45), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	flash.Anchored, flash.CanCollide, flash.Material, flash.Color, flash.Transparency = true, false, Enum.Material.Neon, lighten(color, 0.45), 0.25
	flash.Parent = ensureFolder()
	TweenService:Create(flash, TweenInfo.new(duration * 0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = Vector3.new(0.02, diameter * 1.5, diameter * 1.5), Transparency = 1 }):Play()
	Debris:AddItem(flash, duration + 0.1)
end

local function spawnDisc(position, diameter, thickness, color, duration, expand)
	local disc = Instance.new("Part")
	disc.Shape, disc.Size, disc.CFrame = Enum.PartType.Cylinder, Vector3.new(thickness, diameter, diameter), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	disc.Anchored, disc.CanCollide, disc.Material, disc.Color, disc.Transparency = true, false, Enum.Material.Neon, color, 0.15
	disc.Parent = ensureFolder()
	TweenService:Create(disc, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = Vector3.new(thickness * 0.4, diameter * expand, diameter * expand), Transparency = 1 }):Play()
	Debris:AddItem(disc, duration + 0.15)
end

local function spawnArcRing(origin, opts)
	local segments, sweep, startAngle, radius0, radius1, thickness, duration, spin, tilt, fade, rise, color = 
		quantity(opts.Segments or 26, 8), opts.Sweep or (math.pi * 2), opts.Start or 0, opts.Radius0 or 1.2, opts.Radius1 or 8, opts.Thickness or 0.22, opts.Duration or 0.7, opts.Spin or 0, opts.Tilt or 0, opts.Fade or 0, opts.Rise or 0, opts.Color or Color3.fromRGB(255, 255, 255)
	
	local tipColor, chord0, chord1 = lighten(color, 0.5), (sweep * radius0 / segments) * 1.08, (sweep * radius1 / segments) * 1.08
	local info, base, folder = TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), CFrame.new(origin) * CFrame.Angles(tilt, 0, 0), ensureFolder()

	for index = 1, segments do
		local ratio = (index - 1) / segments
		local angle = startAngle + ratio * sweep
		local piece = newNeonPart(Vector3.new(thickness, thickness, chord0), color:Lerp(tipColor, ratio))
		piece.CFrame = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius0) * CFrame.Angles(0, math.rad(90), 0)
		piece.Anchored, piece.Transparency, piece.Parent = true, math.clamp(fade * ratio, 0, 0.9), folder
		TweenService:Create(piece, info, { CFrame = base * CFrame.Angles(0, angle + spin, 0) * CFrame.new(0, rise, -radius1) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(thickness * 0.32, thickness * 0.32, chord1), Transparency = 1 }):Play()
		Debris:AddItem(piece, duration + 0.2)
	end
end

local function spawnShard(pos, angle, color, duration, height, distance)
	local shard = newNeonPart(Vector3.new(0.18, 1.1, 0.18), color)
	shard.Anchored, shard.Transparency, shard.CFrame, shard.Parent = true, 0.1, CFrame.new(pos) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.4, -1), ensureFolder()
	TweenService:Create(shard, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { CFrame = CFrame.new(pos) * CFrame.Angles(0, angle, 0) * CFrame.new(0, height or 2.2, -(distance or 4.5)), Size = Vector3.new(0.05, 0.3, 0.05), Transparency = 1 }):Play()
	Debris:AddItem(shard, duration + 0.15)
end

local function spawnSparks(origin, color, duration, count, radius)
	if not vis.Jump.Sparks then return end
	local total = quantity(count or 10, 4)
	for index = 1, total do
		local angle = (index / total) * math.pi * 2 + math.random() * 0.4
		local spark = newNeonPart(Vector3.new(0.16, 0.16, 0.16), lighten(color, 0.3), "Part")
		spark.Shape, spark.Anchored, spark.Transparency, spark.CFrame = Enum.PartType.Ball, true, 0.1, CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -0.6)
		spark.Parent = ensureFolder()
		local far, high = (radius or 4) * (0.6 + math.random() * 0.7), 1.4 + math.random() * 2.2
		TweenService:Create(spark, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, high, -far), Size = Vector3.new(0.03, 0.03, 0.03), Transparency = 1 }):Play()
		Debris:AddItem(spark, duration + 0.15)
	end
end

