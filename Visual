	local track = Instance.new("TextButton") track.Size, track.Position, track.BackgroundColor3, track.Text, track.Parent = UDim2.new(1, -24, 0, 8), UDim2.new(0, 12, 0, 32), Color3.fromRGB(40, 40, 50), "", row
	local tCorn = Instance.new("UICorner") tCorn.CornerRadius, tCorn.Parent = UDim.new(1, 0), track
	local fill = Instance.new("Frame") fill.Size, fill.BackgroundColor3, fill.Parent = UDim2.new(math.clamp((default-min)/(max-min), 0, 1), 0, 1, 0), Color3.fromRGB(0, 150, 255), track
	local fCorn = Instance.new("UICorner") fCorn.CornerRadius, fCorn.Parent = UDim.new(1, 0), fill

	local dragging = false
	local function update(input)
		local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		local val = math.floor((min + (max - min) * pct) * 100 + 0.5) / 100
		valLbl.Text = tostring(val)
		callback(val)
	end
	track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true update(input) end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
	UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
end

