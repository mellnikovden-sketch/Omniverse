--                      ДРУГИЕ ЭФФЕКТЫ (GLOW / BIND)                     --
-- ====================================================================== --
local function clearGlow() if glowConn then glowConn:Disconnect() glowConn = nil end if glowLight then glowLight:Destroy() glowLight = nil end end
local function buildGlow()
	if not torso then return end clearGlow()
	glowLight = Instance.new("PointLight") glowLight.Name, glowLight.Color, glowLight.Range, glowLight.Brightness, glowLight.Shadows, glowLight.Parent = "CH_Glow", vis.Extra.Glow.Color, vis.Extra.Glow.Range, vis.Extra.Glow.Brightness, false, torso
end
local function ensureGlowLoop()
	if glowConn then return end
	glowConn = RunService.Heartbeat:Connect(function()
		if not vis.Extra.Glow.Enabled or not glowLight then return end
		if vis.Extra.Glow.Pulse then glowLight.Brightness = vis.Extra.Glow.Brightness * (0.7 + math.sin(os.clock() * 2.2) * 0.3) end
	end)
end

local function bindCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid", 5)
	torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:WaitForChild("HumanoidRootPart", 5)
	headPart = char:FindFirstChild("Head") or torso

	if jumpConnection then jumpConnection:Disconnect() end
	if humanoid then jumpConnection = humanoid.Jumping:Connect(function(a) if a and vis.Jump.Enabled then playJumpEffect() end end) end

	if vis.Wings.Enabled then buildWings() end
	if vis.Halo.Enabled then buildHalo() end
