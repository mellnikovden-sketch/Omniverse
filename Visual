local function trailColorSeq(style, color, color2)
	local c2 = color2 or color
	local light = lighten(color, 0.35)
	local dark  = darken(color, 0.35)
	if style == "Fire" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.4)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   darken(color, 0.5)),
		})
	elseif style == "Comet" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.4, color),
			ColorSequenceKeypoint.new(1,   darken(color, 0.6)),
		})
	elseif style == "Pastel" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,    lighten(color, 0.55)),
			ColorSequenceKeypoint.new(0.3,  lighten(color, 0.3)),
			ColorSequenceKeypoint.new(0.5,  lighten(c2, 0.5)),
			ColorSequenceKeypoint.new(0.7,  lighten(c2, 0.3)),
			ColorSequenceKeypoint.new(1,    color:Lerp(c2, 0.5)),
		})
	elseif style == "Dark" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.15)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.7, darken(color, 0.4)),
			ColorSequenceKeypoint.new(1,   Color3.fromRGB(10, 10, 15)),
		})
	elseif style == "Crystal" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.4)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   color:Lerp(c2, 0.6)),
		})
	elseif style == "Candy" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,    lighten(color, 0.2)),
			ColorSequenceKeypoint.new(0.25, color),
			ColorSequenceKeypoint.new(0.5,  lighten(c2, 0.3)),
			ColorSequenceKeypoint.new(0.75, lighten(color, 0.15)),
			ColorSequenceKeypoint.new(1,    lighten(color, 0.35)),
		})
	elseif style == "Galaxy" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   darken(color, 0.4)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.6, c2),
			ColorSequenceKeypoint.new(1,   darken(c2, 0.5)),
		})
	elseif style == "Phoenix" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.5)),
			ColorSequenceKeypoint.new(0.3, color),
			ColorSequenceKeypoint.new(0.7, darken(color, 0.2)),
			ColorSequenceKeypoint.new(1,   Color3.fromRGB(40, 10, 0)),
		})
	elseif style == "Nebula" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   color:Lerp(c2, 0.2)),
			ColorSequenceKeypoint.new(0.25, lighten(color, 0.25)),
			ColorSequenceKeypoint.new(0.5, c2),
			ColorSequenceKeypoint.new(0.75, lighten(c2, 0.25)),
			ColorSequenceKeypoint.new(1,   color:Lerp(c2, 0.8)),
		})
	elseif style == "Rainbow-Galaxy" then
		-- handled dynamically by rainbow loop; fallback gradient
		return ColorSequence.new({ ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(0.5, c2), ColorSequenceKeypoint.new(1, color) })
	elseif style == "Toxic-Slime" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   Color3.fromRGB(180, 255, 60)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   darken(color, 0.6)),
		})
	elseif style == "Vortex" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.4)),
			ColorSequenceKeypoint.new(0.33, color),
			ColorSequenceKeypoint.new(0.66, c2),
			ColorSequenceKeypoint.new(1,   lighten(c2, 0.4)),
		})
	elseif style == "Ghost-Trail" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.6)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1,   Color3.fromRGB(220, 220, 240):Lerp(lighten(c2, 0.3), 0.4)),
		})
	elseif style == "Plasma" then
		-- Plasma: white-hot electric core -> electric blue -> deep violet edge
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,    lighten(color, 0.55)),
			ColorSequenceKeypoint.new(0.25, color),
			ColorSequenceKeypoint.new(0.65, c2),
			ColorSequenceKeypoint.new(1,    darken(c2, 0.4)),
		})
	elseif style == "Inferno-Dual" then
		-- Inferno-Dual: bright gold-hot core -> fiery orange -> deep red ember edge
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,    lighten(color, 0.45)),
			ColorSequenceKeypoint.new(0.4,  color),
			ColorSequenceKeypoint.new(0.75, c2),
			ColorSequenceKeypoint.new(1,    darken(c2, 0.45)),
		})
	elseif style == "Rainbow-Dual" then
		-- handled dynamically by rainbow loop; fallback gradient
		return ColorSequence.new({ ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(0.5, c2), ColorSequenceKeypoint.new(1, color) })
	else -- Neon / Rainbow: яркая вспышка → основной цвет → мягкий переход
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0,   lighten(color, 0.3)),
			ColorSequenceKeypoint.new(0.2, color),
			ColorSequenceKeypoint.new(0.7, c2 or color),
			ColorSequenceKeypoint.new(1,   darken(c2 or color, 0.2)),
		})
	end
end

local function trailTransSeq(style)
	if style == "Fire" then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Comet" then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Toxic-Slime" then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.4, 0.15),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Plasma" then
		-- electric crackle: sharp bright core, quick falloff
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.2, 0.15),
			NumberSequenceKeypoint.new(0.6, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Inferno-Dual" then
		-- flame flicker: hot opaque core, long smouldering fade
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.35, 0.1),
			NumberSequenceKeypoint.new(0.7, 0.4),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Vortex" then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif style == "Ghost-Trail" then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(0.6, 0.5),
			NumberSequenceKeypoint.new(1, 1),
		})
	else -- Neon / Rainbow / Pastel / Candy / Crystal / Galaxy / Phoenix / Nebula
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.5, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
end

local function clearTrails()
	for _, conn in ipairs(trailConnections) do
		pcall(function() conn:Disconnect() end)
	end
	trailConnections = {}
	if trailRainbowConn then
		trailRainbowConn:Disconnect()
		trailRainbowConn = nil
	end
	if trailFolder and trailFolder.Parent then
		trailFolder:Destroy()
	end
	trailFolder = nil
	-- убираем ранее созданные аттачменты (они висят на HRP, не в папке)
	for _, a in ipairs(trailAttachments) do
		pcall(function() if a then a:Destroy() end end)
	end
	trailAttachments = {}
end

local buildToken = 0
local function buildTrails()
	clearTrails()
	if not trailSettings.Enabled then return end
	buildToken = buildToken + 1
	local myToken = buildToken

	local char = LocalPlayer.Character
	if not char then return end

	-- ждём HumanoidRootPart (важно на респавне: без ретрая трейл не создаётся)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		task.spawn(function()
			local ok = pcall(function() root = char:WaitForChild("HumanoidRootPart", 5) end)
			-- если за это время нажали заново/сменился чар/выключили — не строим
			if not ok or not root or myToken ~= buildToken then return end
			if not trailSettings.Enabled or LocalPlayer.Character ~= char then return end
			buildTrails()
		end)
		return
	end

	trailFolder = Instance.new("Folder")
	trailFolder.Name   = "CrystalHub_Trails"
	trailFolder.Parent = char

	local style    = trailSettings.Style
	local color    = trailSettings.Color
	local color2   = trailSettings.Color2
	local width    = trailSettings.Width
	local lifetime = trailSettings.Lifetime

	local a0 = Instance.new("Attachment")
	a0.Name     = "CrystalHub_TrailA0"
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent   = root

	local a1 = Instance.new("Attachment")
	a1.Name     = "CrystalHub_TrailA1"
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent   = root
	trailAttachments = { a0, a1 }

	local trail = Instance.new("Trail")
	trail.Attachment0    = a0
	trail.Attachment1    = a1
	trail.Lifetime       = lifetime
	trail.WidthScale     = NumberSequence.new({
		NumberSequenceKeypoint.new(0, width),
		NumberSequenceKeypoint.new(1, 0),
	})
	trail.LightEmission  = 1
	trail.LightInfluence = 0
	trail.FaceCamera     = true
	trail.Color          = trailColorSeq(style, color, color2)
	trail.Transparency   = trailTransSeq(style)
	trail.Parent         = trailFolder

	-- Rainbow-Dual / Inferno-Dual: второй трейл с смещёнными аттачментами
	local trail2 = nil
	if style == "Rainbow-Dual" or style == "Inferno-Dual" then
		local a2 = Instance.new("Attachment")
		a2.Name = "CrystalHub_TrailA2"
		a2.Position = Vector3.new(0.8, 0, 0)
		a2.Parent = root
		local a3 = Instance.new("Attachment")
		a3.Name = "CrystalHub_TrailA3"
		a3.Position = Vector3.new(-0.8, 0, 0)
		a3.Parent = root
		trailAttachments[#trailAttachments + 1] = a2
		trailAttachments[#trailAttachments + 1] = a3
		trail2 = Instance.new("Trail")
		trail2.Attachment0    = a2
		trail2.Attachment1    = a3
		trail2.Lifetime       = lifetime
		trail2.WidthScale     = NumberSequence.new({
			NumberSequenceKeypoint.new(0, width * 0.7),
			NumberSequenceKeypoint.new(1, 0),
		})
		trail2.LightEmission  = 1
		trail2.LightInfluence = 0
		trail2.FaceCamera     = true
		trail2.Color          = trailColorSeq(style, color2, color)
		trail2.Transparency   = trailTransSeq(style)
		trail2.Parent         = trailFolder
	end

	-- радужный режим: обновляем цвет каждый кадр
	if style == "Rainbow" or style == "Rainbow-Dual" or style == "Rainbow-Galaxy" or trailSettings.Rainbow then
		trailRainbowConn = RunService.Heartbeat:Connect(function(dt)
			trailHue = (trailHue + dt * 0.4) % 1
			local c = Color3.fromHSV(trailHue, 0.9, 1)
			local c2 = Color3.fromHSV((trailHue + 0.5) % 1, 0.9, 1)
			trail.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c), ColorSequenceKeypoint.new(1, c2) })
			if style == "Rainbow-Dual" and trail2 then
				trail2.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c2), ColorSequenceKeypoint.new(1, c) })
			end
		end)
	end

	-- ===== NEW FEATURE: Echo — ghost echo trail above the main trail =====
	if trailSettings.Echo then
		-- offset pair of attachments higher up, longer-lived, thinner, more transparent
		local e0 = Instance.new("Attachment")
		e0.Name     = "CrystalHub_TrailEcho0"
		e0.Position = Vector3.new(0, 2.4, 0)
		e0.Parent   = root
		local e1 = Instance.new("Attachment")
		e1.Name     = "CrystalHub_TrailEcho1"
		e1.Position = Vector3.new(0, 1.2, 0)
		e1.Parent   = root
		trailAttachments[#trailAttachments + 1] = e0
		trailAttachments[#trailAttachments + 1] = e1
		local echo = Instance.new("Trail")
		echo.Attachment0    = e0
		echo.Attachment1    = e1
		echo.Lifetime       = lifetime * 1.6
		echo.WidthScale     = NumberSequence.new({
			NumberSequenceKeypoint.new(0, width * 0.55),
			NumberSequenceKeypoint.new(0.5, width * 0.35),
			NumberSequenceKeypoint.new(1, 0),
		})
		echo.LightEmission  = 1
		echo.LightInfluence = 0
		echo.FaceCamera     = true
		echo.Color          = trailColorSeq(style, lighten(color, 0.4), color2)
		echo.Transparency   = NumberSequence.new({
			NumberSequenceKeypoint.new(0,   0.35),
			NumberSequenceKeypoint.new(0.6, 0.6),
			NumberSequenceKeypoint.new(1,   1),
		})
		echo.Parent = trailFolder
	end
end

