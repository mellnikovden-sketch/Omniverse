					Length = (4.0 - ratio * 1.3) * scale, Width = 0.1 * scale, Thickness = 0.04 * scale,
					Spread = math.rad(56 + ratio * 54), Sweep = math.rad(24), Pitch = math.rad(-12),
					OriginX = 0.41 * scale, OriginY = 0.31 * scale, OriginZ = 0.67 * scale,
