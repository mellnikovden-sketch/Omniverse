local function newNeonPart(size, color, className)
	local part = Instance.new(className or "Part")
	part.Size, part.Color, part.Material = size, color, Enum.Material.Neon
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = false, false, false, false, false
	part.Massless, part.Locked = true, true
	return part
end

local function weldTo(basePart, part, c0)
	local weld = Instance.new("Weld")
	weld.Part0, weld.Part1, weld.C0, weld.Parent = basePart, part, c0, part
	return weld
end

local function lighten(color, amount) return Color3.new(math.min(color.R + amount, 1), math.min(color.G + amount, 1), math.min(color.B + amount, 1)) end
local function darken(color, amount) return Color3.new(math.max(color.R - amount, 0), math.max(color.G - amount, 0), math.max(color.B - amount, 0)) end

-- [JUMP EFFECTS]
local function spawnFlash(position, diameter, color, duration)
	local flash = Instance.new("Part")
	flash.Shape, flash.Size, flash.CFrame = Enum.PartType.Cylinder, Vector3.new(0.08, diameter * 0.45, diameter * 0.45), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	flash.Anchored, flash.CanCollide, flash.Material, flash.Color, flash.Transparency = true, false, Enum.Material.Neon, lighten(color, 0.45), 0.25
	flash.Parent = ensureFolder()
	TweenService:Create(flash, TweenInfo.new(duration * 0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = Vector3.new(0.02, diameter * 1.5, diameter * 1.5), Transparency = 1 }):Play()
	Debris:AddItem(flash, duration + 0.1)
end

local function spawnArcRing(origin, opts)
	local segments, sweep, startAngle, radius0, radius1, thickness, duration, spin, tilt, fade, rise, color = 
		quantity(opts.Segments or 26, 8), opts.Sweep or (math.pi * 2), opts.Start or 0, opts.Radius0 or 1.2, opts.Radius1 or 8, opts.Thickness or 0.22, opts.Duration or 0.7, opts.Spin or 0, opts.Tilt or 0, opts.Fade or 0, opts.Rise or 0, opts.Color or Color3.fromRGB(255, 255, 255)
	
	local tipColor, chord0, chord1 = lighten(color, 0.5), (sweep * radius0 / segments) * 1.08, (sweep * radius1 / segments) * 1.08
	local info, base, folder = TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), CFrame.new(origin) * CFrame.Angles(tilt, 0, 0), ensureFolder()

	for index = 1, segments do
		local ratio = (index - 1) / segments
		local angle = startAngle + ratio * sweep
		local piece = newNeonPart(Vector3.new(thickness, thickness, chord0), color:Lerp(tipColor, ratio))
		piece.CFrame = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius0) * CFrame.Angles(0, math.rad(90), 0)
		piece.Anchored, piece.Transparency, piece.Parent = true, math.clamp(fade * ratio, 0, 0.9), folder
		TweenService:Create(piece, info, { CFrame = base * CFrame.Angles(0, angle + spin, 0) * CFrame.new(0, rise, -radius1) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(thickness * 0.32, thickness * 0.32, chord1), Transparency = 1 }):Play()
		Debris:AddItem(piece, duration + 0.2)
	end
end

local function spawnSparks(origin, color, duration, count, radius)
	if not vis.Jump.Sparks then return end
	local total = quantity(count or 10, 4)
	for index = 1, total do
		local angle = (index / total) * math.pi * 2 + math.random() * 0.4
		local spark = newNeonPart(Vector3.new(0.16, 0.16, 0.16), lighten(color, 0.3), "Part")
		spark.Shape, spark.Anchored, spark.Transparency, spark.CFrame = Enum.PartType.Ball, true, 0.1, CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -0.6)
		spark.Parent = ensureFolder()
		local far, high = (radius or 4) * (0.6 + math.random() * 0.7), 1.4 + math.random() * 2.2
		TweenService:Create(spark, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(origin) * CFrame.Angles(0, angle, 0) * CFrame.new(0, high, -far), Size = Vector3.new(0.03, 0.03, 0.03), Transparency = 1 }):Play()
		Debris:AddItem(spark, duration + 0.15)
	end
end

local function playJumpEffect()
	if not vis.Jump.Enabled or not torso then return end
	local now = os.clock()
	if now - lastJumpEffect < 0.15 then return end
	lastJumpEffect = now
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local origin, color, duration, size, style = root.Position - Vector3.new(0, 2.55, 0), vis.Jump.Color, vis.Jump.Duration, vis.Jump.Size, vis.Jump.Style
	if vis.Jump.Flash then spawnFlash(origin, size * 0.5, color, duration) end

	if style == "Ring" then
		spawnArcRing(origin, { Color = color, Duration = duration, Segments = 30, Radius0 = size * 0.16, Radius1 = size, Thickness = size * 0.035, Fade = 0.15, Rise = 0.25 })
		spawnSparks(origin, color, duration, 8, size * 0.5)
	elseif style == "Vortex" then
		for layer = 1, 3 do task.delay((layer - 1) * 0.07, function() spawnArcRing(origin, { Color = color, Duration = duration, Segments = 22, Sweep = math.rad(300), Start = layer * 2.1, Radius0 = size * (0.12 + layer * 0.05), Radius1 = size * (0.75 + layer * 0.2), Thickness = size * (0.045 - layer * 0.008), Spin = (layer % 2 == 0) and -0.9 or 0.9, Tilt = math.rad(layer * 4), Rise = 0.35 * layer, Fade = 0.75 }) end) end
	elseif style == "Galaxy" then
		spawnArcRing(origin, { Color = color, Duration = duration * 1.3, Segments = 30, Sweep = math.rad(200), Start = 0, Radius0 = size * 0.15, Radius1 = size * 1.1, Thickness = size * 0.04, Spin = 1.8, Rise = 0.3, Fade = 0.25 })
		spawnArcRing(origin, { Color = color, Duration = duration * 1.3, Segments = 30, Sweep = math.rad(200), Start = math.pi, Radius0 = size * 0.15, Radius1 = size * 1.1, Thickness = size * 0.04, Spin = -1.8, Rise = 0.3, Fade = 0.25 })
		spawnArcRing(origin, { Color = lighten(color, 0.2), Duration = duration * 1.4, Segments = 28, Radius0 = size * 0.3, Radius1 = size * 0.85, Thickness = size * 0.03, Spin = 2.2, Tilt = math.rad(15), Rise = 0.2, Fade = 0.4 })
	else
		-- Default Swirl
		spawnArcRing(origin, { Color = color, Duration = duration, Segments = 28, Sweep = math.rad(310), Start = 0, Radius0 = size * 0.15, Radius1 = size, Thickness = size * 0.045, Spin = 0.7, Rise = 0.4, Fade = 0.85 })
		spawnArcRing(origin, { Color = color, Duration = duration * 1.15, Segments = 22, Sweep = math.rad(265), Start = math.pi, Radius0 = size * 0.1, Radius1 = size * 0.78, Thickness = size * 0.03, Spin = -0.5, Tilt = math.rad(6), Rise = 0.2, Fade = 0.7 })
		spawnSparks(origin, color, duration, 6, size * 0.45)
	end
end

