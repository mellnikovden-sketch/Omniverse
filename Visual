local function addWingPart(side, opts)
	local p = createWeldable(opts.Shape or "Part", Vector3.new(opts.Thickness, opts.Length, opts.Width), opts.Color, opts.Transparency or 0.1)
	p.Parent = wingsFolder
	local spread = opts.Spread + math.rad(vis.Wings.Droop or 0)
	local origin = CFrame.new(side * opts.OriginX, opts.OriginY, opts.OriginZ) * CFrame.Angles(opts.Pitch or 0, side * opts.Sweep, -side * spread)
	local offset = CFrame.new(0, opts.Length * 0.5, 0)
	table.insert(wingParts, { Weld = weldTo(torso, p, origin * offset), Origin = origin, Offset = offset, Phase = opts.Phase or 0, Amp = opts.Amp or 0.12 })
end

local function buildWings()
	clearWings()
	if not vis.Wings.Enabled or not torso then return end
	wingsFolder = Instance.new("Folder") wingsFolder.Name = "CH_Wings" wingsFolder.Parent = ensureFolder()
	local scale, base, light, dark, style = vis.Wings.Scale, vis.Wings.Color, lighten(vis.Wings.Color, 0.4), darken(vis.Wings.Color, 0.3), vis.Wings.Style

	for _, side in ipairs({ -1, 1 }) do
		if style == "Demon" or style == "Dragon" then
			local bones = quantity(7, 5)
			for i = 1, bones do
				local r = (i - 1) / (bones - 1)
				local len, spr = (5.0 - r * 1.8) * scale, math.rad(52 + r * 68)
				addWingPart(side, { Shape = "Wedge", Length = len, Width = 0.2 * scale, Thickness = 0.18 * scale, Spread = spr, Sweep = math.rad(32), Pitch = math.rad(-12 - r * 10), OriginX = 0.55 * scale, OriginY = 0.12 * scale, OriginZ = 0.72 * scale, Color = dark, Transparency = 0.03, Phase = i * 0.28, Amp = 0.15 })
				if i < bones then addWingPart(side, { Shape = "Part", Length = len * 0.85, Width = (1.4 - r * 0.3) * scale, Thickness = 0.04 * scale, Spread = spr + math.rad(12 + (i / (bones - 1)) * 6), Sweep = math.rad(32), Pitch = math.rad(-12 - r * 10), OriginX = 0.55 * scale, OriginY = 0.12 * scale, OriginZ = 0.7 * scale, Color = base, Transparency = 0.6, Phase = i * 0.28 + 0.08, Amp = 0.15 }) end
			end
		elseif style == "Mecha" then
			for i = 1, quantity(6, 4) do
				local r = (i - 1) / 5
				addWingPart(side, { Shape = "CornerWedge", Length = (4.5 - r * 1.5) * scale, Width = 0.6 * scale, Thickness = 0.15 * scale, Spread = math.rad(45 + r * 60), Sweep = math.rad(15), Pitch = math.rad(-5), OriginX = 0.6 * scale, OriginY = 0.2 * scale, OriginZ = 0.8 * scale, Color = dark, Transparency = 0.05, Phase = i * 0.2, Amp = 0.05 })
				addWingPart(side, { Shape = "Part", Length = (4.6 - r * 1.5) * scale, Width = 0.1 * scale, Thickness = 0.17 * scale, Spread = math.rad(45 + r * 60), Sweep = math.rad(15), Pitch = math.rad(-5), OriginX = 0.6 * scale, OriginY = 0.2 * scale, OriginZ = 0.8 * scale, Color = light, Transparency = 0, Phase = i * 0.2, Amp = 0.05 })
			end
		elseif style == "Butterfly" or style == "Fairy" then
			for i = 1, quantity(6, 4) do
				local r = (i - 1) / 5
				addWingPart(side, { Shape = "Cylinder", Length = (3.0 - r * 0.6) * scale, Width = (0.8 - r * 0.12) * scale, Thickness = 0.08 * scale, Spread = math.rad(72 + r * 34), Sweep = math.rad(38), Pitch = math.rad(-22), OriginX = 0.3 * scale, OriginY = 0.35 * scale, OriginZ = 0.5 * scale, Color = base, Transparency = 0.1, Phase = i * 0.38, Amp = 0.2 })
			end
			for i = 1, quantity(4, 3) do
				local r = (i - 1) / 3
				addWingPart(side, { Shape = "Cylinder", Length = (0.35 + r * 0.12) * scale, Width = 0.26 * scale, Thickness = 0.05 * scale, Spread = math.rad(78 + r * 22), Sweep = math.rad(38), Pitch = math.rad(-20), OriginX = 0.28 * scale, OriginY = 0.32 * scale, OriginZ = 0.48 * scale, Color = light, Transparency = 0.03, Phase = i * 0.38 + 0.5, Amp = 0.2 })
			end
		elseif style == "Crystal" then
			for i = 1, quantity(6, 4) do
				local r = (i - 1) / 5
				addWingPart(side, { Shape = "Wedge", Length = (4.5 - r * 2) * scale, Width = (1 - r * 0.4) * scale, Thickness = 0.1 * scale, Spread = math.rad(40 + r * 50), Sweep = math.rad(25), Pitch = math.rad(-15), OriginX = 0.36 * scale, OriginY = 0.3 * scale, OriginZ = 0.64 * scale, Color = base, Transparency = 0.2, Phase = i * 0.45, Amp = 0.1 })
			end
		else
			-- Angel (Default)
			local count = quantity(10, 5)
			for index = 1, count do
				local r = (index - 1) / (count - 1)
				addWingPart(side, { Length = (4.6 - r * 2.1) * scale, Width = 0.5 * scale, Thickness = 0.1 * scale, Spread = math.rad(50 + r * 80), Sweep = math.rad(24), Pitch = math.rad(-14), OriginX = 0.42 * scale, OriginY = 0.32 * scale, OriginZ = 0.7 * scale, Color = base, Transparency = 0.04, Phase = index * 0.26, Amp = 0.19 })
			end
		end
	end
end

