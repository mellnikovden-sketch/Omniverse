        lbl.TextColor3 = THEME.Text
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 105
        lbl.Parent = row

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.35, 0, 0, 16)
        valLbl.Position = UDim2.new(0.65, 0, 0, 0)
        valLbl.BackgroundTransparency = 1
        valLbl.Font = Enum.Font.GothamBold
        valLbl.Text = tostring(default or minVal)
        valLbl.TextSize = IS_PHONE and 12 or 13
        valLbl.TextColor3 = THEME.AccentLight
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.ZIndex = 105
        valLbl.Parent = row

        -- Track
        local track = Instance.new("TextButton")
        track.Size = UDim2.new(1, 0, 0, 6)
        track.Position = UDim2.new(0, 0, 0, 26)
        track.BackgroundColor3 = THEME.SliderTrack
        track.BorderSizePixel = 0
        track.Text = ""
        track.AutoButtonColor = false
        track.ZIndex = 105
        track.Parent = row
        corner(track, UDim.new(1, 0))

        -- Fill
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.BackgroundColor3 = THEME.SliderFill
        fill.BorderSizePixel = 0
        fill.ZIndex = 106
        fill.Parent = track
        corner(fill, UDim.new(1, 0))

        -- Knob on track
        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = UDim2.new(0, 0, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.ZIndex = 107
        knob.Parent = track
        corner(knob, UDim.new(1, 0))
        stroke(knob, THEME.Accent, 2, 0.1)

        local val = default or minVal
        local range = maxVal - minVal

        local function update(newVal, animate)
            newVal = math.clamp(newVal, minVal, maxVal)
            val = newVal
            local pct = (val - minVal) / range
            local trackW = track.AbsoluteSize.X
            local fillW = math.max(0, trackW * pct)
            local knobX = math.max(0, trackW * pct - 7)

            if animate then
                tween(fill, { Size = UDim2.new(0, fillW, 1, 0) }, 0.1)
                tween(knob, { Position = UDim2.new(0, knobX, 0.5, -7) }, 0.1)
            else
                fill.Size = UDim2.new(0, fillW, 1, 0)
                knob.Position = UDim2.new(0, knobX, 0.5, -7)
            end
            valLbl.Text = tostring(val)
            if callback then
                task.spawn(function() callback(val) end)
            end
        end

        -- Initialize
        task.spawn(function()
            task.wait(0.05) -- wait for layout
            update(val, false)
        end)

        local dragging = false
        local function handleInput(input)
            local pct = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
            pct = math.clamp(pct, 0, 1)
            update(minVal + range * pct, false)
        end

        track.MouseButton1Down:Connect(function()
            dragging = true
            local mp = UserInputService:GetMouseLocation()
            handleInput({ Position = mp })
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                handleInput(input)
            end
        end)

        -- Touch support
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                handleInput(input)
            end
        end)

        local sliderObj = {}
        function sliderObj:SetValue(v) update(v, true) end
        function sliderObj:GetValue() return val end
        return sliderObj
    end

    -- ════════ ADD DROPDOWN ══════════════════════════════════════════════
    function section:AddDropdown(label, options, default, callback)
        if not options or type(options) ~= "table" then return end
        local currentValue = default or options[1]

        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 44)
        row.BackgroundColor3 = THEME.Element
        row.BackgroundTransparency = 0.1
        row.BorderSizePixel = 0
        row.Text = ""
        row.AutoButtonColor = false
        row.LayoutOrder = 1002
        row.ZIndex = 104
        row.Parent = page
        corner(row, THEME.CornerSm)
        stroke(row, THEME.Border, 1, 0.6)
        padding(row, 0, 0, 12, 28)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.55, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamMedium
        lbl.Text = label
        lbl.TextSize = IS_PHONE and 12 or 13
        lbl.TextColor3 = THEME.Text
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 105
        lbl.Parent = row

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.4, 0, 1, 0)
        valLbl.Position = UDim2.new(0.55, 0, 0, 0)
        valLbl.BackgroundTransparency = 1
        valLbl.Font = Enum.Font.GothamBold
        valLbl.Text = tostring(currentValue)
        valLbl.TextSize = IS_PHONE and 11 or 12
        valLbl.TextColor3 = THEME.AccentLight
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.ZIndex = 105
        valLbl.Parent = row

        -- Arrow indicator
        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 16, 1, 0)
        arrow.Position = UDim2.new(1, -20, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Font = Enum.Font.GothamBold
        arrow.Text = "▾"
        arrow.TextSize = 10
        arrow.TextColor3 = THEME.TextDim
        arrow.ZIndex = 105
        arrow.Parent = row

        local dropdownOpen = false
        local dropdownFrame
        local backdrop
        local closeConn

        local function closeDropdown()
            if not dropdownOpen then return end
            dropdownOpen = false
            if closeConn then closeConn:Disconnect() closeConn = nil end
            tween(arrow, { TextColor3 = THEME.TextDim, Rotation = 0 }, 0.15)
            if dropdownFrame then
                local df = dropdownFrame
                dropdownFrame = nil
                tween(df, { Size = UDim2.new(0, df.AbsoluteSize.X, 0, 0) }, 0.15, Enum.EasingStyle.Exponential, Enum.EasingDirection.In)
                task.delay(0.16, function()
                    if df then df:Destroy() end
                end)
            end
            if backdrop then
                local bd = backdrop
                backdrop = nil
                tween(bd, { BackgroundTransparency = 1 }, 0.15)
                task.delay(0.16, function()
                    if bd then bd:Destroy() end
                end)
            end
        end

        row.Activated:Connect(function()
            if dropdownOpen then closeDropdown() return end
            dropdownOpen = true
            tween(arrow, { TextColor3 = THEME.AccentLight, Rotation = 180 }, 0.15)

            local g = getGui()
            local rowPos = row.AbsolutePosition
            local rowSize = row.AbsoluteSize
            local vp = workspace.CurrentCamera.ViewportSize

            -- ── Backdrop (Frame, NOT TextButton — doesn't steal touch events) ──
            backdrop = Instance.new("Frame")
            backdrop.Size = UDim2.new(1, 0, 1, 0)
            backdrop.Position = UDim2.new(0, 0, 0, 0)
            backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            backdrop.BackgroundTransparency = 1
            backdrop.BorderSizePixel = 0
            backdrop.ZIndex = 600
            backdrop.Parent = g
            tween(backdrop, { BackgroundTransparency = 0.4 }, 0.15)

            -- ── Popup window (separate, on ScreenGui, above everything) ──
            local popupWidth = math.max(rowSize.X, 200)
            local popupHeight = math.min(#options * 32 + 8, 240)

            -- Calculate position: below the row, but flip above if near bottom
            local popX = rowPos.X
            local popY = rowPos.Y + rowSize.Y + 4
            if popY + popupHeight > vp.Y - 10 then
                popY = rowPos.Y - popupHeight - 4
            end
            -- Clamp horizontally
            if popX + popupWidth > vp.X - 10 then
                popX = vp.X - popupWidth - 10
            end
            if popX < 10 then popX = 10 end

            dropdownFrame = Instance.new("Frame")
            dropdownFrame.Name = "DropdownPopup"
            dropdownFrame.Size = UDim2.new(0, popupWidth, 0, 0)
            dropdownFrame.Position = UDim2.new(0, popX, 0, popY + 10)
            dropdownFrame.BackgroundColor3 = THEME.DropdownBg
            dropdownFrame.BorderSizePixel = 0
            dropdownFrame.ZIndex = 650
            dropdownFrame.ClipsDescendants = true
            dropdownFrame.Parent = g
            corner(dropdownFrame, THEME.CornerSm)
            stroke(dropdownFrame, THEME.BorderLight, 1.5, 0.15)

            -- Shadow effect
            local shadow = Instance.new("UIStroke")
            shadow.Color = Color3.fromRGB(0, 0, 0)
            shadow.Thickness = 3
            shadow.Transparency = 0.7
            shadow.Parent = dropdownFrame

            local scrollFrame = Instance.new("ScrollingFrame")
            scrollFrame.Size = UDim2.new(1, 0, 1, 0)
            scrollFrame.BackgroundTransparency = 1
            scrollFrame.ScrollBarThickness = 4
            scrollFrame.ScrollBarImageColor3 = THEME.Border
            scrollFrame.ScrollBarImageTransparency = 0.4
            scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
            scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
            scrollFrame.ZIndex = 651
            scrollFrame.Parent = dropdownFrame

            local listLayout = Instance.new("UIListLayout")
            listLayout.Padding = UDim.new(0, 2)
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            listLayout.Parent = scrollFrame

            padding(scrollFrame, 4, 4, 4, 4)

            for _, option in ipairs(options) do
                local item = Instance.new("TextButton")
                item.Size = UDim2.new(1, 0, 0, 30)
                item.BackgroundColor3 = (option == currentValue) and THEME.ElementHover or THEME.DropdownBg
                item.Text = ""
                item.AutoButtonColor = false
                item.ZIndex = 652
                item.Parent = scrollFrame
                corner(item, THEME.CornerSm)

                local itemLbl = Instance.new("TextLabel")
                itemLbl.Size = UDim2.new(1, -20, 1, 0)
                itemLbl.Position = UDim2.new(0, 10, 0, 0)
                itemLbl.BackgroundTransparency = 1
                itemLbl.Font = Enum.Font.GothamMedium
                itemLbl.Text = tostring(option)
                itemLbl.TextSize = IS_PHONE and 11 or 12
                itemLbl.TextColor3 = (option == currentValue) and THEME.AccentLight or THEME.Text
                itemLbl.TextXAlignment = Enum.TextXAlignment.Left
                itemLbl.ZIndex = 653
                itemLbl.Parent = item

                -- Check mark for selected
                if option == currentValue then
                    local check = Instance.new("TextLabel")
                    check.Size = UDim2.new(0, 16, 1, 0)
                    check.Position = UDim2.new(1, -20, 0, 0)
                    check.BackgroundTransparency = 1
                    check.Font = Enum.Font.GothamBold
                    check.Text = "✓"
                    check.TextSize = 12
                    check.TextColor3 = THEME.AccentLight
                    check.ZIndex = 653
                    check.Parent = item
                end

                -- Use Activated — most reliable on both mouse and touch
                item.Activated:Connect(function()
                    currentValue = option
                    valLbl.Text = tostring(option)
                    if callback then task.spawn(function() callback(option) end) end
                    closeDropdown()
                end)
            end

            -- Animate popup open
            tween(dropdownFrame, { Size = UDim2.new(0, popupWidth, 0, popupHeight), Position = UDim2.new(0, popX, 0, popY) }, 0.18, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

            -- Close when clicking/tapping OUTSIDE the popup (using UserInputService)
            -- This doesn't interfere with item clicks because we check coordinates
            task.wait(0.2) -- wait for animation to start so we don't catch the opening tap
            closeConn = UserInputService.InputBegan:Connect(function(input, processed)
                if dropdownOpen and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    local pos = input.Position
                    local dfPos = dropdownFrame and dropdownFrame.AbsolutePosition
                    local dfSize = dropdownFrame and dropdownFrame.AbsoluteSize
                    if dfPos and dfSize then
                        -- Check if click is inside the popup
                        if pos.X >= dfPos.X and pos.X <= dfPos.X + dfSize.X
                           and pos.Y >= dfPos.Y and pos.Y <= dfPos.Y + dfSize.Y then
                            -- Click inside popup, do nothing (item will handle it)
                            return
                        end
                    end
                    -- Click outside popup → close
                    closeDropdown()
                end
            end)
        end)

        local ddObj = {}
        function ddObj:SetValue(v)
            currentValue = v
            valLbl.Text = tostring(v)
        end
        function ddObj:GetValue() return currentValue end
        return ddObj
    end

