local function spawnHelix(pos, color, size, dur, twist, rise)
    local segs = quantity(40, 16)
    for i = 1, segs do
        local t = i / segs
        local angle = t * math.pi * 2 * twist
        local radius = size * (0.2 + t * 0.6)
        local height = t * rise
        local p = newPart(Vector3.new(0.08, 0.08, 0.15), color:Lerp(lighten(color, 0.3), t), Enum.PartType.Ball)
        p.Anchored = true
        p.Parent = effectsFolder
        p.CFrame = CFrame.new(pos + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius))
        TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = p.CFrame + Vector3.new(0, 0.5, 0),
            Size = Vector3.new(0.02, 0.02, 0.02),
            Transparency = 1
        }):Play()
        Debris:AddItem(p, dur + 0.2)
