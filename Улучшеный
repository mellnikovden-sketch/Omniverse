-- ==============================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ==============================================
local function GetCharacter(plr)
    if not plr then return nil end
    return plr.Character
end

local function GetHumanoid(plr)
    local char = GetCharacter(plr)
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function GetRootPart(plr)
    local char = GetCharacter(plr)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function IsAlive(plr)
    local hum = GetHumanoid(plr)
    if not hum then return false end
    return hum.Health > 0
end

-- ==============================================
-- ОПРЕДЕЛЕНИЕ РОЛЕЙ
-- ==============================================
local ROLE_KEYWORDS = {
    Murderer = {"murderer", "killer", "knife", "blade", "dagger", "saw", "slasher", "axe", "scythe"},
    Sheriff = {"sheriff", "cop", "gun", "pistol", "revolver", "shooter", "blaster", "glock"},
}

local function GetPlayerRole(plr)
    if not plr or plr == LocalPlayer then return nil end
    if not IsAlive(plr) then return "Dead" end
    
    local char = GetCharacter(plr)
    if not char then return "Dead" end
    
    -- Проверка атрибутов
    local murdererAttr = plr:GetAttribute("Murderer")
    local sheriffAttr = plr:GetAttribute("Sheriff")
    local roleAttr = plr:GetAttribute("Role")
    
    if murdererAttr == true or murdererAttr == "True" or murdererAttr == "Murderer" then
        return "Murderer"
    end
    if sheriffAttr == true or sheriffAttr == "True" or sheriffAttr == "Sheriff" then
        return "Sheriff"
    end
    if roleAttr == "Murderer" or roleAttr == "Murder" or roleAttr == "Killer" then
        return "Murderer"
    end
    if roleAttr == "Sheriff" or roleAttr == "Cop" then
        return "Sheriff"
    end
    
    -- Проверка оружия
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for _, keyword in ipairs(ROLE_KEYWORDS.Murderer) do
                if name:find(keyword) then
                    return "Murderer"
                end
            end
            for _, keyword in ipairs(ROLE_KEYWORDS.Sheriff) do
                if name:find(keyword) then
                    return "Sheriff"
                end
            end
        end
    end
    
    return "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0) end
    if role == "Sheriff" then return Color3.fromRGB(0, 150, 255) end
    if role == "Innocent" then return Color3.fromRGB(0, 255, 0) end
    return Color3.fromRGB(128, 128, 128)
end

-- ==============================================
-- ESP СИСТЕМА
-- ==============================================
local ESP = {
    Enabled = false,
    Boxes = {},
}

local function CreateESPBox(plr)
    if not plr or plr == LocalPlayer then return end
    if ESP.Boxes[plr] then return end
    
    local role = GetPlayerRole(plr)
    if role == "Dead" then return end
    
    local char = GetCharacter(plr)
    if not char then return end
    
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "ESP_Box"
    box.Size = Vector3.new(3, 5, 1)
    box.Color3 = GetRoleColor(role)
    box.Transparency = 0.3
    box.ZIndex = 0
    box.Adornee = char
    box.Parent = char
    
    local outline = Instance.new("BoxHandleAdornment")
    outline.Name = "ESP_Outline"
    outline.Size = Vector3.new(3.2, 5.2, 1.2)
    outline.Color3 = Color3.fromRGB(0, 0, 0)
    outline.Transparency = 0.7
    outline.ZIndex = -1
    outline.Adornee = char
    outline.Parent = char
    
    ESP.Boxes[plr] = {Box = box, Outline = outline}
end

local function RemoveESPBox(plr)
    if ESP.Boxes[plr] then
        pcall(function() ESP.Boxes[plr].Box:Destroy() end)
        pcall(function() ESP.Boxes[plr].Outline:Destroy() end)
        ESP.Boxes[plr] = nil
    end
end

local function UpdateESP()
    if not ESP.Enabled then
        for plr, _ in pairs(ESP.Boxes) do
            RemoveESPBox(plr)
        end
        return
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) then
            local role = GetPlayerRole(plr)
            if role ~= "Dead" then
                if not ESP.Boxes[plr] then
                    CreateESPBox(plr)
                else
                    ESP.Boxes[plr].Box.Color3 = GetRoleColor(role)
                end
            else
                RemoveESPBox(plr)
            end
        else
            RemoveESPBox(plr)
        end
    end
end

-- ==============================================
-- AIM LOCK
-- ==============================================
local AimLock = {
    Enabled = false,
    Target = nil,
    Smoothness = 0.15,
}

local function IsPlayerVisible(plr)
    local root = GetRootPart(plr)
    if not root then return false end
    
    local camera = Workspace.CurrentCamera
    if not camera then return false end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {GetCharacter(LocalPlayer)}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = workspace:Raycast(camera.CFrame.Position, root.Position - camera.CFrame.Position, raycastParams)
    if not result then return true end
    return result.Instance:IsDescendantOf(GetCharacter(plr))
end

local function FindBestTarget()
    local bestTarget = nil
    local bestDist = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) then
            local role = GetPlayerRole(plr)
            if role == "Murderer" then
                local root = GetRootPart(plr)
                local myRoot = GetRootPart(LocalPlayer)
                if root and myRoot then
                    if Config.WallCheckEnabled and not IsPlayerVisible(plr) then
                        continue
                    end
                    local dist = (root.Position - myRoot.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestTarget = plr
                    end
                end
            end
        end
    end
    
    return bestTarget
end

local function UpdateAimLock()
    if not AimLock.Enabled then return end
    
    if not AimLock.Target or not IsAlive(AimLock.Target) then
        AimLock.Target = FindBestTarget()
        if not AimLock.Target then return end
    end
    
    local root = GetRootPart(AimLock.Target)
    if not root then return end
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local vel = root.AssemblyLinearVelocity or Vector3.new()
    local predictedPos = root.Position + (vel * Config.PredictionLevel)
    
    local targetCF = CFrame.new(camera.CFrame.Position, predictedPos)
    camera.CFrame = camera.CFrame:Lerp(targetCF, AimLock.Smoothness)
end

-- ==============================================
-- BOMB JUMP
-- ==============================================
local BombJump = {
    Enabled = true,
    Cooldown = 22,
    Power = 58,
    LastJump = 0,
}

local BOMB_TYPES = {"FakeBomb", "Bomb", "GiftBomb", "PresentBomb", "Snowball", "CandyBomb"}

local function GetBomb()
    local char = GetCharacter(LocalPlayer)
    if not char then return nil end
    
    for _, name in ipairs(BOMB_TYPES) do
        local bomb = char:FindFirstChild(name)
        if bomb then return bomb end
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, name in ipairs(BOMB_TYPES) do
            local bomb = backpack:FindFirstChild(name)
            if bomb then
                bomb.Parent = char
                return bomb
            end
        end
    end
    
    pcall(function()
        ReplicatedStorage.Remotes.Extras.ReplicateToy:InvokeServer("FakeBomb")
    end)
    task.wait(0.1)
    return GetBomb()
end

local function PerformBombJump()
    if not BombJump.Enabled then return end
    if os.clock() - BombJump.LastJump < BombJump.Cooldown then return end
    
    local hum = GetHumanoid(LocalPlayer)
    if not hum then return end
    
    local state = hum:GetState()
    if state ~= Enum.HumanoidStateType.Jumping and 
       state ~= Enum.HumanoidStateType.FallingDown and
       state ~= Enum.HumanoidStateType.Freefall then
        return
    end
    
    local bomb = GetBomb()
    if not bomb then return end
    
    local root = GetRootPart(LocalPlayer)
    if not root then return end
    
    local remote = bomb:FindFirstChild("Remote")
    if remote then
        local camera = Workspace.CurrentCamera
        local pos = root.Position + camera.CFrame.LookVector * 3 + Vector3.new(0, -2, 0)
        pcall(function()
            remote:FireServer(CFrame.new(pos), BombJump.Power)
        end)
        
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            BombJump.Power,
            root.AssemblyLinearVelocity.Z
        )
        BombJump.LastJump = os.clock()
    end
end

-- ==============================================
-- WALLHOP
-- ==============================================
local WallHop = {
    Enabled = false,
    Distance = 3,
    Power = 50,
    LastWall = nil,
    IsJumping = false,
}

local function PerformWallHop()
    if not WallHop.Enabled then return end
    if not WallHop.IsJumping then return end
    
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    
    local hum = GetHumanoid(LocalPlayer)
    if not hum or hum.Health <= 0 then return end
    
    local root = GetRootPart(LocalPlayer)
    if not root then return end
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local direction = camera.CFrame.LookVector * WallHop.Distance
    local result = workspace:Raycast(root.Position, direction, raycastParams)
    
    if result then
        local hit = result.Instance
        if hit:IsA("BasePart") and hit.CanCollide then
            if WallHop.LastWall and WallHop.LastWall ~= hit then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    WallHop.Power,
                    root.AssemblyLinearVelocity.Z
                )
            end
            WallHop.LastWall = hit
        end
    else
        WallHop.LastWall = nil
    end
end

-- ==============================================
-- TRIGGER BOT
-- ==============================================
local TriggerBot = {
    Enabled = false,
    LastShot = 0,
    Cooldown = 0.1,
}

local function PerformTriggerBot()
    if not TriggerBot.Enabled then return end
    if os.clock() - TriggerBot.LastShot < TriggerBot.Cooldown then return end
    
    local target = FindBestTarget()
    if not target then return end
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local root = GetRootPart(target)
    if not root then return end
    
    local pos, onScreen = camera:WorldToViewportPoint(root.Position)
    if not onScreen then return end
    
    local center = camera.ViewportSize / 2
    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
    if dist > 50 then return end
    
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    
    local weapon = char:FindFirstChildOfClass("Tool")
    if not weapon then return end
    
    local remote = weapon:FindFirstChild("Remote") or weapon:FindFirstChild("GunRemote")
    if remote then
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer()
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer()
            end
        end)
        TriggerBot.LastShot = os.clock()
    end
end

-- ==============================================
-- AUTO KNIFE
-- ==============================================
local AutoKnife = {
    Enabled = false,
    LastKnife = 0,
    Cooldown = 0.5,
}

local function PerformAutoKnife()
    if not AutoKnife.Enabled then return end
    if os.clock() - AutoKnife.LastKnife < AutoKnife.Cooldown then return end
    
    local target = FindBestTarget()
    if not target then return end
    
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    
    local knife = nil
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for _, keyword in ipairs(ROLE_KEYWORDS.Murderer) do
                if name:find(keyword) then
                    knife = item
                    break
                end
            end
        end
        if knife then break end
    end
    
    if not knife then return end
    
    local root = GetRootPart(LocalPlayer)
    local targetRoot = GetRootPart(target)
    if not root or not targetRoot then return end
    
    local dist = (root.Position - targetRoot.Position).Magnitude
    if dist > 10 then return end
    
    local remote = knife:FindFirstChild("Remote") or knife:FindFirstChild("KnifeRemote")
    if remote then
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer()
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer()
            end
        end)
        AutoKnife.LastKnife = os.clock()
    end
end

-- ==============================================
-- SPEED BOOST
-- ==============================================
local SpeedBoost = {
    Enabled = false,
    OriginalSpeed = 16,
    BoostSpeed = 25,
    LowHealthThreshold = 30,
}

local function UpdateSpeedBoost()
    if not SpeedBoost.Enabled then return end
    
    local hum = GetHumanoid(LocalPlayer)
    if not hum then return end
    
    local healthPercent = (hum.Health / hum.MaxHealth) * 100
    
    if healthPercent < SpeedBoost.LowHealthThreshold then
        hum.WalkSpeed = SpeedBoost.BoostSpeed
    else
        hum.WalkSpeed = SpeedBoost.OriginalSpeed
    end
end

-- ==============================================
-- NO RECOIL
-- ==============================================
local NoRecoil = {
    Enabled = false,
}

local function ApplyNoRecoil()
    if not NoRecoil.Enabled then return end
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    
    local head = char:FindFirstChild("Head")
    if head then
        local currentCF = camera.CFrame
        local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + currentCF.LookVector)
        camera.CFrame = camera.CFrame:Lerp(targetCF, 0.5)
    end
end

-- ==============================================
-- GUI БЕЗ ОШИБОК UIStroke
-- ==============================================
local GUI = {
    Buttons = {},
}

local function CreateButton(id, text, callback, color)
    if GUI.Buttons[id] then return end
    
    local screen = Workspace.CurrentCamera.ViewportSize
    local size = 0.1
    local xPos = 0.05 + ((#GUI.Buttons % 7) * (size + 0.01))
    local yPos = 0.85 - (math.floor(#GUI.Buttons / 7) * (size + 0.01))
    
    local btn = Instance.new("TextButton")
    btn.Name = "Btn_" .. id
    btn.Size = UDim2.new(size, 0, size, 0)
    btn.Position = UDim2.new(xPos, 0, yPos, 0)
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.BackgroundColor3 = color or Color3.fromRGB(100, 100, 255)
    btn.BackgroundTransparency = 0.3
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.Jura
    btn.Parent = CoreGui
    
    -- Углы
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = btn
    
    -- Анимация
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play()
    end)
    btn.MouseButton1Click:Connect(callback)
    
    GUI.Buttons[id] = btn
    return btn
end

local function UpdateButton(id, text, state, color)
    local btn = GUI.Buttons[id]
    if not btn then return end
    btn.Text = text
    btn.BackgroundColor3 = state and Color3.fromRGB(0, 255, 100) or (color or Color3.fromRGB(100, 100, 255))
end

