-- ==============================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    if input.KeyCode == Enum.KeyCode.T then
        AimLockEnabled = not AimLockEnabled
        if AimLockEnabled then TargetPlayer = FindMurderer() else TargetPlayer = nil end
        BindableButtons.UpdateBButtonText("aim_toggle", AimLockEnabled and "Aim:ON" or "Aim:OFF")
        BindableButtons.UpdateBButtonColor("aim_toggle", AimLockEnabled, "wall")
        
    elseif input.KeyCode == Enum.KeyCode.G then
        WallCheckEnabled = not WallCheckEnabled
        BindableButtons.UpdateBButtonText("wall_toggle", WallCheckEnabled and "Wall:ON" or "Wall:OFF")
        BindableButtons.UpdateBButtonColor("wall_toggle", WallCheckEnabled, "wall")
        
    elseif input.KeyCode == Enum.KeyCode.E then
        OutlineEnabled = not OutlineEnabled
        if OutlineEnabled then UpdateOutline() else 
            for plr, _ in pairs(OutlinedPlayers) do RemoveOutline(plr) end 
        end
        BindableButtons.UpdateBButtonText("outline_toggle", OutlineEnabled and "OL:ON" or "OL:OFF")
        BindableButtons.UpdateBButtonColor("outline_toggle", OutlineEnabled, "outline")
        
    elseif input.KeyCode == Enum.KeyCode.H then
        ToggleWallHop()
        
    elseif input.KeyCode == Enum.KeyCode.R then
        ResetState.resetGuiOpen = not ResetState.resetGuiOpen
        ResetGUI.Enabled = ResetState.resetGuiOpen
        
    elseif input.KeyCode == Enum.KeyCode.B then
        FastBombJump()
    end
end)

