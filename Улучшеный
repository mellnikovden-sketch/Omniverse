local function GetPlayerRole(plr)
    if not plr or plr == LocalPlayer then return nil end
    if not plr.Character then return "Unknown" end
    
    local humanoid = plr.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return "Dead" end
    
    -- Проверяем атрибуты
    local murdererAttr = plr:GetAttribute("Murderer")
    local sheriffAttr = plr:GetAttribute("Sheriff")
    local roleAttr = plr:GetAttribute("Role")
    
    if murdererAttr == true or murdererAttr == "True" then return "Murderer" end
    if sheriffAttr == true or sheriffAttr == "True" then return "Sheriff" end
    if roleAttr == "Murderer" or roleAttr == "Murder" or roleAttr == "Killer" then return "Murderer" end
    if roleAttr == "Sheriff" or roleAttr == "Cop" then return "Sheriff" end
    
    -- Проверяем оружие
    local murdererWeapons = {"knife", "blade", "dagger", "saw", "slasher", "axe", "scythe"}
    local sheriffWeapons = {"gun", "pistol", "revolver", "shooter", "blaster", "glock"}
    
    for _, item in ipairs(plr.Character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for _, wName in ipairs(murdererWeapons) do
                if name:find(wName) or wName:find(name) then return "Murderer" end
            end
            for _, wName in ipairs(sheriffWeapons) do
                if name:find(wName) or wName:find(name) then return "Sheriff" end
            end
            if item:FindFirstChild("KnifeServer") or item:FindFirstChild("KnifeClient") then return "Murderer" end
            if item:FindFirstChild("GunServer") or item:FindFirstChild("GunClient") then return "Sheriff" end
        end
    end
    
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                for _, wName in ipairs(murdererWeapons) do
                    if name:find(wName) or wName:find(name) then return "Murderer" end
                end
                for _, wName in ipairs(sheriffWeapons) do
                    if name:find(wName) or wName:find(name) then return "Sheriff" end
                end
            end
        end
    end
    
    return "Innocent"
end

-- ==============================================
-- AIM LOCK
-- ==============================================
local AimLockEnabled = false
local TargetPlayer = nil
local WallCheckEnabled = false
local TargetPart = "HumanoidRootPart"
local PredictionLevel = 0.15
local LastSearchTime = 0

function IsPlayerVisible(plr)
    if not plr or not plr.Character then return false end
    
    local targetPart = plr.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end
    
    local CurrentCamera = Workspace.CurrentCamera
    if not CurrentCamera then return false end
    
    local raycastParams = RaycastParams.new()
    local filterList = {}
    if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
    raycastParams.FilterDescendantsInstances = filterList
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local origin = CurrentCamera.CFrame.Position
    local direction = targetPart.Position - origin
    local result = Workspace:Raycast(origin, direction, raycastParams)
    
    if not result then return true end
    return result.Instance:IsDescendantOf(plr.Character)
end

function FindMurderer()
    local bestTarget = nil
    local bestDist = math.huge
    
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local role = GetPlayerRole(pl)
            if role == "Murderer" then
                local hum = pl.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    if WallCheckEnabled and not IsPlayerVisible(pl) then
                        goto continue
                    end
                    local root = pl.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if myRoot then
                            local dist = (root.Position - myRoot.Position).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                bestTarget = pl
                            end
                        end
                    end
                end
            end
        end
        ::continue::
    end
    
    return bestTarget
end

local function AimLockLoop()
    if not AimLockEnabled then return end
    
    local CurrentCamera = Workspace.CurrentCamera 
    if not CurrentCamera then return end

    if not TargetPlayer or not TargetPlayer.Character then
        local currentTime = os.clock()
        if currentTime - LastSearchTime > 0.15 then
            TargetPlayer = FindMurderer()
            LastSearchTime = currentTime
        end
        return
    end
    
    local hum = TargetPlayer.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        TargetPlayer = FindMurderer()
        return
    end
    
    if GetPlayerRole(TargetPlayer) ~= "Murderer" then
        TargetPlayer = FindMurderer()
        return
    end
    
    if WallCheckEnabled and not IsPlayerVisible(TargetPlayer) then
        TargetPlayer = FindMurderer()
        return
    end
    
    local targetNode = TargetPlayer.Character:FindFirstChild(TargetPart)
    if targetNode then
        local vel = targetNode.AssemblyLinearVelocity or Vector3.new()
        local predictedPos = targetNode.Position + (vel * PredictionLevel)
        CurrentCamera.CFrame = CFrame.new(CurrentCamera.CFrame.Position, predictedPos)
    end
end

