local function RemoveESPBox(plr)
    if ESP.Boxes[plr] then
        local data = ESP.Boxes[plr]
        for _, obj in pairs(data) do
            pcall(function() obj:Destroy() end)
        end
        ESP.Boxes[plr] = nil
    end
end

local function UpdateESP()
    if not ESP.Enabled then
        for plr, _ in pairs(ESP.Boxes) do
            RemoveESPBox(plr)
        end
        return
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local role = GetPlayerRole(plr)
            local alive = IsAlive(plr)
            
            if alive and role ~= "Dead" then
                if not ESP.Boxes[plr] then
                    CreateESPBox(plr)
                else
                    -- Обновление цвета
                    local data = ESP.Boxes[plr]
                    local color = GetRoleColor(role)
                    data.Box.Color3 = color
                    data.NameLabel.TextColor3 = color
                    data.NameLabel.Text = plr.Name .. " [" .. role .. "]"
                    
                    -- Обновление здоровья
                    local hum = GetHumanoid(plr)
                    if hum then
                        local health = hum.Health / hum.MaxHealth
                        data.HealthFill.Size = UDim2.new(health, 0, 1, 0)
                        data.HealthFill.BackgroundColor3 = Color3.fromRGB(
                            255 * (1 - health),
                            255 * health,
                            0
                        )
                    end
                end
            else
                if ESP.Boxes[plr] then
                    RemoveESPBox(plr)
                end
            end
        end
    end
end

