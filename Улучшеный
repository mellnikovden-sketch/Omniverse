-- АНТИ-ДЕТЕКТ СИСТЕМА
-- ==============================================
local AntiDetect = {
    RandomDelays = {},
    LastActionTime = 0,
    ActivityCounter = 0,
}

function AntiDetect:RandomDelay(min, max)
    return math.random() * (max - min) + min
end

function AntiDetect:ShouldAct()
    local now = os.clock()
    if now - self.LastActionTime < 0.05 then
        return false
    end
    self.LastActionTime = now
    self.ActivityCounter = self.ActivityCounter + 1
    if self.ActivityCounter > 100 then
        self.ActivityCounter = 0
        task.wait(self:RandomDelay(0.01, 0.05))
    end
    return true
end

-- ==============================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ==============================================
local function GetCharacter(plr)
    if not plr then return nil end
    return plr.Character
end

local function GetHumanoid(plr)
    local char = GetCharacter(plr)
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function GetRootPart(plr)
    local char = GetCharacter(plr)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function IsAlive(plr)
    local hum = GetHumanoid(plr)
    if not hum then return false end
    return hum.Health > 0
end

local function IsInGame(plr)
    if not plr then return false end
    if plr == LocalPlayer then return true end
    return IsAlive(plr)
end

-- ==============================================
-- ОПРЕДЕЛЕНИЕ РОЛЕЙ (УЛУЧШЕННОЕ)
-- ==============================================
local ROLE_KEYWORDS = {
    Murderer = {"murderer", "killer", "knife", "blade", "dagger", "saw", "slasher", "axe", "scythe"},
    Sheriff = {"sheriff", "cop", "gun", "pistol", "revolver", "shooter", "blaster", "glock"},
}

local function GetPlayerRole(plr)
    if not plr or plr == LocalPlayer then return nil end
    if not IsAlive(plr) then return "Dead" end
    
    local char = GetCharacter(plr)
    if not char then return "Dead" end
    
    -- Проверка атрибутов
    local attributes = {
        plr:GetAttribute("Murderer"),
        plr:GetAttribute("Sheriff"),
        plr:GetAttribute("Role"),
        plr:GetAttribute("Team")
    }
    
    for _, attr in ipairs(attributes) do
        if attr then
            local str = tostring(attr):lower()
            if str:find("murderer") or str:find("killer") or str:find("murder") then
                return "Murderer"
            end
            if str:find("sheriff") or str:find("cop") or str:find("sherif") then
                return "Sheriff"
            end
        end
    end
    
    -- Проверка оружия в руках
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for _, keyword in ipairs(ROLE_KEYWORDS.Murderer) do
                if name:find(keyword) then
                    return "Murderer"
                end
            end
            for _, keyword in ipairs(ROLE_KEYWORDS.Sheriff) do
                if name:find(keyword) then
                    return "Sheriff"
                end
            end
        end
    end
    
    -- Проверка рюкзака
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                for _, keyword in ipairs(ROLE_KEYWORDS.Murderer) do
                    if name:find(keyword) then
                        return "Murderer"
                    end
                end
                for _, keyword in ipairs(ROLE_KEYWORDS.Sheriff) do
                    if name:find(keyword) then
                        return "Sheriff"
                    end
                end
            end
        end
    end
    
    return "Innocent"
end

