-- BOMB JUMP (УЛУЧШЕННЫЙ)
-- ==============================================
local BombJump = {
    Enabled = true,
    Cooldown = 22,
    Power = 58,
    LastJump = 0,
    IsGold = false,
    AutoGet = true,
}

local BOMB_TYPES = {
    "FakeBomb", "Bomb", "GiftBomb", "PresentBomb", "Snowball", "CandyBomb",
    "GoldBomb", "GoldenBomb", "BombGold", "Gold"
}

local function GetBomb()
    local char = GetCharacter(LocalPlayer)
    if not char then return nil end
    
    -- Проверка в руках
    for _, name in ipairs(BOMB_TYPES) do
        local bomb = char:FindFirstChild(name)
        if bomb then return bomb end
    end
    
    -- Проверка в рюкзаке
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, name in ipairs(BOMB_TYPES) do
            local bomb = backpack:FindFirstChild(name)
            if bomb then
                bomb.Parent = char
                return bomb
            end
        end
    end
    
    -- Автоматическое получение
    if BombJump.AutoGet then
        pcall(function()
            ReplicatedStorage.Remotes.Extras.ReplicateToy:InvokeServer("FakeBomb")
        end)
        task.wait(0.1)
        return GetBomb()
    end
    
    return nil
end

local function PerformBombJump()
    if not BombJump.Enabled then return end
    if os.clock() - BombJump.LastJump < BombJump.Cooldown then return end
    
    local hum = GetHumanoid(LocalPlayer)
    if not hum then return end
    
    -- Проверка, что игрок в воздухе
    local state = hum:GetState()
    if state ~= Enum.HumanoidStateType.Jumping and 
       state ~= Enum.HumanoidStateType.FallingDown and
       state ~= Enum.HumanoidStateType.Freefall then
        return
    end
    
    local bomb = GetBomb()
    if not bomb then return end
    
    local root = GetRootPart(LocalPlayer)
    if not root then return end
    
    -- Активация бомбы
    local remote = bomb:FindFirstChild("Remote")
    if remote then
        local camera = Workspace.CurrentCamera
        local pos = root.Position + camera.CFrame.LookVector * 3 + Vector3.new(0, -2, 0)
        
        pcall(function()
            remote:FireServer(CFrame.new(pos), BombJump.Power)
        end)
        
        -- Принудительный прыжок
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            BombJump.Power,
            root.AssemblyLinearVelocity.Z
        )
        
        BombJump.LastJump = os.clock()
        
        -- Создание визуального эффекта
        if KillEffect.Enabled then
            CreateKillEffect(root.Position)
        end
    end
end

-- ==============================================
-- WALLHOP (УЛУЧШЕННЫЙ)
-- ==============================================
local WallHop = {
    Enabled = false,
    Distance = 3,
    Power = 50,
    LastHop = 0,
    IsJumping = false,
    LastWall = nil,
}

local function PerformWallHop()
    if not WallHop.Enabled then return end
    if os.clock() - WallHop.LastHop < 0.2 then return end
    
    local char = GetCharacter(LocalPlayer)
    if not char then return end
    
    local hum = GetHumanoid(LocalPlayer)
    if not hum then return end
    if hum.Health <= 0 then return end
    
    local root = GetRootPart(LocalPlayer)
    if not root then return end
    
    -- Проверка стены
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local direction = camera.CFrame.LookVector * WallHop.Distance
    local result = workspace:Raycast(root.Position, direction, raycastParams)
    
    if result then
        local hit = result.Instance
        
        -- Проверка, что это стена
        if hit:IsA("BasePart") and hit.CanCollide then
            -- Проверка смены стены для флинга
            if WallHop.LastWall and WallHop.LastWall ~= hit then
                -- Выполнение флинга
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    WallHop.Power,
                    root.AssemblyLinearVelocity.Z
                )
                WallHop.LastHop = os.clock()
            end
            WallHop.LastWall = hit
        end
    else
        WallHop.LastWall = nil
    end
end

