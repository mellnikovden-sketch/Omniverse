-- OUTLINE СИСТЕМА
-- ==============================================
local OutlineEnabled = false
local OutlinedPlayers = {}

local function GetOutlineColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

local function GetRoleEmoji(role)
    if role == "Murderer" then return "🔪"
    elseif role == "Sheriff" then return "🔫"
    elseif role == "Innocent" then return "👤"
    else return "❓" end
end

local function ApplyOutline(plr)
    if not plr or plr == LocalPlayer or OutlinedPlayers[plr] then return end
    if not plr.Character then return end
    
    local role = GetPlayerRole(plr)
    if role == "Dead" or role == "Unknown" then return end
    if not IsPlayerInGame(plr) then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "Outline_Highlight"
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0.2
    highlight.OutlineColor = GetOutlineColor(role)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = plr.Character
    highlight.Parent = plr.Character
    
    local head = plr.Character:FindFirstChild("Head")
    local billboard = nil
    
    if head then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "Outline_NameTag"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.Adornee = head
        billboard.Parent = plr.Character
        billboard.AlwaysOnTop = true
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = GetRoleEmoji(role) .. " " .. plr.Name .. " [" .. role .. "]"
        nameLabel.TextColor3 = GetOutlineColor(role)
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.Jura
        nameLabel.TextStrokeTransparency = 0.2
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = billboard
    end
    
    OutlinedPlayers[plr] = {
        Highlight = highlight,
        Billboard = billboard,
        Role = role
    }
end

local function RemoveOutline(plr)
    if OutlinedPlayers[plr] then
        local data = OutlinedPlayers[plr]
        if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
        if data.Billboard then pcall(function() data.Billboard:Destroy() end) end
        OutlinedPlayers[plr] = nil
    end
end

local function UpdateOutline()
    if OutlineEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local role = GetPlayerRole(plr)
                local inGame = IsPlayerInGame(plr)
                
                if (role == "Dead" or role == "Unknown" or not inGame) then
                    if OutlinedPlayers[plr] then RemoveOutline(plr) end
                else
                    if OutlinedPlayers[plr] then
                        local data = OutlinedPlayers[plr]
                        if data.Role ~= role then
                            if data.Highlight then data.Highlight.OutlineColor = GetOutlineColor(role) end
                            if data.Billboard then
                                local label = data.Billboard:FindFirstChildOfClass("TextLabel")
                                if label then
                                    label.Text = GetRoleEmoji(role) .. " " .. plr.Name .. " [" .. role .. "]"
                                    label.TextColor3 = GetOutlineColor(role)
                                end
                            end
                            data.Role = role
                        end
                    else
                        ApplyOutline(plr)
                    end
                end
            end
        end
    else
        for plr, _ in pairs(OutlinedPlayers) do
            RemoveOutline(plr)
        end
    end
end

-- ==============================================
-- WALLHOP СИСТЕМА
-- ==============================================
local WallHop = {
    enabled = false,
    detectionDistance = 3,
    flickPower = 50,
    isFlicking = false,
    isJumpKeyPressed = false,
}

local function isWall(instance)
    if not instance then return false end
    if instance:IsA("BasePart") and instance.CanCollide then
        return true
    end
    if instance:IsA("Terrain") then
        return true
    end
    return false
end

local function performWallhop()
    if not WallHop.enabled then return end
    
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not (humanoid and rootPart and humanoid:GetState() ~= Enum.HumanoidStateType.Dead) then return end
    
    local raycastParams = RaycastParams.new()
    local filterList = {character}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            table.insert(filterList, plr.Character)
        end
    end
    raycastParams.FilterDescendantsInstances = filterList
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local direction = camera.CFrame.LookVector * WallHop.detectionDistance
    local result = Workspace:Raycast(rootPart.Position, direction, raycastParams)
    
    if result and isWall(result.Instance) then
        rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + result.Normal)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        rootPart.AssemblyLinearVelocity = Vector3.new(
            rootPart.AssemblyLinearVelocity.X,
            WallHop.flickPower,
            rootPart.AssemblyLinearVelocity.Z
        )
    end
end

function ToggleWallHop()
    WallHop.enabled = not WallHop.enabled
    local btn = BindableButtons.Buttons["wallhop_toggle"]
    if btn then
        BindableButtons.UpdateBButtonText("wallhop_toggle", WallHop.enabled and "WH:ON" or "WH:OFF")
        BindableButtons.UpdateBButtonColor("wallhop_toggle", WallHop.enabled, "wallhop")
    end
    print("🧱 WallHop: " .. (WallHop.enabled and "ENABLED" or "DISABLED"))
end

