-- Очистка
LocalPlayer.CharacterAdded:Connect(function()
    TargetPlayer = nil
end)

RootMaid:GiveTask(function()
    RunService:UnbindFromRenderStep("MM2_AimLock")
    for _, id in ipairs({"aim_toggle", "wall_toggle", "outline_toggle", "wallhop_toggle", "bombjump_bind", "goldbombjump_bind"}) do
        BindableButtons.DeleteBButton(id)
    end
    if MainGUI then MainGUI:Destroy() end
    OutlineMaid:Destroy()
    for plr, _ in pairs(OutlinedPlayers) do
        RemoveOutline(plr)
    end
    OutlinedPlayers = {}
    for _, conn in pairs(PlayerConnections) do
        pcall(function() conn:Disconnect() end)
    end
    PlayerConnections = {}
end)

