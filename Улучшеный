local function CreateButton(id, text, callback, color, icon)
    if GUI.Buttons[id] then return end
    
    local screen = Workspace.CurrentCamera.ViewportSize
    local size = 0.12
    local xPos = 0.05 + ((#GUI.Buttons % 6) * (size + 0.01))
    local yPos = 0.85 - (math.floor(#GUI.Buttons / 6) * (size + 0.01))
    
    local btn = Instance.new("ImageButton")
    btn.Name = "Btn_" .. id
    btn.Size = UDim2.new(size, 0, size, 0)
    btn.Position = UDim2.new(xPos, 0, yPos, 0)
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.Image = "rbxassetid://86221076925479"
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Parent = CoreGui
    
    -- Градиент
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color or Color3.fromRGB(100, 100, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 200)),
    })
    gradient.Parent = btn
    
    -- Текст
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.8, 0, 0.8, 0)
    label.Position = UDim2.new(0.5, 0, 0.5, 0)
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Jura
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 18
    label.TextWrapped = true
    label.Parent = btn
    
    -- Иконка
    if icon then
        local iconLabel = Instance.new("ImageLabel")
        iconLabel.Size = UDim2.new(0.3, 0, 0.3, 0)
        iconLabel.Position = UDim2.new(0.05, 0, 0.05, 0)
        iconLabel.BackgroundTransparency = 1
        iconLabel.Image = icon
        iconLabel.Parent = btn
    end
    
    -- Анимация при наведении
    local function AnimateHover(hover)
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local targetSize = hover and UDim2.new(size * 1.1, 0, size * 1.1, 0) or UDim2.new(size, 0, size, 0)
        TweenService:Create(btn, tweenInfo, {Size = targetSize}):Play()
    end
    
    btn.MouseEnter:Connect(function() AnimateHover(true) end)
    btn.MouseLeave:Connect(function() AnimateHover(false) end)
    btn.MouseButton1Click:Connect(callback)
    
    GUI.Buttons[id] = {
        Button = btn,
        Label = label,
        Gradient = gradient,
        State = false,
    }
    
    return btn
end

local function UpdateButton(id, text, state, color)
    local data = GUI.Buttons[id]
    if not data then return end
    
    data.Label.Text = text
    data.State = state
    
    if state then
        data.Gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 100)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 200, 50)),
        })
    else
        data.Gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, color or Color3.fromRGB(100, 100, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 200)),
        })
    end
end

