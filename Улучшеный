local function UpdateLoop()
    UpdateAimLock()
    UpdateESP()
    UpdateSpeedBoost()
    
    if NoRecoil.Enabled then
        ApplyNoRecoil()
    end
    
    if TriggerBot.Enabled then
        PerformTriggerBot()
    end
    
    if AutoKnife.Enabled then
        PerformAutoKnife()
    end
    
    if WallHop.Enabled then
        PerformWallHop()
    end
    
    if Config.AutoRespawnEnabled then
        local hum = GetHumanoid(LocalPlayer)
        if hum and hum.Health <= 0 then
            pcall(function()
                ReplicatedStorage.Respawn:FireServer()
            end)
        end
    end
end

-- ==============================================
-- ЗАПУСК
-- ==============================================
local function Setup()
    CreateAllButtons()
    
    -- Горячие клавиши
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        local callback = Keybinds[input.KeyCode]
        if callback then callback() end
    end)
    
    -- Отслеживание прыжка для WallHop
    UserInputService.JumpRequest:Connect(function()
        WallHop.IsJumping = true
        if BombJump.Enabled then
            PerformBombJump()
        end
    end)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Space then
            WallHop.IsJumping = true
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Space then
            WallHop.IsJumping = false
        end
    end)
    
    -- Основной цикл
    RunService.Heartbeat:Connect(UpdateLoop)
    
    -- Очистка при выходе игроков
    Players.PlayerRemoving:Connect(function(plr)
        RemoveESPBox(plr)
    end)
    
    -- Сброс при респавне
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        AimLock.Target = nil
        WallHop.LastWall = nil
    end)
end

Setup()

