end))

WallhopMaid:GiveTask(UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Space then
        WallHop.isJumpKeyPressed = false
        WallHop.lastHitInstance = nil
    end
end))

WallhopMaid:GiveTask(LocalPlayer.CharacterAdded:Connect(function(character)
    WallHop.lastHitInstance = nil
    WallHop.currentHitInstance = nil
    WallHop.isFlicking = false
end))

WallhopMaid:GiveTask(UserInputService.WindowFocused:Connect(function()
    WallHop.isJumpKeyPressed = false
    WallHop.lastHitInstance = nil
end))

