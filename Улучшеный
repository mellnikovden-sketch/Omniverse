local Tracers = {
    Enabled = false,
    Lines = {},
}

local function CreateTracer(plr)
    if not plr or plr == LocalPlayer then return end
    if Tracers.Lines[plr] then return end
    
    local role = GetPlayerRole(plr)
    if role == "Dead" then return end
    
    local char = GetCharacter(plr)
    if not char then return end
    
    local line = Instance.new("LineHandleAdornment")
    line.Name = "Tracer"
    line.Color3 = GetRoleColor(role)
    line.Transparency = 0.5
    line.Thickness = 1
    line.ZIndex = 0
    line.Parent = char
    
    Tracers.Lines[plr] = line
end

local function RemoveTracer(plr)
    if Tracers.Lines[plr] then
        pcall(function() Tracers.Lines[plr]:Destroy() end)
        Tracers.Lines[plr] = nil
    end
end

local function UpdateTracers()
    if not Tracers.Enabled then
        for plr, _ in pairs(Tracers.Lines) do
            RemoveTracer(plr)
        end
        return
    end
    
    local camera = Workspace.CurrentCamera
    if not camera then return end
    
    local myPos = camera.CFrame.Position
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local role = GetPlayerRole(plr)
            local alive = IsAlive(plr)
            
            if alive and role ~= "Dead" then
                local root = GetRootPart(plr)
                if root then
                    if not Tracers.Lines[plr] then
                        CreateTracer(plr)
                    end
                    
                    local line = Tracers.Lines[plr]
                    if line then
                        line.From = myPos
                        line.To = root.Position
                        line.Color3 = GetRoleColor(role)
                    end
                end
            else
                if Tracers.Lines[plr] then
                    RemoveTracer(plr)
                end
            end
        end
    end
end

