local function UpdateButtonSizes()
    local camera = Workspace.CurrentCamera
    if not camera then return end
    local screen = camera.ViewportSize
    if screen and screen.X > 0 and screen.Y > 0 then
        local size = 0.10
        local widthScale = size * (screen.Y / screen.X)
        for _, btn in pairs(BindableButtons.Buttons) do
            if btn and btn.Size then
                btn.Size = __UD2(widthScale, 0, size, 0)
            end
        end
    end
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    UpdateButtonSizes()
end)

