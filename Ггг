    local stroke = Instance.new("UIStroke")
    stroke.Color, stroke.Thickness = __RGB(255, 255, 255), 1.5
    stroke.Parent = frame
    
    local title = Instance.new("TextLabel")
    title.Size, title.Position, title.BackgroundTransparency = __UD2(1, 0, 0, 30), __UD2(0, 0, 0, 0), 1
    title.Text, title.TextColor3, title.TextSize, title.Font = " RT SYSTEM", __RGB(255, 255, 255), 13, Enum.Font.Jura
    title.TextXAlignment, title.Parent = Enum.TextXAlignment.Left, frame
    
