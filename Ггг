    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size, scrollFrame.Position, scrollFrame.BackgroundTransparency = __UD2(1, -8, 1, -38), __UD2(0, 4, 0, 34), 1
    scrollFrame.ScrollBarThickness, scrollFrame.Parent = 3, frame
    
    local layout = Instance.new("UIListLayout")
    layout.Padding, layout.Parent = UDim.new(0, 3), scrollFrame
    
    local function AddButton(text, callback)
        local btn = Instance.new("TextButton")
        btn.Size, btn.BackgroundColor3, btn.BackgroundTransparency = __UD2(0.92, 0, 0, 24), __RGB(40, 40, 40), 0.4
        btn.Text, btn.TextColor3, btn.TextSize, btn.Font = text, __RGB(255, 255, 255), 10, Enum.Font.Jura
        btn.Parent = scrollFrame
        Instance.new("UICorner", btn).CornerRadius = __UD(0, 4)
        btn.MouseButton1Click:Connect(callback)
        return btn
    end
    
    AddButton("⚫ Reset Murderer", function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and GetPlayerRole(plr) == "Murderer" then
                task.spawn(VoidReset, plr)
                return
            end
        end
        Reset_Notify("Error", "No Murderer found")
    end)
    
    AddButton(" Reset Sheriff", function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and GetPlayerRole(plr) == "Sheriff" then
                task.spawn(VoidReset, plr)
                return
            end
        end
        Reset_Notify("Error", "No Sheriff found")
    end)
    
    AddButton("⚫ Reset All", function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then task.spawn(VoidReset, plr) end
        end
    end)
    
    AddButton("⚫ Toggle Noclip", function()
        ResetState.noclipEnabled = not ResetState.noclipEnabled
