-- WALLCHECK
-- ==============================================
function IsPlayerVisible(plr)
    if not plr or not plr.Character then return false end
    local targetPart = plr.Character:FindFirstChild("HumanoidRootPart")
    local CurrentCamera = Workspace.CurrentCamera
    if not targetPart or not CurrentCamera then return false end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = Workspace:Raycast(CurrentCamera.CFrame.Position, targetPart.Position - CurrentCamera.CFrame.Position, raycastParams)
    return not result or result.Instance:IsDescendantOf(plr.Character)
end

-- ==============================================
-- AIM LOCK
-- ==============================================
local AimLockEnabled = false
local TargetPart = "HumanoidRootPart"
local TargetPlayer = nil
local WallCheckEnabled = false
local PredictionLevel = 0.2
local LastSearchTime = 0
local LastWallCheckTime = 0
local IsTargetVisibleCache = false
local WALL_CHECK_INTERVAL = 0.15 
local InvisibleTimer = 0
local MAX_INVISIBLE_TIME = 0.5

local function FindMurderer(preferTarget)
    if preferTarget and preferTarget.Character then
        local hum = preferTarget.Character:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 and GetPlayerRole(preferTarget) == "Murderer" then
            if not WallCheckEnabled or IsPlayerVisible(preferTarget) then return preferTarget end
        end
    end

    local bestTarget, bestDist = nil, math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            if GetPlayerRole(pl) == "Murderer" then
                local hum = pl.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    if WallCheckEnabled and not IsPlayerVisible(pl) then continue end
                    local root = pl.Character:FindFirstChild("HumanoidRootPart")
                    if root and myRoot then
                        local dist = (root.Position - myRoot.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestTarget = pl
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

local function AimLockLoop(deltaTime)
    if not AimLockEnabled then return end
    local CurrentCamera = Workspace.CurrentCamera 
    if not CurrentCamera then return end

    local valid = false
    if TargetPlayer and TargetPlayer.Character then
        local hum = TargetPlayer.Character:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 and GetPlayerRole(TargetPlayer) == "Murderer" then
            valid = true
        end
    end
    
    if WallCheckEnabled and valid then
        local currentTime = os.clock()
        if currentTime - LastWallCheckTime > WALL_CHECK_INTERVAL then
            IsTargetVisibleCache = IsPlayerVisible(TargetPlayer)
            LastWallCheckTime = currentTime
        end
        if not IsTargetVisibleCache then
            InvisibleTimer = InvisibleTimer + deltaTime
            if InvisibleTimer > MAX_INVISIBLE_TIME then valid = false end
        else
            InvisibleTimer = 0
        end
    else
        InvisibleTimer = 0
    end
    
    if not valid then 
        local currentTime = os.clock()
        if currentTime - LastSearchTime > 0.1 then
            TargetPlayer = FindMurderer(TargetPlayer)
            LastSearchTime = currentTime
        end
    end
    
    if TargetPlayer and TargetPlayer.Character then
        local targetNode = TargetPlayer.Character:FindFirstChild(TargetPart)
        if targetNode then
            local vel = targetNode.AssemblyLinearVelocity or Vector3.new()
            local predVector = Vector3.new(vel.X, vel.Y * 0.3, vel.Z)
            local predictedPos = targetNode.Position + (predVector * PredictionLevel)
            CurrentCamera.CFrame = CFrame.new(CurrentCamera.CFrame.Position, predictedPos)
        end
    end
end

-- ==============================================
-- OUTLINE СИСТЕМА
-- ==============================================
local OutlineEnabled = false
local OutlinedPlayers = {}
local OutlineMaid = Maid.new()
local OutlineUpdateRate = 0.1
local LastOutlineUpdate = 0
local PlayerConnections = {}

local function GetOutlineColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

local function GetRoleEmoji(role)
    if role == "Murderer" then return "🔪"
    elseif role == "Sheriff" then return "🔫"
    elseif role == "Innocent" then return "👤"
    else return "❓" end
end

local function IsPlayerInGame(plr)
    if not plr or not plr.Character then return false end
    local humanoid = plr.Character:FindFirstChild("Humanoid")
    return humanoid and humanoid.Health > 0
end

local function ApplyOutline(plr)
    if not plr or plr == LocalPlayer or OutlinedPlayers[plr] or not plr.Character then return end
    local role = GetPlayerRole(plr)
    if role == "Dead" or role == "Unknown" or not role or not IsPlayerInGame(plr) then return end
    
    local color = GetOutlineColor(role)
    local highlight = Instance.new("Highlight")
    highlight.Name = "Outline_Highlight"
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0.2
    highlight.OutlineColor = color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = plr.Character
    highlight.Parent = plr.Character
    
    local head = plr.Character:FindFirstChild("Head")
    local billboard, nameLabel = nil, nil
    if head then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "Outline_NameTag"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.Adornee = head
        billboard.AlwaysOnTop = true
        billboard.Parent = plr.Character
        
        nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = GetRoleEmoji(role) .. " " .. plr.Name .. " [" .. role .. "]"
        nameLabel.TextColor3 = color
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.Jura
        nameLabel.TextStrokeTransparency = 0.2
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = billboard
    end
    
    OutlinedPlayers[plr] = {Highlight = highlight, Billboard = billboard, Label = nameLabel, Role = role}
end

local function RemoveOutline(plr)
    if OutlinedPlayers[plr] then
        local data = OutlinedPlayers[plr]
        pcall(function() if data.Highlight then data.Highlight:Destroy() end end)
        pcall(function() if data.Billboard then data.Billboard:Destroy() end end)
        OutlinedPlayers[plr] = nil
    end
end

local function FullRefreshOutline()
    for plr, _ in pairs(OutlinedPlayers) do RemoveOutline(plr) end
    if OutlineEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then ApplyOutline(plr) end
        end
    end
end

local function UpdateOutline()
    if not OutlineEnabled then
        for plr, _ in pairs(OutlinedPlayers) do RemoveOutline(plr) end
        return
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local role = GetPlayerRole(plr)
            local isValid = role and role ~= "Dead" and role ~= "Unknown" and IsPlayerInGame(plr)
            
            if not isValid then
                RemoveOutline(plr)
            else
                if OutlinedPlayers[plr] then
                    local data = OutlinedPlayers[plr]
                    if data.Role ~= role then
                        local color = GetOutlineColor(role)
                        if data.Highlight then data.Highlight.OutlineColor = color end
                        if data.Label then 
                            data.Label.Text = GetRoleEmoji(role) .. " " .. plr.Name .. " [" .. role .. "]"
                            data.Label.TextColor3 = color 
                        end
                        data.Role = role
                    end
                else
                    ApplyOutline(plr)
                end
            end
        end
    end
end

local function OutlineUpdateLoop()
    local now = os.clock()
    if now - LastOutlineUpdate < OutlineUpdateRate then return end
    LastOutlineUpdate = now
    UpdateOutline()
end

local function SetupPlayer(plr)
    if plr == LocalPlayer then return end
    if PlayerConnections[plr] then PlayerConnections[plr]:Disconnect() end
    
    local conn = plr.CharacterAdded:Connect(function()
        task.wait(0.05)
        if OutlineEnabled then
            RemoveOutline(plr)
            ApplyOutline(plr)
        end
    end)
    PlayerConnections[plr] = conn
    OutlineMaid:GiveTask(conn)
    
    if OutlineEnabled then
        task.wait(0.05)
        ApplyOutline(plr)
    end
end

for _, plr in ipairs(Players:GetPlayers()) do SetupPlayer(plr) end

Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(function(plr)
    RemoveOutline(plr)
    if PlayerConnections[plr] then PlayerConnections[plr]:Disconnect(); PlayerConnections[plr] = nil end
end)

-- ==============================================
-- WALLHOP СИСТЕМА
-- ==============================================
local WallHop = {
    enabled = false,
    detectionDistance = 3,
    flickPower = 50,
    isFlicking = false,
    lastFlickTime = 0,
    isJumpKeyPressed = false,
    lastHitInstance = nil,
    currentHitInstance = nil,
}

local wallRaycastParams = RaycastParams.new()
wallRaycastParams.FilterType = Enum.RaycastFilterType.Blacklist

local function isWall(instance)
    if not instance or not instance.IsA then return false end
    if instance:IsA("BasePart") and not instance.CanCollide then return false end
    if instance:IsA("BasePart") and instance.Parent and instance.Parent:IsA("Model") and instance.Parent:FindFirstChild("Humanoid") then return false end
    return instance:IsA("BasePart") or instance:IsA("Terrain")
end

local function getWallRaycastResult()
    local character = LocalPlayer.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local blacklist = {character}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then table.insert(blacklist, player.Character) end
    end
    wallRaycastParams.FilterDescendantsInstances = blacklist
    
    local closestHit, minDistance = nil, WallHop.detectionDistance
    local hrpCF = hrp.CFrame
    for i = 0, 7 do
        local angle = math.rad(i * 45)
        local dir = (hrpCF * CFrame.Angles(0, angle, 0)).LookVector
        local ray = Workspace:Raycast(hrp.Position, dir * WallHop.detectionDistance, wallRaycastParams)
        if ray and ray.Instance and ray.Distance < minDistance and isWall(ray.Instance) then
            minDistance = ray.Distance
            closestHit = ray
        end
    end
    return closestHit
end

local function performVideoFlick()
    if not WallHop.enabled or WallHop.isFlicking then return end
    WallHop.isFlicking = true
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not hum or not hrp or hum.Health <= 0 then WallHop.isFlicking = false; return end
    
    local currentVel = hrp.Velocity
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    hrp.Velocity = Vector3.new(currentVel.X, WallHop.flickPower, currentVel.Z)
    
    local Camera = Workspace.CurrentCamera
    local startCFrame = Camera.CFrame
    Camera.CFrame = startCFrame * CFrame.Angles(0, math.rad(180), 0)
    task.wait(0.01)
    Camera.CFrame = startCFrame
    WallHop.isFlicking = false
end

local function performWallhop()
    if not WallHop.enabled then return end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    -- Защита от случайных срабатываний в воздухе
    if not (humanoid and rootPart) or humanoid:GetState() == Enum.HumanoidStateType.Dead or humanoid:GetState() == Enum.HumanoidStateType.Freefall then return end
    
    local wall = getWallRaycastResult()
    if not wall then return end

    rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + wall.Normal)
    RunService.Heartbeat:Wait()
    
    if humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.1)
    end
end

local WallhopMaid = Maid.new()
RootMaid:GiveTask(WallhopMaid)

WallhopMaid:GiveTask(RunService.Heartbeat:Connect(function()
    if not WallHop.enabled or WallHop.isFlicking or not WallHop.isJumpKeyPressed then 
        WallHop.lastHitInstance = nil
        return 
    end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then 
        WallHop.lastHitInstance = nil
        return 
    end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    local Camera = Workspace.CurrentCamera
    local direction = Camera.CFrame.LookVector * WallHop.detectionDistance
    local result = Workspace:Raycast(hrp.Position, direction, raycastParams)
    
    WallHop.currentHitInstance = nil
    if result and isWall(result.Instance) then
        WallHop.currentHitInstance = result.Instance
        if WallHop.lastHitInstance and WallHop.lastHitInstance ~= WallHop.currentHitInstance then
            local currentTime = os.clock()
            if currentTime - WallHop.lastFlickTime > 0.1 then
                WallHop.lastFlickTime = currentTime
                performVideoFlick()
            end
        end
    end
    WallHop.lastHitInstance = WallHop.currentHitInstance
end))

WallhopMaid:GiveTask(UserInputService.JumpRequest:Connect(function()
    if WallHop.enabled then performWallhop() end
end))

WallhopMaid:GiveTask(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.Space then WallHop.isJumpKeyPressed = true end
