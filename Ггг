    end)
    
    AddButton("⚫ Close", function() ResetGUI.Enabled = false; ResetState.resetGuiOpen = false end)
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = __UD2(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)
end

