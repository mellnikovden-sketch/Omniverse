local function FindWeapon(character, keywords)
    if not character then return false end
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for _, wName in ipairs(keywords) do
                if name:find(wName) or wName:find(name) then return true end
            end
            if item:FindFirstChild("KnifeServer") or item:FindFirstChild("KnifeClient") or item:FindFirstChild("GunServer") or item:FindFirstChild("GunClient") then return true end
            if item.ToolTip and string.lower(item.ToolTip):find("knife") or string.lower(item.ToolTip):find("gun") then return true end
        end
    end
    return false
end

local function GetPlayerRole(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return nil end
    local humanoid = plr.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return "Dead" end
    
    local murdererAttr = plr:GetAttribute("Murderer")
    local sheriffAttr = plr:GetAttribute("Sheriff")
    local roleAttr = plr:GetAttribute("Role")
    
    if murdererAttr == true or murdererAttr == "True" or roleAttr == "Murderer" or roleAttr == "Murder" or roleAttr == "Killer" then return "Murderer" end
    if sheriffAttr == true or sheriffAttr == "True" or roleAttr == "Sheriff" or roleAttr == "Cop" then return "Sheriff" end
    
    if FindWeapon(plr.Character, {"knife", "blade", "dagger", "saw", "slasher", "axe", "scythe", "peppermint", "cookie", "edge", "batwing", "icewing", "bone", "hallow", "vampire", "cutter", "candy"}) then return "Murderer" end
    if FindWeapon(plr.Character, {"gun", "pistol", "revolver", "shooter", "blaster", "glock"}) then return "Sheriff" end
    
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        if FindWeapon(backpack, {"knife", "blade", "dagger"}) then return "Murderer" end
        if FindWeapon(backpack, {"gun", "pistol", "revolver"}) then return "Sheriff" end
    end
    
    return "Innocent"
end

