-- MM2 Murderer Aim Lock V3.0 (Optimized & Smoothed)
-- IMPROVED: Производительность Raycast и ESP (FPS Boost)
-- IMPROVED: Плавность AimLock (Lerp) для обхода античита
-- FIXED: Устаревшие API (Velocity -> AssemblyLinearVelocity)
-- FIXED: Утечки памяти и глобальные переменные

-- ==============================================
-- СЕРВИСЫ И ПЕРЕМЕННЫЕ
-- ==============================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local LocalPlayer = Players.LocalPlayer

local Camera = Workspace.CurrentCamera
local CurrentCamera = Workspace.CurrentCamera

-- ==============================================
-- УТИЛИТЫ (ОПТИМИЗИРОВАНЫ)
-- ==============================================
local function getCharacterModel(instance)
    if not instance then return nil end
    local model = instance:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then
        return model
    end
    return nil
end

local function isWall(instance)
    if not instance or not instance:IsA("BasePart") then return false end
    if not instance.CanCollide then return false end
    -- Мгновенная проверка без циклов
    if getCharacterModel(instance) then return false end
    return true
end

-- ==============================================
-- WALLHOP СИСТЕМА
-- ==============================================
local WallHop = {
    enabled = false,
    detectionDistance = 4,
    flickPower = 55,
    isFlicking = false,
    lastHitInstance = nil,
    isJumpKeyPressed = false
}

local wallRaycastParams = RaycastParams.new()
wallRaycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function performVideoFlick()
    if not WallHop.enabled or WallHop.isFlicking then return end
    WallHop.isFlicking = true
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not (hum and hrp and hum.Health > 0) then 
        WallHop.isFlicking = false 
        return 
    end

    local currentVel = hrp.AssemblyLinearVelocity
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    hrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, WallHop.flickPower, currentVel.Z)

    -- Разворот камеры
    local startCFrame = CurrentCamera.CFrame
    CurrentCamera.CFrame = startCFrame * CFrame.Angles(0, math.rad(180), 0)
    task.wait(0.02)
    CurrentCamera.CFrame = startCFrame
    WallHop.isFlicking = false
end

local function wallHopHeartbeat()
    if not WallHop.enabled or WallHop.isFlicking then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not WallHop.isJumpKeyPressed then 
        WallHop.lastHitInstance = nil
        return 
    end

    -- Фильтруем только своего персонажа
    wallRaycastParams.FilterDescendantsInstances = {char}
    
    -- 1 луч по направлению камеры (вместо 8 для экономии FPS)
    local direction = CurrentCamera.CFrame.LookVector * WallHop.detectionDistance
    local result = Workspace:Raycast(hrp.Position, direction, wallRaycastParams)

    if result and isWall(result.Instance) then
        local hitInstance = result.Instance
        if WallHop.lastHitInstance and WallHop.lastHitInstance ~= hitInstance then
            performVideoFlick()
        end
        WallHop.lastHitInstance = hitInstance
    else
        WallHop.lastHitInstance = nil
    end
end

local function performWallhop()
    if not WallHop.enabled then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp and hum.Health > 0) then return end

    wallRaycastParams.FilterDescendantsInstances = {char}
    local result = Workspace:Raycast(hrp.Position, CurrentCamera.CFrame.LookVector * 3, wallRaycastParams)
    
    if result and isWall(result.Instance) then
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + result.Normal)
        task.wait(0.05)
        if hum.Health > 0 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end

local function ToggleWallHop()
    WallHop.enabled = not WallHop.enabled
    print("🧱 WallHop: " .. (WallHop.enabled and "ENABLED" or "DISABLED"))
end

