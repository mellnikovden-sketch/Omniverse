local function FindWeapon(character, keywords)
    if not character then return false end
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for _, wName in ipairs(keywords) do
                if name:find(wName) then return true end
            end
            if item:FindFirstChild("KnifeServer") or item:FindFirstChild("KnifeClient") or item:FindFirstChild("GunServer") or item:FindFirstChild("GunClient") then return true end
        end
    end
    return false
end

local function GetPlayerRole(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return nil end
    local humanoid = plr.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return "Dead" end
    
    if plr:GetAttribute("Murderer") or plr:GetAttribute("Role") == "Murderer" then return "Murderer" end
    if plr:GetAttribute("Sheriff") or plr:GetAttribute("Role") == "Sheriff" then return "Sheriff" end
    
    if FindWeapon(plr.Character, {"knife", "blade", "dagger", "saw", "slasher"}) then return "Murderer" end
    if FindWeapon(plr.Character, {"gun", "pistol", "revolver", "shooter"}) then return "Sheriff" end
    
    return "Innocent"
end

