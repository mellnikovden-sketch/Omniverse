-- которые не грузят память и не вызывают конфликтов с античитом]

local function CreateSimpleButton(text, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Name = text
    btn.Size = UDim2.new(0, 100, 0, 35)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = MainGUI
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- ==============================================
-- OUTLINE / ESP СИСТЕМА
-- ==============================================
local OutlineEnabled = false
local OutlinedPlayers = {}

local function GetRole(plr)
    if not plr or not plr.Character then return "Unknown" end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return "Dead" end
    
    -- Проверка атрибутов (самый надежный способ)
    if plr:GetAttribute("Murderer") or plr:GetAttribute("Role") == "Murderer" then return "Murderer" end
    if plr:GetAttribute("Sheriff") or plr:GetAttribute("Role") == "Sheriff" then return "Sheriff" end
    
    return "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0) end
    if role == "Sheriff" then return Color3.fromRGB(0, 150, 255) end
    return Color3.fromRGB(0, 255, 0)
end

local function ApplyOutline(plr)
    if not plr.Character or OutlinedPlayers[plr] then return end
    
    local role = GetRole(plr)
    if role == "Dead" or role == "Unknown" then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_HL"
    highlight.FillTransparency = 0.7
    highlight.OutlineColor = GetRoleColor(role)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = plr.Character
    highlight.Parent = plr.Character
    
    OutlinedPlayers[plr] = highlight
end

local function RemoveOutline(plr)
    if OutlinedPlayers[plr] then
        pcall(function() OutlinedPlayers[plr]:Destroy() end)
        OutlinedPlayers[plr] = nil
    end
end

local function UpdateOutlineLoop()
    if not OutlineEnabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local role = GetRole(plr)
            if role ~= "Dead" and role ~= "Unknown" then
                if not OutlinedPlayers[plr] then
                    ApplyOutline(plr)
                end
            else
                RemoveOutline(plr)
            end
        end
    end
end

local function ToggleOutline()
    OutlineEnabled = not OutlineEnabled
    if not OutlineEnabled then
        for plr, _ in pairs(OutlinedPlayers) do RemoveOutline(plr) end
    end
    print("👁️ Outline: " .. (OutlineEnabled and "ENABLED" or "DISABLED"))
end

-- ==============================================
-- BOMB JUMP+ СИСТЕМА
-- ==============================================
local BombJumpEnabled = true
local BombCooldown = false

local function FastBombJump()
    if not BombJumpEnabled or BombCooldown then return end
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return end
    
    -- Проверка воздуха
    if hum:GetState() ~= Enum.HumanoidStateType.Freefall and hum:GetState() ~= Enum.HumanoidStateType.Jumping then return end

    local bomb = char:FindFirstChild("FakeBomb") or LocalPlayer.Backpack:FindFirstChild("FakeBomb")
    if not bomb then
        -- Попытка получить бомбу
        pcall(function()
            ReplicatedStorage.Remotes.Extras.ReplicateToy:InvokeServer("FakeBomb")
        end)
        bomb = char:FindFirstChild("FakeBomb")
        if not bomb then return end
    end

    BombCooldown = true
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    
    -- Используем AssemblyLinearVelocity вместо устаревшего Velocity
    local currentVel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(currentVel.X, currentVel.Y + 60, currentVel.Z)

    -- Бросок бомбы вниз для ускорения
    local remote = bomb:FindFirstChild("Remote")
    if remote then
        local pos = hrp.Position + Vector3.new(0, -3, 0)
        pcall(function() remote:FireServer(CFrame.new(pos), 50) end)
    end
    
    -- Убираем бомбу в инвентарь
    task.spawn(function()
        task.wait(0.2)
        if bomb and bomb.Parent == char then
            bomb.Parent = LocalPlayer.Backpack
        end
    end)

    task.delay(22, function() BombCooldown = false end)
end

local function ToggleBombJump()
    BombJumpEnabled = not BombJumpEnabled
    print("💣 Bomb Jump: " .. (BombJumpEnabled and "ENABLED" or "DISABLED"))
end

-- ==============================================
-- AIMLOCK СИСТЕМА (СГЛАЖЕННАЯ)
-- ==============================================
local AimLockEnabled = false
local TargetPlayer = nil
local WallCheckEnabled = false
local PredictionLevel = 0.15

local aimRaycastParams = RaycastParams.new()
aimRaycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function IsPlayerVisible(plr)
    if not plr.Character then return false end
    local targetPart = plr.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end

    aimRaycastParams.FilterDescendantsInstances = {LocalPlayer.Character, plr.Character}
    local origin = CurrentCamera.CFrame.Position
    local direction = (targetPart.Position - origin)
    
    local result = Workspace:Raycast(origin, direction, aimRaycastParams)
    return not result or result.Instance:IsDescendantOf(plr.Character)
end

local function FindMurderer()
    local bestTarget, bestDist = nil, math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local role = GetRole(pl)
            if role == "Murderer" then
                local hum = pl.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    if WallCheckEnabled and not IsPlayerVisible(pl) then continue end
                    
                    local root = pl.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - myRoot.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestTarget = pl
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

local function AimLockLoop()
    if not AimLockEnabled then return end
    
    if not TargetPlayer or not TargetPlayer.Character or GetRole(TargetPlayer) ~= "Murderer" then
        TargetPlayer = FindMurderer()
    end

    if TargetPlayer and TargetPlayer.Character then
        local targetNode = TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetNode then
            local vel = targetNode.AssemblyLinearVelocity
            local predVector = Vector3.new(vel.X, vel.Y * 0.2, vel.Z)
            local predictedPos = targetNode.Position + (predVector * PredictionLevel)
            
            local targetCFrame = CFrame.new(CurrentCamera.CFrame.Position, predictedPos)
            -- ПЛАВНОЕ НАВЕДЕНИЕ (Защита от античита)
            CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(targetCFrame, 0.4) 
        end
    end
end

local function ToggleAimLock()
    AimLockEnabled = not AimLockEnabled
    if not AimLockEnabled then TargetPlayer = nil end
    print("⚡ Aim Lock: " .. (AimLockEnabled and "ENABLED" or "DISABLED"))
end

local function ToggleWallCheck()
    WallCheckEnabled = not WallCheckEnabled
    print("🧱 Wall Check: " .. (WallCheckEnabled and "ENABLED" or "DISABLED"))
end

-- ==============================================
-- ИНИЦИАЛИЗАЦИЯ И ГОРЯЧИЕ КЛАВИШИ
-- ==============================================
RunService:BindToRenderStep("MM2_AimLock_Sync", Enum.RenderPriority.Camera.Value + 1, AimLockLoop)
RunService.Heartbeat:Connect(wallHopHeartbeat)
RunService.Heartbeat:Connect(UpdateOutlineLoop)

UserInputService.JumpRequest:Connect(function()
    if WallHop.enabled then performWallhop() end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.T then ToggleAimLock() end
    if input.KeyCode == Enum.KeyCode.G then ToggleWallCheck() end
    if input.KeyCode == Enum.KeyCode.E then ToggleOutline() end
    if input.KeyCode == Enum.KeyCode.H then ToggleWallHop() end
    if input.KeyCode == Enum.KeyCode.B then ToggleBombJump() end
    
    -- Bomb Jump на клик (если в воздухе)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        FastBombJump()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then
        WallHop.isJumpKeyPressed = false
    end
end)

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then
        WallHop.isJumpKeyPressed = true
    end
end)

