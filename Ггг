local Hotkeys = {
    [Enum.KeyCode.T] = function() if BindableButtons.Buttons["aim_toggle"] then BindableButtons.Buttons["aim_toggle"].MouseButton1Click:Fire() end end,
    [Enum.KeyCode.G] = function() if BindableButtons.Buttons["wall_toggle"] then BindableButtons.Buttons["wall_toggle"].MouseButton1Click:Fire() end end,
    [Enum.KeyCode.E] = function() if BindableButtons.Buttons["outline_toggle"] then BindableButtons.Buttons["outline_toggle"].MouseButton1Click:Fire() end end,
    [Enum.KeyCode.H] = function() if BindableButtons.Buttons["wallhop_toggle"] then BindableButtons.Buttons["wallhop_toggle"].MouseButton1Click:Fire() end end,
    [Enum.KeyCode.R] = function() if BindableButtons.Buttons["rt_toggle"] then BindableButtons.Buttons["rt_toggle"].MouseButton1Click:Fire() end end,
    [Enum.KeyCode.Insert] = function() BindableButtons.SetVisible(not BindableButtons.Visible) end,
    [Enum.KeyCode.Delete] = function() print("🧹 Cleaning up..."); RootMaid:Destroy() end
}

__UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if Hotkeys[input.KeyCode] then xpcall(Hotkeys[input.KeyCode], function(e) warn(e) end) end
end)

