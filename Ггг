local Hotkeys = {
    [Enum.KeyCode.T] = function() BindableButtons.Buttons["aim_toggle"].MouseButton1Click:Fire() end,
    [Enum.KeyCode.G] = function() BindableButtons.Buttons["wall_toggle"].MouseButton1Click:Fire() end,
    [Enum.KeyCode.E] = function() BindableButtons.Buttons["outline_toggle"].MouseButton1Click:Fire() end,
    [Enum.KeyCode.H] = function() BindableButtons.Buttons["wallhop_toggle"].MouseButton1Click:Fire() end,
    [Enum.KeyCode.R] = function() BindableButtons.Buttons["rt_toggle"].MouseButton1Click:Fire() end,
    [Enum.KeyCode.Insert] = function()
        local isVisible = BindableButtons.Buttons["aim_toggle"].Visible
        for _, btn in pairs(BindableButtons.Buttons) do btn.Visible = not isVisible end
        print("👁️ UI: " .. (not isVisible and "VISIBLE" or "HIDDEN"))
    end,
    [Enum.KeyCode.Delete] = function()
        print("🧹 Cleaning up and destroying script...")
        RootMaid:Destroy()
    end
}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if Hotkeys[input.KeyCode] then Hotkeys[input.KeyCode]() end
end)

