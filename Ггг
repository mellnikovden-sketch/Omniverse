local OutlineEnabled, OutlinedPlayers = false, {}
local OutlineUpdateRate, LastOutlineUpdate = 0.1, 0

local function GetOutlineColor(role)
    return role == "Murderer" and Color3.fromRGB(255, 0, 0) or 
           role == "Sheriff" and Color3.fromRGB(0, 150, 255) or 
           role == "Innocent" and Color3.fromRGB(0, 255, 0) or 
           Color3.fromRGB(255, 255, 255)
end

local function GetRoleEmoji(role)
    return role == "Murderer" and "" or role == "Sheriff" and "🔫" or role == "Innocent" and "👤" or "❓"
end

local function ApplyOutline(plr)
    if not plr or plr == LocalPlayer or OutlinedPlayers[plr] or not plr.Character then return end
    local role = GetPlayerRole(plr)
    if not role or role == "Dead" then return end
    
    local color = GetOutlineColor(role)
    local highlight = Instance.new("Highlight")
    highlight.Name, highlight.FillTransparency, highlight.OutlineTransparency = "Outline_Highlight", 1, 0.2
    highlight.OutlineColor, highlight.DepthMode, highlight.Adornee = color, Enum.HighlightDepthMode.AlwaysOnTop, plr.Character
    highlight.Parent = plr.Character
    
    local head = plr.Character:FindFirstChild("Head")
    if head then
        local billboard = Instance.new("BillboardGui")
        billboard.Name, billboard.Size, billboard.Adornee = "Outline_NameTag", UDim2.new(0, 200, 0, 50), head
        billboard.AlwaysOnTop, billboard.Parent = true, plr.Character
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size, nameLabel.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
        nameLabel.Text = GetRoleEmoji(role) .. " " .. plr.Name .. " [" .. role .. "]"
        nameLabel.TextColor3, nameLabel.TextSize, nameLabel.Font = color, 14, Enum.Font.Jura
        nameLabel.TextStrokeTransparency, nameLabel.TextStrokeColor3 = 0.2, Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = billboard
    end
    
    OutlinedPlayers[plr] = {Highlight = highlight, Role = role}
end

local function RemoveOutline(plr)
    if OutlinedPlayers[plr] then
        local data = OutlinedPlayers[plr]
        pcall(function() if data.Highlight then data.Highlight:Destroy() end end)
        OutlinedPlayers[plr] = nil
    end
end

local function FullRefreshOutline()
    for plr in pairs(OutlinedPlayers) do RemoveOutline(plr) end
    if OutlineEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then ApplyOutline(plr) end
        end
    end
end

local function UpdateOutline()
    if not OutlineEnabled then
        for plr in pairs(OutlinedPlayers) do RemoveOutline(plr) end
        return
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local role = GetPlayerRole(plr)
            if not role or role == "Dead" then
                RemoveOutline(plr)
            elseif OutlinedPlayers[plr] then
                local data = OutlinedPlayers[plr]
                if data.Role ~= role then
                    local color = GetOutlineColor(role)
                    if data.Highlight then data.Highlight.OutlineColor = color end
                    data.Role = role
                end
            else
                ApplyOutline(plr)
            end
        end
    end
end

